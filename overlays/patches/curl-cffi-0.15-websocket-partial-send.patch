@@ -0,0 +1,41 @@
+from __future__ import annotations
+
+import pytest
+
+from curl_cffi.const import CurlWsFlag
+from curl_cffi.requests.websockets import AsyncWebSocket
+
+
+class PartialWriteCurl:
+    """Force libcurl's documented CURLE_OK-with-partial-consumption result."""
+
+    def __init__(self) -> None:
+        self.attempts: list[tuple[int, int, int]] = []
+        self.accepted = bytearray()
+
+    def ws_send(
+        self, chunk: memoryview, flags: CurlWsFlag | int
+    ) -> int:
+        chunk_len = len(chunk)
+        n_sent = 10000 if not self.attempts else chunk_len
+        self.attempts.append((chunk_len, n_sent, int(flags)))
+        self.accepted.extend(chunk[:n_sent])
+        return n_sent
+
+    def close(self) -> None:
+        pass
+
+
+@pytest.mark.asyncio
+async def test_partial_write_exact_boundary_resumption() -> None:
+    curl = PartialWriteCurl()
+    websocket = AsyncWebSocket(None, curl, send_time_slice=3600.0)
+    payload = b"X" * 100000
+
+    assert await websocket._send_payload(payload, CurlWsFlag.BINARY)
+    assert bytes(curl.accepted) == payload
+    assert curl.attempts == [
+        (65536, 10000, int(CurlWsFlag.BINARY | CurlWsFlag.CONT)),
+        (55536, 55536, int(CurlWsFlag.BINARY | CurlWsFlag.CONT)),
+        (34464, 34464, int(CurlWsFlag.BINARY)),
+    ]
