+    // The persisted SQLite log database grows without bound under the
+    // upstream TRACE default once sessions run for days or weeks, and every
+    // cold start then stalls on its inline maintenance. Keep only warnings
+    // and errors by default; CODEX_LOG_DB_FILTER accepts target/level `Targets`
+    // syntax, for example "info" or "trace,hyper_util=warn", to restore richer
+    // capture for a single session when diagnosing Codex itself.
+    match std::env::var("CODEX_LOG_DB_FILTER") {
+        Ok(spec) => filter_for_spec(Some(&spec)),
+        Err(std::env::VarError::NotPresent) => filter_for_spec(None),
+        Err(std::env::VarError::NotUnicode(_)) => {
+            eprintln!("codex: invalid CODEX_LOG_DB_FILTER; using warn");
+            filter_for_spec(None)
+        }
+    }
+}
+
+fn filter_for_spec(spec: Option<&str>) -> Targets {
+    let targets = match spec {
+        Some(spec) if has_field_qualified_syntax(spec) => {
+            eprintln!("codex: invalid CODEX_LOG_DB_FILTER; using warn");
+            Targets::new().with_default(LevelFilter::WARN)
+        }
+        Some(spec) => match spec.parse::<Targets>() {
+            Ok(targets) => targets,
+            Err(_) => {
+                eprintln!("codex: invalid CODEX_LOG_DB_FILTER; using warn");
+                Targets::new().with_default(LevelFilter::WARN)
+            }
+        },
+        None => Targets::new().with_default(LevelFilter::WARN),
+    };
+    let mut sanitized = Targets::new();
+    if let Some(level) = targets.default_level() {
+        sanitized = sanitized.with_default(level);
+    }
+    for (target, level) in targets.iter() {
+        if !is_mandatory_off_target(target) {
+            sanitized = sanitized.with_target(target, level);
+        }
+    }
+    for target in MANDATORY_OFF_TARGETS {
+        sanitized = sanitized.with_target(*target, LevelFilter::OFF);
+    }
+    sanitized
+}
+
+fn is_mandatory_off_target(target: &str) -> bool {
+    MANDATORY_OFF_TARGETS
+        .iter()
+        .any(|blocked| target.starts_with(*blocked))
+}
+
+fn has_field_qualified_syntax(spec: &str) -> bool {
+    // Targets::iter exposes only target/level pairs, so rebuilding a parsed
+    // span or field directive would silently broaden its meaning.
+    spec.bytes()
+        .any(|byte| matches!(byte, b'[' | b']' | b'{' | b'}'))
 }
 
