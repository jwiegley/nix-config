+use super::MultitoolCli;
+use super::profile_v2_applies_to_subcommand;
+use clap::ArgMatches;
+use clap::Command;
+use clap::CommandFactory;
+use clap::FromArgMatches;
+use clap::parser::ValueSource;
+use std::ffi::OsString;
+use std::io;
+use std::io::Write;
+
+const WRAPPER_POLICY_PROBE_ENV_VAR: &str = "CODEX_INTERNAL_WRAPPER_POLICY_PROBE";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Policy {
+    Manage,
+    Delegate,
+    ConflictProfile,
+    ConflictIgnoreUserConfig,
+}
+
+impl Policy {
+    fn as_str(self) -> &'static str {
+        match self {
+            Self::Manage => "manage",
+            Self::Delegate => "delegate",
+            Self::ConflictProfile => "conflict-profile",
+            Self::ConflictIgnoreUserConfig => "conflict-ignore-user-config",
+        }
+    }
+}
+
+pub(super) fn run_if_requested() -> io::Result<bool> {
+    if std::env::var_os(WRAPPER_POLICY_PROBE_ENV_VAR).is_none_or(|value| value != "v1") {
+        return Ok(false);
+    }
+
+    let policy = policy_for_args(std::env::args_os());
+    writeln!(io::stdout().lock(), "{}", policy.as_str())?;
+    Ok(true)
+}
+
+fn policy_for_args<I, T>(args: I) -> Policy
+where
+    I: IntoIterator<Item = T>,
+    T: Into<OsString> + Clone,
+{
+    let mut command = MultitoolCli::command();
+    let matches = match command.try_get_matches_from_mut(args) {
+        Ok(matches) => matches,
+        Err(_) => return Policy::Delegate,
+    };
+    let cli = match MultitoolCli::from_arg_matches(&matches) {
+        Ok(cli) => cli,
+        Err(_) => return Policy::Delegate,
+    };
+    if !cli
+        .subcommand
+        .as_ref()
+        .is_none_or(profile_v2_applies_to_subcommand)
+    {
+        return Policy::Delegate;
+    }
+    if has_explicit_long_arg(&command, &matches, "ignore-user-config") {
+        return Policy::ConflictIgnoreUserConfig;
+    }
+    if has_explicit_long_arg(&command, &matches, "profile") {
+        return Policy::ConflictProfile;
+    }
+
+    Policy::Manage
+}
+
+fn has_explicit_long_arg(command: &Command, matches: &ArgMatches, long: &str) -> bool {
+    if command.get_arguments().any(|arg| {
+        arg.get_long() == Some(long)
+            && matches.ids().any(|id| id == arg.get_id())
+            && matches.value_source(arg.get_id().as_str()) == Some(ValueSource::CommandLine)
+    }) {
+        return true;
+    }
+
+    let Some((name, subcommand_matches)) = matches.subcommand() else {
+        return false;
+    };
+    command
+        .find_subcommand(name)
+        .is_some_and(|subcommand| has_explicit_long_arg(subcommand, subcommand_matches, long))
+}
