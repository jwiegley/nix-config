+use super::Policy;
+use super::policy_for_args;
+use pretty_assertions::assert_eq;
+
+fn policy(args: &[&str]) -> Policy {
+    policy_for_args(args.iter().copied())
+}
+
+#[test]
+fn manages_exactly_the_existing_profile_applicability_set() {
+    for args in [
+        &["codex"][..],
+        &["codex", "prompt"][..],
+        &["codex", "exec", "prompt"][..],
+        &["codex", "e", "prompt"][..],
+        &["codex", "review", "--uncommitted"][..],
+        &["codex", "resume", "--last"][..],
+        &["codex", "archive", "thread"][..],
+        &["codex", "delete", "thread"][..],
+        &["codex", "unarchive", "thread"][..],
+        &["codex", "fork", "--last"][..],
+        &["codex", "mcp", "list"][..],
+        &["codex", "sandbox", "--", "echo"][..],
+        &["codex", "debug", "prompt-input"][..],
+    ] {
+        assert_eq!(policy(args), Policy::Manage, "argv: {args:?}");
+    }
+
+    for args in [
+        &["codex", "completion", "bash"][..],
+        &["codex", "features", "list"][..],
+        &["codex", "debug", "models", "--bundled"][..],
+    ] {
+        assert_eq!(policy(args), Policy::Delegate, "argv: {args:?}");
+    }
+}
+
+#[test]
+fn delegates_help_version_and_every_parse_error() {
+    for args in [
+        &["codex", "--help"][..],
+        &["codex", "--version"][..],
+        &["codex", "exec", "--help"][..],
+        &["codex", "exec", "--version"][..],
+        &["codex", "--unknown-option"][..],
+        &["codex", "--profile"][..],
+        &["codex", "--profile", "nested/work"][..],
+        &["codex", "--profile", "work", "features", "list"][..],
+        &["codex", "--ignore-user-config"][..],
+        &["codex", "mcp", "list", "--ignore-user-config"][..],
+        &["codex", "mcp", "add"][..],
+    ] {
+        assert_eq!(policy(args), Policy::Delegate, "argv: {args:?}");
+    }
+}
+
+#[test]
+fn finds_explicit_profiles_at_root_and_subcommand_scopes() {
+    for args in [
+        &["codex", "--profile", "work"][..],
+        &["codex", "-pwork", "exec", "prompt"][..],
+        &["codex", "exec", "--profile=work", "prompt"][..],
+        &["codex", "resume", "--profile", "work", "--last"][..],
+        &["codex", "sandbox", "--profile", "work", "--", "echo"][..],
+    ] {
+        assert_eq!(policy(args), Policy::ConflictProfile, "argv: {args:?}");
+    }
+}
+
+#[test]
+fn ignore_user_config_wins_only_when_clap_parses_it_as_an_option() {
+    assert_eq!(
+        policy(&["codex", "exec", "--ignore-user-config", "prompt"]),
+        Policy::ConflictIgnoreUserConfig
+    );
+    assert_eq!(
+        policy(&["codex", "exec", "resume", "--ignore-user-config", "--last",]),
+        Policy::ConflictIgnoreUserConfig
+    );
+    assert_eq!(
+        policy(&[
+            "codex",
+            "exec",
+            "--profile",
+            "work",
+            "--ignore-user-config",
+            "prompt",
+        ]),
+        Policy::ConflictIgnoreUserConfig
+    );
+    assert_eq!(
+        policy(&["codex", "exec", "--", "--ignore-user-config"]),
+        Policy::Manage
+    );
+}
+
+#[test]
+fn profile_looking_payloads_are_not_conflicts() {
+    for args in [
+        &["codex", "--", "--profile"][..],
+        &["codex", "exec", "--", "--profile"][..],
+        &["codex", "exec", "--", "--help"][..],
+        &[
+            "codex",
+            "mcp",
+            "add",
+            "server",
+            "--",
+            "command",
+            "--profile",
+            "work",
+            "--help",
+        ][..],
+        &[
+            "codex",
+            "sandbox",
+            "--",
+            "command",
+            "--profile",
+            "work",
+            "--help",
+        ][..],
+        &["codex", "debug", "prompt-input", "--", "--profile"][..],
+    ] {
+        assert_eq!(policy(args), Policy::Manage, "argv: {args:?}");
+    }
+
+    assert_eq!(policy(&["codex", "apply", "--", "-p"]), Policy::Delegate);
+}
