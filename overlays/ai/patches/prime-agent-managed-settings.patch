@@ -0,0 +1,79 @@
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "fs";
+import { tmpdir } from "os";
+import { join } from "path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { SettingsManager } from "../src/core/settings-manager.js";
+
+describe("managed settings overlay", () => {
+	let root: string;
+	let agentDir: string;
+	let projectDir: string;
+	let managedPath: string;
+	let originalManagedPath: string | undefined;
+
+	beforeEach(() => {
+		root = mkdtempSync(join(tmpdir(), "prime-managed-settings-"));
+		agentDir = join(root, "agent");
+		projectDir = join(root, "project");
+		managedPath = join(root, "managed-settings.json");
+		mkdirSync(agentDir, { recursive: true });
+		mkdirSync(join(projectDir, ".prime", "agent"), { recursive: true });
+		originalManagedPath = process.env.PRIME_AGENT_MANAGED_SETTINGS;
+		delete process.env.PRIME_AGENT_MANAGED_SETTINGS;
+	});
+
+	afterEach(() => {
+		if (originalManagedPath === undefined) delete process.env.PRIME_AGENT_MANAGED_SETTINGS;
+		else process.env.PRIME_AGENT_MANAGED_SETTINGS = originalManagedPath;
+		rmSync(root, { recursive: true, force: true });
+	});
+
+	it("keeps managed resource policy effective while user preferences remain writable", async () => {
+		const globalPath = join(agentDir, "settings.json");
+		const managed = { packages: ["managed-package"], theme: "managed-theme" };
+		writeFileSync(globalPath, JSON.stringify({ packages: ["user-package"], theme: "user-theme" }));
+		writeFileSync(
+			join(projectDir, ".prime", "agent", "settings.json"),
+			JSON.stringify({ packages: ["project-package"], theme: "project-theme" }),
+		);
+		writeFileSync(managedPath, JSON.stringify(managed));
+		process.env.PRIME_AGENT_MANAGED_SETTINGS = managedPath;
+
+		const manager = SettingsManager.create(projectDir, agentDir);
+		expect(manager.getPackages()).toEqual(["managed-package"]);
+		expect(manager.getTheme()).toBe("managed-theme");
+
+		manager.setOnboardingShown(true);
+		manager.setDefaultModelAndProvider("provider", "model");
+		manager.setTheme("user-attempt");
+		await manager.flush();
+
+		const saved = JSON.parse(readFileSync(globalPath, "utf-8"));
+		expect(saved.onboardingShown).toBe(true);
+		expect(saved.defaultProvider).toBe("provider");
+		expect(saved.defaultModel).toBe("model");
+		expect(saved.theme).toBe("user-attempt");
+		expect(manager.getTheme()).toBe("managed-theme");
+		expect(JSON.parse(readFileSync(managedPath, "utf-8"))).toEqual(managed);
+	});
+
+	it("reloads a replaced managed leaf without copying it into mutable settings", async () => {
+		writeFileSync(managedPath, JSON.stringify({ theme: "first" }));
+		process.env.PRIME_AGENT_MANAGED_SETTINGS = managedPath;
+		const manager = SettingsManager.create(projectDir, agentDir);
+		expect(manager.getTheme()).toBe("first");
+
+		writeFileSync(managedPath, JSON.stringify({ theme: "second" }));
+		await manager.reload();
+		expect(manager.getTheme()).toBe("second");
+		expect(() => readFileSync(join(agentDir, "settings.json"), "utf-8")).toThrow();
+	});
+
+	it("fails closed when the managed leaf is not a valid JSON object", () => {
+		writeFileSync(managedPath, "[]");
+		process.env.PRIME_AGENT_MANAGED_SETTINGS = managedPath;
+		expect(() => SettingsManager.create(projectDir, agentDir)).toThrow("Managed settings must be a JSON object");
+	});
+});
