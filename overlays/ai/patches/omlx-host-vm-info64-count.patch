diff --git a/omlx/utils/psutil_compat.py b/omlx/utils/psutil_compat.py
--- a/omlx/utils/psutil_compat.py
+++ b/omlx/utils/psutil_compat.py
@@ -23,7 +23,9 @@
 logger = logging.getLogger(__name__)
 
 _HOST_VM_INFO64 = 4
+_HOST_VM_INFO64_COUNT = 62
 _HOST_INFO64_MAX_COUNT = 256
+_MIG_ARRAY_TOO_LARGE = -307  # <mach/mig_errors.h>: array not large enough
 _VM_STATS_MIN_COUNT = 4
 # Offsets into vm_statistics64_data_t past the stable first four. Cross-checked
 # against `vm_stat` output on Apple Silicon.
@@ -103,7 +105,8 @@ def get_macos_vm_stats() -> dict[str, int] | None:
     """Return macOS vm_statistics64 page counters in bytes.
 
-    The first four counters are stable across SDK versions. The oversized
-    host_info64_t buffer avoids binding oMLX to an SDK-specific struct tail.
+    The first four counters are stable across SDK versions. Keep oversized
+    storage for forward-compatible struct tails, but begin with the current
+    HOST_VM_INFO64_COUNT and retry once if Mach reports a larger reply.
     "speculative" and "compressed" sit further into the struct and are only
     reported when the kernel filled that far, so callers must treat them as
     optional.
@@ -113,10 +116,18 @@ def get_macos_vm_stats() -> dict[str, int] | None:
         return None
     try:
         stats = (ctypes.c_int * _HOST_INFO64_MAX_COUNT)()
-        count = ctypes.c_uint(_HOST_INFO64_MAX_COUNT)
+        count = ctypes.c_uint(_HOST_VM_INFO64_COUNT)
         rc = _libc.host_statistics64(
             _MACH_HOST, _HOST_VM_INFO64, stats, ctypes.byref(count)
         )
+        if rc == _MIG_ARRAY_TOO_LARGE:
+            required_count = int(count.value)
+            if not (_HOST_VM_INFO64_COUNT < required_count <= _HOST_INFO64_MAX_COUNT):
+                return None
+            count = ctypes.c_uint(required_count)
+            rc = _libc.host_statistics64(
+                _MACH_HOST, _HOST_VM_INFO64, stats, ctypes.byref(count)
+            )
         if rc != 0 or count.value < _VM_STATS_MIN_COUNT:
             return None
         ps = _VM_PAGE_SIZE
