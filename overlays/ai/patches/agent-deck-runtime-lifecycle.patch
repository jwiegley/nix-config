+func (h *Home) transitionCurrent(instanceID string, token uint64) bool {
+	if token == 0 {
+		return true
+	}
+	h.transitionMu.Lock()
+	defer h.transitionMu.Unlock()
+	return h.transitionTokens[instanceID] == token
