+		statusWinner := requireOnePackagedWinner(t, runPackagedContendedCAS(t, helper, path,
+			packagedRuntimeContender(t, helper, "status", path, "1", "0", "waiting"),
+			packagedRuntimeContender(t, helper, "status", path, "1", "0", "error"),
