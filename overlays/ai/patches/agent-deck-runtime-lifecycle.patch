+
+func commitSwitchAccount(inst *session.Instance, account string, persist func() error) (string, error) {
+	oldAccount, postCommit, err := session.SetField(inst, session.FieldAccount, account, nil)
+	if err != nil {
+		return oldAccount, err
+	}
+	if postCommit != nil {
+		postCommit()
+	}
+	saveErr := persist()
+	if saveErr == nil {
+		return oldAccount, nil
+	}
+	// SaveWithGroups is transactional. Restore the in-memory field when its
+	// commit fails so a replacement cannot launch with uncommitted metadata.
+	_, rollbackPostCommit, rollbackErr := session.SetField(inst, session.FieldAccount, oldAccount, nil)
+	if rollbackPostCommit != nil {
+		rollbackPostCommit()
+	}
+	if rollbackErr != nil {
+		return oldAccount, fmt.Errorf("failed to save session state: %v; failed to restore account: %w", saveErr, rollbackErr)
+	}
+	return oldAccount, fmt.Errorf("failed to save session state: %w", saveErr)
 }
 
