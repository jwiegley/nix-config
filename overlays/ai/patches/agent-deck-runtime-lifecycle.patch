+	afterRuntime, found, err := storage.GetDB().ReadRuntimeState(winner.ID)
+	if err != nil || !found || afterRuntime != winnerRuntime {
+		t.Fatalf("winner runtime=%#v found=%v err=%v, want %#v", afterRuntime, found, err, winnerRuntime)
+	}
