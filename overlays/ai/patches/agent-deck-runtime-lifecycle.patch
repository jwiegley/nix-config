+func profileMigrationLockError(id string) error {
+	release, acquired, err := defaultTryAcquireInstanceSpawnLock(id)
+	if err != nil {
+		return err
+	}
+	if acquired {
+		release()
+		return fmt.Errorf("instance spawn lock for %q was not held", id)
+	}
+	return nil
+}
