+func (h *Home) rollbackPhysicalSeed(inst *session.Instance, seed statedb.InstanceSeedToken, seeded bool, cause error) (bool, error) {
+	if !seeded || h.storage == nil {
+		return false, cause
+	}
+	if err := h.storage.RollbackSessionSeed(seed); err != nil {
