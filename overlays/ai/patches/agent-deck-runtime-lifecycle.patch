+	state, _, _ = db.ReadRuntimeState("one")
+	if state.Generation != 1 || spawnCount != 1 || sweepCount != 1 {
+		t.Fatalf("generation=%d spawn=%d sweep=%d", state.Generation, spawnCount, sweepCount)
+	}
+}
