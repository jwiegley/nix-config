+		panePID, pids, probeErr := paneProcessTreeForPaneID(target.SocketName, target.PaneID)
+		if probeErr != nil {
+			return nil, probeErr
+		}
+		if panePID != target.PanePID {
+			return nil, errStableSessionTargetChanged
+		}
