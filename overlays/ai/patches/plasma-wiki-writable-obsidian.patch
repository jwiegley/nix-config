+class _RootedDirectory:
+    """Directory capability that never reopens a validated destination path."""
+
+    _METADATA_CONTRACT = (
+        'regular-file-contents',
+        'permission-bits-plus-owner-write',
+        'nanosecond-atime-mtime',
+        'descriptor-addressable-xattrs-and-flags',
+        'metadata-without-public-fd-api-excluded',
+    )
+    _DIRECTORY_FLAGS = (
+        os.O_RDONLY
+        | getattr(os, 'O_DIRECTORY', 0)
+        | getattr(os, 'O_NOFOLLOW', 0)
+        | getattr(os, 'O_CLOEXEC', 0)
+    )
+    def __init__(
+        self,
+        fds: list[int],
+        links: list[tuple[int, str, int]],
+    ) -> None:
+        self._fds = fds
+        self._links = links
+
+    @classmethod
+    def open(cls, path: pathlib.Path) -> _RootedDirectory:
+        """Open the trusted root without following the root itself."""
+        cls._require_capabilities()
+        try:
+            fd = os.open(path, cls._DIRECTORY_FLAGS)
+        except OSError as error:
+            if error.errno in (errno.ELOOP, errno.ENOTDIR):
+                raise RuntimeError(
+                    f'Refusing symlink or non-directory root: {path}'
+                ) from error
+            raise
+        try:
+            is_directory = stat.S_ISDIR(os.fstat(fd).st_mode)
+        except BaseException:
+            os.close(fd)
+            raise
+        if not is_directory:
+            os.close(fd)
+            raise NotADirectoryError(path)
+        return cls([fd], [])
+
+    @classmethod
+    def _require_capabilities(cls) -> None:
+        required_dir_fd = (
+            os.mkdir,
+            os.open,
+            os.rename,
+            os.rmdir,
+            os.stat,
+            os.unlink,
+        )
+        if (
+            not hasattr(os, 'O_DIRECTORY')
+            or not hasattr(os, 'O_NOFOLLOW')
+            or not hasattr(os, 'fchmod')
+            or any(
+                function not in os.supports_dir_fd
+                for function in required_dir_fd
+            )
+            or os.stat not in os.supports_follow_symlinks
+            or os.scandir not in os.supports_fd
+            or os.utime not in os.supports_fd
+        ):
+            raise NotImplementedError(
+                'Safe descriptor-relative filesystem operations are unsupported'
+            )
+
+    @property
+    def fd(self) -> int:
+        """Return the pinned directory descriptor."""
+        if not self._fds:
+            raise ValueError('Rooted directory is closed')
+        return self._fds[-1]
+
+    def __enter__(self) -> _RootedDirectory:
+        return self
+
+    def __exit__(self, exc_type, value, traceback) -> bool:
+        verification_error = None
+        try:
+            self._verify_links()
+        except BaseException as error:
+            verification_error = error
+        finally:
+            while self._fds:
+                os.close(self._fds.pop())
+        if verification_error is not None:
+            if value is not None:
+                raise verification_error from value
+            raise verification_error
+        return False
+
+    @staticmethod
+    def _parts(relative: Union[str, pathlib.PurePath]) -> tuple[str, ...]:
+        path = pathlib.PurePath(relative)
+        if (
+            path.is_absolute()
+            or not path.parts
+            or any(part in ('', '.', '..') for part in path.parts)
+        ):
+            raise ValueError(f'Unsafe relative path: {relative}')
+        return path.parts
+
+    @classmethod
+    def _component(cls, name: str) -> str:
+        parts = cls._parts(name)
+        if len(parts) != 1:
+            raise ValueError(f'Expected one path component: {name}')
+        return parts[0]
+
+    @classmethod
+    def _open_directory(cls, parent_fd: int, name: str, *, create: bool) -> int:
+        name = cls._component(name)
+        try:
+            info = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
+        except FileNotFoundError:
+            if not create:
+                raise
+            parent_mode = os.fstat(parent_fd).st_mode
+            os.fchmod(parent_fd, stat.S_IMODE(parent_mode) | stat.S_IWUSR)
+            os.mkdir(name, mode=0o777, dir_fd=parent_fd)
+        else:
+            if stat.S_ISLNK(info.st_mode):
+                raise RuntimeError(
+                    f'Refusing symlink destination component: {name}'
+                )
+            if not stat.S_ISDIR(info.st_mode):
+                raise NotADirectoryError(name)
+        try:
+            child_fd = os.open(name, cls._DIRECTORY_FLAGS, dir_fd=parent_fd)
+        except OSError as error:
+            if error.errno in (errno.ELOOP, errno.ENOTDIR):
+                raise RuntimeError(
+                    f'Refusing changed destination component: {name}'
+                ) from error
+            raise
+        try:
+            is_directory = stat.S_ISDIR(os.fstat(child_fd).st_mode)
+        except BaseException:
+            os.close(child_fd)
+            raise
+        if not is_directory:
+            os.close(child_fd)
+            raise NotADirectoryError(name)
+        return child_fd
+
+    def directory(
+        self,
+        relative: Union[str, pathlib.PurePath],
+        *,
+        create: bool = False,
+    ) -> _RootedDirectory:
+        """Open every relative component with ``O_NOFOLLOW``."""
+        fds = [os.dup(self.fd)]
+        links = []
+        try:
+            for part in self._parts(relative):
+                child_fd = self._open_directory(fds[-1], part, create=create)
+                links.append((fds[-1], part, child_fd))
+                fds.append(child_fd)
+        except BaseException:
+            while fds:
+                os.close(fds.pop())
+            raise
+        return type(self)(fds, links)
+
+    def _verify_links(self) -> None:
+        for parent_fd, name, child_fd in self._links:
+            try:
+                visible = os.stat(
+                    name,
+                    dir_fd=parent_fd,
+                    follow_symlinks=False,
+                )
+            except FileNotFoundError as error:
+                raise RuntimeError(
+                    f'Destination component disappeared during operation: {name}'
+                ) from error
+            pinned = os.fstat(child_fd)
+            if (
+                not stat.S_ISDIR(visible.st_mode)
+                or (visible.st_dev, visible.st_ino)
+                != (pinned.st_dev, pinned.st_ino)
+            ):
+                raise RuntimeError(
+                    f'Destination component changed during operation: {name}'
+                )
+
+    def _entry_stat(self, name: str, *, missing_ok: bool = False):
+        name = self._component(name)
+        try:
+            info = os.stat(name, dir_fd=self.fd, follow_symlinks=False)
+        except FileNotFoundError:
+            if missing_ok:
+                return None
+            raise
+        if stat.S_ISLNK(info.st_mode):
+            raise RuntimeError(f'Refusing symlink destination entry: {name}')
+        return info
+
+    def _verify_entry(self, name: str, fd: int) -> None:
+        visible = self._entry_stat(name)
+        pinned = os.fstat(fd)
+        if (visible.st_dev, visible.st_ino) != (pinned.st_dev, pinned.st_ino):
+            raise RuntimeError(
+                f'Destination entry changed during operation: {name}'
+            )
+
+    def entries(self) -> list[tuple[str, os.stat_result]]:
+        """Return no-follow metadata for the pinned directory entries."""
+        with os.scandir(self.fd) as entries:
+            result = [
+                (entry.name, entry.stat(follow_symlinks=False))
+                for entry in entries
+            ]
+        return sorted(result, key=lambda item: item[0])
+
+    def file_exists(self, name: str) -> bool:
+        info = self._entry_stat(name, missing_ok=True)
+        if info is None:
+            return False
+        if not stat.S_ISREG(info.st_mode):
+            raise IsADirectoryError(name)
+        return True
+
+    def _open_regular(self, name: str, flags: int, mode: int = 0o666) -> int:
+        name = self._component(name)
+        try:
+            fd = os.open(
+                name,
+                flags | os.O_NOFOLLOW | getattr(os, 'O_CLOEXEC', 0),
+                mode,
+                dir_fd=self.fd,
+            )
+        except OSError as error:
+            if error.errno == errno.ELOOP:
+                raise RuntimeError(
+                    f'Refusing symlink destination entry: {name}'
+                ) from error
+            raise
+        try:
+            is_regular = stat.S_ISREG(os.fstat(fd).st_mode)
+        except BaseException:
+            os.close(fd)
+            raise
+        if not is_regular:
+            os.close(fd)
+            raise OSError(f'Refusing non-regular file: {name}')
+        return fd
+
+    def read_bytes(self, name: str) -> bytes:
+        fd = self._open_regular(
+            name,
+            os.O_RDONLY | getattr(os, 'O_NONBLOCK', 0),
+        )
+        try:
+            chunks = []
+            while chunk := os.read(fd, 1024 * 1024):
+                chunks.append(chunk)
+            self._verify_entry(name, fd)
+            return b''.join(chunks)
+        finally:
+            os.close(fd)
+
+    def read_text(self, name: str) -> str:
+        return self.read_bytes(name).decode('utf-8')
+
+    def private_temp(self) -> _TempFile:
+        """Create a file inside a private, descriptor-pinned stage."""
+        for _ in range(100):
+            stage_name = f'.wiki-stage-{secrets.token_hex(12)}'
