+    def install_temp(
+        self,
+        temporary: _TempFile,
+        name: str,
+        *,
+        mode: int | None = None,
+    ) -> None:
+        """Atomically install a staged file within this pinned directory."""
+        name = self._component(name)
+        if (
+            temporary._directory is not self
+            or temporary._stage_fd < 0
+            or temporary._installed
+        ):
+            raise ValueError('Temporary file does not belong to this directory')
+        existing = self._entry_stat(name, missing_ok=True)
+        if existing is not None and not stat.S_ISREG(existing.st_mode):
+            raise OSError(f'Refusing non-regular destination: {name}')
+        if mode is None:
+            mode = (
+                temporary._creation_mode
+                if existing is None
+                else stat.S_IMODE(existing.st_mode) & 0o777
+            )
+        os.fchmod(temporary._fd, mode & 0o777)
+        os.fsync(temporary._fd)
+        temporary._verify()
+        try:
+            os.rename(
+                temporary._FILENAME,
+                name,
+                src_dir_fd=temporary._stage_fd,
+                dst_dir_fd=self.fd,
+            )
+            temporary._installed = True
+        except BaseException:
+            try:
+                self._verify_entry(name, temporary._fd)
+            except (FileNotFoundError, RuntimeError):
+                pass
+            else:
+                temporary._installed = True
+            raise
+        self._verify_entry(name, temporary._fd)
+        os.fsync(temporary._stage_fd)
+        os.fsync(self.fd)
+
+    def write_text(self, name: str, text: str) -> None:
+        temporary = self.private_temp()
+        try:
+            temporary.write_bytes(text.encode('utf-8'))
+            self.install_temp(temporary, name)
+        finally:
+            temporary.close()
