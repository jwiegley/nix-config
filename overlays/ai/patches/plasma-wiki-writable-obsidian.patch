+    def make_writable(self) -> None:
+        """Add owner write permission without mutating regular-file aliases."""
+        info = os.fstat(self.fd)
+        if not stat.S_ISDIR(info.st_mode):
+            raise NotADirectoryError
+        os.fchmod(self.fd, stat.S_IMODE(info.st_mode) | stat.S_IWUSR)
+        for name, entry_info in self.entries():
+            if stat.S_ISLNK(entry_info.st_mode):
+                continue
+            if stat.S_ISDIR(entry_info.st_mode):
+                with self.directory(name) as child:
+                    child.make_writable()
+                continue
+            if not stat.S_ISREG(entry_info.st_mode):
+                continue
+            if entry_info.st_mode & stat.S_IWUSR:
+                continue
+            try:
+                self._copy_file_from(self, name)
+            except PermissionError as error:
+                raise NotImplementedError(
+                    'Safe replacement of an unreadable file is unsupported'
+                ) from error
+
+    @staticmethod
+    def _copy_contents(source_fd: int, destination_fd: int) -> None:
+        os.lseek(source_fd, 0, os.SEEK_SET)
+        os.lseek(destination_fd, 0, os.SEEK_SET)
+        os.ftruncate(destination_fd, 0)
+        while chunk := os.read(source_fd, 1024 * 1024):
+            remaining = memoryview(chunk)
+            while remaining:
+                written = os.write(destination_fd, remaining)
+                if written == 0:
+                    raise OSError('Could not make progress copying file contents')
+                remaining = remaining[written:]
+
+    @staticmethod
+    def _copy_xattrs(source_fd: int, destination_fd: int) -> None:
+        functions = tuple(
+            getattr(os, name, None)
+            for name in ('listxattr', 'getxattr', 'setxattr')
+        )
+        if not all(functions):
+            return
+        listxattr, getxattr, setxattr = functions
+        try:
+            names = listxattr(source_fd)
+        except (TypeError, ValueError, NotImplementedError) as error:
+            raise NotImplementedError(
+                'Descriptor-relative extended metadata is unsupported'
+            ) from error
+        for name in names:
+            setxattr(destination_fd, name, getxattr(source_fd, name))
+
+    @classmethod
+    def _copy_metadata(
+        cls,
+        source_fd: int,
+        destination_fd: int,
+        *,
+        info: os.stat_result | None = None,
+    ) -> None:
+        """Apply the explicit descriptor-safe copy metadata contract.
+
+        The contract covers permission bits plus owner-write, nanosecond times,
+        and extended attributes or flags only when Python exposes an FD API.
+        Metadata without a public ``os`` FD API (including macOS resource
+        forks) is deliberately excluded rather than reopening a raced path.
+        """
+        if info is None:
+            info = os.fstat(source_fd)
+        cls._copy_xattrs(source_fd, destination_fd)
+        os.fchmod(
+            destination_fd,
+            (stat.S_IMODE(info.st_mode) & 0o777) | stat.S_IWUSR,
+        )
+        os.utime(
+            destination_fd,
+            ns=(info.st_atime_ns, info.st_mtime_ns),
+        )
+        flags = getattr(info, 'st_flags', None)
+        destination_flags = getattr(os.fstat(destination_fd), 'st_flags', None)
+        if flags is not None and flags != destination_flags:
+            fchflags = getattr(os, 'fchflags', None)
+            if fchflags is None:
+                raise NotImplementedError(
+                    'Descriptor-relative file flags are unsupported'
+                )
+            fchflags(destination_fd, flags)
+
+    def copytree_from(self, source: _RootedDirectory) -> None:
+        """Merge a source tree under the descriptor-safe metadata contract."""
+        self.make_writable()
+        for name, info in source.entries():
