+class _TempFile:
+    """Staged file held inside a private, descriptor-pinned directory."""
+
+    _FILENAME = 'payload'
+
+    def __init__(
+        self,
+        directory: _RootedDirectory,
+        stage_name: str,
+        stage_fd: int,
+        fd: int,
+    ) -> None:
+        self._directory = directory
+        self._stage_name = stage_name
+        self._stage_fd = stage_fd
+        self._fd = fd
+        self._creation_mode = stat.S_IMODE(os.fstat(fd).st_mode) & 0o777
+        self._installed = False
+
+    def write_bytes(self, data: bytes) -> None:
+        """Replace the staged contents without exposing a destination path."""
+        os.lseek(self._fd, 0, os.SEEK_SET)
+        os.ftruncate(self._fd, 0)
+        remaining = memoryview(data)
+        while remaining:
+            written = os.write(self._fd, remaining)
+            if written == 0:
+                raise OSError('Could not make progress writing staged contents')
+            remaining = remaining[written:]
+
+    def read_bytes(self) -> bytes:
+        """Read the staged contents through the pinned descriptor."""
+        os.lseek(self._fd, 0, os.SEEK_SET)
+        chunks = []
+        while chunk := os.read(self._fd, 1024 * 1024):
+            chunks.append(chunk)
+        return b''.join(chunks)
+
+    def _verify(self) -> None:
+        self._directory._verify_entry(self._stage_name, self._stage_fd)
