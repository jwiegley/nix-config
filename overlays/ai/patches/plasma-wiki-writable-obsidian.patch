+    def install_many(self, staged: list[tuple[_TempFile, str]]) -> None:
+        """Install one asset set atomically with respect to exceptions.
+
+        A process or system crash can still expose a partial set because POSIX
+        has no portable atomic operation spanning several directory entries.
+        """
+        names = [self._component(name) for _, name in staged]
+        if len(names) != len(set(names)):
+            raise ValueError('Duplicate staged destination name')
+        backups: list[tuple[_TempFile | None, int | None]] = []
+        try:
+            for name in names:
+                existing = self._entry_stat(name, missing_ok=True)
+                if existing is None:
+                    backups.append((None, None))
+                    continue
+                if not stat.S_ISREG(existing.st_mode):
+                    raise OSError(f'Refusing non-regular destination: {name}')
+                source_fd = self._open_regular(
+                    name,
+                    os.O_RDONLY | getattr(os, 'O_NONBLOCK', 0),
+                )
+                backup = None
+                try:
+                    backup = self.private_temp()
+                    source_info = os.fstat(source_fd)
+                    self._copy_contents(source_fd, backup._fd)
+                    self._copy_metadata(
+                        source_fd,
+                        backup._fd,
+                        info=source_info,
+                    )
+                    self._verify_entry(name, source_fd)
+                except BaseException:
+                    if backup is not None:
+                        backup.close()
+                    raise
+                finally:
+                    os.close(source_fd)
+                backups.append(
+                    (backup, stat.S_IMODE(source_info.st_mode) & 0o777)
+                )
+            try:
+                for temporary, name in staged:
+                    self.install_temp(temporary, name)
+            except BaseException:
+                rollback_error = None
+                for (temporary, name), (backup, mode) in reversed(
+                    list(zip(staged, backups))
+                ):
+                    if not temporary._installed:
+                        continue
+                    try:
+                        if backup is None:
+                            self._verify_entry(name, temporary._fd)
+                            os.unlink(name, dir_fd=self.fd)
+                            os.fsync(self.fd)
+                        else:
+                            self.install_temp(backup, name, mode=mode)
+                    except BaseException as error:
+                        rollback_error = error
+                if rollback_error is not None:
+                    raise RuntimeError(
+                        'Could not restore the previous plugin asset set'
+                    ) from rollback_error
+                raise
+        finally:
+            for backup, _ in backups:
+                if backup is not None:
+                    backup.close()
