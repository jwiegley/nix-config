diff --git a/internal/session/last_started_persist.go b/internal/session/last_started_persist.go
--- a/internal/session/last_started_persist.go
+++ b/internal/session/last_started_persist.go
@@ -48,12 +48,21 @@ func ReadLastStartedAtFromToolData(td json.RawMessage) time.Time {
 	if len(td) == 0 {
 		return time.Time{}
 	}
-	var blob struct {
+	var unixBlob struct {
 		LastStartedAt int64 `json:"last_started_at"`
 	}
-	_ = json.Unmarshal(td, &blob)
-	if blob.LastStartedAt == 0 {
-		return time.Time{}
+	if err := json.Unmarshal(td, &unixBlob); err == nil && unixBlob.LastStartedAt != 0 {
+		return time.Unix(unixBlob.LastStartedAt, 0).UTC()
 	}
-	return time.Unix(blob.LastStartedAt, 0).UTC()
+
+	// v1.10.11's Nix patch persisted this field as RFC3339 text. Read that
+	// legacy form so the upgrade preserves the runtime-generation boundary;
+	// all new writes continue to use upstream's Unix-seconds representation.
+	var legacyBlob struct {
+		LastStartedAt time.Time `json:"last_started_at"`
+	}
+	if err := json.Unmarshal(td, &legacyBlob); err != nil || legacyBlob.LastStartedAt.IsZero() {
+		return time.Time{}
+	}
+	return legacyBlob.LastStartedAt.UTC()
 }
diff --git a/internal/session/last_started_persist_test.go b/internal/session/last_started_persist_test.go
--- a/internal/session/last_started_persist_test.go
