@@ -45,6 +45,17 @@ func TestLastStartedAt_ToolDataPersistenceRoundTrip(t *testing.T) {
 	}
 }
 
+func TestLastStartedAt_LegacyRFC3339Text(t *testing.T) {
+	want := time.Date(2026, 7, 1, 9, 30, 0, 123456789, time.UTC)
+	td := []byte(`{"last_started_at":"2026-07-01T09:30:00.123456789Z"}`)
+	if got := ReadLastStartedAtFromToolData(td); !got.Equal(want) {
+		t.Fatalf("legacy RFC3339 last_started_at = %v, want %v", got, want)
+	}
+	if got := ReadLastStartedAtFromToolData([]byte(`{"last_started_at":"invalid"}`)); !got.IsZero() {
+		t.Fatalf("malformed legacy last_started_at = %v, want zero", got)
+	}
+}
+
 // TestLastStartedAt_SQLiteRoundTrip is the boundary test finding #1/#2 of
 // the #1704 review demanded: prove LastStartedAt survives an actual
 // SaveWithGroups -> LoadWithGroups cycle through SQLite — the exact process
@@ -100,4 +111,39 @@ func TestLastStartedAt_SQLiteRoundTrip(t *testing.T) {
 	if !freshLoaded.LastStartedAt.IsZero() {
 		t.Fatalf("never-started instance got a non-zero LastStartedAt after round-trip: %v", freshLoaded.LastStartedAt)
	}
 }
+
+func TestLastStartedAt_TargetedWriteRoundTrip(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	storage := newTestStorage(t)
+
+	inst := NewInstance("targeted-last-started-roundtrip", "/tmp")
+	inst.Tool = "shell"
+	groupTree := NewGroupTreeWithGroups([]*Instance{inst}, nil)
+	if err := storage.SaveWithGroups([]*Instance{inst}, groupTree); err != nil {
+		t.Fatalf("SaveWithGroups: %v", err)
+	}
+
+	want := time.Now().Add(-time.Hour).Truncate(time.Second)
+	if err := storage.db.WriteLastStartedAt(inst.ID, want); err != nil {
+		t.Fatalf("WriteLastStartedAt: %v", err)
+	}
+
+	loaded, _, err := storage.LoadWithGroups()
+	if err != nil {
+		t.Fatalf("LoadWithGroups: %v", err)
+	}
+	var got time.Time
+	for _, candidate := range loaded {
+		if candidate.ID == inst.ID {
+			got = candidate.LastStartedAt
+			break
+		}
+	}
+	if got.IsZero() {
+		t.Fatal("targeted last_started_at row was not loaded")
+	}
+	if !got.Equal(want) {
+		t.Fatalf("targeted last_started_at = %v, want %v", got, want)
+	}
+}
diff --git a/internal/session/restart_persistence_db_test.go b/internal/session/restart_persistence_db_test.go
new file mode 100644
--- /dev/null
+++ b/internal/session/restart_persistence_db_test.go
@@ -0,0 +1,36 @@
+package session
+
+import (
+	"testing"
+
+	"github.com/asheshgoplani/agent-deck/internal/statedb"
+)
+
+func TestRestartPersistenceDBPrefersOwningProfile(t *testing.T) {
+	owner := newTestStorage(t)
+	other := newTestStorage(t)
+	previousGlobal := statedb.GetGlobal()
+	statedb.SetGlobal(other.db)
+	t.Cleanup(func() { statedb.SetGlobal(previousGlobal) })
+
+	inst := NewInstance("owning-profile-db", "/tmp")
+	inst.Tool = "shell"
+	groups := NewGroupTreeWithGroups([]*Instance{inst}, nil)
+	if err := owner.SaveWithGroups([]*Instance{inst}, groups); err != nil {
+		t.Fatalf("SaveWithGroups: %v", err)
+	}
+	if got := inst.restartPersistenceDB(); got != owner.db {
+		t.Fatalf("saved instance restart DB = %p, want owner %p", got, owner.db)
+	}
+
+	loaded, _, err := owner.LoadWithGroups()
+	if err != nil {
+		t.Fatalf("LoadWithGroups: %v", err)
+	}
+	if len(loaded) != 1 {
+		t.Fatalf("loaded %d instances, want 1", len(loaded))
+	}
+	if got := loaded[0].restartPersistenceDB(); got != owner.db {
+		t.Fatalf("loaded instance restart DB = %p, want owner %p", got, owner.db)
+	}
+}
