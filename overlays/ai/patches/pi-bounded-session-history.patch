+			).resolves.toEqual({ entries: [], nextOrdinal: null });
+			await expect(manager.getTreePage({ beforeOrdinal: 0, direction: "reverse" })).resolves.toEqual({
+				entries: [],
+				nextOrdinal: null,
+			});
