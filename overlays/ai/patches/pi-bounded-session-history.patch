+
+class AgentMessageBacking {
+	private source?: AgentMessageSource;
+	private tail: AgentMessage[] = [];
+	private adopted: AgentMessage[];
+
+	constructor(messages: AgentMessage[] = []) {
+		this.adopted = messages.slice();
+	}
