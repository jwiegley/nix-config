+// =============================================================================
+// loadConfig() - Environment-only credentials
+// =============================================================================
+describe("loadConfig() - environment-only credentials", () => {
+  test("rejects an apiKey field in global config without echoing its value", async () => {
+    await withTempCassHome(async (env) => {
+      const sentinel = "credential-value-must-not-appear";
+      await writeFile(env.configPath, JSON.stringify({ apiKey: sentinel }));
+
+      try {
+        await loadConfig();
+        throw new Error("loadConfig unexpectedly accepted apiKey");
+      } catch (error) {
+        const message = String(error);
+        expect(message).toContain("apiKey configuration field is disabled");
+        expect(message).toContain("OPENAI_API_KEY");
+        expect(message).not.toContain(sentinel);
+      }
+    });
+  });
+
+  test("rejects an apiKey CLI override without echoing its value", async () => {
+    const sentinel = "cli-credential-value-must-not-appear";
+    try {
+      await loadConfig({ apiKey: sentinel });
+      throw new Error("loadConfig unexpectedly accepted apiKey");
+    } catch (error) {
+      const message = String(error);
+      expect(message).toContain("apiKey configuration field is disabled");
+      expect(message).not.toContain(sentinel);
+    }
+  });
+});
+
