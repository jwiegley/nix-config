+    while (true) {
+      const bytesRead = readSync(fd, buffer, 0, buffer.length, null);
+      if (bytesRead === 0) break;
+      consume(decoder.write(buffer.subarray(0, bytesRead)));
+    }
+    consume(decoder.end());
+    if (discardingOversizedLine) {
+      parseErrors++;
+      truncated = true;
+    } else if (pending.length > 0) {
+      processLine(pending);
+    }
+  } finally {
+    closeSync(fd);
+  }
+  if (parseErrors > 0) console.warn(
+    `blackhole: ${parseErrors} malformed or oversized JSONL line(s) in ${sessionFile}`,
+  );
+
+  const retained = records.slice(recordStart);
+  const result: LoadedMessages = {
+    rendered: retained.map((record) => record.rendered),
+    rawMessages: retained.map((record) => record.rawMessage),
+    entryIds: retained.map((record) => record.entryId),
+    truncated,
+    totalMessages,
+  };
   setCache(sessionFile, full, allowedEntryIds, result);
   return result;
 };
+
+export const historyWindowNotice = (loaded: LoadedMessages): string =>
+  loaded.truncated
+    ? `[History window bounded to ${loaded.rendered.length.toLocaleString()} retained messages; ${loaded.totalMessages.toLocaleString()} matching messages were scanned.]\n\n`
+    : "";
