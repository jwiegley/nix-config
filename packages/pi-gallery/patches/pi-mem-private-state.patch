@@ -0,0 +1,34 @@
+import * as fs from "node:fs";
+
+import { updatePrivateFile } from "../lib.ts";
+
+const [filePath, role, gateDir] = process.argv.slice(2);
+if (!filePath || !role || !gateDir) throw new Error("missing worker arguments");
+
+const sleepBuffer = new Int32Array(new SharedArrayBuffer(Int32Array.BYTES_PER_ELEMENT));
+const gate = (name) => `${gateDir}/${name}`;
+
+function waitFor(name) {
+	const deadline = Date.now() + 30_000;
+	while (!fs.existsSync(gate(name))) {
+		if (Date.now() >= deadline) throw new Error(`timed out waiting for ${name}`);
+		Atomics.wait(sleepBuffer, 0, 0, 10);
+	}
+}
+
+if (role === "first") {
+	updatePrivateFile(filePath, (current) => {
+		fs.writeFileSync(gate("first-entered"), "", { flag: "wx" });
+		waitFor("release-first");
+		return `${current}first\n`;
+	});
+} else if (role === "second") {
+	waitFor("first-entered");
+	fs.writeFileSync(gate("second-attempting"), "", { flag: "wx" });
+	updatePrivateFile(filePath, (current) => {
+		fs.writeFileSync(gate("second-entered"), "", { flag: "wx" });
+		return `${current}second\n`;
+	});
+} else {
+	throw new Error(`unknown worker role: ${role}`);
+}
