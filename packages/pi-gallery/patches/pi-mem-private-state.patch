+				path.dirname(filePath),
+				fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW,
+			);
+			try {
+				operations.renameSync(tempPath, filePath);
+				renamed = true;
+				operations.fsyncSync(parent);
+			} finally {
+				operations.closeSync(parent);
+			}
+		}
+	} finally {
+		if (created && !renamed) {
+			try {
+				fs.unlinkSync(tempPath);
+			} catch (error) {
+				if (!hasErrorCode(error, "ENOENT")) throw error;
+			}
+		}
+	}
+}
+
+export function writePrivateFile(
+	filePath: string,
+	content: string,
+	operations: AtomicReplaceOps = defaultAtomicReplaceOps,
+): void {
+	withFileLock(filePath, () => replacePrivateFile(filePath, content, operations));
+}
