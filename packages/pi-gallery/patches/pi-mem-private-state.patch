+function replacePrivateFile(
+	filePath: string,
+	content: string,
+	operations: AtomicReplaceOps = defaultAtomicReplaceOps,
+): void {
+	const tempPath = path.join(
+		path.dirname(filePath),
+		`.${path.basename(filePath)}.${process.pid}.${randomUUID()}.tmp`,
+	);
+	let created = false;
+	let renamed = false;
