+		const child = spawn(process.execPath, ["-e", ""], { stdio: "ignore" });
+		const exited = once(child, "exit");
+		await once(child, "spawn");
+		if (child.pid === undefined) throw new Error("owner child has no pid");
+		const ownerPid = child.pid;
+		await exited;
+
+		const lockPath = `${config.memoryFile}.lock`;
+		const staleToken = "stale-race-owner-token";
+		fs.mkdirSync(lockPath, { mode: 0o700 });
+		fs.writeFileSync(
+			path.join(lockPath, staleToken),
+			JSON.stringify({ token: staleToken, pid: ownerPid, hostname: os.hostname() }),
+			{ mode: 0o600 },
+		);
+		const staleTime = new Date(Date.now() - 10 * 60_000);
+		fs.utimesSync(lockPath, staleTime, staleTime);
+
+		const gateDir = path.join(tmpDir, "recovery-race-gates");
+		fs.mkdirSync(gateDir);
+		const worker = fileURLToPath(new URL("./private-file-recovery-race-worker.mjs", import.meta.url));
+		// Node exposes syncBuiltinESMExports(), which lets the workers place exact
+		// barriers around the fs operations used by lib.ts. Bun still exercises the
+		// resulting protocol through the parent test.
+		const workerRuntime = process.versions.bun ? "node" : process.execPath;
+		const runtimeArgs = ["--experimental-strip-types"];
+		const start = (role: string) => spawn(
+			workerRuntime,
+			[...runtimeArgs, worker, config.memoryFile, role, gateDir, staleToken],
+			{ stdio: ["ignore", "ignore", "pipe"] },
+		);
+
+		const first = start("first");
+		const second = start("second");
+		const exits: Promise<void>[] = [waitForExit(first), waitForExit(second)];
+		let failure: unknown;
+		try {
+			await Promise.all([
+				waitForPath(path.join(gateDir, "first-recovery-ready")),
+				waitForPath(path.join(gateDir, "second-recovery-ready")),
+			]);
+			releaseGate(gateDir, "release-first-recovery");
+			await waitForPath(path.join(gateDir, "first-entered"));
+			const activeLeaf = fs.lstatSync(lockPath);
+			const activeMarkers = fs.readdirSync(lockPath);
+
+			releaseGate(gateDir, "release-second-recovery");
+			await waitForPath(path.join(gateDir, "second-recovery-result"));
+			const third = start("third");
+			exits.push(waitForExit(third));
+			await waitForPath(path.join(gateDir, "third-acquisition-result"));
+
+			assert.equal(
+				fs.readFileSync(path.join(gateDir, "third-acquisition-result"), "utf-8"),
+				"blocked",
+				"the successor lock must remain held while its writer is active",
+			);
+			assert.equal(
+				fs.readFileSync(path.join(gateDir, "second-recovery-result"), "utf-8"),
+				"rejected",
+				"a stale observation must not move the successor lock",
+			);
+			const afterLeaf = fs.lstatSync(lockPath);
+			assert.equal(afterLeaf.dev, activeLeaf.dev);
+			assert.equal(afterLeaf.ino, activeLeaf.ino);
+			assert.deepEqual(fs.readdirSync(lockPath), activeMarkers);
+		} catch (error) {
+			failure = error;
+		} finally {
+			for (const gateName of [
+				"release-first-recovery",
+				"release-second-recovery",
+				"release-second-after-rename",
+				"release-first-action",
+				"release-third-action",
+			]) releaseGate(gateDir, gateName);
+		}
+
+		const results = await Promise.allSettled(exits);
+		if (failure !== undefined) throw failure;
+		for (const result of results) {
+			if (result.status === "rejected") throw result.reason;
+		}
+		assert.deepEqual(
+			fs.readFileSync(config.memoryFile, "utf-8").trim().split("\n").sort(),
+			["first", "initial", "second", "third"],
+		);
+		assert.equal(fs.existsSync(lockPath), false);
+	});
+
+	it("orders the atomic rename before parent sync and propagates sync errors", () => {
+		const config = makeConfig(tmpDir);
+		ensureDirs(config);
+		writePrivateFile(config.memoryFile, "initial");
+		const calls: string[] = [];
+		const parentDescriptor = 1234;
+		const syncError = Object.assign(new Error("directory fsync failed"), { code: "EINVAL" });
+		const operations = {
+			supportsDirectoryFsync: true,
+			openSync(directory: string, flags: number): number {
+				calls.push("open");
+				assert.equal(directory, config.memoryDir);
+				assert.equal(
+					flags,
+					fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW,
+				);
+				assert.equal(fs.readFileSync(config.memoryFile, "utf-8"), "initial");
+				return parentDescriptor;
+			},
+			renameSync(oldPath: string, newPath: string): void {
+				calls.push("rename");
+				fs.renameSync(oldPath, newPath);
+			},
+			fsyncSync(descriptor: number): void {
+				calls.push("fsync");
+				assert.equal(descriptor, parentDescriptor);
+				assert.equal(fs.readFileSync(config.memoryFile, "utf-8"), "replacement");
+				throw syncError;
+			},
+			closeSync(descriptor: number): void {
+				calls.push("close");
+				assert.equal(descriptor, parentDescriptor);
+			},
+		};
+
+		assert.throws(
+			() => writePrivateFile(config.memoryFile, "replacement", operations),
+			(error: unknown) => error === syncError,
+		);
+
+		assert.deepEqual(calls, ["open", "rename", "fsync", "close"]);
+		assert.equal(fs.readFileSync(config.memoryFile, "utf-8"), "replacement");
+		assert.deepEqual(
+			fs.readdirSync(config.memoryDir).filter((name) => name.endsWith(".tmp") || name.endsWith(".lock")),
+			[],
+		);
+	});
+
+	it("keeps atomic replacement when Windows directory fsync is unsupported", () => {
+		const config = makeConfig(tmpDir);
+		ensureDirs(config);
+		writePrivateFile(config.memoryFile, "initial");
+		const calls: string[] = [];
+		const unsupported = (): never => { throw new Error("directory fsync operation was called"); };
+		const operations = {
+			supportsDirectoryFsync: false,
+			openSync: unsupported,
+			renameSync(oldPath: string, newPath: string): void {
+				calls.push("rename");
+				fs.renameSync(oldPath, newPath);
+			},
+			fsyncSync: unsupported,
+			closeSync: unsupported,
+		};
+
+		writePrivateFile(config.memoryFile, "replacement", operations);
+
+		assert.deepEqual(calls, ["rename"]);
+		assert.equal(fs.readFileSync(config.memoryFile, "utf-8"), "replacement");
+		assert.deepEqual(
+			fs.readdirSync(config.memoryDir).filter((name) => name.endsWith(".tmp") || name.endsWith(".lock")),
+			[],
+		);
+	});
+
+	it("serializes two process writers and leaves complete private state", { timeout: 45_000 }, async () => {
+		const config = makeConfig(tmpDir);
+		ensureDirs(config);
+		writePrivateFile(config.memoryFile, "initial\n");
+		const gateDir = path.join(tmpDir, "gates");
+		fs.mkdirSync(gateDir);
+		const worker = fileURLToPath(new URL("./private-file-worker.mjs", import.meta.url));
+		const runtimeArgs = process.versions.bun ? [] : ["--experimental-strip-types"];
+		const start = (role: string) => spawn(
+			process.execPath,
+			[...runtimeArgs, worker, config.memoryFile, role, gateDir],
+			{ stdio: ["ignore", "ignore", "pipe"] },
+		);
+
+		const first = start("first");
+		const firstExit = waitForExit(first);
+		await waitForPath(path.join(gateDir, "first-entered"));
+		const lockPath = `${config.memoryFile}.lock`;
+		assert.equal(mode(lockPath), 0o700);
+		const ownerMarkers = fs.readdirSync(lockPath);
+		assert.equal(ownerMarkers.length, 1);
+		assert.equal(mode(path.join(lockPath, ownerMarkers[0])), 0o600);
+		const second = start("second");
+		const secondExit = waitForExit(second);
+		try {
+			await waitForPath(path.join(gateDir, "second-attempting"));
+			await new Promise((resolve) => setTimeout(resolve, 250));
+			assert.equal(fs.existsSync(path.join(gateDir, "second-entered")), false);
+			assert.equal(fs.readFileSync(config.memoryFile, "utf-8"), "initial\n");
+		} finally {
+			fs.writeFileSync(path.join(gateDir, "release-first"), "");
+		}
+
+		await Promise.all([firstExit, secondExit]);
+		assert.equal(fs.readFileSync(config.memoryFile, "utf-8"), "initial\nfirst\nsecond\n");
+		assert.equal(mode(config.memoryFile), 0o600);
+		assert.equal(fs.existsSync(`${config.memoryFile}.lock`), false);
+		assert.deepEqual(
+			fs.readdirSync(config.memoryDir).filter((name) => name.endsWith(".tmp")),
+			[],
+		);
+	});
+});
