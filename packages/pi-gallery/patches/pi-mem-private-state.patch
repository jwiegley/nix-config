+		fs.mkdirSync(lockPath, { mode: 0o700 });
+		fs.writeFileSync(
+			path.join(lockPath, recoveryToken),
+			JSON.stringify({ token: originalToken, pid: ownerPid, hostname: os.hostname() }),
+			{ mode: 0o600 },
+		);
+		const staleTime = new Date(Date.now() - 10 * 60_000);
