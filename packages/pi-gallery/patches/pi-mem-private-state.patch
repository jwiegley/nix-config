diff --git a/tests/private-file-recovery-race-worker.mjs b/tests/private-file-recovery-race-worker.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..d0c554cad5b80af4c3e66b857c600b9c647ca641
--- /dev/null
+++ b/tests/private-file-recovery-race-worker.mjs
@@ -0,0 +1,87 @@
+import fs from "node:fs";
+import { syncBuiltinESMExports } from "node:module";
+import * as path from "node:path";
+
+const [filePath, role, gateDir, staleToken] = process.argv.slice(2);
+if (!filePath || !role || !gateDir || !staleToken)
+	throw new Error("missing worker arguments");
+
+const lockPath = `${filePath}.lock`;
+const sleepBuffer = new Int32Array(
+	new SharedArrayBuffer(Int32Array.BYTES_PER_ELEMENT),
+);
+const gate = (name) => path.join(gateDir, name);
+
+function mark(name, content = "") {
+	const finalPath = gate(name);
+	const temporaryPath = gate("." + name + "." + process.pid + ".tmp");
+	fs.writeFileSync(temporaryPath, content, { flag: "wx" });
+	fs.renameSync(temporaryPath, finalPath);
+}
+
+function waitFor(name) {
+	const deadline = Date.now() + 30_000;
+	while (!fs.existsSync(gate(name))) {
+		if (Date.now() >= deadline)
+			throw new Error(`timed out waiting for ${name}`);
+		Atomics.wait(sleepBuffer, 0, 0, 10);
+	}
+}
+
+if (role === "first" || role === "second") {
+	const renameSync = fs.renameSync.bind(fs);
+	let recoveryGated = false;
+	fs.renameSync = (oldPath, newPath) => {
+		const recoveryRename =
+			oldPath === lockPath || oldPath === path.join(lockPath, staleToken);
+		if (recoveryGated || !recoveryRename) return renameSync(oldPath, newPath);
+
+		recoveryGated = true;
+		mark(`${role}-recovery-ready`);
+		waitFor(`release-${role}-recovery`);
+		try {
+			const result = renameSync(oldPath, newPath);
+			if (role === "second") {
+				mark("second-recovery-result", "moved");
+				waitFor("release-second-after-rename");
+			}
+			return result;
+		} catch (error) {
+			if (role === "second") mark("second-recovery-result", "rejected");
+			throw error;
+		}
+	};
+} else if (role === "third") {
+	const mkdirSync = fs.mkdirSync.bind(fs);
+	let acquisitionObserved = false;
+	fs.mkdirSync = (directory, options) => {
+		if (acquisitionObserved || directory !== lockPath)
+			return mkdirSync(directory, options);
+		acquisitionObserved = true;
+		try {
+			const result = mkdirSync(directory, options);
+			mark("third-acquisition-result", "acquired");
+			return result;
+		} catch (error) {
+			mark("third-acquisition-result", "blocked");
+			throw error;
+		}
+	};
+} else {
+	throw new Error(`unknown worker role: ${role}`);
+}
+
+syncBuiltinESMExports();
+const { updatePrivateFile } = await import("../lib.ts");
+
+try {
+	updatePrivateFile(filePath, (current) => {
+		mark(`${role}-entered`);
+		if (role === "first") waitFor("release-first-action");
+		if (role === "third") waitFor("release-third-action");
+		return `${current}${role}\n`;
+	});
+} catch (error) {
+	console.error(`race worker ${role} failed`);
+	throw error;
+}
