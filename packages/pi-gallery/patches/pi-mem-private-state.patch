index 0000000000000000000000000000000000000000..dd005fe8a88e3374dc03e32fcda6e93d61fb357c
--- /dev/null
+++ b/tests/source-security.test.ts
@@ -0,0 +1,43 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+import * as fs from "node:fs";
+
+const indexSource = fs.readFileSync(new URL("../index.ts", import.meta.url), "utf-8");
+const libSource = fs.readFileSync(new URL("../lib.ts", import.meta.url), "utf-8");
+const readmeSource = fs.readFileSync(new URL("../README.md", import.meta.url), "utf-8");
+
+describe("source security ordering", () => {
+	it("validates private directories before reading the summary cache", () => {
+		const start = indexSource.indexOf("async function getOrRebuildSummary");
+		const end = indexSource.indexOf("export default function", start);
+		const body = indexSource.slice(start, end);
+		const ensurePosition = body.indexOf("ensureDirs(config);");
+		const readPosition = body.indexOf("readFileSafe(SUMMARY_CACHE, config.dailyDir)");
+
+		assert.ok(ensurePosition >= 0, "getOrRebuildSummary must validate directories");
+		assert.ok(readPosition > ensurePosition, "summary cache must be read only after directory validation");
+		assert.doesNotMatch(body, /readFileSafe\(SUMMARY_CACHE\)(?!,)/);
+	});
+
+	it("streams session JSONL through the safe no-follow open seam", () => {
+		const start = libSource.indexOf("export async function scanSession");
+		const end = libSource.indexOf("export async function collectSessions", start);
+		const body = libSource.slice(start, end);
+
+		assert.match(body, /createLineReaderSafe\(filePath, rootDir\)/);
+		assert.match(body, /for await \(const line of/);
+		assert.doesNotMatch(body, /readFileSafe|split\(\/\\r\?\\n/);
+	});
+
+	it("keeps managed Git autocommit removed", () => {
+		for (const source of [indexSource, libSource]) {
+			assert.doesNotMatch(source, /\bPI_AUTOCOMMIT\b|\bgitCommit\b/);
+		}
+		assert.doesNotMatch(libSource, /node:child_process/);
+		assert.match(readmeSource, /deliberately\s+removes upstream Git autocommit/);
+		assert.match(readmeSource, /PI_AUTOCOMMIT.*field are inert/s);
+		assert.match(readmeSource, /private Git workflow outside Pi Mem/);
+		assert.match(readmeSource, /same-host owner is proven to have\s+exited/);
+		assert.match(readmeSource, /in-progress-recovery locks\s+remain in place/);
+	});
+});
