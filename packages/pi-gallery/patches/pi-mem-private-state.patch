+		assert.throws(
+			() => updatePrivateFile(config.memoryFile, (current) => `${current}local memory`),
+			/non-file memory path/,
+		);
+		assert.throws(() => writePrivateFile(config.memoryFile, "replacement"), /non-file memory path/);
+
+		assert.equal(fs.readFileSync(external, "utf-8"), "external secret");
+		assert.equal(mode(external), 0o644);
+		assert.equal(fs.lstatSync(config.memoryFile).isSymbolicLink(), true);
+		assert.deepEqual(
+			fs.readdirSync(config.memoryDir).filter((name) => name.endsWith(".tmp") || name.includes(".stale.")),
