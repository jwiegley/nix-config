+	update: (current: string) => string | undefined,
+): string | undefined;
+export function updatePrivateFile(
+	filePath: string,
+	update: (current: string) => string | undefined,
+): string | undefined {
+	return withFileLock(filePath, () => {
+		const content = update(readPrivateFileForUpdate(filePath));
+		if (content !== undefined) replacePrivateFile(filePath, content);
+		return content;
+	});
