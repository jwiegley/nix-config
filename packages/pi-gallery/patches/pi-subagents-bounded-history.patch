new file mode 100644
index 00000000..db8b37aa
--- /dev/null
+++ b/src/shared/jsonl-lines.ts
@@ -0,0 +1,73 @@
+import * as fs from "node:fs";
+
+const READ_CHUNK_BYTES = 64 * 1024;
+
+export interface JsonlLine {
+	bytes: Buffer;
+	lineNumber: number;
+	terminated: boolean;
+}
+
+export type SyncBufferWriter = (
+	fd: number,
+	buffer: Uint8Array,
+	offset: number,
+	length: number,
+) => number;
+
+/** Visit one physical JSONL record at a time without retaining prior records. */
+export function forEachJsonlLineSync(
+	filePath: string,
+	visitor: (line: JsonlLine) => void,
+): void {
+	const fd = fs.openSync(filePath, "r");
+	const chunk = Buffer.allocUnsafe(READ_CHUNK_BYTES);
+	let fragments: Buffer[] = [];
+	let lineNumber = 0;
+	try {
+		while (true) {
+			const bytesRead = fs.readSync(fd, chunk, 0, chunk.length, null);
+			if (bytesRead === 0) break;
+			let start = 0;
+			while (start < bytesRead) {
+				const newline = chunk.indexOf(0x0a, start);
+				if (newline < 0 || newline >= bytesRead) {
+					fragments.push(Buffer.from(chunk.subarray(start, bytesRead)));
+					break;
+				}
+				let bytes: Buffer;
+				if (fragments.length === 0) {
+					bytes = chunk.subarray(start, newline);
+				} else {
+					if (newline > start) fragments.push(Buffer.from(chunk.subarray(start, newline)));
+					bytes = Buffer.concat(fragments);
+					fragments = [];
+				}
+				visitor({ bytes, lineNumber: ++lineNumber, terminated: true });
+				start = newline + 1;
+			}
+		}
+		if (fragments.length > 0) {
+			const bytes = fragments.length === 1 ? fragments[0]! : Buffer.concat(fragments);
+			fragments = [];
+			visitor({ bytes, lineNumber: ++lineNumber, terminated: false });
+		}
+	} finally {
+		fs.closeSync(fd);
+	}
+}
+
+/** Complete a synchronous write even when the operating system accepts a short write. */
+export function writeAllSync(
+	fd: number,
+	value: Buffer | string,
+	write: SyncBufferWriter = fs.writeSync,
+): void {
+	const bytes = typeof value === "string" ? Buffer.from(value, "utf-8") : value;
+	let offset = 0;
+	while (offset < bytes.length) {
+		const written = write(fd, bytes, offset, bytes.length - offset);
+		if (written <= 0) throw new Error("Unable to complete JSONL write");
+		offset += written;
+	}
+}
