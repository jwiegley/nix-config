index 0000000..2efc719
--- /dev/null
+++ b/src/droid-process-env.ts
@@ -0,0 +1,62 @@
+const DROID_PROCESS_ENVIRONMENT = new Set([
+	"ALL_PROXY",
+	"COLORTERM",
+	"CURL_CA_BUNDLE",
+	"GIT_SSL_CAINFO",
+	"HOME",
+	"HTTP_PROXY",
+	"HTTPS_PROXY",
+	"LANG",
+	"LANGUAGE",
+	"LC_ALL",
+	"LC_CTYPE",
+	"LOGNAME",
+	"NIX_SSL_CERT_FILE",
+	"NODE_EXTRA_CA_CERTS",
+	"NO_COLOR",
+	"NO_PROXY",
+	"PATH",
+	"REQUESTS_CA_BUNDLE",
+	"SHELL",
+	"SSL_CERT_DIR",
+	"SSL_CERT_FILE",
+	"TEMP",
+	"TERM",
+	"TMP",
+	"TMPDIR",
+	"TZ",
+	"USER",
+	"XDG_CACHE_HOME",
+	"XDG_CONFIG_HOME",
+	"XDG_DATA_HOME",
+	"XDG_STATE_HOME",
+	"all_proxy",
+	"http_proxy",
+	"https_proxy",
+	"no_proxy",
+]);
+
+const DROID_EXEC_PATH = "@droid@";
+
+export function getDroidExecPath(): string {
+	return DROID_EXEC_PATH;
+}
+
+export function buildDroidProcessEnv(
+	apiKey: string,
+	env: NodeJS.ProcessEnv = process.env,
+): Record<string, string> {
+	const childEnv: Record<string, string> = {};
+	for (const [name, value] of Object.entries(env)) {
+		if (value === undefined) continue;
+		if (
+			DROID_PROCESS_ENVIRONMENT.has(name)
+			|| name.startsWith("FACTORY_")
+			|| name.startsWith("LC_")
+		) {
+			childEnv[name] = value;
+		}
+	}
+	childEnv.FACTORY_API_KEY = apiKey;
+	return childEnv;
+}
