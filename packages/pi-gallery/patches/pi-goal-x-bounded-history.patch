+  let ringLength = 0;
+  let nextIndex = 0;
+  let matchingEvents = 0;
+  let hasCompletionRequested = false;
+  const stats = scanGoalLedger(ctx, (event) => {
+    if (!("goalId" in event) || event.goalId !== safeId) return;
+    matchingEvents++;
+    if (event.type === "completion_requested") hasCompletionRequested = true;
+    ring[nextIndex] = event;
+    nextIndex = (nextIndex + 1) % maxEvents;
+    ringLength = Math.min(ringLength + 1, maxEvents);
+  });
+  const events = ringLength < maxEvents
+    ? ring.slice(0, ringLength)
+    : [...ring.slice(nextIndex), ...ring.slice(0, nextIndex)];
+  return {
+    events,
+    ...stats,
+    truncated: matchingEvents > events.length,
+    hasCompletionRequested,
