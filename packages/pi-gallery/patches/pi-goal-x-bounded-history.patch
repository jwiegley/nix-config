+export function readGoalLedger(
+  ctx: GoalLedgerContext,
+  options: { maxEvents?: number } = {},
+): GoalLedgerReadResult {
+  const maxEvents = Math.max(1, Math.trunc(options.maxEvents ?? DEFAULT_LEDGER_EVENT_LIMIT));
+  const ring = new Array<GoalLedgerEvent>(maxEvents);
+  let ringLength = 0;
+  let nextIndex = 0;
+  const stats = scanGoalLedger(ctx, (event) => {
+    ring[nextIndex] = event;
+    nextIndex = (nextIndex + 1) % maxEvents;
+    ringLength = Math.min(ringLength + 1, maxEvents);
+  });
+  const events = ringLength < maxEvents
+    ? ring.slice(0, ringLength)
+    : [...ring.slice(nextIndex), ...ring.slice(0, nextIndex)];
+  return { events, ...stats, truncated: stats.validEvents > events.length };
+}
