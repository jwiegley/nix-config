#!/bin/bash

set -euo pipefail

umask 077

readonly key_dir="$HOME/.config/gnupg/private-keys-v1.d"
readonly keys=(
    4975B4558FC5A7699D4E6DFD940DF0A5633B661F.key
    99C79A2052C3B513DF26BB5B03519C83328F13E1.key
    A8ADF3692CFDEA476DD3EF8191DF7C5806C0C825.key
)

mode=${1:-}
if [[ -z $mode ]]; then
    echo "Usage: yubikey-switch MODE" >&2
    exit 2
fi

cd "$key_dir"

transaction_dir=$key_dir/.yubikey-switch.lock
stage_dir=
backup_dir=
transaction_owned=0
transaction_active=0
replaced_count=0
destination_existed=()

cleanup() {
    cleanup_status=$?
    trap '' HUP INT QUIT TERM
    trap - EXIT
    rollback_failed=0

    if ((transaction_active)); then
        for ((index = 0; index < replaced_count; index++)); do
            key=${keys[$index]}
            if ((destination_existed[index])); then
                rollback_command=(mv -f "$backup_dir/$key" "$key_dir/$key")
            else
                rollback_command=(rm -f "$key_dir/$key")
            fi
            if ! "${rollback_command[@]}"; then
                echo "Could not roll back key file $key_dir/$key!" >&2
                rollback_failed=1
            fi
        done
        if ((rollback_failed)); then
            cleanup_status=1
            echo "Transaction files retained in $transaction_dir for recovery." >&2
        fi
    fi

    if ((!rollback_failed && transaction_owned)) && [[ -d $transaction_dir ]] && ! rm -rf "$transaction_dir"; then
        echo "Could not remove transaction directory $transaction_dir!" >&2
        cleanup_status=1
    fi

    exit "$cleanup_status"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM

if ! mkdir "$transaction_dir"; then
    echo "Refusing to continue while transaction lock exists: $transaction_dir" >&2
    exit 1
fi
transaction_owned=1

for stale_transaction_path in "$key_dir"/.yubikey-switch.*; do
    if [[ $stale_transaction_path != "$transaction_dir" ]] &&
        [[ -e $stale_transaction_path || -L $stale_transaction_path ]]; then
        echo "Refusing to continue while stale transaction path exists: $stale_transaction_path" >&2
        exit 1
    fi
done

if [[ $mode == restore ]]; then
    source_root=${YUBIKEY_SWITCH_TEST_RESTORE_ROOT:-/Volumes/Files/Keys/GnuPG/private-keys-v1.d}
    source_suffix=
else
    source_root=$key_dir
    source_suffix=.$mode
fi

for index in "${!keys[@]}"; do
    key=${keys[$index]}
    source_file=$source_root/$key$source_suffix
    if [[ ! -f $source_file ]]; then
        echo "Could not find key file $source_file!" >&2
        exit 1
    fi
    if [[ -f $key_dir/$key ]]; then
        destination_existed[$index]=1
    elif [[ $mode == restore && ! -e $key_dir/$key && ! -L $key_dir/$key ]]; then
        destination_existed[$index]=0
    else
        echo "Could not find active key file $key_dir/$key!" >&2
        exit 1
    fi
done

stage_dir=$transaction_dir/stage
backup_dir=$transaction_dir/backup
mkdir "$stage_dir" "$backup_dir"

for key in "${keys[@]}"; do
    stage_file=$stage_dir/$key
    install -m 600 "$source_root/$key$source_suffix" "$stage_file"
    if [[ $(uname -s) == Darwin ]]; then
        /bin/chmod -N "$stage_file"
    fi
    chmod 600 "$stage_file"
done

for index in "${!keys[@]}"; do
    if ((destination_existed[index])); then
        key=${keys[$index]}
        cp -p "$key_dir/$key" "$backup_dir/$key"
    fi
done

transaction_active=1
for key in "${keys[@]}"; do
    replaced_count=$((replaced_count + 1))
    if ! mv -f "$stage_dir/$key" "$key_dir/$key"; then
        echo "Could not replace key file $key_dir/$key; rolling back." >&2
        exit 1
    fi
done
transaction_active=0
rm -rf "$stage_dir" "$backup_dir"

(sudo killall gpg-agent 2>/dev/null || exit 0)
sleep 2
(sudo killall -9 gpg-agent 2>/dev/null || exit 0)

gpg --card-status

(
    cd "$HOME/src/category-theory"
    git remote update
)

if [[ ! -f $HOME/.yubico/challenge-$mode ]] && command -v ykpamcfg >/dev/null 2>&1; then
    ykpamcfg -2
fi
