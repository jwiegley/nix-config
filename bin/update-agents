#!/usr/bin/env bash

set -euo pipefail
unset GIT_INDEX_FILE

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
installed_routing_path=
routing=${installed_routing_path:-$script_dir/lib/host-routing.sh}
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

run_all_inputs=false
run_pull=false
run_commit=false
run_switch=false
run_push=false
run_brew=false
run_dry_run=false
requested_version=
declare -a requested_targets=()

candidate_dir=
candidate_git_dir=
transaction_dir=
transaction_patch=
transaction_paths=
transaction_committed_paths=
transaction_live_untracked_baseline=
transaction_live_untracked_current=
transaction_lock=
transaction_lock_acquired=false
transaction_head_ref=
committed_head=
expected_candidate_tree=
publication_kind=
transaction_complete=false
transaction_signal_status=0
declare -A publication_baseline_git_mode=()
declare -A publication_baseline_kind=()
declare -A publication_baseline_mode=()
declare -A publication_baseline_object=()
declare -A publication_baseline_parent_exists=()

usage() {
    cat <<'EOF'
usage: update-agents [--all-inputs] [--target NAME] [--version VALUE] [--dry-run]
                     [--pull] [--commit] [--switch] [--push] [--brew]

Update integrated AI inputs, both repository locks, and catalog-managed package sources.
By default, leave reviewed working-tree changes without external side effects.

Options:
  --all-inputs  Update every root and portable flake input
  --target NAME Update one catalog target through this transaction (repeatable)
  --version VALUE  Force the revision or release for one named projection target
  --dry-run     Validate the candidate without publishing it
  --pull       Fast-forward the clean repository before updating
  --commit     Create one signed commit of updater-owned paths
  --switch     Switch the host after a successful signed commit
  --push       Push after a successful signed commit
  --brew       Update/upgrade Homebrew in the background
  --no-switch  Compatibility spelling; switching is already off by default
  --no-brew    Compatibility spelling; Homebrew is already off by default
EOF
}

capture_publication_metadata() {
    local path stage mode git_mode object_type object_hash _ignored parent
    while IFS= read -r -d '' path; do
        if ! stage=$(git -C "$config_dir" ls-tree "$transaction_baseline" -- "$path"); then
            return 1
        fi
        if [[ -n $stage ]]; then
            read -r git_mode object_type object_hash _ignored <<<"$stage"
            if [[ $object_type != blob || -z $object_hash ]]; then
                echo "update-agents: unsupported baseline Git object: $path" >&2
                return 1
            fi
            publication_baseline_git_mode["$path"]=$git_mode
            publication_baseline_object["$path"]=$object_hash
        else
            publication_baseline_git_mode["$path"]=
            publication_baseline_object["$path"]=
        fi
        if [[ -L $config_dir/$path ]]; then
            publication_baseline_kind["$path"]=symlink
        elif [[ -f $config_dir/$path ]]; then
            publication_baseline_kind["$path"]=regular
            if ! mode=$(stat -c '%a' "$config_dir/$path" 2>/dev/null || stat -f '%Lp' "$config_dir/$path"); then
                return 1
            fi
            publication_baseline_mode["$path"]=$mode
        elif [[ ! -e $config_dir/$path ]]; then
            publication_baseline_kind["$path"]=missing
            parent=${path%/*}
            while [[ $parent != "$path" && $parent != . ]]; do
                if [[ -d $config_dir/$parent && ! -L $config_dir/$parent ]]; then
                    publication_baseline_parent_exists["$parent"]=true
                    break
                fi
                if [[ -e $config_dir/$parent || -L $config_dir/$parent ]]; then
                    echo "update-agents: unsupported authoritative parent type: $parent" >&2
                    return 1
                fi
                publication_baseline_parent_exists["$parent"]=false
                path=$parent
                parent=${path%/*}
            done
        else
            echo "update-agents: unsupported authoritative path type: $path" >&2
            return 1
        fi
    done <"$transaction_paths"
}

normalize_publication_paths() {
    local state=$1 path stage mode expected_mode kind
    while IFS= read -r -d '' path; do
        if [[ $state == baseline ]]; then
            kind=${publication_baseline_kind[$path]}
            case $kind in
            missing)
                if [[ -e $config_dir/$path || -L $config_dir/$path ]]; then
                    echo "update-agents: rollback retained created path: $path" >&2
                    return 1
                fi
                ;;
            regular)
                if [[ ! -f $config_dir/$path || -L $config_dir/$path ]]; then
                    echo "update-agents: rollback path is not a regular file: $path" >&2
                    return 1
                fi
                chmod "${publication_baseline_mode[$path]}" "$config_dir/$path" || return 1
                ;;
            symlink)
                if [[ ! -L $config_dir/$path ]]; then
                    echo "update-agents: rollback path is not a symlink: $path" >&2
                    return 1
                fi
                ;;
            *)
                echo "update-agents: missing rollback metadata: $path" >&2
                return 1
                ;;
            esac
            continue
        fi

        if ! stage=$(git -C "$config_dir" ls-files --stage -- "$path"); then
            return 1
        fi
        [[ -n $stage ]] || continue
        mode=${stage%% *}
        case $mode in
        100644)
            if [[ ! -f $config_dir/$path || -L $config_dir/$path ]]; then
                echo "update-agents: published path is not a regular file: $path" >&2
                return 1
            fi
            expected_mode=0644
            if [[ ${publication_baseline_kind[$path]} == regular &&
                ${publication_baseline_git_mode[$path]} == "$mode" ]]; then
                expected_mode=${publication_baseline_mode[$path]}
            fi
            chmod "$expected_mode" "$config_dir/$path" || return 1
            ;;
        100755)
            if [[ ! -f $config_dir/$path || -L $config_dir/$path ]]; then
                echo "update-agents: published executable is not a regular file: $path" >&2
                return 1
            fi
            expected_mode=0755
            if [[ ${publication_baseline_kind[$path]} == regular &&
                ${publication_baseline_git_mode[$path]} == "$mode" ]]; then
                expected_mode=${publication_baseline_mode[$path]}
            fi
            chmod "$expected_mode" "$config_dir/$path" || return 1
            ;;
        120000)
            if [[ ! -L $config_dir/$path ]]; then
                echo "update-agents: published path is not a symlink: $path" >&2
                return 1
            fi
            ;;
        *)
            echo "update-agents: unsupported published Git mode $mode: $path" >&2
            return 1
            ;;
        esac
    done <"$transaction_paths"
}

restore_publication_baseline() {
    local path kind parent removed=true
    local -a paths=()
    mapfile -d '' -t paths <"$transaction_paths"
    while IFS= read -r -d '' path; do
        kind=${publication_baseline_kind[$path]}
        case $kind in
        missing)
            if [[ -d $config_dir/$path && ! -L $config_dir/$path ]]; then
                echo "update-agents: refusing to remove rollback directory: $path" >&2
                return 1
            fi
            rm -f -- "$config_dir/$path" || return 1
            git -C "$config_dir" update-index --force-remove -- "$path" || return 1
            ;;
        regular | symlink)
            if ! git -C "$config_dir" restore \
                --source="$transaction_baseline" --staged --worktree -- "$path"; then
                git -C "$config_dir" update-index --add --cacheinfo \
                    "${publication_baseline_git_mode[$path]}" \
                    "${publication_baseline_object[$path]}" "$path" ||
                    return 1
                git -C "$config_dir" checkout-index --force -- "$path" || return 1
            fi
            ;;
        *)
            echo "update-agents: missing restore metadata: $path" >&2
            return 1
            ;;
        esac
    done <"$transaction_paths"
    while [[ $removed == true ]]; do
        removed=false
        for parent in "${!publication_baseline_parent_exists[@]}"; do
            if [[ ${publication_baseline_parent_exists[$parent]} == false &&
                -d $config_dir/$parent && ! -L $config_dir/$parent ]] &&
                rmdir "$config_dir/$parent" 2>/dev/null; then
                removed=true
            fi
        done
    done
    for parent in "${!publication_baseline_parent_exists[@]}"; do
        if [[ ${publication_baseline_parent_exists[$parent]} == false &&
            (-e $config_dir/$parent || -L $config_dir/$parent) ]]; then
            echo "update-agents: rollback retained created directory: $parent" >&2
            return 1
        fi
    done
    normalize_publication_paths baseline || return 1
    git -C "$config_dir" diff --quiet -- "${paths[@]}" &&
        git -C "$config_dir" diff --cached --quiet \
            "$transaction_baseline" -- "${paths[@]}"
}

rollback_commit_publication() {
    local current_head
    current_head=$(git -C "$config_dir" rev-parse HEAD)
    if [[ $current_head == "$transaction_baseline" ]]; then
        restore_publication_baseline
        return
    fi
    if [[ $current_head != "$committed_head" ]]; then
        echo "update-agents: live HEAD changed during commit rollback" >&2
        return 1
    fi
    git -C "$config_dir" update-ref \
        "$transaction_head_ref" "$transaction_baseline" "$committed_head" &&
        restore_publication_baseline
}

candidate_untracked_paths() {
    {
        git ls-files --others --exclude-standard -z
        git ls-files --others --ignored --exclude-standard -z
    } | sort -zu
}

authoritative_untracked_paths() {
    {
        git -C "$config_dir" ls-files --others --exclude-standard -z
        git -C "$config_dir" ls-files --others --ignored --exclude-standard -z
    } | sort -zu
}

live_repository_matches_baseline() {
    authoritative_untracked_paths >"$transaction_live_untracked_current" &&
        [[ $(git -C "$config_dir" rev-parse HEAD) == "$transaction_baseline" ]] &&
        [[ -z $(git -C "$config_dir" status --porcelain) ]] &&
        cmp -s "$transaction_live_untracked_baseline" \
            "$transaction_live_untracked_current"
}

while (($#)); do
    case $1 in
    --all-inputs)
        run_all_inputs=true
        ;;
    --target)
        [[ $# -ge 2 && -n $2 ]] || {
            echo "update-agents: --target requires a name" >&2
            exit 2
        }
        requested_targets+=("$2")
        shift
        ;;
    --version)
        [[ $# -ge 2 && -n $2 ]] || {
            echo "update-agents: --version requires a revision" >&2
            exit 2
        }
        requested_version=$2
        shift
        ;;
    --dry-run)
        run_dry_run=true
        ;;
    --pull)
        run_pull=true
        ;;
    --commit)
        run_commit=true
        ;;
    --switch)
        run_switch=true
        ;;
    --push)
        run_push=true
        ;;
    --brew)
        run_brew=true
        ;;
    --no-switch)
        run_switch=false
        ;;
    --no-brew)
        run_brew=false
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo "update-agents: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
done

system_config_dir=${UPDATE_AGENTS_SYSTEM_CONFIG_DIR:-/etc/nixos}
if [[ -n ${NIX_CONFIG_DIR:-} ]]; then
    config_dir=$NIX_CONFIG_DIR
elif [[ -d $system_config_dir ]]; then
    config_dir=$system_config_dir
else
    config_dir=$HOME/src/nix
fi

ai_inputs=(
    git-ai
    llm-agents
    mcp-remote
    mcp-servers-nix
    pal-mcp-server
    pi-openai-server-compaction
    pi-quiet
    translate-tool
)

brew_pid=

require_clean() {
    local repo=$1
    if [[ -n $(git -C "$repo" status --porcelain) ]]; then
        echo "update-agents: refusing to update dirty repo: $repo" >&2
        exit 1
    fi
}

git_pull_clean() {
    local repo=$1
    require_clean "$repo"
    git -C "$repo" pull --ff-only
}

cleanup_transaction() {
    local status=$?
    local rollback_status=0
    local rollback_failed=false
    local worktree_list=
    set +e
    trap - HUP INT TERM

    if [[ -n $publication_kind && $transaction_complete != true ]]; then
        if [[ $publication_kind == commit ]]; then
            rollback_commit_publication || rollback_status=$?
        else
            restore_publication_baseline || rollback_status=$?
        fi
        if [[ $rollback_status -eq 0 ]]; then
            echo "update-agents: rolled back incomplete source transaction" >&2
        else
            echo "update-agents: failed to roll back incomplete source transaction" >&2
            rollback_failed=true
        fi
    fi

    if [[ -n $candidate_dir ]]; then
        if ! git -C "$config_dir" worktree remove --force "$candidate_dir" >/dev/null 2>&1; then
            if [[ -z $candidate_git_dir && -f $candidate_dir/.git ]]; then
                candidate_git_dir=$(
                    git -C "$candidate_dir" rev-parse --path-format=absolute --git-dir \
                        2>/dev/null
                )
            fi
            if [[ -e $candidate_dir ]]; then
                if [[ $candidate_dir == "$transaction_dir/candidate" ]]; then
                    rm -rf -- "$candidate_dir"
                else
                    echo "update-agents: refusing unsafe candidate cleanup" >&2
                    rollback_failed=true
                fi
            fi
            if [[ -n $candidate_git_dir ]]; then
                case $candidate_git_dir in
                "$git_common_dir"/worktrees/*) rm -rf -- "$candidate_git_dir" ;;
                *)
                    echo "update-agents: refusing unsafe worktree metadata cleanup" >&2
                    rollback_failed=true
                    ;;
                esac
            fi
            if [[ -e $candidate_dir ]]; then
                echo "update-agents: failed to remove candidate worktree" >&2
                rollback_failed=true
            fi
        fi
        if [[ -n $candidate_git_dir && -e $candidate_git_dir ]]; then
            echo "update-agents: failed to remove candidate worktree metadata" >&2
            rollback_failed=true
        fi
        if ! worktree_list=$(git -C "$config_dir" worktree list --porcelain); then
            echo "update-agents: failed to verify candidate worktree removal" >&2
            rollback_failed=true
        elif awk -v target="$candidate_dir" '
                $1 == "worktree" && substr($0, 10) == target { found = 1 }
                END { exit(found ? 0 : 1) }
            ' <<<"$worktree_list"; then
            echo "update-agents: candidate remains registered" >&2
            rollback_failed=true
        fi
    fi
    if [[ -n $transaction_dir ]]; then
        rm -f -- "$transaction_patch" "$transaction_paths" \
            "$transaction_committed_paths" \
            "$transaction_live_untracked_baseline" \
            "$transaction_live_untracked_current" \
            "$transaction_dir/inventory.json" "$transaction_dir/allowed-paths"
        rmdir "$transaction_dir" 2>/dev/null || true
    fi
    if [[ $transaction_lock_acquired == true ]] && ! rmdir "$transaction_lock" 2>/dev/null; then
        echo "update-agents: failed to release transaction lock" >&2
        rollback_failed=true
    fi

    if [[ $rollback_failed == true ]]; then
        status=1
    fi
    trap - EXIT
    exit "$status"
}

with_nixos_build_lock() {
    local lock=/etc/nixos/.nixos-build

    for _ in {1..60}; do
        if [[ ! -e $lock ]]; then
            sudo touch "$lock"
            trap 'sudo rm -f /etc/nixos/.nixos-build' RETURN
            "$@"
            sudo rm -f "$lock"
            trap - RETURN
            return
        fi
        sleep 10
    done

    echo "update-agents: $lock still exists after 10 minutes" >&2
    exit 1
}

if [[ $run_all_inputs == true && ${#requested_targets[@]} -ne 0 ]]; then
    echo "update-agents: --all-inputs cannot be combined with --target" >&2
    exit 2
fi
if [[ -n $requested_version && ${#requested_targets[@]} -ne 1 ]]; then
    echo "update-agents: --version requires exactly one --target" >&2
    exit 2
fi
if [[ $run_dry_run == true ]] &&
    [[ $run_pull == true || $run_commit == true || $run_switch == true ||
        $run_push == true || $run_brew == true ]]; then
    echo "update-agents: --dry-run cannot be combined with external actions" >&2
    exit 2
fi

if [[ $run_pull == true ]]; then
    git_pull_clean "$config_dir"
else
    require_clean "$config_dir"
fi

if [[ $run_switch == true || $run_push == true ]] && [[ $run_commit != true ]]; then
    echo "update-agents: --switch/--push require --commit" >&2
    exit 2
fi

transaction_baseline=$(git -C "$config_dir" rev-parse HEAD)
git_common_dir=$(git -C "$config_dir" rev-parse --path-format=absolute --git-common-dir)
transaction_lock=$git_common_dir/update-agents.lock
trap cleanup_transaction EXIT
trap 'transaction_signal_status=129' HUP
trap 'transaction_signal_status=130' INT
trap 'transaction_signal_status=143' TERM
if mkdir "$transaction_lock" 2>/dev/null; then
    transaction_lock_acquired=true
else
    echo "update-agents: another update transaction is active" >&2
    exit 1
fi
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ $transaction_signal_status -ne 0 ]]; then
    exit "$transaction_signal_status"
fi
transaction_dir=$(mktemp -d "${TMPDIR:-/tmp}/update-agents.XXXXXX")
candidate_dir=$transaction_dir/candidate
transaction_patch=$transaction_dir/update.patch
transaction_paths=$transaction_dir/paths
transaction_committed_paths=$transaction_dir/committed-paths
transaction_live_untracked_baseline=$transaction_dir/live-untracked-baseline
transaction_live_untracked_current=$transaction_dir/live-untracked-current
authoritative_untracked_paths >"$transaction_live_untracked_baseline"
git -C "$config_dir" worktree add --quiet --detach "$candidate_dir" "$transaction_baseline"
candidate_git_dir=$(git -C "$candidate_dir" rev-parse --path-format=absolute --git-dir)

if [[ $run_brew == true ]] && command -v brew >/dev/null 2>&1; then
    (
        brew update
        brew upgrade --greedy --yes
    ) &>/tmp/brew.log &
    brew_pid=$!
fi

(
    cd "$candidate_dir"
    export UPDATE_AGENTS_CANDIDATE=1
    python3 bin/update-overlay --inventory --json >"$transaction_dir/inventory.json"

    declare -a fixed_target_names=()
    declare -a npm_flake_target_names=()
    declare -a npm_lock_target_names=()
    declare -a pypi_target_names=()
    declare -a github_projection_target_names=()
    declare -a lock_target_inputs=()
    if ((${#requested_targets[@]})); then
        declare -A seen_targets=()
        for target_name in "${requested_targets[@]}"; do
            if [[ ${seen_targets[$target_name]+present} ]]; then
                echo "update-agents: duplicate target: $target_name" >&2
                exit 2
            fi
            seen_targets["$target_name"]=1
            if ! target_row=$(jq -er --arg name "$target_name" '
                .packages[]
                | select(.name == $name)
                | [.kind, .executor, (.input // "")] | @tsv
            ' "$transaction_dir/inventory.json"); then
                echo "update-agents: unknown target: $target_name" >&2
                exit 2
            fi
            IFS=$'\t' read -r target_kind target_executor target_input <<<"$target_row"
            if [[ $target_executor != update-agents ]] ||
                [[ $target_kind != fixed-flake-input && $target_kind != flake-input &&
                    $target_kind != flake-input+build &&
                    $target_kind != flake-input+copy &&
                    $target_kind != npm-release &&
                    $target_kind != npm-release+flake-input &&
                    $target_kind != pypi-release &&
                    $target_kind != github-commit &&
                    $target_kind != github-release &&
                    $target_kind != github-release-asset ]] ||
                [[ $target_kind != npm-release &&
                    $target_kind != pypi-release &&
                    $target_kind != github-commit &&
                    $target_kind != github-release &&
                    $target_kind != github-release-asset &&
                    -z $target_input ]]; then
                echo "update-agents: target is not owned by this transaction: $target_name" >&2
                exit 2
            fi
            if [[ -n $requested_version && $target_kind != fixed-flake-input &&
                $target_kind != npm-release &&
                $target_kind != npm-release+flake-input &&
                $target_kind != pypi-release &&
                $target_kind != github-commit &&
                $target_kind != github-release &&
                $target_kind != github-release-asset ]]; then
                echo "update-agents: --version is unsupported for this target" >&2
                exit 2
            fi
            if [[ -n $target_input ]]; then
                lock_target_inputs+=("$target_input")
            fi
            if [[ $target_kind == fixed-flake-input ]]; then
                fixed_target_names+=("$target_name")
            elif [[ $target_kind == npm-release ]]; then
                npm_lock_target_names+=("$target_name")
            elif [[ $target_kind == npm-release+flake-input ]]; then
                npm_flake_target_names+=("$target_name")
            elif [[ $target_kind == pypi-release ]]; then
                pypi_target_names+=("$target_name")
            elif [[ $target_kind == github-commit || $target_kind == github-release ||
                $target_kind == github-release-asset ]]; then
                github_projection_target_names+=("$target_name")
            fi
        done
    else
        while IFS=$'\t' read -r target_name target_input target_kind; do
            [[ -n $target_name && -n $target_input ]] || continue
            lock_target_inputs+=("$target_input")
            if [[ $target_kind == fixed-flake-input ]]; then
                fixed_target_names+=("$target_name")
            elif [[ $target_kind == npm-release+flake-input ]]; then
                npm_flake_target_names+=("$target_name")
            fi
        done < <(
            jq -r --arg include_manual "$run_all_inputs" '
                .packages[]
                | select(
                    (
                        .kind == "fixed-flake-input"
                        or .kind == "flake-input+copy"
                        or .kind == "npm-release+flake-input"
                    )
                    and .executor == "update-agents"
                    and ($include_manual == "true" or .policy == "automatic")
                )
                | [.name, .input, .kind] | @tsv
            ' "$transaction_dir/inventory.json"
        )
        mapfile -t pypi_target_names < <(
            jq -r '
                .packages[]
                | select(
                    .kind == "pypi-release"
                    and .executor == "update-agents"
                    and .policy == "automatic"
                )
                | .name
            ' "$transaction_dir/inventory.json"
        )
        mapfile -t npm_lock_target_names < <(
            jq -r '
                .packages[]
                | select(
                    .kind == "npm-release"
                    and .executor == "update-agents"
                    and .policy == "automatic"
                )
                | .name
            ' "$transaction_dir/inventory.json"
        )
        mapfile -t github_projection_target_names < <(
            jq -r '
                .packages[]
                | select(
                    (
                        .kind == "github-commit"
                        or .kind == "github-release"
                        or .kind == "github-release-asset"
                    )
                    and .executor == "update-agents"
                    and .policy == "automatic"
                )
                | .name
            ' "$transaction_dir/inventory.json"
        )
    fi

    if ((${#requested_targets[@]})); then
        requested_targets_json=$(printf '%s\n' "${requested_targets[@]}" |
            jq -Rsc 'split("\n")[:-1]')
        {
            jq -r --argjson names "$requested_targets_json" '
                .packages[]
                | select(.name as $name | $names | index($name))
                | .files[]
            ' "$transaction_dir/inventory.json"
            if ((${#lock_target_inputs[@]})); then
                printf '%s\n' flake.lock config/ai/flake.lock
            fi
        } | sort -u >"$transaction_dir/allowed-paths"
    else
        {
            jq -r '.packages[].files[]' "$transaction_dir/inventory.json"
            printf '%s\n' flake.lock config/ai/flake.lock
        } | sort -u >"$transaction_dir/allowed-paths"
    fi

    if ((${#fixed_target_names[@]})); then
        prepare_args=(--prepare-fixed-inputs)
        if [[ -n $requested_version ]]; then
            prepare_args+=(--version "$requested_version")
        fi
        python3 bin/update-overlay "${prepare_args[@]}" "${fixed_target_names[@]}"
    fi
    if ((${#npm_flake_target_names[@]})); then
        prepare_args=(--prepare-npm-flake-inputs)
        if [[ -n $requested_version ]]; then
            prepare_args+=(--version "$requested_version")
        fi
        python3 bin/update-overlay "${prepare_args[@]}" \
            "${npm_flake_target_names[@]}"
    fi
    if ((${#pypi_target_names[@]})); then
        prepare_args=(--prepare-pypi-artifacts)
        if [[ -n $requested_version ]]; then
            prepare_args+=(--version "$requested_version")
        fi
        python3 bin/update-overlay "${prepare_args[@]}" \
            "${pypi_target_names[@]}"
    fi
    if ((${#github_projection_target_names[@]})); then
        prepare_args=(--prepare-github-projections)
        if [[ -n $requested_version ]]; then
            prepare_args+=(--version "$requested_version")
        fi
        python3 bin/update-overlay "${prepare_args[@]}" \
            "${github_projection_target_names[@]}"
    fi

    if [[ $run_all_inputs == true ]]; then
        nix flake update --flake ./config/ai
        nix flake update
    elif ((${#requested_targets[@]})); then
        if ((${#lock_target_inputs[@]})); then
            nix flake update --flake ./config/ai "${lock_target_inputs[@]}"
            nix flake update nix-config-ai
        fi
    else
        nix flake update --flake ./config/ai "${ai_inputs[@]}" "${lock_target_inputs[@]}"
        # The root consumes the portable subflake transitively; refresh its nested
        # nodes only after the portable lock is complete.
        nix flake update nix-config-ai
    fi
    if ((${#requested_targets[@]} == 0 || ${#lock_target_inputs[@]})); then
        python bin/update-overlay --sync-flake-projections
    fi
    # npmDepsHash validation observes the complete package graph. Prepare Pi
    # locks only after every flake lock and its catalog projection are final.
    if ((${#npm_lock_target_names[@]})); then
        prepare_args=(--prepare-npm-locks)
        if [[ -n $requested_version ]]; then
            prepare_args+=(--version "$requested_version")
        fi
        python3 bin/update-overlay "${prepare_args[@]}" \
            "${npm_lock_target_names[@]}"
    fi
    if ((${#requested_targets[@]} == 0)); then
        python bin/update-overlay --all
    fi
    mapfile -t changed_nix < <(git diff --no-renames --name-only -- '*.nix')
    if ((${#changed_nix[@]})); then
        nixfmt "${changed_nix[@]}"
    fi
    nix flake check ./config/ai --all-systems --no-build
    nix flake check --no-build

    declare -A allowed=()
    while IFS= read -r path; do
        if [[ -z $path || $path == /* || $path == ../* || $path == */../* ]]; then
            echo "update-agents: unsafe updater path: $path" >&2
            exit 1
        fi
        allowed["$path"]=1
    done <"$transaction_dir/allowed-paths"

    mapfile -d '' -t changed < <(
        {
            git diff --no-renames --name-only -z HEAD --
            candidate_untracked_paths
        } | sort -zu
    )
    for path in "${changed[@]}"; do
        if [[ ! ${allowed[$path]+present} ]]; then
            echo "update-agents: undeclared updater mutation: $path" >&2
            exit 1
        fi
    done

    if ((${#changed[@]})); then
        git add -- "${changed[@]}"
    fi
    git diff --cached --no-renames --name-only -z HEAD -- >"$transaction_paths"
    git diff --cached --no-renames --binary --full-index HEAD -- >"$transaction_patch"
    mapfile -d '' -t remaining_untracked < <(candidate_untracked_paths)
    if ! git diff --quiet || ((${#remaining_untracked[@]})); then
        echo "update-agents: candidate tree has unstaged mutations" >&2
        exit 1
    fi
    git diff --cached --check
)

if [[ -s $transaction_patch ]]; then
    expected_candidate_tree=$(git -C "$candidate_dir" write-tree)
fi

if [[ -s $transaction_patch ]] && ! live_repository_matches_baseline; then
    echo "update-agents: live repository changed before publication" >&2
    exit 1
fi

commit_created=false
if [[ $run_dry_run == true ]]; then
    if [[ -s $transaction_patch ]]; then
        git -C "$candidate_dir" diff --cached --stat HEAD --
        echo "update-agents: dry-run candidate validated; authoritative tree unchanged"
    else
        echo "update-agents: dry-run candidate has no changes"
    fi
elif [[ $run_commit == true && -s $transaction_patch ]]; then
    commit_baseline=$(git -C "$candidate_dir" rev-parse HEAD)
    if ! git -C "$candidate_dir" commit -S -m "Update AI agents"; then
        echo "update-agents: signed commit failed" >&2
        exit 1
    fi
    committed_head=$(git -C "$candidate_dir" rev-parse HEAD)
    commit_record=$(git -C "$candidate_dir" rev-list --parents -n 1 "$committed_head")
    read -r commit_id committed_parent committed_extra <<<"$commit_record"
    committed_tree=$(git -C "$candidate_dir" rev-parse "$committed_head^{tree}")
    git -C "$candidate_dir" diff-tree --no-commit-id --name-only -r -z \
        --no-renames "$transaction_baseline" "$committed_head" \
        >"$transaction_committed_paths"
    if [[ $committed_head == "$commit_baseline" ]] ||
        [[ $commit_id != "$committed_head" ]] ||
        [[ $committed_parent != "$transaction_baseline" ]] ||
        [[ -n $committed_extra ]] ||
        [[ $committed_tree != "$expected_candidate_tree" ]] ||
        ! cmp -s "$transaction_paths" "$transaction_committed_paths" ||
        ! git -C "$candidate_dir" verify-commit "$committed_head" >/dev/null 2>&1 ||
        [[ -n $(git -C "$candidate_dir" status --porcelain) ]]; then
        echo "update-agents: signed commit did not capture the complete transaction" >&2
        exit 1
    fi
    if ! live_repository_matches_baseline; then
        echo "update-agents: live repository changed before publication" >&2
        exit 1
    fi
    capture_publication_metadata
    publication_kind="commit"
    transaction_head_ref=$(git -C "$config_dir" symbolic-ref -q HEAD || printf HEAD)
    if ! git -C "$config_dir" -c core.hooksPath=/dev/null \
        merge --ff-only "$committed_head"; then
        echo "update-agents: live repository changed before publication" >&2
        exit 1
    fi
    normalize_publication_paths candidate
    authoritative_untracked_paths >"$transaction_live_untracked_current"
    if [[ $(git -C "$config_dir" rev-parse HEAD) != "$committed_head" ]] ||
        [[ $(git -C "$config_dir" write-tree) != "$expected_candidate_tree" ]] ||
        ! git -C "$config_dir" diff --quiet -- ||
        ! cmp -s "$transaction_live_untracked_baseline" \
            "$transaction_live_untracked_current"; then
        echo "update-agents: published commit differs from validated candidate" >&2
        exit 1
    fi
    transaction_complete=true
    commit_created=true
elif [[ $run_commit == true ]]; then
    echo "update-agents: no changes; no signed commit created"
elif [[ -s $transaction_patch ]]; then
    capture_publication_metadata
    publication_kind="patch"
    git -C "$config_dir" apply --index "$transaction_patch"
    normalize_publication_paths candidate
    git -C "$config_dir" read-tree "$transaction_baseline"
fi

if [[ $run_switch == true || $run_push == true ]] && [[ $commit_created != true ]]; then
    echo "update-agents: refusing external action without a newly signed commit" >&2
    exit 1
fi

transaction_complete=true

if [[ $run_switch == true ]]; then
    raw_host=$(hostname -s)
    [[ ! -d /etc/srp-next ]] || raw_host=vps
    output=$(nix_flake_output_for_host "$raw_host") || {
        echo "update-agents: no flake output for host: $raw_host" >&2
        exit 2
    }
    if [[ -d /etc/nixos || -d /etc/srp-next ]]; then
        with_nixos_build_lock sudo nixos-rebuild switch --flake "$config_dir#$output"
    else
        sudo darwin-rebuild switch --flake "$config_dir#$output"
    fi
fi

if [[ $run_push == true ]]; then
    git -C "$config_dir" push
fi

if [[ -n $brew_pid ]]; then
    wait "$brew_pid"
fi
