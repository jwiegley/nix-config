#!/usr/bin/env bash

set -euo pipefail

update-and-pull &

pushme andoria hera &
pushme git-ai hera &

wait

# A failed Hera host upgrade must stop the rollout: everything below publishes
# or activates state derived from it. Project maintenance is diagnostic and
# must not gate the rollout, so it runs separately at the end.
upgrade hera --host-only

(
    cd $NIX_CONF
    changes
)

pushme hera@6 clio@6 tank@1

update-remote

upgrade hera --projects-only || echo "upgrade-projects reported failures; inspect its build logs" >&2
