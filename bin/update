#!/usr/bin/env bash

set -euo pipefail
# Scrub ambient git plumbing wholesale: a leaked GIT_DIR (from a hook or a
# parent git process) would redirect every `git -C` below — and the work-tree
# detection — at a different repository than the one named on the command.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR \
    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
installed_routing_path=
routing=${installed_routing_path:-$script_dir/lib/host-routing.sh}
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

run_all_inputs=false
run_pull=false
run_commit=false
run_switch=false
run_push=false
run_brew=false
run_dry_run=false
requested_version=
declare -a requested_targets=()

candidate_dir=
candidate_git_dir=
transaction_dir=
transaction_patch=
transaction_paths=
transaction_committed_paths=
transaction_live_untracked_baseline=
transaction_live_untracked_current=
transaction_lock=
transaction_lock_acquired=false
transaction_head_ref=
committed_head=
expected_candidate_tree=
publication_kind=
transaction_complete=false
transaction_signal_status=0
switch_output=
declare -A publication_baseline_git_mode=()
declare -A publication_baseline_kind=()
declare -A publication_baseline_mode=()
declare -A publication_baseline_object=()
declare -A publication_baseline_parent_exists=()

usage() {
    cat <<'EOF'
usage: update [--all-inputs] [--target NAME] [--version VALUE] [--dry-run]
                     [--pull] [--commit] [--switch] [--push] [--brew]

Update both repository locks and every catalog-managed package source.
By default, leave reviewed working-tree changes without external side effects.

Options:
  --all-inputs  Update every root and portable flake input
  --target NAME Update one catalog target through this transaction (repeatable)
  --version VALUE  Force the revision or release for one named projection target
  --dry-run     Validate the candidate without publishing it
  --pull       Fast-forward the clean repository before updating
  --commit     Create one signed commit of updater-owned paths
  --switch     Switch the host after a successful signed commit
  --push       Push after a successful signed commit
  --brew       Update/upgrade Homebrew after the repository transaction
  --no-switch  Disable a previously requested --switch (later flag wins; off by default)
  --no-brew    Disable a previously requested --brew (later flag wins; off by default)
EOF
}

capture_publication_metadata() {
    local path stage mode git_mode object_type object_hash _ignored parent
    while IFS= read -r -d '' path; do
        if ! stage=$(git -C "$config_dir" ls-tree "$transaction_baseline" -- "$path"); then
            return 1
        fi
        if [[ -n $stage ]]; then
            read -r git_mode object_type object_hash _ignored <<<"$stage"
            if [[ $object_type != blob || -z $object_hash ]]; then
                echo "update: unsupported baseline Git object: $path" >&2
                return 1
            fi
            publication_baseline_git_mode["$path"]=$git_mode
            publication_baseline_object["$path"]=$object_hash
        else
            publication_baseline_git_mode["$path"]=
            publication_baseline_object["$path"]=
        fi
        if [[ -L $config_dir/$path ]]; then
            publication_baseline_kind["$path"]=symlink
        elif [[ -f $config_dir/$path ]]; then
            publication_baseline_kind["$path"]=regular
            if ! mode=$(stat -c '%a' "$config_dir/$path" 2>/dev/null || stat -f '%Lp' "$config_dir/$path"); then
                return 1
            fi
            publication_baseline_mode["$path"]=$mode
        elif [[ ! -e $config_dir/$path ]]; then
            publication_baseline_kind["$path"]=missing
            parent=${path%/*}
            while [[ $parent != "$path" && $parent != . ]]; do
                if [[ -d $config_dir/$parent && ! -L $config_dir/$parent ]]; then
                    publication_baseline_parent_exists["$parent"]=true
                    break
                fi
                if [[ -e $config_dir/$parent || -L $config_dir/$parent ]]; then
                    echo "update: unsupported authoritative parent type: $parent" >&2
                    return 1
                fi
                publication_baseline_parent_exists["$parent"]=false
                path=$parent
                parent=${path%/*}
            done
        else
            echo "update: unsupported authoritative path type: $path" >&2
            return 1
        fi
    done <"$transaction_paths"
}

normalize_publication_paths() {
    local state=$1 path stage mode expected_mode kind
    while IFS= read -r -d '' path; do
        if [[ $state == baseline ]]; then
            kind=${publication_baseline_kind[$path]}
            case $kind in
            missing)
                if [[ -e $config_dir/$path || -L $config_dir/$path ]]; then
                    echo "update: rollback retained created path: $path" >&2
                    return 1
                fi
                ;;
            regular)
                if [[ ! -f $config_dir/$path || -L $config_dir/$path ]]; then
                    echo "update: rollback path is not a regular file: $path" >&2
                    return 1
                fi
                chmod "${publication_baseline_mode[$path]}" "$config_dir/$path" || return 1
                ;;
            symlink)
                if [[ ! -L $config_dir/$path ]]; then
                    echo "update: rollback path is not a symlink: $path" >&2
                    return 1
                fi
                ;;
            *)
                echo "update: missing rollback metadata: $path" >&2
                return 1
                ;;
            esac
            continue
        fi

        if ! stage=$(git -C "$config_dir" ls-files --stage -- "$path"); then
            return 1
        fi
        [[ -n $stage ]] || continue
        mode=${stage%% *}
        case $mode in
        100644)
            if [[ ! -f $config_dir/$path || -L $config_dir/$path ]]; then
                echo "update: published path is not a regular file: $path" >&2
                return 1
            fi
            expected_mode=0644
            if [[ ${publication_baseline_kind[$path]} == regular &&
                ${publication_baseline_git_mode[$path]} == "$mode" ]]; then
                expected_mode=${publication_baseline_mode[$path]}
            fi
            chmod "$expected_mode" "$config_dir/$path" || return 1
            ;;
        100755)
            if [[ ! -f $config_dir/$path || -L $config_dir/$path ]]; then
                echo "update: published executable is not a regular file: $path" >&2
                return 1
            fi
            expected_mode=0755
            if [[ ${publication_baseline_kind[$path]} == regular &&
                ${publication_baseline_git_mode[$path]} == "$mode" ]]; then
                expected_mode=${publication_baseline_mode[$path]}
            fi
            chmod "$expected_mode" "$config_dir/$path" || return 1
            ;;
        120000)
            if [[ ! -L $config_dir/$path ]]; then
                echo "update: published path is not a symlink: $path" >&2
                return 1
            fi
            ;;
        *)
            echo "update: unsupported published Git mode $mode: $path" >&2
            return 1
            ;;
        esac
    done <"$transaction_paths"
}

restore_publication_baseline() {
    local path kind parent removed=true
    local -a paths=()
    mapfile -d '' -t paths <"$transaction_paths"
    while IFS= read -r -d '' path; do
        kind=${publication_baseline_kind[$path]}
        case $kind in
        missing)
            if [[ -d $config_dir/$path && ! -L $config_dir/$path ]]; then
                echo "update: refusing to remove rollback directory: $path" >&2
                return 1
            fi
            rm -f -- "$config_dir/$path" || return 1
            git -C "$config_dir" update-index --force-remove -- "$path" || return 1
            ;;
        regular | symlink)
            if ! git -C "$config_dir" restore \
                --source="$transaction_baseline" --staged --worktree -- "$path"; then
                git -C "$config_dir" update-index --add --cacheinfo \
                    "${publication_baseline_git_mode[$path]}" \
                    "${publication_baseline_object[$path]}" "$path" ||
                    return 1
                git -C "$config_dir" checkout-index --force -- "$path" || return 1
            fi
            ;;
        *)
            echo "update: missing restore metadata: $path" >&2
            return 1
            ;;
        esac
    done <"$transaction_paths"
    while [[ $removed == true ]]; do
        removed=false
        for parent in "${!publication_baseline_parent_exists[@]}"; do
            if [[ ${publication_baseline_parent_exists[$parent]} == false &&
                -d $config_dir/$parent && ! -L $config_dir/$parent ]] &&
                rmdir "$config_dir/$parent" 2>/dev/null; then
                removed=true
            fi
        done
    done
    for parent in "${!publication_baseline_parent_exists[@]}"; do
        if [[ ${publication_baseline_parent_exists[$parent]} == false &&
            (-e $config_dir/$parent || -L $config_dir/$parent) ]]; then
            echo "update: rollback retained created directory: $parent" >&2
            return 1
        fi
    done
    normalize_publication_paths baseline || return 1
    git -C "$config_dir" diff --quiet -- "${paths[@]}" &&
        git -C "$config_dir" diff --cached --quiet \
            "$transaction_baseline" -- "${paths[@]}"
}

rollback_commit_publication() {
    local current_head
    current_head=$(git -C "$config_dir" rev-parse HEAD)
    if [[ $current_head == "$transaction_baseline" ]]; then
        restore_publication_baseline
        return
    fi
    if [[ $current_head != "$committed_head" ]]; then
        echo "update: live HEAD changed during commit rollback" >&2
        return 1
    fi
    git -C "$config_dir" update-ref \
        "$transaction_head_ref" "$transaction_baseline" "$committed_head" &&
        restore_publication_baseline
}

candidate_untracked_paths() {
    {
        git ls-files --others --exclude-standard -z
        git ls-files --others --ignored --exclude-standard -z
    } | sort -zu
}

authoritative_untracked_paths() {
    {
        git -C "$config_dir" ls-files --others --exclude-standard -z
        git -C "$config_dir" ls-files --others --ignored --exclude-standard -z
    } | sort -zu
}

live_repository_matches_baseline() {
    authoritative_untracked_paths >"$transaction_live_untracked_current" &&
        [[ $(git -C "$config_dir" rev-parse HEAD) == "$transaction_baseline" ]] &&
        [[ -z $(git -C "$config_dir" status --porcelain) ]] &&
        cmp -s "$transaction_live_untracked_baseline" \
            "$transaction_live_untracked_current"
}

while (($#)); do
    case $1 in
    --all-inputs)
        run_all_inputs=true
        ;;
    --target)
        [[ $# -ge 2 && -n $2 ]] || {
            echo "update: --target requires a name" >&2
            exit 2
        }
        requested_targets+=("$2")
        shift
        ;;
    --version)
        [[ $# -ge 2 && -n $2 ]] || {
            echo "update: --version requires a revision" >&2
            exit 2
        }
        requested_version=$2
        shift
        ;;
    --dry-run)
        run_dry_run=true
        ;;
    --pull)
        run_pull=true
        ;;
    --commit)
        run_commit=true
        ;;
    --switch)
        run_switch=true
        ;;
    --push)
        run_push=true
        ;;
    --brew)
        run_brew=true
        ;;
    --no-switch)
        run_switch=false
        ;;
    --no-brew)
        run_brew=false
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo "update: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
done

# Target selection. Explicit NIX_CONFIG_DIR wins. The system checkout wins
# next: on NixOS hosts /etc/nixos is the authoritative checkout and owns the
# build lock, so no work tree may displace it. Otherwise the invoking work
# tree is honored when it is a PRIMARY nix-config checkout — flake.nix plus
# the config/ai portable core, and not a linked worktree, so `update` run
# from an agent worktree on a feature branch cannot pull, activate, and
# publish that branch. Invocations from outside any nix-config work tree
# fall back to ~/src/nix as before.
is_primary_nix_config_work_tree() {
    local tree=$1 git_dir git_common_dir
    [[ -n $tree && -f $tree/flake.nix && -d $tree/config/ai ]] || return 1
    git_dir=$(git -C "$tree" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
    git_common_dir=$(git -C "$tree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        return 1
    [[ $git_dir == "$git_common_dir" ]]
}

invoking_work_tree=$(git rev-parse --show-toplevel 2>/dev/null || true)
system_config_dir=${UPDATE_AGENTS_SYSTEM_CONFIG_DIR:-/etc/nixos}
if [[ -n ${NIX_CONFIG_DIR:-} ]]; then
    config_dir=$NIX_CONFIG_DIR
elif [[ -d $system_config_dir ]]; then
    config_dir=$system_config_dir
    # Implicit cross-repository mutation is forbidden: when the operator is
    # standing in a different nix-config checkout, refuse instead of silently
    # transacting against the system checkout.
    if is_primary_nix_config_work_tree "$invoking_work_tree" &&
        [[ $(cd "$invoking_work_tree" && pwd -P) != "$(cd "$config_dir" && pwd -P)" ]]; then
        echo "update: refusing implicit retarget: invoked inside $invoking_work_tree" >&2
        echo "update: the system checkout $config_dir owns this host; cd there or set NIX_CONFIG_DIR" >&2
        exit 2
    fi
elif is_primary_nix_config_work_tree "$invoking_work_tree"; then
    config_dir=$invoking_work_tree
else
    config_dir=$HOME/src/nix
fi
echo "update: target checkout: $config_dir" >&2

require_clean() {
    local repo=$1
    if [[ -n $(git -C "$repo" status --porcelain) ]]; then
        echo "update: refusing to update dirty repo: $repo" >&2
        exit 1
    fi
}

git_pull_clean() {
    local repo=$1
    require_clean "$repo"
    git -C "$repo" pull --ff-only
}

cleanup_transaction() {
    local status=$?
    local rollback_status=0
    local rollback_failed=false
    local worktree_list=
    set +e
    trap - HUP INT TERM

    if [[ -n $publication_kind && $transaction_complete != true ]]; then
        if [[ $publication_kind == commit ]]; then
            rollback_commit_publication || rollback_status=$?
        else
            restore_publication_baseline || rollback_status=$?
        fi
        if [[ $rollback_status -eq 0 ]]; then
            echo "update: rolled back incomplete source transaction" >&2
        else
            echo "update: failed to roll back incomplete source transaction" >&2
            rollback_failed=true
        fi
    fi

    if [[ -n $candidate_dir ]]; then
        if ! git -C "$config_dir" worktree remove --force "$candidate_dir" >/dev/null 2>&1; then
            if [[ -z $candidate_git_dir && -f $candidate_dir/.git ]]; then
                candidate_git_dir=$(
                    git -C "$candidate_dir" rev-parse --path-format=absolute --git-dir \
                        2>/dev/null
                )
            fi
            if [[ -e $candidate_dir ]]; then
                if [[ $candidate_dir == "$transaction_dir/candidate" ]]; then
                    rm -rf -- "$candidate_dir"
                else
                    echo "update: refusing unsafe candidate cleanup" >&2
                    rollback_failed=true
                fi
            fi
            if [[ -n $candidate_git_dir ]]; then
                case $candidate_git_dir in
                "$git_common_dir"/worktrees/*) rm -rf -- "$candidate_git_dir" ;;
                *)
                    echo "update: refusing unsafe worktree metadata cleanup" >&2
                    rollback_failed=true
                    ;;
                esac
            fi
            if [[ -e $candidate_dir ]]; then
                echo "update: failed to remove candidate worktree" >&2
                rollback_failed=true
            fi
        fi
        if [[ -n $candidate_git_dir && -e $candidate_git_dir ]]; then
            echo "update: failed to remove candidate worktree metadata" >&2
            rollback_failed=true
        fi
        if ! worktree_list=$(git -C "$config_dir" worktree list --porcelain); then
            echo "update: failed to verify candidate worktree removal" >&2
            rollback_failed=true
        elif awk -v target="$candidate_dir" '
                $1 == "worktree" && substr($0, 10) == target { found = 1 }
                END { exit(found ? 0 : 1) }
            ' <<<"$worktree_list"; then
            echo "update: candidate remains registered" >&2
            rollback_failed=true
        fi
    fi
    if [[ -n $transaction_dir ]]; then
        rm -f -- "$transaction_patch" "$transaction_paths" \
            "$transaction_committed_paths" \
            "$transaction_live_untracked_baseline" \
            "$transaction_live_untracked_current" \
            "$transaction_dir/inventory.json" "$transaction_dir/allowed-paths" \
            "$transaction_dir/catalog-inputs" \
            "$transaction_dir/portable-inputs" \
            "$transaction_dir/root-inputs" \
            "$transaction_dir/target-rows" \
            "$transaction_dir/before-target-untracked" \
            "$transaction_dir/after-target-untracked"
        rmdir "$transaction_dir" 2>/dev/null || true
    fi
    if [[ $transaction_lock_acquired == true ]] && ! rmdir "$transaction_lock" 2>/dev/null; then
        echo "update: failed to release transaction lock" >&2
        rollback_failed=true
    fi

    if [[ $rollback_failed == true ]]; then
        status=1
    fi
    trap - EXIT
    exit "$status"
}

if [[ $run_all_inputs == true && ${#requested_targets[@]} -ne 0 ]]; then
    echo "update: --all-inputs cannot be combined with --target" >&2
    exit 2
fi
if [[ -n $requested_version && ${#requested_targets[@]} -ne 1 ]]; then
    echo "update: --version requires exactly one --target" >&2
    exit 2
fi
if [[ $run_dry_run == true ]] &&
    [[ $run_pull == true || $run_commit == true || $run_switch == true ||
        $run_push == true || $run_brew == true ]]; then
    echo "update: --dry-run cannot be combined with external actions" >&2
    exit 2
fi

if [[ $run_switch == true || $run_push == true ]] && [[ $run_commit != true ]]; then
    echo "update: --switch/--push require --commit" >&2
    exit 2
fi

# Shared-work is an external Home Manager consumer, not a root-flake system
# output. Refuse before pull or candidate construction so --switch cannot
# mutate this checkout and then fail while looking for a Darwin configuration.
if [[ $run_switch == true ]]; then
    raw_host=$(hostname -s)
    [[ ! -d /etc/srp-next ]] || raw_host=vps
    switch_host=$(normalize_nix_host "$raw_host") || {
        echo "update: no switch route for host: $raw_host" >&2
        exit 2
    }
    if [[ $switch_host == shared-work ]]; then
        echo "update: --switch is unsupported on shared-work hosts" >&2
        echo "update: use the authoritative external Home Manager rollout" >&2
        exit 2
    fi
    switch_output=$(nix_flake_output_for_host "$switch_host") || {
        echo "update: no flake output for host: $raw_host" >&2
        exit 2
    }
fi

if [[ $run_pull == true ]]; then
    git_pull_clean "$config_dir"
else
    require_clean "$config_dir"
fi

transaction_baseline=$(git -C "$config_dir" rev-parse HEAD)
git_common_dir=$(git -C "$config_dir" rev-parse --path-format=absolute --git-common-dir)
transaction_lock=$git_common_dir/update-agents.lock
trap cleanup_transaction EXIT
trap 'transaction_signal_status=129' HUP
trap 'transaction_signal_status=130' INT
trap 'transaction_signal_status=143' TERM
if mkdir "$transaction_lock" 2>/dev/null; then
    transaction_lock_acquired=true
else
    echo "update: another update transaction is active" >&2
    exit 1
fi
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ $transaction_signal_status -ne 0 ]]; then
    exit "$transaction_signal_status"
fi
transaction_dir=$(mktemp -d "${TMPDIR:-/tmp}/update.XXXXXX")
candidate_dir=$transaction_dir/candidate
transaction_patch=$transaction_dir/update.patch
transaction_paths=$transaction_dir/paths
transaction_committed_paths=$transaction_dir/committed-paths
transaction_live_untracked_baseline=$transaction_dir/live-untracked-baseline
transaction_live_untracked_current=$transaction_dir/live-untracked-current
authoritative_untracked_paths >"$transaction_live_untracked_baseline"
git -C "$config_dir" worktree add --quiet --detach "$candidate_dir" "$transaction_baseline"
candidate_git_dir=$(git -C "$candidate_dir" rev-parse --path-format=absolute --git-dir)

(
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    cd "$candidate_dir"
    export UPDATE_AGENTS_CANDIDATE=1
    python3 bin/update-overlay --inventory --json >"$transaction_dir/inventory.json"

    explicit_targets=false
    explicit_has_lock=false
    requested_targets_json='[]'
    if ((${#requested_targets[@]})); then
        explicit_targets=true
        declare -A seen_targets=()
        for target_name in "${requested_targets[@]}"; do
            if [[ ${seen_targets[$target_name]+present} ]]; then
                echo "update: duplicate target: $target_name" >&2
                exit 2
            fi
            seen_targets["$target_name"]=1
            if ! target_row=$(jq -er --arg name "$target_name" '
                .packages[]
                | select(.name == $name)
                | [.kind, .executor, (.input // "-")] | @tsv
            ' "$transaction_dir/inventory.json"); then
                echo "update: unknown target: $target_name" >&2
                exit 2
            fi
            IFS=$'\t' read -r target_kind target_executor target_input <<<"$target_row"
            case "$target_executor:$target_kind" in
            update:fixed-flake-input | update:flake-input | update:flake-input+build | \
                update:flake-input+copy | update:npm-release | \
                update:npm-release+flake-input | update:pypi-release | \
                update:github-commit | update:github-release | update:github-tag | \
                update:github-release-asset) ;;
            *)
                echo "update: target is not owned by this transaction: $target_name" >&2
                exit 2
                ;;
            esac
            case $target_kind in
            fixed-flake-input | flake-input | flake-input+build | flake-input+copy | \
                npm-release+flake-input)
                [[ $target_input != - ]] || {
                    echo "update: target has no declared flake input: $target_name" >&2
                    exit 2
                }
                explicit_has_lock=true
                ;;
            esac
            case $target_kind in
            fixed-flake-input | npm-release | npm-release+flake-input | pypi-release | \
                github-commit | github-release | github-tag | github-release-asset) ;;
            *)
                if [[ -n $requested_version ]]; then
                    echo "update: --version is unsupported for this target" >&2
                    exit 2
                fi
                ;;
            esac
        done
        requested_targets_json=$(printf '%s\n' "${requested_targets[@]}" |
            jq -Rsc 'split("\n")[:-1]')
        {
            jq -r --argjson names "$requested_targets_json" '
                .packages[]
                | select(.name as $name | $names | index($name))
                | .files[]
            ' "$transaction_dir/inventory.json"
            if [[ $explicit_has_lock == true ]]; then
                printf '%s\n' flake.lock config/ai/flake.lock
            fi
        } | sort -u >"$transaction_dir/allowed-paths"
    else
        {
            jq -r '.packages[].files[]' "$transaction_dir/inventory.json"
            printf '%s\n' flake.lock config/ai/flake.lock
        } | sort -u >"$transaction_dir/allowed-paths"
    fi

    run_hard() {
        local status=0
        "$@" || status=$?
        [[ $status -ne 3 ]] || status=1
        return "$status"
    }

    # Uncatalogued flake inputs remain a repository-wide operation. Catalogued
    # inputs are excluded here and advanced below with their own source record,
    # dependent hashes, and generated files as one target transaction.
    if [[ $run_all_inputs == true ]]; then
        jq -r '.packages[] | .input // empty' "$transaction_dir/inventory.json" |
            sort -u >"$transaction_dir/catalog-inputs"
        mapfile -t catalog_inputs <"$transaction_dir/catalog-inputs"
        catalog_inputs_json=$(printf '%s\n' "${catalog_inputs[@]}" |
            jq -Rsc 'split("\n")[:-1]')
        jq -r --argjson catalog "$catalog_inputs_json" '
            .nodes[.root].inputs | keys[]
            | select(. as $name | $catalog | index($name) | not)
        ' config/ai/flake.lock >"$transaction_dir/portable-inputs"
        mapfile -t portable_inputs <"$transaction_dir/portable-inputs"
        jq -r '.nodes[.root].inputs | keys[] | select(. != "nix-config-ai")' \
            flake.lock >"$transaction_dir/root-inputs"
        mapfile -t root_inputs <"$transaction_dir/root-inputs"
        if ((${#portable_inputs[@]})); then
            run_hard nix flake update --flake ./config/ai "${portable_inputs[@]}"
        fi
        if ((${#root_inputs[@]})); then
            run_hard nix flake update "${root_inputs[@]}"
        fi
        run_hard nix flake update nix-config-ai
    fi

    # Preserve the dependency order of the former grouped updater while each
    # target now owns its own subprocess and rollback boundary. In particular,
    # npm lock validation still observes the complete updated flake graph.
    jq -r \
        --argjson names "$requested_targets_json" \
        --argjson explicit "$explicit_targets" \
        --argjson all_inputs "$run_all_inputs" '
            def phase:
                if .executor == "update-overlay" then 6
                elif .kind == "pypi-release" then 0
                elif (
                    .kind == "github-commit"
                    or .kind == "github-release"
                    or .kind == "github-tag"
                    or .kind == "github-release-asset"
                ) then 1
                elif .kind == "npm-release+flake-input" then 2
                elif .kind == "fixed-flake-input" then 3
                elif (.input // "") != "" then 4
                elif .kind == "npm-release" then 5
                else 0
                end;
            [
                .packages[]
                | select(
                    if $explicit then
                        .name as $name | $names | index($name)
                    else
                        .managed
                        and (
                            .executor == "update"
                            or .executor == "update-overlay"
                        )
                        and (
                            (.policy // "automatic") == "automatic"
                            or ($all_inputs and (.input // "") != "")
                        )
                    end
                )
                | [
                    phase,
                    .name,
                    (.kind // "-"),
                    (.executor // "-"),
                    (.input // "-"),
                    (.version // "unknown")
                  ]
            ]
            | sort_by(.[0], .[1])[]
            | .[1:]
            | @tsv
        ' "$transaction_dir/inventory.json" >"$transaction_dir/target-rows"
    mapfile -t target_rows <"$transaction_dir/target-rows"

    run_target() {
        local name=$1 executor=$2 input=$3
        local -a command
        if [[ $executor == update-overlay ]]; then
            python3 bin/update-overlay "$name"
            return
        fi

        command=(python3 bin/update-overlay --prepare-target "$name")
        if [[ -n $requested_version ]]; then
            command+=(--version "$requested_version")
        fi
        "${command[@]}" || return $?
        if [[ -n $input ]]; then
            run_hard nix flake update --flake ./config/ai "$input" || return $?
            run_hard nix flake update nix-config-ai || return $?
            python3 bin/update-overlay --sync-flake-projections
        fi
    }

    declare -a held_back=()
    for target_row in "${target_rows[@]}"; do
        IFS=$'\t' read -r target_name target_kind target_executor target_input \
            target_version <<<"$target_row"
        [[ $target_input != - ]] || target_input=
        git add -A --
        before_target_tree=$(git write-tree)
        candidate_untracked_paths >"$transaction_dir/before-target-untracked"
        echo "update: catalog/$target_name: evaluating candidate" >&2
        set +e
        run_target "$target_name" "$target_executor" "$target_input"
        target_status=$?
        set -e
        if [[ $target_status -eq 0 ]]; then
            git add -A --
            continue
        fi
        [[ $target_status -eq 3 ]] || exit "$target_status"

        # Status 3 is provisional until the complete pre-target tree is
        # restored and its package contract builds. This separates a bad
        # candidate from daemon, evaluator, and resource failures.
        git add -A --
        git read-tree --reset -u "$before_target_tree"
        candidate_untracked_paths >"$transaction_dir/after-target-untracked"
        if [[ $(git write-tree) != "$before_target_tree" ]] ||
            ! git diff --quiet ||
            ! cmp -s "$transaction_dir/before-target-untracked" \
                "$transaction_dir/after-target-untracked"; then
            echo "update: failed to restore held-back target: $target_name" >&2
            exit 1
        fi
        set +e
        python3 bin/update-overlay --validate-target "$target_name"
        baseline_status=$?
        set -e
        if [[ $baseline_status -ne 0 ]]; then
            echo "update: restored baseline validation failed: $target_name" >&2
            exit "$baseline_status"
        fi
        held_back+=("$target_name"$'\t'"$target_version")
    done
    rm -f -- "$transaction_dir/before-target-untracked" \
        "$transaction_dir/after-target-untracked"

    if ((${#held_back[@]})); then
        echo "update: held-back catalog targets:" >&2
        for target_row in "${held_back[@]}"; do
            IFS=$'\t' read -r name version <<<"$target_row"
            printf '  %s: retained %s (package validation rejected the candidate)\n' \
                "$name" "$version" >&2
        done
        if ((${#held_back[@]} == ${#target_rows[@]})); then
            echo "update: every selected catalog candidate was held back" >&2
            exit 3
        fi
    fi

    # Every target subprocess reloads the catalog. The global checks remain a
    # fatal publication gate over the combined accepted candidate.
    if ((${#requested_targets[@]} == 0)) || [[ $explicit_has_lock == true ]]; then
        python3 bin/update-overlay --sync-flake-projections
    fi
    python3 bin/update-overlay --inventory --json >/dev/null
    mapfile -t changed_nix < <(git diff --no-renames --name-only HEAD -- '*.nix')
    if ((${#changed_nix[@]})); then
        nixfmt "${changed_nix[@]}"
    fi
    run_hard nix flake check ./config/ai --all-systems --no-build --no-eval-cache
    # The root graph has IFD inputs. Serialize their store registration and
    # materialize lazy sources so the publication gate cannot cache a race.
    run_hard nix flake check --no-build --option eval-cores 1 --option lazy-trees false --option eval-cache false

    declare -A allowed=()
    while IFS= read -r path; do
        if [[ -z $path || $path == /* || $path == ../* || $path == */../* ]]; then
            echo "update: unsafe updater path: $path" >&2
            exit 1
        fi
        allowed["$path"]=1
    done <"$transaction_dir/allowed-paths"

    mapfile -d '' -t changed < <(
        {
            git diff --no-renames --name-only -z HEAD --
            candidate_untracked_paths
        } | sort -zu
    )
    for path in "${changed[@]}"; do
        if [[ ! ${allowed[$path]+present} ]]; then
            echo "update: undeclared updater mutation: $path" >&2
            exit 1
        fi
    done

    git add -A --
    git diff --cached --no-renames --name-only -z HEAD -- >"$transaction_paths"
    git diff --cached --no-renames --binary --full-index HEAD -- >"$transaction_patch"
    mapfile -d '' -t remaining_untracked < <(candidate_untracked_paths)
    if ! git diff --quiet || ((${#remaining_untracked[@]})); then
        echo "update: candidate tree has unstaged mutations" >&2
        exit 1
    fi
    git diff --cached --check
)

if [[ -s $transaction_patch ]]; then
    expected_candidate_tree=$(git -C "$candidate_dir" write-tree)
fi

if [[ -s $transaction_patch ]] && ! live_repository_matches_baseline; then
    echo "update: live repository changed before publication" >&2
    exit 1
fi

commit_created=false
if [[ $run_dry_run == true ]]; then
    if [[ -s $transaction_patch ]]; then
        git -C "$candidate_dir" diff --cached --stat HEAD --
        echo "update: dry-run candidate validated; authoritative tree unchanged"
    else
        echo "update: dry-run candidate has no changes"
    fi
elif [[ $run_commit == true && -s $transaction_patch ]]; then
    commit_baseline=$(git -C "$candidate_dir" rev-parse HEAD)
    if ! git -C "$candidate_dir" commit -S -m "Update project pins"; then
        echo "update: signed commit failed" >&2
        exit 1
    fi
    committed_head=$(git -C "$candidate_dir" rev-parse HEAD)
    commit_record=$(git -C "$candidate_dir" rev-list --parents -n 1 "$committed_head")
    read -r commit_id committed_parent committed_extra <<<"$commit_record"
    committed_tree=$(git -C "$candidate_dir" rev-parse "$committed_head^{tree}")
    git -C "$candidate_dir" diff-tree --no-commit-id --name-only -r -z \
        --no-renames "$transaction_baseline" "$committed_head" \
        >"$transaction_committed_paths"
    if [[ $committed_head == "$commit_baseline" ]] ||
        [[ $commit_id != "$committed_head" ]] ||
        [[ $committed_parent != "$transaction_baseline" ]] ||
        [[ -n $committed_extra ]] ||
        [[ $committed_tree != "$expected_candidate_tree" ]] ||
        ! cmp -s "$transaction_paths" "$transaction_committed_paths" ||
        ! git -C "$candidate_dir" verify-commit "$committed_head" >/dev/null 2>&1 ||
        [[ -n $(git -C "$candidate_dir" status --porcelain) ]]; then
        echo "update: signed commit did not capture the complete transaction" >&2
        exit 1
    fi
    if ! live_repository_matches_baseline; then
        echo "update: live repository changed before publication" >&2
        exit 1
    fi
    commit_created=true
elif [[ $run_commit == true ]]; then
    echo "update: no changes; no signed commit created"
    committed_head=$transaction_baseline
elif [[ -s $transaction_patch ]]; then
    capture_publication_metadata
    publication_kind="patch"
    git -C "$config_dir" apply --index "$transaction_patch"
    normalize_publication_paths candidate
    git -C "$config_dir" read-tree "$transaction_baseline"
fi

if [[ $run_switch == true ]]; then
    if ! live_repository_matches_baseline; then
        echo "update: live repository changed before candidate build" >&2
        exit 1
    fi
    case $switch_output in
    vulcan | ovh-vps)
        nixos_limits=()
        if build_limits=$(nix_local_build_limits_for_host "$switch_host"); then
            read -r max_jobs cores <<<"$build_limits"
            nixos_limits=(--max-jobs "$max_jobs" --cores "$cores")
        fi
        build_driver="$config_dir/build"
        if [[ ! -x $build_driver ]]; then
            echo "update: NixOS build driver is missing or not executable: $build_driver" >&2
            exit 1
        fi
        (
            cd "$config_dir"
            ./build -- nix build "${nixos_limits[@]}" --no-link \
                "$candidate_dir#nixosConfigurations.$switch_output.config.system.build.toplevel"
        )
        if ! live_repository_matches_baseline; then
            echo "update: live repository changed before candidate switch" >&2
            exit 1
        fi
        (
            cd "$config_dir"
            ./build -- nixos-rebuild switch "${nixos_limits[@]}" \
                --flake "$candidate_dir#$switch_output"
        )
        ;;
    *)
        system_config=$(nix build --no-link --print-out-paths \
            "$candidate_dir#darwinConfigurations.$switch_output.system")
        if [[ -z $system_config || ! -x $system_config/sw/bin/darwin-rebuild ]]; then
            echo "update: Nix did not produce an activatable Darwin system" >&2
            exit 1
        fi
        if ! live_repository_matches_baseline; then
            echo "update: live repository changed before candidate switch" >&2
            exit 1
        fi
        sudo nix-env -p /nix/var/nix/profiles/system --set "$system_config"
        sudo "$system_config/sw/bin/darwin-rebuild" activate
        ;;
    esac
    if ! live_repository_matches_baseline; then
        echo "update: live repository changed during candidate switch" >&2
        exit 1
    fi
fi

if [[ $commit_created == true ]]; then
    capture_publication_metadata
    publication_kind="commit"
    transaction_head_ref=$(git -C "$config_dir" symbolic-ref -q HEAD || printf HEAD)
    if ! git -C "$config_dir" -c core.hooksPath=/dev/null \
        merge --ff-only "$committed_head"; then
        echo "update: live repository changed before publication" >&2
        exit 1
    fi
    normalize_publication_paths candidate
    authoritative_untracked_paths >"$transaction_live_untracked_current"
    if [[ $(git -C "$config_dir" rev-parse HEAD) != "$committed_head" ]] ||
        [[ $(git -C "$config_dir" write-tree) != "$expected_candidate_tree" ]] ||
        ! git -C "$config_dir" diff --quiet -- ||
        ! cmp -s "$transaction_live_untracked_baseline" \
            "$transaction_live_untracked_current"; then
        echo "update: published commit differs from validated candidate" >&2
        exit 1
    fi
fi

# A push failure retains the local commit for an explicit retry; earlier
# transaction failures still roll back.
transaction_complete=true

if [[ $run_push == true && $commit_created == true ]]; then
    publish_branch=$(git -C "$config_dir" symbolic-ref --quiet --short HEAD) || {
        echo "update: cannot publish a detached branch" >&2
        exit 1
    }
    (
        cd "$config_dir"
        bin/publish --publish --rev "$committed_head" --branch "$publish_branch"
    )
fi

if [[ $run_brew == true ]] && command -v brew >/dev/null 2>&1; then
    brew update
    brew upgrade --greedy --yes
fi
