#!/usr/bin/env bash
set -euo pipefail
set +x

user=${USER:-$(id -un)}
pass_bin=${CODEX_ENV_PASS_BIN:-/etc/profiles/per-user/${user}/bin/pass}
codex_bin=${CODEX_ENV_REAL_CODEX:-/etc/profiles/per-user/${user}/bin/codex}

if [[ ! -x $pass_bin ]]; then
    echo "codex: credential helper is unavailable" >&2
    exit 1
fi
if [[ ! -x $codex_bin ]]; then
    echo "codex: underlying Codex executable is unavailable" >&2
    exit 1
fi

load_credential() {
    local entry=$1
    local label=$2
    local variable=$3
    local credential=""

    if ! credential=$("$pass_bin" "$entry"); then
        echo "codex: $label credential is unavailable or empty" >&2
        exit 1
    fi
    credential=${credential%%$'\n'*}
    if [[ -z $credential ]]; then
        echo "codex: $label credential is unavailable or empty" >&2
        exit 1
    fi
    printf -v "$variable" '%s' "$credential"
}

REF_API_KEY=""
PERPLEXITY_API_KEY=""
load_credential api.ref.tools Ref REF_API_KEY
load_credential api.perplexity.ai Perplexity PERPLEXITY_API_KEY
export REF_API_KEY PERPLEXITY_API_KEY

exec "$codex_bin" "$@"
