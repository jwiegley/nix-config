#!/usr/bin/env python3
"""
update-overlay - Update Nix overlay package definitions to their latest versions.

Usage:
    update-overlay <package1> [package2] ...

Examples:
    update-overlay llama-swap llama-cpp
    update-overlay hfdownloader
    update-overlay --dry-run mlx-lm
"""

import argparse
import atexit
import base64
import copy
import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Optional
from urllib.parse import quote, urlsplit
from urllib.request import urlopen


# ANSI color codes
class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"

    @classmethod
    def disable(cls):
        """Disable colors (e.g., when not a TTY)."""
        cls.RESET = cls.BOLD = cls.DIM = ""
        cls.RED = cls.GREEN = cls.YELLOW = cls.BLUE = cls.MAGENTA = cls.CYAN = ""


# Disable colors if not a TTY
if not sys.stdout.isatty():
    Colors.disable()

DUMMY_SRI_HASH = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="


@dataclass
class PackageInfo:
    """Information about a package in an overlay."""
    name: str
    file_path: Path
    owner: str = ""
    repo: str = ""
    npm_package: str = ""
    version: str = ""
    version_prefix: str = ""  # e.g., "v", "b", ""
    src_hash: str = ""
    vendor_hash: Optional[str] = None
    cargo_hash: Optional[str] = None
    npm_deps_hash: Optional[str] = None
    # Track where in the file each field is located
    version_line: int = 0
    hash_line: int = 0
    vendor_hash_line: int = 0
    cargo_hash_line: int = 0
    npm_deps_hash_line: int = 0
    # Raw text patterns for replacement
    raw_version_pattern: str = ""
    raw_hash_pattern: str = ""
    # Package type
    package_type: str = "standard"  # standard, go, rust, npm
    # Commit-based versioning (no tags/releases)
    uses_commit: bool = False  # True if rev = "full-commit-hash" pattern
    full_rev: str = ""  # Full commit hash if uses_commit
    hash_format: str = "sri"  # "sri" (sha256-...) or "base32" (old format)
    source_type: str = "github"  # github, npm


@dataclass
class OverlaySource:
    """An overlay tree that can be scanned and updated."""

    name: str
    repo_dir: Path
    overlays_dir: Path
    parser: "OverlayParser"
    hash_computer: "HashComputer"


class OverlayParser:
    """Parse Nix overlay files to extract package information."""

    # Overlay files to skip entirely (not auto-updatable)
    SKIP_FILES = {
        '00-last-known-good.nix',  # Packages pinned to specific nixpkgs revisions
    }

    # Package names to skip when using --all (not updatable or special)
    SKIP_PACKAGES = {
        'pythonPackagesExtensions',  # Not a package, extends python packages
        'coqPackages', 'coq',  # References to other packages
        'coqPackages_HEAD', 'coqPackages_9_1', 'coqPackages_9_0',
        'coqPackages_8_20', 'coqPackages_8_19', 'coqPackages_8_18',
        'coqPackages_8_17', 'coqPackages_8_16', 'coqPackages_8_15',
        'coqPackages_8_14', 'coqPackages_8_13', 'coqPackages_8_12',
        'coqPackages_8_11', 'coqPackages_8_10',
        'coq_HEAD', 'coq_9_1', 'coq_9_0', 'coq_8_20', 'coq_8_19',
        'coq_8_18', 'coq_8_17', 'coq_8_16', 'coq_8_15', 'coq_8_14',
        'coq_8_13', 'coq_8_12', 'coq_8_11', 'coq_8_10',
        'ledger_HEAD',  # Local build from source
        'mcp-server-sequential-thinking',  # Override only, no version
        'myEmacsPackageOverrides',  # Function definition, not a package
        'mkEmacsPackages',  # Function definition, not a package
        'paths',  # Local path import, not a package
    }

    def __init__(
        self,
        overlays_dir: Path,
        include_files: tuple[str, ...] | None = None,
    ):
        self.overlays_dir = overlays_dir
        self.include_files = include_files

    def _overlay_files(self) -> list[Path]:
        """Return production overlay files, including the integrated AI subtree."""
        candidates = (
            (self.overlays_dir / relative for relative in self.include_files)
            if self.include_files is not None
            else self.overlays_dir.rglob("*.nix")
        )
        return sorted(
            path
            for path in candidates
            if path.is_file()
            and path.name not in self.SKIP_FILES
            and "tests" not in path.relative_to(self.overlays_dir).parts
        )

    def find_package_owners(self) -> dict[str, list[Path]]:
        """Return every discovered package name with all defining overlay files."""
        owners: dict[str, list[Path]] = {}
        for overlay_file in self._overlay_files():
            for name in self._find_packages_in_file(overlay_file):
                if name not in self.SKIP_PACKAGES:
                    owners.setdefault(name, []).append(overlay_file)
        return owners

    def find_all_packages(self) -> list[str]:
        """Find all package names defined in overlay files."""
        return sorted(self.find_package_owners())

    def _find_packages_in_file(self, file_path: Path) -> list[str]:
        """Find all package names defined in a single overlay file."""
        content = file_path.read_text()
        packages = []

        # Match top-level package definitions: name = ...
        # These are inside the `final: prev: { ... }` block, typically indented 2 spaces
        for line in content.split('\n'):
            # Skip empty lines and comments
            stripped = line.strip()
            if not stripped or stripped.startswith('#') or stripped.startswith('//'):
                continue
            # Match package definitions at top-level (column 0) or standard
            # overlay indentation (2 spaces inside final: prev: { })
            indent = len(line) - len(line.lstrip())
            if indent <= 2:
                match = re.match(r'^([a-zA-Z_][a-zA-Z0-9_-]*)\s*=', stripped)
                if match:
                    name = match.group(1)
                    # Skip 'self', 'super', 'pkgs', 'let', 'in', etc.
                    if name not in ('self', 'super', 'pkgs', 'let', 'in', 'with', 'inherit'):
                        packages.append(name)

        # Also find packages inside rec { } blocks (e.g., Emacs packages)
        # Look for fetchFromGitHub blocks and extract the enclosing package name
        packages.extend(self._find_nested_packages(content))

        return packages

    def _find_nested_packages(self, content: str) -> list[str]:
        """Find packages defined inside rec { } blocks with fetchFromGitHub."""
        packages = []
        lines = content.split('\n')

        # Track if we're inside a rec { } block
        in_rec_block = False
        brace_depth = 0

        for i, line in enumerate(lines):
            stripped = line.strip()

            # Detect rec { or in rec {
            if re.search(r'\brec\s*\{', line):
                in_rec_block = True

            # Count braces to track depth
            brace_depth += line.count('{') - line.count('}')

            if brace_depth <= 0:
                in_rec_block = False

            # Inside rec block, look for package definitions with fetchFromGitHub
            if in_rec_block and line.startswith('    '):  # Must be indented
                # Match: "package-name = compileEmacsFiles {" or similar on the stripped line
                match = re.match(r'^([a-zA-Z_][a-zA-Z0-9_-]*)\s*=\s*(?:compileEmacsFiles|compileEmacsWikiFile|mkDerivation)', stripped)
                if match:
                    name = match.group(1)
                    # Check if this package has fetchFromGitHub within its own block
                    # Track brace depth to stay within the package boundary
                    pkg_depth = lines[i].count('{') - lines[i].count('}')
                    has_fetch = 'fetchFromGitHub' in lines[i]
                    for j in range(i + 1, min(i + 30, len(lines))):
                        if has_fetch:
                            break
                        pkg_line = lines[j]
                        if 'fetchFromGitHub' in pkg_line:
                            has_fetch = True
                            break
                        pkg_depth += pkg_line.count('{') - pkg_line.count('}')
                        if pkg_depth <= 0:
                            break  # Exited this package's block
                    if has_fetch:
                        packages.append(name)

        return packages

    def find_package(self, package_name: str) -> Optional[PackageInfo]:
        """Find a package definition in overlay files."""
        for overlay_file in self._overlay_files():
            result = self._parse_file_for_package(overlay_file, package_name)
            if result:
                return result
        return None

    def _parse_file_for_package(self, file_path: Path, package_name: str) -> Optional[PackageInfo]:
        """Parse a single overlay file for a package definition."""
        content = file_path.read_text()

        # Pattern 1: Standard package definition (name = ... { })
        # Pattern 2: overrideAttrs pattern (name = prev.name.overrideAttrs...)
        # Pattern 3: Nested package (indented, inside rec { } block)

        # First, find the package definition block
        patterns = [
            # Standard: llama-swap = { ... } or llama-swap = with super; { ... }
            # Allow up to 2 spaces for overlay indentation (inside final: prev: { })
            rf'^[ ]{{0,2}}{re.escape(package_name)}\s*=',
            # overrideAttrs: llama-cpp = super.llama-cpp.overrideAttrs
            rf'^[ ]{{0,2}}{re.escape(package_name)}\s*=\s*(?:super|prev|pkgs)\.[a-zA-Z0-9_-]+\.overrideAttrs',
            # Nested (indented): gnus-harvest = compileEmacsFiles {
            rf'^\s+{re.escape(package_name)}\s*=\s*(?:compileEmacsFiles|compileEmacsWikiFile|mkDerivation)',
        ]

        for line_num, line in enumerate(content.split('\n'), 1):
            for pattern in patterns:
                if re.match(pattern, line):
                    return self._extract_package_info(content, file_path, package_name, line_num)

        return None

    def _extract_package_block(self, content: str, package_name: str) -> Optional[str]:
        """Extract just the block of code defining a specific package."""
        lines = content.split('\n')

        # Find the line where the package definition starts
        start_idx = None
        start_indent = 0  # Track the indentation level of the package
        for i, line in enumerate(lines):
            # Match: "package_name =" or "package_name=" (at any indentation)
            match = re.match(rf'^(\s*){re.escape(package_name)}\s*=', line)
            if match:
                start_idx = i
                start_indent = len(match.group(1))
                break

        if start_idx is None:
            return None

        # Find the end by looking for the next definition at same or lower indentation
        block_lines = [lines[start_idx]]

        # Track brace depth to understand nesting
        brace_depth = lines[start_idx].count('{') - lines[start_idx].count('}')

        for i in range(start_idx + 1, len(lines)):
            line = lines[i]

            # Check if we've reached a new definition at same or lower indentation
            # BEFORE updating brace depth, so opening braces on new package
            # definitions don't prevent block termination
            stripped = line.lstrip()
            if stripped:
                current_indent = len(line) - len(stripped)

                # If brace depth is 0 or negative, and we find a new definition
                # at same/lower indent, we're done
                if brace_depth <= 0 and current_indent <= start_indent:
                    if re.match(r'^in(?:\s|$)', stripped):
                        break
                    if re.match(r'^[a-zA-Z_][a-zA-Z0-9_-]*\s*=', stripped):
                        break
                    # Also stop at closing brace at same/lower indent
                    if stripped.startswith('}') and current_indent <= start_indent:
                        break

            # Update brace depth AFTER termination check
            brace_depth += line.count('{') - line.count('}')

            block_lines.append(line)

            # Safety limit
            if len(block_lines) > 500:
                break

        return '\n'.join(block_lines)

    def _extract_package_info(self, content: str, file_path: Path, package_name: str, start_line: int) -> Optional[PackageInfo]:
        """Extract package information from the content."""
        info = PackageInfo(name=package_name, file_path=file_path)

        # Extract just the package block, not the whole file
        block = self._extract_package_block(content, package_name)
        if not block:
            return None

        # Sanity check: a single package definition shouldn't span hundreds of lines.
        # If the block is unreasonably large, it's likely a function/let-binding that
        # contains nested packages, not an actual package definition.
        if len(block.split('\n')) > 200:
            return None

        # Extract GitHub owner/repo or npm package name from the block
        owner_match = re.search(r'owner\s*=\s*"([^"]+)"', block)
        repo_match = re.search(r'repo\s*=\s*"([^"]+)"', block)
        npm_package_match = re.search(r'npmPackage\s*=\s*"([^"]+)"', block)

        if npm_package_match:
            info.source_type = "npm"
            info.npm_package = npm_package_match.group(1)
        elif owner_match and repo_match:
            info.source_type = "github"
            info.owner = owner_match.group(1)
            info.repo = repo_match.group(1)
        else:
            return None

        # Extract version - multiple patterns
        version_patterns = [
            # tag = "v${version}";
            (r'tag\s*=\s*"v\$\{version\}"', "v", False),
            # tag = "b${version}";
            (r'tag\s*=\s*"b\$\{version\}"', "b", False),
            # tag = version;
            (r'tag\s*=\s*version', "", False),
            # tag = "${version}";
            (r'tag\s*=\s*"\$\{version\}"', "", False),
            # rev = "v${version}";
            (r'rev\s*=\s*"v\$\{version\}"', "v", False),
            # rev = "${version}";
            (r'rev\s*=\s*"\$\{version\}"', "", False),
            # version = "123";
            (r'version\s*=\s*"([^"]+)"', "", False),
        ]

        for pattern, prefix, is_commit in version_patterns:
            match = re.search(pattern, block)
            if match:
                info.version_prefix = prefix
                info.uses_commit = is_commit
                break

        # Check for commit-based versioning: rev = "full-40-char-hash"
        # This is when rev is a literal commit hash, not interpolated
        rev_literal_match = re.search(r'rev\s*=\s*"([a-f0-9]{40})"', block)
        if rev_literal_match:
            info.uses_commit = True
            info.full_rev = rev_literal_match.group(1)

        # Now find the actual version value
        version_match = re.search(r'\bversion\s*=\s*"([^"$]+)"', block)
        if version_match:
            info.version = version_match.group(1)
            info.raw_version_pattern = version_match.group(0)

        # Extract source hash (SRI format: sha256-/sha512-... or base32 format)
        sri_match = re.search(r'hash\s*=\s*"(sha(?:256|512)-[^"]+)"', block)
        base32_match = re.search(r'sha256\s*=\s*"([^"]+)"', block)

        if sri_match:
            info.src_hash = sri_match.group(1)
            info.raw_hash_pattern = sri_match.group(0)
            info.hash_format = "sri"
        elif base32_match:
            info.src_hash = base32_match.group(1)
            info.raw_hash_pattern = base32_match.group(0)
            info.hash_format = "base32"

        # Extract ALL hashes found in the block (packages can have multiple)
        # e.g., llama-swap has vendorHash (main) + npmDepsHash (ui subpackage)

        vendor_match = re.search(r'vendorHash\s*=\s*"(sha256-[^"]+)"', block)
        cargo_match = re.search(r'cargoHash\s*=\s*"(sha256-[^"]+)"', block)
        npm_match = re.search(r'npmDepsHash\s*=\s*"(sha256-[^"]+)"', block)

        if vendor_match:
            info.vendor_hash = vendor_match.group(1)
        if cargo_match:
            info.cargo_hash = cargo_match.group(1)
        if npm_match:
            info.npm_deps_hash = npm_match.group(1)

        # Set primary package type for display purposes
        # Priority: vendorHash (Go) > cargoHash (Rust) > npmDepsHash (npm)
        if vendor_match or 'buildGoModule' in block:
            info.package_type = "go"
        elif cargo_match or 'buildRustPackage' in block:
            info.package_type = "rust"
        elif npm_match or 'buildNpmPackage' in block:
            info.package_type = "npm"

        return info


class GitHubClient:
    """Client for GitHub API operations using gh CLI."""

    def get_latest_release(self, owner: str, repo: str) -> Optional[str]:
        """Get the latest GitHub release tag without changing strategy."""
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}/releases/latest"],
                capture_output=True, text=True
            )
            if result.returncode != 0:
                return None
            return json.loads(result.stdout).get("tag_name") or None
        except (OSError, ValueError, json.JSONDecodeError):
            return None

    def get_default_branch(self, owner: str, repo: str) -> Optional[str]:
        """Get the repository's declared default branch."""
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}", "--jq", ".default_branch"],
                capture_output=True, text=True
            )
            return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else None
        except OSError:
            return None

    def get_latest_commit(self, owner: str, repo: str, branch: str) -> Optional[tuple[str, str]]:
        """Get the latest commit SHA from exactly the declared branch."""
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}/commits/{branch}", "--jq", ".sha"],
                capture_output=True, text=True
            )
            if result.returncode != 0 or not result.stdout.strip():
                return None
            full_sha = result.stdout.strip()
            return full_sha, full_sha[:8]
        except OSError:
            return None


class NpmRegistryClient:
    """Client for npm registry metadata using only the Python standard library."""

    def get_version(
        self,
        package_name: str,
        requested_version: Optional[str] = None,
    ) -> Optional[tuple[str, str]]:
        """Return an npm version and tarball integrity hash."""
        encoded = quote(package_name, safe="@")
        url = f"https://registry.npmjs.org/{encoded}"

        try:
            with urlopen(url, timeout=30) as response:
                data = json.load(response)
        except Exception as e:
            print(f"  Error fetching npm metadata: {e}", file=sys.stderr)
            return None

        version = requested_version or data.get("dist-tags", {}).get("latest")
        if not version:
            return None

        version_info = data.get("versions", {}).get(version, {})
        integrity = version_info.get("dist", {}).get("integrity")
        if not integrity:
            return None

        return version, integrity


class PypiClient:
    """Resolve the exact PyPI artifact selected by native fetcher arguments."""

    def get_release(
        self, package_name: str, record: dict, requested_version: Optional[str] = None
    ) -> Optional[tuple[str, str, str]]:
        try:
            with urlopen(f"https://pypi.org/pypi/{quote(package_name, safe='')}/json", timeout=30) as response:
                data = json.load(response)
        except Exception as error:
            print(f"  Error fetching PyPI metadata: {error}", file=sys.stderr)
            return None

        version = requested_version or data.get("info", {}).get("version")
        if not version:
            return None
        source = record["source"]
        args = source["args"]
        old_version = record["version"]
        if source["fetcher"] == "fetchPypi":
            if args.get("format", "setuptools") == "wheel":
                filename = (
                    f"{args['pname']}-{version}-{args.get('python', 'py2.py3')}-"
                    f"{args.get('abi', 'none')}-{args.get('platform', 'any')}.whl"
                )
            else:
                filename = f"{args['pname']}-{version}.{args.get('extension', 'tar.gz')}"
        else:
            current_filename = Path(urlsplit(args["url"]).path).name
            if current_filename.count(old_version) != 1:
                return None
            filename = current_filename.replace(old_version, version, 1)

        artifact = next(
            (item for item in data.get("releases", {}).get(version, []) if item.get("filename") == filename),
            None,
        )
        if artifact is None or not artifact.get("digests", {}).get("sha256"):
            return None
        digest = base64.b64encode(bytes.fromhex(artifact["digests"]["sha256"])).decode()
        return version, artifact["url"], f"sha256-{digest}"


class HashComputer:
    """Compute Nix hashes for various package types."""

    def __init__(self, repo_dir: Path):
        self.repo_dir = repo_dir

    def compute_src_hash(self, owner: str, repo: str, rev: str) -> Optional[str]:
        """Compute source hash using nix-prefetch-github."""
        try:
            result = subprocess.run(
                ["nix", "run", "nixpkgs#nix-prefetch-github", "--",
                 owner, repo, "--rev", rev, "--json"],
                capture_output=True, text=True, timeout=300
            )
            if result.returncode == 0:
                data = json.loads(result.stdout)
                # nix-prefetch-github returns hash in SRI format
                return data.get("hash", data.get("sha256"))
        except Exception as e:
            print(f"  Error computing src hash: {e}", file=sys.stderr)
        return None

    def compute_native_hash(self, source: dict, replacements: dict) -> Optional[str]:
        """Hash through the repository-locked native fetcher with exact arguments."""
        args = copy.deepcopy(source["args"])
        args.update(replacements)
        hash_name = next(iter({"hash", "sha256", "narHash"} & args.keys()))
        old_hash = args[hash_name]
        fetcher = source["fetcher"]

        try:
            if fetcher == "fetchTree":
                args.pop("narHash")
                expression = (
                    f"(builtins.fetchTree (builtins.fromJSON "
                    f"{json.dumps(json.dumps(args))})).narHash"
                )
                result = subprocess.run(
                    ["nix", "eval", "--impure", "--json", "--expr", expression],
                    capture_output=True,
                    text=True,
                    timeout=600,
                    cwd=self.repo_dir,
                )
                if result.returncode == 0:
                    return json.loads(result.stdout)
                return None

            args[hash_name] = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
            expression = f"""
let
  flake = builtins.getFlake (toString {json.dumps(str(self.repo_dir))});
  pkgs = import flake.inputs.nix-config-ai.inputs.nixpkgs {{ system = builtins.currentSystem; }};
  args = builtins.fromJSON {json.dumps(json.dumps(args))};
in
  pkgs.{fetcher} args
"""
            result = subprocess.run(
                ["nix", "build", "--impure", "--no-link", "--expr", expression],
                capture_output=True,
                text=True,
                timeout=600,
                cwd=self.repo_dir,
            )
            match = re.search(r"got:\s+(sha256-[A-Za-z0-9+/=]+)", result.stdout + result.stderr)
            if not match:
                return None
            value = match.group(1)
            if old_hash.startswith("sha256-"):
                return value
            converted = subprocess.run(
                ["nix", "hash", "convert", "--hash-algo", "sha256", "--to", "nix32", value],
                capture_output=True,
                text=True,
                timeout=60,
                cwd=self.repo_dir,
            )
            return converted.stdout.strip() if converted.returncode == 0 else None
        except (OSError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired) as error:
            print(f"  Error computing native source hash: {error}", file=sys.stderr)
            return None

    def compute_vendor_hash(self, package_name: str) -> Optional[str]:
        """Compute vendorHash by attempting a build with fake hash."""
        return self._compute_fod_hash(package_name, "vendorHash")

    def compute_cargo_hash(self, package_name: str) -> Optional[str]:
        """Compute cargoHash by attempting a build with fake hash."""
        return self._compute_fod_hash(package_name, "cargoHash")

    def compute_npm_deps_hash(self, package_name: str) -> Optional[str]:
        """Compute npmDepsHash by attempting a build with fake hash."""
        return self._compute_fod_hash(package_name, "npmDepsHash")

    def _package_build_command(self, package_name: str) -> list[str]:
        build_script = self.repo_dir / "build"
        if build_script.is_file() and os.access(build_script, os.X_OK):
            return ["./build", "pkg", package_name]
        expression = f"""
let
  flake = builtins.getFlake "path:{self.repo_dir}";
  system = builtins.currentSystem;
  pkgs = import flake.inputs.nix-config-ai.inputs.nixpkgs {{
    inherit system;
    overlays = [ flake.overlays.default ];
    config.allowUnfree = true;
  }};
in
  pkgs.{json.dumps(package_name)}
"""
        return ["nix", "build", "--impure", "--no-link", "--expr", expression]

    def _run_package_build(self, package_name: str):
        return subprocess.run(
            self._package_build_command(package_name),
            capture_output=True,
            text=True,
            timeout=600,
            cwd=self.repo_dir,
        )

    @staticmethod
    def _parse_dummy_hash_mismatch(output: str) -> Optional[str]:
        pairs = re.findall(
            r"specified:\s+(sha256-[A-Za-z0-9+/=]+)\s+"
            r"got:\s+(sha256-[A-Za-z0-9+/=]+)",
            output,
        )
        matching = [got for specified, got in pairs if specified == DUMMY_SRI_HASH]
        return matching[0] if len(matching) == 1 else None

    def _compute_fod_hash(self, package_name: str, hash_type: str) -> Optional[str]:
        """Compute a fixed-output derivation hash from our injected mismatch."""
        print(f"  Computing {hash_type} (this may take a while)...")
        try:
            result = self._run_package_build(package_name)
            return self._parse_dummy_hash_mismatch(result.stdout + result.stderr)
        except subprocess.TimeoutExpired:
            print(f"  Timeout computing {hash_type}", file=sys.stderr)
        except Exception as e:
            print(f"  Error computing {hash_type}: {e}", file=sys.stderr)
        return None

    def validate_package_build(self, package_name: str) -> bool:
        try:
            return self._run_package_build(package_name).returncode == 0
        except (OSError, subprocess.TimeoutExpired) as error:
            print(f"  Error validating {package_name}: {error}", file=sys.stderr)
            return False


def make_overlay_sources(args, nix_dir: Path) -> list[OverlaySource]:
    """Create the single integrated overlay tree to update."""
    local_overlays_dir = args.overlays_dir.resolve()
    package_dir = nix_dir / "packages"
    return [
        OverlaySource(
            name="nix",
            repo_dir=nix_dir,
            overlays_dir=local_overlays_dir,
            parser=OverlayParser(local_overlays_dir),
            hash_computer=HashComputer(nix_dir),
        ),
        OverlaySource(
            name="packages",
            repo_dir=nix_dir,
            overlays_dir=package_dir,
            parser=OverlayParser(
                package_dir,
                include_files=(
                    "ai-llm.nix",
                    "ai-mcp.nix",
                    "llm-mlx.nix",
                ),
            ),
            hash_computer=HashComputer(nix_dir),
        ),
    ]


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def _validate_https(name: str, value: object) -> str:
    if not isinstance(value, str) or not value.startswith("https://"):
        raise RuntimeError(f"source catalog URL must use HTTPS: {name}")
    return value


def _same_git_url(left: str, right: str) -> bool:
    def canonical(value: str) -> tuple[str, str]:
        parsed = urlsplit(value)
        return parsed.netloc.lower(), parsed.path.rstrip("/").removesuffix(".git")

    return canonical(left) == canonical(right)


def _normalized_package_name(value: str) -> str:
    return re.sub(r"[-_.]+", "-", value).lower()


def _lock_input_node(lock: dict, input_name: str, catalog_name: str) -> dict:
    nodes = lock.get("nodes")
    root_name = lock.get("root", "root")
    if not isinstance(nodes, dict) or not isinstance(nodes.get(root_name), dict):
        raise RuntimeError("invalid portable flake lock structure")
    reference = nodes[root_name].get("inputs", {}).get(input_name)
    if not isinstance(reference, str) or not isinstance(nodes.get(reference), dict):
        raise RuntimeError(
            f"flake input projection has no selected lock node: {catalog_name} ({input_name})"
        )
    return nodes[reference]


def _flake_input_literal(nix_dir: Path, input_name: str, catalog_name: str) -> dict[str, str]:
    flake_path = nix_dir / "config" / "ai" / "flake.nix"
    if not flake_path.is_file():
        raise RuntimeError(f"flake input projection requires config/ai/flake.nix: {catalog_name}")
    text = flake_path.read_text()
    escaped = re.escape(input_name)
    urls = re.findall(rf'(?m)^\s*{escaped}\.url\s*=\s*"([^"]+)"\s*;', text)
    for match in re.finditer(rf"(?ms)^\s*{escaped}\s*=\s*\{{(.*?)^\s*\}};", text):
        urls.extend(re.findall(r'(?m)^\s*url\s*=\s*"([^"]+)"\s*;', match.group(1)))
    if len(urls) != 1 or not urls[0].startswith("github:"):
        raise RuntimeError(f"flake input projection has no unique github literal: {catalog_name}")
    parts = urls[0].removeprefix("github:").split("/")
    if len(parts) not in {2, 3} or not all(parts):
        raise RuntimeError(f"flake input projection has an invalid github literal: {catalog_name}")
    literal = {"type": "github", "owner": parts[0], "repo": parts[1]}
    if len(parts) == 3:
        literal["rev"] = parts[2]
    return literal


def _validate_flake_projection(
    nix_dir: Path, name: str, record: dict, portable_lock: Optional[dict]
) -> None:
    update = record["update"]
    source = record["source"]
    if source["fetcher"] != "fetchTree" or "input" not in update:
        return
    if portable_lock is None:
        raise RuntimeError(f"flake input projection requires config/ai/flake.lock: {name}")

    node = _lock_input_node(portable_lock, update["input"], name)
    locked = node.get("locked")
    original = node.get("original")
    if not isinstance(locked, dict) or not isinstance(original, dict):
        raise RuntimeError(f"flake input projection has no locked/original source: {name}")

    args = source["args"]
    for field in ("type", "owner", "repo", "rev", "narHash"):
        if args.get(field) != locked.get(field):
            raise RuntimeError(f"flake input projection {name} {field} does not match portable lock")
    for field in ("type", "owner", "repo"):
        if args.get(field) != original.get(field):
            raise RuntimeError(f"flake input projection {name} {field} does not match declared input")
    if "rev" in original and args.get("rev") != original["rev"]:
        raise RuntimeError(f"flake input projection {name} rev does not match declared input")
    literal = _flake_input_literal(nix_dir, update["input"], name)
    for field in ("type", "owner", "repo"):
        if args.get(field) != literal.get(field):
            raise RuntimeError(f"flake input projection {name} {field} does not match flake literal")
    if "rev" in literal and args.get("rev") != literal["rev"]:
        raise RuntimeError(f"flake input projection {name} rev does not match flake literal")


def _validate_fetch_record(name: str, source: dict) -> None:
    if not isinstance(source, dict) or set(source) != {"args", "fetcher", "url"}:
        raise RuntimeError(f"invalid source object for {name}")
    args = source["args"]
    if not isinstance(args, dict):
        raise RuntimeError(f"source catalog record has no fetcher args: {name}")

    fetcher = source["fetcher"]
    required = {
        "fetchFromGitHub": {"owner", "repo"},
        "fetchgit": {"rev"},
        "fetchurl": set(),
        "fetchzip": set(),
        "fetchpatch": set(),
        "fetchPypi": {"pname", "version"},
        "fetchTree": {"owner", "repo", "rev", "type"},
    }
    if fetcher not in required:
        raise RuntimeError(f"unknown source fetcher for {name}: {fetcher}")
    missing = required[fetcher] - args.keys()
    if missing:
        raise RuntimeError(f"invalid source catalog record {name}: missing {sorted(missing)}")

    identity_url = _validate_https(name, source["url"])
    hash_fields = {"hash", "sha256", "narHash"} & args.keys()
    allowed_hashes = {"narHash"} if fetcher == "fetchTree" else {"hash", "sha256"}
    if len(hash_fields) != 1 or not hash_fields <= allowed_hashes:
        raise RuntimeError(f"source catalog record must have exactly one native hash: {name}")
    hash_value = args[next(iter(hash_fields))]
    if not isinstance(hash_value, str) or not hash_value:
        raise RuntimeError(f"invalid source hash for {name}")

    if fetcher == "fetchFromGitHub":
        refs = {"rev", "tag"} & args.keys()
        if len(refs) != 1:
            raise RuntimeError(f"fetchFromGitHub record must have exactly one rev or tag: {name}")
        expected = f"https://github.com/{args['owner']}/{args['repo']}"
        if not _same_git_url(identity_url, expected):
            raise RuntimeError(f"GitHub identity does not match fetcher args: {name}")
    elif fetcher == "fetchTree":
        if args["type"] != "github":
            raise RuntimeError(f"unsupported fetchTree type for {name}: {args['type']}")
        expected = f"https://github.com/{args['owner']}/{args['repo']}"
        if not _same_git_url(identity_url, expected):
            raise RuntimeError(f"GitHub identity does not match fetcher args: {name}")
    elif fetcher == "fetchPypi":
        parsed = urlsplit(identity_url)
        parts = [part for part in parsed.path.split("/") if part]
        if (
            parsed.netloc.lower() != "pypi.org"
            or len(parts) != 2
            or parts[0] != "project"
            or _normalized_package_name(parts[1]) != _normalized_package_name(args["pname"])
        ):
            raise RuntimeError(f"PyPI identity does not match fetcher args: {name}")
    elif fetcher in {"fetchgit", "fetchurl", "fetchzip", "fetchpatch"}:
        locators = {"url", "urls"} & args.keys()
        if len(locators) != 1:
            raise RuntimeError(f"source catalog record must have exactly one url or urls: {name}")
        values = [args["url"]] if "url" in args else args["urls"]
        if not isinstance(values, list) or not values:
            raise RuntimeError(f"invalid source URLs for {name}")
        actual_urls = [_validate_https(name, value) for value in values]
        matches = (
            any(_same_git_url(identity_url, value) for value in actual_urls)
            if fetcher == "fetchgit"
            else identity_url in actual_urls
        )
        if not matches:
            raise RuntimeError(f"source identity does not match fetcher args: {name}")


def _catalog_executor(record: dict) -> Optional[str]:
    update = record["update"]
    if update["kind"] in {
        "fixed-flake-input",
        "flake-input",
        "flake-input+build",
        "flake-input+copy",
    }:
        return "update-agents"
    expected_fetchers = {
        "explicit-rev": {"fetchgit", "fetchpatch", "fetchTree", "fetchurl"},
        "github-commit": {"fetchFromGitHub"},
        "github-release": {"fetchFromGitHub"},
        "npm-release": {"fetchurl", "fetchzip"},
        "pypi-release": {"fetchPypi", "fetchurl"},
        "url-release": {"fetchurl"},
    }.get(update["kind"], set())
    if (
        record["source"]["fetcher"] in expected_fetchers
        and not update.get("artifacts")
        and not record.get("artifacts")
        and set(record.get("hashes", {})) <= {"cargoHash", "npmDepsHash", "vendorHash"}
    ):
        return "update-overlay"
    return None


def load_source_catalog(nix_dir: Path) -> dict[str, dict]:
    """Load data-only package source records from sources/*.json."""
    catalog_dir = nix_dir / "sources"
    targets = {}
    allowed = {
        "artifacts", "commit", "date", "hashes", "source", "update", "version",
    }
    common_update_fields = {"artifacts", "kind", "policy", "reason"}
    update_schema = {
        "explicit-rev": (common_update_fields | {"branch"}, set()),
        "fixed-flake-input": (common_update_fields | {"input"}, {"input"}),
        "flake-input": (common_update_fields | {"input"}, {"input"}),
        "flake-input+build": (
            common_update_fields | {"buildPackage", "input"},
            {"buildPackage", "input"},
        ),
        "flake-input+copy": (common_update_fields | {"input"}, {"input"}),
        "github-commit": (common_update_fields | {"branch"}, {"branch"}),
        "github-release": (common_update_fields | {"tagPrefix"}, set()),
        "github-release-asset": (common_update_fields | {"tagPrefix"}, set()),
        "npm-release": (common_update_fields | {"package"}, {"package"}),
        "npm-release+flake-input": (
            common_update_fields | {"input", "package"},
            {"input", "package"},
        ),
        "pypi-release": (common_update_fields | {"package"}, {"package"}),
        "url-release": (common_update_fields, set()),
    }
    portable_lock_path = nix_dir / "config" / "ai" / "flake.lock"
    portable_lock = None
    for path in sorted(catalog_dir.glob("*.json")):
        payload = json.loads(path.read_text(), object_pairs_hook=_unique_object)
        if set(payload) != {"schemaVersion", "sources"}:
            raise RuntimeError(f"invalid source catalog document fields: {path}")
        if payload.get("schemaVersion") != 1 or not isinstance(payload.get("sources"), dict):
            raise RuntimeError(f"invalid source catalog schema: {path}")
        for name, record in payload["sources"].items():
            if name in targets:
                raise RuntimeError(f"duplicate source catalog id: {name}")
            unknown = record.keys() - allowed
            if unknown:
                raise RuntimeError(f"unknown source catalog fields for {name}: {sorted(unknown)}")
            for field in ("version", "date", "commit"):
                if field in record and (not isinstance(record[field], str) or not record[field]):
                    raise RuntimeError(f"invalid source catalog {field}: {name}")
            _validate_fetch_record(name, record.get("source"))
            artifacts = record.get("artifacts", {})
            if not isinstance(artifacts, dict):
                raise RuntimeError(f"invalid source artifacts for source catalog record: {name}")
            for artifact, fetch in artifacts.items():
                _validate_fetch_record(f"{name}.{artifact}", fetch)
            hashes = record.get("hashes", {})
            if not isinstance(hashes, dict) or not all(isinstance(value, str) and value for value in hashes.values()):
                raise RuntimeError(f"invalid dependent hashes for source catalog record: {name}")
            update = record.get("update")
            if not isinstance(update, dict) or update.get("kind") not in update_schema:
                raise RuntimeError(f"invalid update strategy for source catalog record: {name}")
            update_allowed, update_required = update_schema[update["kind"]]
            if update.keys() - update_allowed or update_required - update.keys():
                raise RuntimeError(f"invalid update strategy fields for source catalog record: {name}")
            if update.get("policy", "automatic") not in {"automatic", "manual"}:
                raise RuntimeError(f"invalid update policy for source catalog record: {name}")
            if "reason" in update and (not isinstance(update["reason"], str) or not update["reason"]):
                raise RuntimeError(f"invalid update reason for source catalog record: {name}")
            kind = update["kind"]
            if kind == "flake-input+build" and (
                not isinstance(update["buildPackage"], str)
                or not update["buildPackage"]
                or not hashes
            ):
                raise RuntimeError(
                    f"invalid flake input build strategy for source catalog record: {name}"
                )
            source_args = record["source"]["args"]
            source_fetcher = record["source"]["fetcher"]
            if source_fetcher == "fetchTree" and "input" in update and portable_lock is None:
                if not portable_lock_path.is_file():
                    raise RuntimeError(f"flake input projection requires config/ai/flake.lock: {name}")
                portable_lock = json.loads(portable_lock_path.read_text())
            _validate_flake_projection(nix_dir, name, record, portable_lock)
            if source_fetcher == "fetchPypi" and record.get("version") != source_args["version"]:
                raise RuntimeError(f"PyPI source version does not match catalog version: {name}")
            if kind == "github-commit" and (
                source_fetcher != "fetchFromGitHub"
                or "rev" not in source_args
                or "tag" in source_args
            ):
                raise RuntimeError(f"github-commit requires a native rev field: {name}")
            if kind == "npm-release":
                package = update["package"]
                if (
                    source_fetcher not in {"fetchurl", "fetchzip"}
                    or f"/{package}/-/" not in source_args["url"]
                ):
                    raise RuntimeError(f"npm source identity does not match update package: {name}")
            if kind == "pypi-release" and source_fetcher == "fetchPypi":
                if _normalized_package_name(source_args["pname"]) != _normalized_package_name(
                    update["package"]
                ):
                    raise RuntimeError(f"PyPI source identity does not match update package: {name}")
            update_artifacts = update.get("artifacts", [])
            if (
                not isinstance(update_artifacts, list)
                or not all(isinstance(value, str) and value for value in update_artifacts)
            ):
                raise RuntimeError(f"invalid update artifacts for source catalog record: {name}")
            catalog_root = nix_dir.resolve()
            invalid_artifacts = [
                value for value in update_artifacts
                if Path(value).is_absolute()
                or not (nix_dir / value).resolve().is_relative_to(catalog_root)
            ]
            if invalid_artifacts:
                raise RuntimeError(
                    f"source catalog record {name} references unsafe artifacts: {invalid_artifacts}"
                )
            missing_artifacts = [value for value in update_artifacts if not (nix_dir / value).is_file()]
            if missing_artifacts:
                raise RuntimeError(f"source catalog record {name} references missing artifacts: {missing_artifacts}")
            targets[name] = {
                "kind": update["kind"],
                "version": record.get("version", record["source"]["args"].get("rev", record["source"]["args"].get("tag", "unversioned"))),
                "files": [str(path.relative_to(nix_dir)), *update_artifacts],
                "source": "catalog",
                "executor": _catalog_executor(record),
                "_document": payload,
                "_path": path,
                "_record": record,
            }
    return targets


def resolve_flake_input_version(
    nix_dir: Path, input_name: str, locked: dict, runner=subprocess.run
) -> str:
    fetch_args = {
        field: locked[field]
        for field in ("type", "owner", "repo", "rev", "narHash")
    }
    expression = f"""
let
  input = builtins.fetchTree (builtins.fromJSON {json.dumps(json.dumps(fetch_args))});
  package = builtins.fromJSON (builtins.readFile (input.outPath + "/package.json"));
in
  package.version
"""
    result = runner(
        ["nix", "eval", "--impure", "--raw", "--expr", expression],
        capture_output=True,
        text=True,
        timeout=600,
        cwd=nix_dir,
    )
    version = result.stdout.strip()
    if result.returncode != 0 or not version:
        raise RuntimeError(f"failed to resolve flake input package version: {input_name}")
    return version


def resolve_flake_input_dependent_hash(
    nix_dir: Path, package_name: str, hash_type: str
) -> str:
    value = HashComputer(nix_dir)._compute_fod_hash(package_name, hash_type)
    if not value:
        raise RuntimeError(
            f"failed to resolve flake input dependent hash: {package_name}.{hash_type}"
        )
    return value


def validate_flake_input_build(nix_dir: Path, package_name: str) -> None:
    if not HashComputer(nix_dir).validate_package_build(package_name):
        raise RuntimeError(f"flake input package validation failed: {package_name}")


def sync_flake_projections(
    nix_dir: Path,
    version_resolver=resolve_flake_input_version,
    dependent_hash_resolver=resolve_flake_input_dependent_hash,
    build_validator=validate_flake_input_build,
) -> int:
    """Refresh catalog fetchTree projections from the selected portable lock nodes."""
    lock_path = nix_dir / "config" / "ai" / "flake.lock"
    if not lock_path.is_file():
        raise RuntimeError("flake projection sync requires config/ai/flake.lock")
    portable_lock = json.loads(lock_path.read_text())
    changed_records = 0
    for path in sorted((nix_dir / "sources").glob("*.json")):
        payload = json.loads(path.read_text(), object_pairs_hook=_unique_object)
        changed_document = False
        for name, record in payload.get("sources", {}).items():
            source = record.get("source", {})
            update = record.get("update", {})
            if source.get("fetcher") != "fetchTree" or not isinstance(update.get("input"), str):
                continue
            node = _lock_input_node(portable_lock, update["input"], name)
            locked = node.get("locked")
            if not isinstance(locked, dict):
                raise RuntimeError(f"flake input projection has no locked source: {name}")
            args = source.get("args")
            if not isinstance(args, dict):
                raise RuntimeError(f"flake input projection has no fetchTree args: {name}")
            projected = {
                **args,
                **{field: locked[field] for field in ("type", "owner", "repo", "rev", "narHash")},
            }
            projected_url = f"https://github.com/{locked['owner']}/{locked['repo']}"
            record_changed = False
            if projected != args or source.get("url") != projected_url:
                source["args"] = projected
                source["url"] = projected_url
                record_changed = True
            if update["kind"] in {"flake-input+build", "flake-input+copy"}:
                projected_version = version_resolver(
                    nix_dir, update["input"], locked
                )
                if record.get("version") != projected_version:
                    record["version"] = projected_version
                    record_changed = True
            if update["kind"] == "flake-input+build" and record_changed:
                dependent_hashes = record.get("hashes", {})
                if not dependent_hashes:
                    raise RuntimeError(
                        f"flake input build has no dependent hashes: {name}"
                    )
                for hash_type in dependent_hashes:
                    dependent_hashes[hash_type] = DUMMY_SRI_HASH
                    path.write_text(json.dumps(payload, indent=2) + "\n")
                    dependent_hashes[hash_type] = dependent_hash_resolver(
                        nix_dir, update["buildPackage"], hash_type
                    )
                path.write_text(json.dumps(payload, indent=2) + "\n")
                build_validator(nix_dir, update["buildPackage"])
            if record_changed:
                changed_document = True
                changed_records += 1
        if changed_document:
            path.write_text(json.dumps(payload, indent=2) + "\n")
    load_source_catalog(nix_dir)
    return changed_records


def require_detached_linked_worktree(nix_dir: Path) -> None:
    """Refuse projection writes in the primary or any branch-attached worktree."""
    dotgit = nix_dir / ".git"
    if not dotgit.is_file():
        raise RuntimeError("projection sync requires a detached linked worktree")
    pointer = dotgit.read_text().strip()
    if not pointer.startswith("gitdir:"):
        raise RuntimeError("projection sync requires a detached linked worktree")
    git_dir = Path(pointer.removeprefix("gitdir:").strip())
    if not git_dir.is_absolute():
        git_dir = (nix_dir / git_dir).resolve()
    if not git_dir.is_dir() or not (git_dir / "commondir").is_file():
        raise RuntimeError("projection sync requires a detached linked worktree")
    head_path = git_dir / "HEAD"
    if not head_path.is_file() or head_path.read_text().strip().startswith("ref:"):
        raise RuntimeError("projection sync requires a detached linked worktree")


def load_update_manifest(nix_dir: Path) -> dict[str, dict]:
    """Evaluate and validate explicit update targets outside ordinary overlays."""
    manifest_path = nix_dir / "packages" / "update-manifest.nix"
    result = subprocess.run(
        ["nix", "eval", "--json", "--file", str(manifest_path)],
        capture_output=True,
        text=True,
        timeout=60,
    )
    if result.returncode != 0:
        raise RuntimeError(f"failed to evaluate {manifest_path}: {result.stderr.strip()}")
    payload = json.loads(result.stdout)
    if payload.get("schemaVersion") != 1 or not isinstance(payload.get("targets"), dict):
        raise RuntimeError(f"invalid update manifest schema: {manifest_path}")
    for name, target in payload["targets"].items():
        if not isinstance(target, dict) or not target.get("kind") or not target.get("files"):
            raise RuntimeError(f"invalid update target: {name}")
        missing = [path for path in target["files"] if not (nix_dir / path).is_file()]
        if missing:
            raise RuntimeError(f"update target {name} references missing files: {missing}")
    return payload["targets"]


def build_inventory(
    sources: list[OverlaySource], explicit_targets: dict[str, dict], nix_dir: Path
) -> dict:
    """Return every supported update target and separately list non-package attrs."""
    packages = []
    unsupported = []
    seen = set()
    catalog_names = {
        name for name, target in explicit_targets.items() if target.get("source") == "catalog"
    }
    for source in sources:
        for name, owner_files in source.parser.find_package_owners().items():
            if name in catalog_names:
                continue
            definitions = [
                info for path in owner_files
                if (info := source.parser._parse_file_for_package(path, name)) is not None
            ]
            if len(definitions) > 1:
                owners = [str(info.file_path.relative_to(nix_dir)) for info in definitions]
                raise RuntimeError(f"duplicate overlay owners for {name}: {owners}")
            if not definitions:
                unsupported.append(f"{source.name}/{name}")
                continue
            info = definitions[0]
            if name in seen:
                raise RuntimeError(f"duplicate update target: {name}")
            seen.add(name)
            packages.append({
                "name": name,
                "source": source.name,
                "kind": f"overlay-{info.source_type}",
                "version": info.version,
                "files": [str(info.file_path.relative_to(nix_dir))],
                "inventoried": True,
                "managed": True,
                "executor": "update-overlay",
            })
    for name, target in explicit_targets.items():
        if name in seen:
            raise RuntimeError(f"duplicate manifest/overlay update target: {name}")
        seen.add(name)
        executor = target.get("executor")
        package = {
            "name": name,
            "source": target.get("source", "manifest"),
            "kind": target["kind"],
            "version": target.get("version", target.get("rev", "")),
            "files": target["files"],
            "inventoried": True,
            "managed": executor is not None,
            "executor": executor,
        }
        if target.get("source") == "catalog":
            update = target["_record"]["update"]
            package["policy"] = update.get("policy", "automatic")
            if "input" in update:
                package["input"] = update["input"]
        packages.append(package)
    return {
        "schemaVersion": 1,
        "packages": sorted(packages, key=lambda item: item["name"]),
        "unsupportedOverlayAttributes": sorted(unsupported),
    }


def print_inventory(inventory: dict, json_output: bool) -> None:
    if json_output:
        print(json.dumps(inventory, indent=2, sort_keys=True))
        return
    for package in inventory["packages"]:
        print(f"{package['name']}\t{package['kind']}\t{package['version']}")
    managed = sum(package["managed"] for package in inventory["packages"])
    pending = len(inventory["packages"]) - managed
    print(
        f"{len(inventory['packages'])} inventoried targets; {managed} executable; "
        f"{pending} pending executors; "
        f"{len(inventory['unsupportedOverlayAttributes'])} non-package overlay attributes"
    )


def collect_targets(
    args, sources: list[OverlaySource], skip_names: set[str] | None = None
) -> list[tuple[OverlaySource, str]]:
    """Collect package update targets across all configured overlay trees."""
    skip_names = skip_names or set()
    targets: list[tuple[OverlaySource, str]] = []

    if args.all:
        total = 0
        for source in sources:
            packages = [p for p in source.parser.find_all_packages() if p not in skip_names]
            if args.packages:
                packages = [p for p in packages if p in args.packages]
            total += len(packages)
            print(f"Found {len(packages)} packages in {source.name} overlay files")
            targets.extend((source, package) for package in packages)
        print(f"Found {total} packages across {len(sources)} overlay trees")
        return targets

    for package in args.packages:
        if package in skip_names:
            continue
        matches = [
            source for source in sources
            if source.parser.find_package(package) is not None
        ]
        if matches:
            targets.extend((source, package) for source in matches)
        else:
            targets.append((sources[0], package))

    return targets


def delegate_to_update_agents(nix_dir: Path, names: list[str], args, runner=subprocess.run) -> int:
    command = [str(Path(__file__).with_name("update-agents"))]
    for name in names:
        command.extend(["--target", name])
    if args.version:
        command.extend(["--version", args.version])
    if args.dry_run:
        command.append("--dry-run")
    environment = {**os.environ, "NIX_CONFIG_DIR": str(nix_dir)}
    result = runner(command, cwd=nix_dir, env=environment, check=False)
    return result.returncode


class SourceTransaction:
    """Restore every watched source file unless the invocation commits."""

    def __init__(self) -> None:
        self.original: dict[Path, str] = {}
        self.committed = False

    def watch(self, path: Path) -> None:
        self.original.setdefault(path, path.read_text())

    def rollback(self) -> int:
        restored = 0
        for path, content in self.original.items():
            if path.read_text() != content:
                path.write_text(content)
                restored += 1
        self.committed = True
        return restored

    def commit(self) -> None:
        self.committed = True

    def rollback_unless_committed(self) -> None:
        if not self.committed:
            self.rollback()


def _write_catalog_target(target: dict) -> None:
    target["_path"].write_text(json.dumps(target["_document"], indent=2) + "\n")


def _rewrite_fixed_flake_input(target: dict, old_rev: str, new_rev: str) -> Path:
    record = target["_record"]
    source_args = record["source"]["args"]
    flake_path = target["_path"].parent.parent / "config" / "ai" / "flake.nix"
    old_url = f"github:{source_args['owner']}/{source_args['repo']}/{old_rev}"
    new_url = f"github:{source_args['owner']}/{source_args['repo']}/{new_rev}"
    text = flake_path.read_text()
    if text.count(old_url) != 1:
        raise RuntimeError(
            f"fixed flake input {record['update']['input']} has no unique literal revision"
        )
    flake_path.write_text(text.replace(old_url, new_url, 1))
    return flake_path


def update_catalog_target(
    name: str,
    target: dict,
    args,
    github_client: GitHubClient,
    npm_client: NpmRegistryClient,
    pypi_client: PypiClient,
    hash_computer: HashComputer,
    transaction,
 ) -> str:
    record = target["_record"]
    source = record["source"]
    source_args = source["args"]
    update = record["update"]
    kind = update["kind"]
    old_version = record.get(
        "version", source_args.get("rev", source_args.get("tag", "unversioned"))
    )
    hash_name = next(iter({"hash", "sha256", "narHash"} & source_args.keys()))
    old_hash = source_args[hash_name]
    current_ref = source_args.get("tag", source_args.get("rev"))
    current_url = source_args.get("url")
    new_ref = None
    new_version = None
    new_hash = None
    new_url = None

    display = f"{Colors.BOLD}catalog/{name}{Colors.RESET} {Colors.DIM}{old_version}{Colors.RESET}"
    print(display, end=" ")

    if kind == "fixed-flake-input":
        if args.version:
            new_ref = args.version
        else:
            branch = github_client.get_default_branch(
                source_args["owner"], source_args["repo"]
            )
            candidate = (
                github_client.get_latest_commit(
                    source_args["owner"], source_args["repo"], branch
                )
                if branch
                else None
            )
            if candidate:
                new_ref = candidate[0]
        if new_ref:
            new_version = new_ref
    elif kind == "npm-release":
        candidate = npm_client.get_version(update["package"], args.version)
        if candidate:
            new_version, _registry_integrity = candidate
            if old_version and current_url and current_url.count(old_version) == 1:
                new_url = current_url.replace(old_version, new_version, 1)
    elif kind == "pypi-release":
        candidate = pypi_client.get_release(update["package"], record, args.version)
        if candidate:
            new_version, artifact_url, new_hash = candidate
            new_url = artifact_url if source["fetcher"] == "fetchurl" else None
            new_ref = new_version
    elif kind == "github-commit":
        if args.version:
            new_ref = args.version
        else:
            candidate = github_client.get_latest_commit(
                source_args["owner"], source_args["repo"], update["branch"]
            )
            if candidate:
                new_ref = candidate[0]
        if new_ref:
            current_version = record.get("version")
            new_version = (
                new_ref[: len(current_version)]
                if current_version and current_ref.startswith(current_version)
                else current_version or new_ref
            )
    elif kind == "github-release":
        prefix = update.get("tagPrefix")
        if prefix is None:
            prefix = (
                current_ref[: -len(old_version)]
                if old_version and current_ref and current_ref.endswith(old_version)
                else ""
            )
        if args.version:
            new_ref = args.version if args.version.startswith(prefix) else f"{prefix}{args.version}"
        else:
            new_ref = github_client.get_latest_release(source_args["owner"], source_args["repo"])
        if new_ref:
            new_version = extract_version_number(new_ref, prefix)
    elif kind == "explicit-rev":
        if not args.version:
            print(f"{Colors.RED}✗ explicit --version required{Colors.RESET}")
            return "failed"
        if current_ref:
            prefix = (
                current_ref[: -len(old_version)]
                if old_version and current_ref.endswith(old_version)
                else ""
            )
            new_ref = args.version if args.version.startswith(prefix) else f"{prefix}{args.version}"
            new_version = extract_version_number(new_ref, prefix) if prefix else args.version
        elif current_url:
            match = re.search(r"[0-9a-fA-F]{40}", current_url)
            if match is None:
                print(f"{Colors.RED}✗ URL has no replaceable revision{Colors.RESET}")
                return "failed"
            new_ref = args.version
            new_version = record.get("version", new_ref)
            new_url = current_url.replace(match.group(0), new_ref, 1)
    elif kind == "url-release":
        new_version = args.version or old_version
        if args.version:
            if not record.get("version") or current_url.count(old_version) != 1:
                print(f"{Colors.RED}✗ URL has no unique version coordinate{Colors.RESET}")
                return "failed"
            new_url = current_url.replace(old_version, args.version, 1)
        else:
            new_url = current_url

    if new_version is None:
        print(f"{Colors.RED}✗ fetch failed{Colors.RESET}")
        return "failed"
    if kind == "npm-release" and new_url is None:
        print(f"{Colors.RED}✗ URL rewrite failed{Colors.RESET}")
        return "failed"

    replacements = {}
    if new_ref and current_ref:
        replacements["tag" if "tag" in source_args else "rev"] = new_ref
    if new_url is not None:
        replacements["url"] = new_url
    if kind != "pypi-release":
        new_hash = hash_computer.compute_native_hash(source, replacements)
    if not new_hash:
        print(f"{Colors.RED}✗ hash failed{Colors.RESET}")
        return "failed"

    same_location = (new_ref is None or new_ref == current_ref) and (
        new_url is None or new_url == current_url
    )
    if new_version == old_version and same_location and new_hash == old_hash:
        print(f"{Colors.GREEN}✓ up-to-date{Colors.RESET}")
        return "skipped"

    print(f"{Colors.YELLOW}→ {new_version}{Colors.RESET}", end="")
    if args.dry_run:
        print(f" {Colors.CYAN}(dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    if kind == "fixed-flake-input":
        flake_path = target["_path"].parent.parent / "config" / "ai" / "flake.nix"
        transaction.watch(flake_path)
    if "version" in record:
        record["version"] = new_version
    source_args[hash_name] = new_hash
    if new_url is not None:
        source_args["url"] = new_url
        source["url"] = new_url
    if kind == "pypi-release" and source["fetcher"] == "fetchPypi":
        source_args["version"] = new_version
    if new_ref and current_ref:
        source_args["tag" if "tag" in source_args else "rev"] = new_ref
    if kind == "fixed-flake-input":
        _rewrite_fixed_flake_input(target, current_ref, new_ref)
    if kind == "explicit-rev" and "commit" in record:
        resolved = subprocess.run(
            ["git", "ls-remote", source["url"], new_ref, f"{new_ref}^{{}}"],
            capture_output=True,
            text=True,
            timeout=60,
        )
        commits = [line.split()[0] for line in resolved.stdout.splitlines() if line.split()]
        if resolved.returncode != 0 or not commits:
            print(f" {Colors.RED}✗ commit resolution failed{Colors.RESET}")
            return "failed"
        record["commit"] = commits[-1]
    _write_catalog_target(target)

    computed = []
    for hash_type, old_dependent_hash in record.get("hashes", {}).items():
        record["hashes"][hash_type] = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
        _write_catalog_target(target)
        new_dependent_hash = hash_computer._compute_fod_hash(name, hash_type)
        if not new_dependent_hash:
            record["hashes"][hash_type] = old_dependent_hash
            _write_catalog_target(target)
            print(f" {Colors.RED}✗ {hash_type} failed{Colors.RESET}")
            return "failed"
        record["hashes"][hash_type] = new_dependent_hash
        computed.append(hash_type)
    _write_catalog_target(target)
    suffix = f" +{','.join(computed)}" if computed else ""
    print(f" {Colors.GREEN}✓{Colors.RESET}{suffix}")
    return "updated"


class OverlayUpdater:
    """Update overlay files with new versions and hashes."""

    def set_dummy_hash(self, file_path: Path, package_name: str, hash_type: str, old_hash: str) -> bool:
        """Set a dummy hash for a specific package to trigger hash computation on build."""
        content = file_path.read_text()
        lines = content.split('\n')

        start_idx, end_idx = self._find_package_block_lines(content, package_name)
        if start_idx < 0:
            return False

        # Extract and update the block
        block_lines = lines[start_idx:end_idx + 1]
        block = '\n'.join(block_lines)

        # Map hash type to pattern
        patterns = {
            'vendorHash': rf'(vendorHash\s*=\s*")({re.escape(old_hash)})(")',
            'cargoHash': rf'(cargoHash\s*=\s*")({re.escape(old_hash)})(")',
            'npmDepsHash': rf'(npmDepsHash\s*=\s*")({re.escape(old_hash)})(")',
        }

        pattern = patterns.get(hash_type)
        if not pattern:
            return False

        dummy_hash = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
        new_block = re.sub(pattern, rf'\g<1>{dummy_hash}\g<3>', block)

        if new_block == block:
            return False

        # Reconstruct file
        new_lines = lines[:start_idx] + new_block.split('\n') + lines[end_idx + 1:]
        file_path.write_text('\n'.join(new_lines))
        return True

    def _find_package_block_lines(self, content: str, package_name: str) -> tuple[int, int]:
        """Find the start and end line indices for a package block."""
        lines = content.split('\n')

        # Find start (at any indentation level)
        start_idx = None
        start_indent = 0
        for i, line in enumerate(lines):
            match = re.match(rf'^(\s*){re.escape(package_name)}\s*=', line)
            if match:
                start_idx = i
                start_indent = len(match.group(1))
                break

        if start_idx is None:
            return (-1, -1)

        # Find end by tracking brace depth
        end_idx = start_idx
        brace_depth = lines[start_idx].count('{') - lines[start_idx].count('}')

        for i in range(start_idx + 1, len(lines)):
            line = lines[i]

            # Check termination BEFORE updating brace depth, so opening braces
            # on new package definitions don't prevent block termination
            stripped = line.lstrip()
            if stripped:
                current_indent = len(line) - len(stripped)

                # If brace depth is 0 or negative, and we find a new definition
                # at same/lower indent, we're done
                if brace_depth <= 0 and current_indent <= start_indent:
                    if re.match(r'^in(?:\s|$)', stripped):
                        end_idx = i - 1
                        break
                    if re.match(r'^[a-zA-Z_][a-zA-Z0-9_-]*\s*=', stripped):
                        end_idx = i - 1
                        break
                    if stripped.startswith('}') and current_indent <= start_indent:
                        end_idx = i - 1
                        break

            brace_depth += line.count('{') - line.count('}')
            end_idx = i

        return (start_idx, end_idx)

    def update_package(self, info: PackageInfo, new_version: str, new_src_hash: str,
                      new_vendor_hash: Optional[str] = None,
                      new_cargo_hash: Optional[str] = None,
                      new_npm_deps_hash: Optional[str] = None,
                      new_full_rev: Optional[str] = None,
                      dry_run: bool = False) -> bool:
        """Update a package in its overlay file."""
        content = info.file_path.read_text()
        lines = content.split('\n')

        # Find the package block boundaries
        start_idx, end_idx = self._find_package_block_lines(content, info.name)
        if start_idx < 0:
            print(f"  Could not find package block for {info.name}")
            return False

        # Extract the block
        block_lines = lines[start_idx:end_idx + 1]
        block = '\n'.join(block_lines)
        original_block = block

        # Update version within the block
        old_version = info.version
        block = re.sub(
            rf'(\bversion\s*=\s*")({re.escape(old_version)})(")',
            rf'\g<1>{new_version}\g<3>',
            block
        )

        # For commit-based packages, also update the rev
        if info.uses_commit and new_full_rev and info.full_rev:
            block = re.sub(
                rf'(rev\s*=\s*")({re.escape(info.full_rev)})(")',
                rf'\g<1>{new_full_rev}\g<3>',
                block
            )

        # Update source hash within the block
        if new_src_hash and info.src_hash:
            if info.hash_format == "sri":
                block = re.sub(
                    rf'(hash\s*=\s*")({re.escape(info.src_hash)})(")',
                    rf'\g<1>{new_src_hash}\g<3>',
                    block
                )
            else:
                # base32 format - update sha256 = "..."
                block = re.sub(
                    rf'(sha256\s*=\s*")({re.escape(info.src_hash)})(")',
                    rf'\g<1>{new_src_hash}\g<3>',
                    block
                )

        # Update vendorHash if present
        if new_vendor_hash and info.vendor_hash:
            block = re.sub(
                rf'(vendorHash\s*=\s*")({re.escape(info.vendor_hash)})(")',
                rf'\g<1>{new_vendor_hash}\g<3>',
                block
            )

        # Update cargoHash if present
        if new_cargo_hash and info.cargo_hash:
            block = re.sub(
                rf'(cargoHash\s*=\s*")({re.escape(info.cargo_hash)})(")',
                rf'\g<1>{new_cargo_hash}\g<3>',
                block
            )

        # Update npmDepsHash if present
        if new_npm_deps_hash and info.npm_deps_hash:
            block = re.sub(
                rf'(npmDepsHash\s*=\s*")({re.escape(info.npm_deps_hash)})(")',
                rf'\g<1>{new_npm_deps_hash}\g<3>',
                block
            )

        if block == original_block:
            return False

        if dry_run:
            return True

        # Reconstruct the file with the updated block
        new_lines = lines[:start_idx] + block.split('\n') + lines[end_idx + 1:]
        new_content = '\n'.join(new_lines)

        # Write the updated content
        info.file_path.write_text(new_content)
        return True


def extract_version_number(tag: str, prefix: str = "") -> str:
    """Extract a version number using the declared prefix exactly."""
    if prefix and tag.startswith(prefix):
        return tag[len(prefix):]

    for candidate in ("v", "b", "release-", "version-"):
        if tag.startswith(candidate):
            return tag[len(candidate):]
    return tag


def main():
    parser = argparse.ArgumentParser(
        description="Update Nix overlay package definitions to their latest versions",
        epilog="""
Examples:
  update-overlay llama-cpp gguf-tools    Update to latest release/commit
  update-overlay --dry-run llama-swap    Preview changes without modifying
  update-overlay --no-build hfdownloader Skip slow hash computation (src only)
  update-overlay -V 1.2.3 browser-control-mcp  Force specific version
  update-overlay --all --dry-run         Preview updates for all packages
  update-overlay --all --no-build        Update all packages (src hash only)
""",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "packages", nargs="*",
        help="Package names to update (not required if --all is used)"
    )
    parser.add_argument(
        "--all", "-a", action="store_true",
        help="Update all packages found in overlay files"
    )
    parser.add_argument(
        "--dry-run", "-n", action="store_true",
        help="Show what would be changed without making changes"
    )
    parser.add_argument(
        "--overlays-dir", "-d", type=Path,
        default=Path(__file__).parent.parent / "overlays",
        help="Directory containing overlay files"
    )
    parser.add_argument(
        "--no-build", action="store_true",
        help="Skip computing vendorHash/cargoHash/npmDepsHash (faster but incomplete)"
    )
    parser.add_argument(
        "--version", "-V",
        help="Specify version instead of fetching latest"
    )
    parser.add_argument(
        "--verbose", "-v", action="store_true",
        help="Show skipped packages (no supported source)"
    )
    parser.add_argument(
        "--inventory", action="store_true",
        help="List every managed update target without network access"
    )
    parser.add_argument(
        "--json", dest="json_output", action="store_true",
        help="Emit inventory as JSON (with --inventory)"
    )
    parser.add_argument(
        "--sync-flake-projections", action="store_true",
        help="Refresh catalog fetchTree projections from config/ai/flake.lock"
    )
    parser.add_argument(
        "--prepare-fixed-inputs", action="store_true", help=argparse.SUPPRESS
    )
    args = parser.parse_args()

    # Validate arguments
    if (
        not args.inventory
        and not args.all
        and not args.packages
        and not args.sync_flake_projections
        and not args.prepare_fixed_inputs
    ):
        parser.error(
            "Please specify package names, --all, --inventory, or --sync-flake-projections"
        )

    if args.sync_flake_projections and (
        args.inventory
        or args.all
        or args.packages
        or args.version
        or args.dry_run
        or args.no_build
        or args.verbose
        or args.json_output
    ):
        parser.error("--sync-flake-projections cannot be combined with another operation")

    if args.prepare_fixed_inputs and (
        args.inventory
        or args.all
        or args.sync_flake_projections
        or args.dry_run
        or args.no_build
        or args.verbose
        or args.json_output
    ):
        parser.error("--prepare-fixed-inputs cannot be combined with another operation")

    if args.sync_flake_projections and os.environ.get("UPDATE_AGENTS_CANDIDATE") != "1":
        parser.error("--sync-flake-projections is restricted to the update-agents candidate")

    if args.prepare_fixed_inputs and os.environ.get("UPDATE_AGENTS_CANDIDATE") != "1":
        parser.error("--prepare-fixed-inputs is restricted to the update-agents candidate")

    if args.inventory and (args.all or args.packages or args.version):
        parser.error("--inventory cannot be combined with package updates")

    if args.json_output and not args.inventory:
        parser.error("--json requires --inventory")

    if args.all and args.version:
        parser.error("Cannot use --version with --all")

    if args.prepare_fixed_inputs and args.version and len(args.packages) != 1:
        parser.error("--version with --prepare-fixed-inputs requires exactly one target")

    nix_dir = Path(__file__).parent.parent.resolve()
    if args.sync_flake_projections:
        require_detached_linked_worktree(nix_dir)
        changed = sync_flake_projections(nix_dir)
        print(f"synchronized {changed} flake input projection(s)")
        return 0
    sources = make_overlay_sources(args, nix_dir)
    explicit_targets = load_update_manifest(nix_dir)
    catalog_targets = load_source_catalog(nix_dir)
    duplicates = explicit_targets.keys() & catalog_targets.keys()
    if duplicates:
        raise RuntimeError(f"source catalog duplicates update manifest: {sorted(duplicates)}")
    explicit_targets.update(catalog_targets)
    if args.inventory:
        print_inventory(build_inventory(sources, explicit_targets, nix_dir), args.json_output)
        return 0

    if args.prepare_fixed_inputs:
        require_detached_linked_worktree(nix_dir)
    elif args.packages:
        delegated_names = [
            name
            for name in args.packages
            if name in catalog_targets
            and catalog_targets[name].get("executor") == "update-agents"
        ]
        if delegated_names:
            if len(delegated_names) != len(args.packages):
                parser.error("update-agents targets cannot be mixed with direct targets")
            if args.no_build or args.verbose:
                parser.error("update-agents targets do not accept --no-build or --verbose")
            return delegate_to_update_agents(nix_dir, delegated_names, args)

    github_client = GitHubClient()
    npm_client = NpmRegistryClient()
    pypi_client = PypiClient()
    updater = OverlayUpdater()
    transaction = SourceTransaction()
    atexit.register(transaction.rollback_unless_committed)
    success_count = 0
    fail_count = 0
    skipped_count = 0

    if args.prepare_fixed_inputs:
        selected_catalog_names = (
            args.packages
            or [
                name
                for name in sorted(catalog_targets)
                if catalog_targets[name]["kind"] == "fixed-flake-input"
                and catalog_targets[name]["_record"]["update"].get(
                    "policy", "automatic"
                )
                == "automatic"
            ]
        )
    elif args.all:
        selected_catalog_names = [
            name for name in sorted(catalog_targets)
            if catalog_targets[name]["_record"]["update"].get("policy", "automatic")
            == "automatic"
            and (not args.packages or name in args.packages)
        ]
    else:
        selected_catalog_names = [
            name for name in args.packages if name in catalog_targets
        ]
    catalog_hash_computer = HashComputer(nix_dir)
    for name in selected_catalog_names:
        target = catalog_targets[name]
        expected_executor = "update-agents" if args.prepare_fixed_inputs else "update-overlay"
        if target.get("executor") != expected_executor or (
            args.prepare_fixed_inputs and target["kind"] != "fixed-flake-input"
        ):
            if args.all:
                if args.verbose:
                    print(f"{Colors.DIM}catalog/{name}: skipped (no executor){Colors.RESET}")
                skipped_count += 1
            else:
                print(f"{Colors.RED}{name}: catalog target has no update executor{Colors.RESET}")
                fail_count += 1
            continue
        status = update_catalog_target(
            name, target, args, github_client, npm_client, pypi_client, catalog_hash_computer, transaction
        )
        success_count += status == "updated"
        skipped_count += status == "skipped"
        fail_count += status == "failed"

    if args.prepare_fixed_inputs:
        if fail_count:
            transaction.rollback()
        else:
            transaction.commit()
        return 0 if fail_count == 0 else 1

    targets = collect_targets(args, sources, set(catalog_targets))
    for source, package_name in targets:
        # Find package in overlays
        info = source.parser.find_package(package_name)
        if not info:
            if args.all:
                # In --all mode, silently skip packages without source metadata.
                if args.verbose:
                    print(
                        f"{Colors.DIM}{source.name}/{package_name}: "
                        f"skipped (no supported source){Colors.RESET}"
                    )
                skipped_count += 1
            else:
                print(
                    f"{Colors.RED}{package_name}: not found or no supported source"
                    f"{Colors.RESET}"
                )
                fail_count += 1
            continue

        # Build hash info string
        hash_types = []
        if info.src_hash:
            hash_types.append("src")
        if info.vendor_hash:
            hash_types.append("vendor")
        if info.cargo_hash:
            hash_types.append("cargo")
        if info.npm_deps_hash:
            hash_types.append("npm")
        hash_info = f" [{','.join(hash_types)}]" if len(hash_types) > 1 else ""

        # Compact package info
        pkg_display = f"{Colors.BOLD}{source.name}/{package_name}{Colors.RESET}"
        version_display = f"{Colors.DIM}{info.version}{Colors.RESET}"
        print(f"{pkg_display} {version_display}{hash_info}", end=" ")

        # Get latest version
        latest_tag = None
        new_version = None
        new_full_rev = None

        if info.source_type == "npm":
            if args.version:
                npm_version = npm_client.get_version(info.npm_package, args.version)
                if not npm_version:
                    print(f"{Colors.RED}✗ fetch failed{Colors.RESET}")
                    fail_count += 1
                    continue
                new_version, new_src_hash = npm_version
                latest_tag = new_version
            else:
                npm_version = npm_client.get_version(info.npm_package)
                if not npm_version:
                    print(f"{Colors.RED}✗ fetch failed{Colors.RESET}")
                    fail_count += 1
                    continue
                new_version, new_src_hash = npm_version
                latest_tag = new_version
        elif args.version:
            latest_tag = args.version
            if not latest_tag.startswith(("v", "b")):
                latest_tag = f"{info.version_prefix}{args.version}"
            new_version = extract_version_number(latest_tag, info.version_prefix)
        elif info.uses_commit:
            # Legacy regex targets follow the repository's declared default branch.
            branch = github_client.get_default_branch(info.owner, info.repo)
            commit_info = (
                github_client.get_latest_commit(info.owner, info.repo, branch)
                if branch
                else None
            )
            if not commit_info:
                print(f"{Colors.RED}✗ fetch failed{Colors.RESET}")
                fail_count += 1
                continue
            new_full_rev, new_version = commit_info
            latest_tag = new_full_rev
        else:
            latest_tag = github_client.get_latest_release(info.owner, info.repo)
            if not latest_tag:
                print(f"{Colors.RED}✗ fetch failed{Colors.RESET}")
                fail_count += 1
                continue
            new_version = extract_version_number(latest_tag, info.version_prefix)
        if new_version == info.version:
            print(f"{Colors.GREEN}✓ up-to-date{Colors.RESET}")
            skipped_count += 1
            continue

        # Show update arrow
        print(f"{Colors.YELLOW}→ {new_version}{Colors.RESET}", end="")

        # Compute new source hash
        if info.source_type != "npm":
            new_src_hash = source.hash_computer.compute_src_hash(info.owner, info.repo, latest_tag)
        if not new_src_hash:
            print(f" {Colors.RED}✗ hash failed{Colors.RESET}")
            fail_count += 1
            continue

        # Update the overlay file with new version and src hash first
        # This is needed so we can compute the other hashes. Watch the source
        # before any mutation so one failed target rolls back the whole command.
        transaction.watch(info.file_path)
        updater.update_package(
            info, new_version, new_src_hash,
            new_full_rev=new_full_rev,
            dry_run=args.dry_run
        )

        # Compute additional hashes if needed
        new_vendor_hash = None
        new_cargo_hash = None
        new_npm_deps_hash = None
        extra_hashes = []
        hash_failed = False

        if not args.no_build and not args.dry_run:
            def apply_computed_hash(**hashes):
                current_info = source.parser.find_package(package_name)
                if current_info:
                    updater.update_package(
                        current_info,
                        new_version,
                        new_src_hash,
                        new_vendor_hash=hashes.get("vendor"),
                        new_cargo_hash=hashes.get("cargo"),
                        new_npm_deps_hash=hashes.get("npm"),
                        new_full_rev=new_full_rev,
                        dry_run=False
                    )

            # Compute hashes for nested/build-time dependencies before hashes
            # for packages that may consume them. Otherwise Nix can report an
            # npmDepsHash mismatch while we are trying to compute vendorHash.
            if info.npm_deps_hash:
                updater.set_dummy_hash(info.file_path, package_name, 'npmDepsHash', info.npm_deps_hash)
                new_npm_deps_hash = source.hash_computer.compute_npm_deps_hash(package_name)
                if new_npm_deps_hash:
                    apply_computed_hash(npm=new_npm_deps_hash)
                    extra_hashes.append("npm")
                else:
                    apply_computed_hash(npm=info.npm_deps_hash)
                    hash_failed = True

            if not hash_failed and info.cargo_hash:
                updater.set_dummy_hash(info.file_path, package_name, 'cargoHash', info.cargo_hash)
                new_cargo_hash = source.hash_computer.compute_cargo_hash(package_name)
                if new_cargo_hash:
                    apply_computed_hash(cargo=new_cargo_hash)
                    extra_hashes.append("cargo")
                else:
                    apply_computed_hash(cargo=info.cargo_hash)
                    hash_failed = True

            if not hash_failed and info.vendor_hash:
                updater.set_dummy_hash(info.file_path, package_name, 'vendorHash', info.vendor_hash)
                new_vendor_hash = source.hash_computer.compute_vendor_hash(package_name)
                if new_vendor_hash:
                    apply_computed_hash(vendor=new_vendor_hash)
                    extra_hashes.append("vendor")
                else:
                    apply_computed_hash(vendor=info.vendor_hash)
                    hash_failed = True

        if hash_failed:
            print(f" {Colors.RED}✗ hash failed{Colors.RESET}")
            fail_count += 1
            continue

        # Final update with all hashes
        if not args.dry_run:
            info = source.parser.find_package(package_name)
            updater.update_package(
                info, new_version, new_src_hash,
                new_vendor_hash=new_vendor_hash,
                new_cargo_hash=new_cargo_hash,
                new_npm_deps_hash=new_npm_deps_hash,
                new_full_rev=new_full_rev,
                dry_run=False
            )
        success_count += 1
        extra_info = f" +{','.join(extra_hashes)}" if extra_hashes else ""
        if args.dry_run:
            print(f" {Colors.CYAN}(dry-run){Colors.RESET}")
        else:
            print(f" {Colors.GREEN}✓{Colors.RESET}{extra_info}")

    if fail_count and not args.dry_run:
        restored = transaction.rollback()
        if restored:
            print(f"Rolled back {restored} source file(s) after update failure")
    else:
        transaction.commit()

    # Colored summary
    updated_str = f"{Colors.GREEN}{success_count} updated{Colors.RESET}" if success_count else f"{success_count} updated"
    skipped_str = f"{skipped_count} up-to-date"
    failed_str = f"{Colors.RED}{fail_count} failed{Colors.RESET}" if fail_count else f"{fail_count} failed"
    print(f"\n{Colors.BOLD}Summary:{Colors.RESET} {updated_str}, {skipped_str}, {failed_str}")

    return 0 if fail_count == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
