import tomllib
from pathlib import Path, PurePosixPath
from typing import Optional
from urllib.parse import quote, urlsplit
from urllib.request import urlopen


# ANSI color codes
class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"

    @classmethod
    def disable(cls):
        """Disable colors (e.g., when not a TTY)."""
        cls.RESET = cls.BOLD = cls.DIM = ""
        cls.RED = cls.GREEN = cls.YELLOW = cls.BLUE = cls.MAGENTA = cls.CYAN = ""


# Disable colors if not a TTY
if not sys.stdout.isatty():
    Colors.disable()

DUMMY_SRI_HASH = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
CANDIDATE_REJECTED_EXIT = 3
PI_NORMALIZATION_POLICY = Path("packages/pi-gallery/normalization-policy.json")
PI_NORMALIZER = Path("packages/pi-gallery/normalize-manifest.jq")
PRIME_AGENT_LOCK = Path("packages/prime-agent/package-lock.json")
PRIME_AGENT_NORMALIZER = "prime-agent-lock-v1"
PI_NPM_REQUIRED_DEPENDENCY_FLAGS = (
    "--ignore-scripts",
    "--omit=dev",
    "--omit=peer",
    "--legacy-peer-deps",
)
PI_NPM_LOCK_EXTRA_FLAGS = (
    "--package-lock-only",
    "--no-audit",
    "--no-fund",
)
MAX_NPM_TARBALL_BYTES = 256 * 1024 * 1024
MAX_NPM_TAR_MEMBER_BYTES = 64 * 1024 * 1024
MAX_NPM_TAR_DECLARED_BYTES = 256 * 1024 * 1024
MAX_NPM_TAR_MEMBERS = 10000
MAX_ACTIONABLE_ERROR_CHARS = 512
ANSI_ESCAPE_RE = re.compile(
    r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\))"
)
CONTROL_CHAR_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


class CandidateRejected(RuntimeError):
    """A resolved candidate failed its package-specific build contract."""


def _bounded_actionable_error(*output: object, fallback: str) -> str:
    """Extract one bounded, terminal-safe command failure summary."""
    lines = []
    for value in output:
        if value is None:
            continue
        if isinstance(value, bytes):
            text = value.decode("utf-8", "replace")
        else:
            text = str(value)
        text = ANSI_ESCAPE_RE.sub("", text)
        text = CONTROL_CHAR_RE.sub(" ", text)
        for raw_line in text.splitlines():
            line = re.sub(r"^\s*>\s?", "", raw_line)
            line = re.sub(r"\s+", " ", line).strip()
            if line and line not in lines:
                lines.append(line)

    meaningful = [
        line
        for line in lines
        if re.search(r"\bfatal:", line, re.IGNORECASE)
        or re.search(r"\bERROR\b", line)
        or re.search(r"\bUnable\b", line, re.IGNORECASE)
    ]
    secondary = [
        line
        for line in lines
        if re.search(r"\berror:", line, re.IGNORECASE)
        and "cannot build" not in line.lower()
    ]
    candidates = meaningful or secondary
    if not candidates:
        candidates = [
            line for line in lines if "cannot build" not in line.lower()
        ] or lines
    summary = "; ".join(candidates[:4]) if candidates else fallback
    if len(summary) > MAX_ACTIONABLE_ERROR_CHARS:
        summary = summary[: MAX_ACTIONABLE_ERROR_CHARS - 3].rstrip() + "..."
    return summary


def _failure_message(label: str, detail: Optional[str]) -> str:
    return f"{label}: {detail}" if detail else label


class _RegistryProxyServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = False
    daemon_threads = True


class _RegistryProxyHandler(socketserver.BaseRequestHandler):
    def handle(self) -> None:
        client = self.request
        client.settimeout(30)
        request = b""
        try:
            while b"\r\n\r\n" not in request and len(request) <= 65536:
                chunk = client.recv(8192)
                if not chunk:
                    return
                request += chunk
            header, separator, remainder = request.partition(b"\r\n\r\n")
            if not separator:
                client.sendall(b"HTTP/1.1 400 Bad Request\r\n\r\n")
                return
            parts = header.splitlines()[0].decode("ascii", "strict").split()
            if (
                len(parts) != 3
                or parts[0].upper() != "CONNECT"
                or parts[1].lower() != "registry.npmjs.org:443"
            ):
                client.sendall(b"HTTP/1.1 403 Forbidden\r\n\r\n")
                return
            upstream = socket.create_connection(("registry.npmjs.org", 443), 30)
            try:
                client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                if remainder:
                    upstream.sendall(remainder)
                sockets = (client, upstream)
                while True:
                    readable, _writable, _errors = select.select(sockets, [], [], 60)
                    if not readable:
                        return
                    for source in readable:
                        data = source.recv(65536)
                        if not data:
                            return
                        destination = upstream if source is client else client
                        destination.sendall(data)
            finally:
                upstream.close()
        except (OSError, UnicodeError):
            try:
                client.sendall(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
            except OSError:
                pass


@contextlib.contextmanager
def registry_only_proxy():
    server = _RegistryProxyServer(("127.0.0.1", 0), _RegistryProxyHandler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        host, port = server.server_address
        yield f"http://{host}:{port}"
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=5)


class GitHubClient:
    """Client for GitHub API operations using gh CLI."""

    def __init__(self):
        self.last_error: Optional[str] = None

    def get_latest_release(self, owner: str, repo: str) -> Optional[str]:
        """Get the latest GitHub release tag without changing strategy."""
        self.last_error = None
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}/releases/latest"],
                capture_output=True, text=True
            )
            if result.returncode != 0:
                detail = _bounded_actionable_error(
                    getattr(result, "stderr", ""),
                    result.stdout,
                    fallback=f"gh exited with status {result.returncode}",
                )
                self.last_error = _bounded_actionable_error(
                    f"GitHub release lookup failed for {owner}/{repo}: {detail}",
                    fallback="GitHub release lookup failed",
                )
                return None
            payload = json.loads(result.stdout)
            tag = (
                payload.get("tag_name")
                if isinstance(payload, dict)
                and isinstance(payload.get("tag_name"), str)
                and payload["tag_name"]
                else None
            )
            if tag is None:
                self.last_error = _bounded_actionable_error(
                    f"GitHub release lookup returned no tag for {owner}/{repo}",
                    fallback="GitHub release lookup returned no tag",
                )
            return tag
        except (OSError, ValueError, json.JSONDecodeError) as error:
            detail = _bounded_actionable_error(
                error,
                fallback="GitHub release lookup raised an exception",
            )
            self.last_error = _bounded_actionable_error(
                f"GitHub release lookup failed for {owner}/{repo}: {detail}",
                fallback="GitHub release lookup failed",
            )
            return None

    def get_latest_tag(
        self, owner: str, repo: str, prefix: str = ""
    ) -> Optional[str]:
        """Get the first matching tag from GitHub's tag ordering."""
        self.last_error = None
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}/tags?per_page=100"],
                capture_output=True,
                text=True,
            )
            if result.returncode != 0:
                detail = _bounded_actionable_error(
                    getattr(result, "stderr", ""),
                    result.stdout,
                    fallback=f"gh exited with status {result.returncode}",
                )
                self.last_error = _bounded_actionable_error(
                    f"GitHub tag lookup failed for {owner}/{repo}: {detail}",
                    fallback="GitHub tag lookup failed",
                )
                return None
            payload = json.loads(result.stdout)
            if isinstance(payload, list):
                for item in payload:
                    name = item.get("name") if isinstance(item, dict) else None
                    if isinstance(name, str) and name.startswith(prefix):
                        return name
            self.last_error = _bounded_actionable_error(
                f"GitHub tag lookup returned no {prefix!r} tag for {owner}/{repo}",
                fallback="GitHub tag lookup returned no matching tag",
            )
            return None
        except (OSError, ValueError, json.JSONDecodeError) as error:
            detail = _bounded_actionable_error(
                error,
                fallback="GitHub tag lookup raised an exception",
            )
            self.last_error = _bounded_actionable_error(
                f"GitHub tag lookup failed for {owner}/{repo}: {detail}",
                fallback="GitHub tag lookup failed",
            )
            return None

    def get_default_branch(self, owner: str, repo: str) -> Optional[str]:
        """Get the repository's declared default branch."""
        self.last_error = None
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}", "--jq", ".default_branch"],
                capture_output=True, text=True
            )
            branch = (
                result.stdout.strip()
                if result.returncode == 0 and result.stdout.strip()
                else None
            )
            if branch is None:
                detail = _bounded_actionable_error(
                    getattr(result, "stderr", ""),
                    result.stdout,
                    fallback=f"gh exited with status {result.returncode}",
                )
                self.last_error = _bounded_actionable_error(
                    f"GitHub default branch lookup failed for {owner}/{repo}: {detail}",
                    fallback="GitHub default branch lookup failed",
                )
            return branch
        except OSError as error:
            detail = _bounded_actionable_error(
                error,
                fallback="GitHub default branch lookup raised an exception",
            )
            self.last_error = _bounded_actionable_error(
                f"GitHub default branch lookup failed for {owner}/{repo}: {detail}",
                fallback="GitHub default branch lookup failed",
            )
            return None

    def get_latest_commit(self, owner: str, repo: str, branch: str) -> Optional[tuple[str, str]]:
        """Get the latest commit SHA from exactly the declared branch."""
        self.last_error = None
        result = None
        command_error = None
        try:
            result = subprocess.run(
                ["gh", "api", f"repos/{owner}/{repo}/commits/{branch}", "--jq", ".sha"],
                capture_output=True, text=True
            )
            if result.returncode == 0 and result.stdout.strip():
                full_sha = result.stdout.strip()
                return full_sha, full_sha[:8]
            command_error = _bounded_actionable_error(
                getattr(result, "stderr", ""),
                result.stdout,
                fallback=f"gh exited with status {result.returncode}",
            )
        except OSError as error:
            command_error = _bounded_actionable_error(
                error,
                fallback="GitHub commit lookup raised an exception",
            )

        default_branch = self.get_default_branch(owner, repo)
        default_error = self.last_error
        default_summary = (
            f"repository default branch is {default_branch!r}"
            if default_branch
            else "repository default branch is unavailable"
        )
        details = [
            f"GitHub commit lookup failed for {owner}/{repo}",
            f"requested branch {branch!r}",
            default_summary,
        ]
        if command_error:
            details.append(command_error)
        if default_branch is None and default_error:
            details.append(default_error)
        self.last_error = _bounded_actionable_error(
            "; ".join(details),
            fallback="GitHub commit lookup failed",
        )
        return None

    def get_file(self, owner: str, repo: str, rev: str, path: str) -> Optional[str]:
        """Read one UTF-8 repository file from an exact revision."""
        self.last_error = None
        endpoint = (
            f"repos/{owner}/{repo}/contents/{quote(path, safe='/')}?"
            f"ref={quote(rev, safe='')}"
        )
        try:
            result = subprocess.run(
                ["gh", "api", endpoint],
                capture_output=True,
                text=True,
                timeout=60,
            )
            if result.returncode != 0 or not result.stdout:
                detail = _bounded_actionable_error(
                    getattr(result, "stderr", ""),
                    result.stdout,
                    fallback=f"gh exited with status {result.returncode}",
                )
                self.last_error = _bounded_actionable_error(
                    f"GitHub file lookup failed for {owner}/{repo}:{path}@{rev}: {detail}",
                    fallback="GitHub file lookup failed",
                )
                return None
            payload = json.loads(result.stdout)
            if (
                not isinstance(payload, dict)
                or payload.get("type") != "file"
                or payload.get("encoding") != "base64"
                or not isinstance(payload.get("content"), str)
            ):
                self.last_error = _bounded_actionable_error(
                    f"GitHub file lookup returned invalid payload for "
                    f"{owner}/{repo}:{path}@{rev}",
                    fallback="GitHub file lookup returned invalid payload",
                )
                return None
            encoded = "".join(payload["content"].split())
            return base64.b64decode(encoded, validate=True).decode("utf-8")
        except (
            OSError,
            ValueError,
            UnicodeDecodeError,
            binascii.Error,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            detail = _bounded_actionable_error(
                getattr(error, "stderr", ""),
                getattr(error, "output", ""),
                error,
                fallback="GitHub file lookup raised an exception",
            )
            self.last_error = _bounded_actionable_error(
                f"GitHub file lookup failed for {owner}/{repo}:{path}@{rev}: {detail}",
                fallback="GitHub file lookup failed",
            )
            return None


class NpmRegistryClient:
    """Client for npm registry metadata using only the Python standard library."""

    def get_version_metadata(
        self,
        package_name: str,
        requested_version: Optional[str] = None,
    ) -> Optional[dict[str, str]]:
        """Return npm version metadata needed by simple and Git-coupled updates."""
        encoded = quote(package_name, safe="@")
        url = f"https://registry.npmjs.org/{encoded}"

        try:
            with urlopen(url, timeout=30) as response:
                data = json.load(response)
        except Exception as e:
            print(f"  Error fetching npm metadata: {e}", file=sys.stderr)
            return None

        version = requested_version or data.get("dist-tags", {}).get("latest")
        if not version:
            return None

        version_info = data.get("versions", {}).get(version, {})
        distribution = version_info.get("dist", {})
        integrity = distribution.get("integrity")
        tarball = distribution.get("tarball")
        if (
            not isinstance(integrity, str)
            or not integrity
            or not isinstance(tarball, str)
            or not tarball
        ):
            return None

        metadata = {
            "version": version,
            "integrity": integrity,
            "tarball": tarball,
        }
        git_head = version_info.get("gitHead")
        if isinstance(git_head, str) and git_head:
            metadata["gitHead"] = git_head
        return metadata

    def get_version(
        self,
        package_name: str,
        requested_version: Optional[str] = None,
    ) -> Optional[tuple[str, str]]:
        metadata = self.get_version_metadata(package_name, requested_version)
        if metadata is None:
            return None
        return metadata["version"], metadata["integrity"]


class PypiClient:
    """Resolve the exact PyPI artifact selected by native fetcher arguments."""

    def _get_metadata(self, package_name: str) -> Optional[dict]:
        try:
            with urlopen(
                f"https://pypi.org/pypi/{quote(package_name, safe='')}/json",
                timeout=30,
            ) as response:
                return json.load(response)
        except Exception as error:
            print(f"  Error fetching PyPI metadata: {error}", file=sys.stderr)
            return None

    @staticmethod
    def _resolve_artifact(
        data: dict, source: dict, version: str, old_version: str
    ) -> Optional[tuple[str, str]]:
        args = source["args"]
        if source["fetcher"] == "fetchPypi":
            if args.get("format", "setuptools") == "wheel":
                filename = (
                    f"{args['pname']}-{version}-{args.get('python', 'py2.py3')}-"
                    f"{args.get('abi', 'none')}-{args.get('platform', 'any')}.whl"
                )
            else:
                filename = f"{args['pname']}-{version}.{args.get('extension', 'tar.gz')}"
        else:
            current_filename = Path(urlsplit(args["url"]).path).name
            if current_filename.count(old_version) != 1:
                return None
            filename = current_filename.replace(old_version, version, 1)

        artifact = next(
            (
                item
                for item in data.get("releases", {}).get(version, [])
                if item.get("filename") == filename
            ),
            None,
        )
        if artifact is None or not artifact.get("digests", {}).get("sha256"):
            return None
        digest = base64.b64encode(
            bytes.fromhex(artifact["digests"]["sha256"])
        ).decode()
        return artifact["url"], f"sha256-{digest}"

    def get_release(
        self, package_name: str, record: dict, requested_version: Optional[str] = None
    ) -> Optional[tuple[str, str, str]]:
        data = self._get_metadata(package_name)
        if data is None:
            return None

        version = requested_version or data.get("info", {}).get("version")
        if not version:
            return None
        resolved = self._resolve_artifact(
            data, record["source"], version, record["version"]
        )
        if resolved is None:
            return None
        artifact_url, artifact_hash = resolved
        return version, artifact_url, artifact_hash

    def get_release_artifacts(
        self, package_name: str, record: dict, requested_version: Optional[str] = None
    ) -> Optional[tuple[str, dict[str, tuple[str, str]]]]:
        """Resolve a compound PyPI release completely before returning it."""
        documents: dict[str, dict] = {}

        def metadata(project: str) -> Optional[dict]:
            key = _normalized_package_name(project)
            if key not in documents:
                document = self._get_metadata(project)
                if document is None:
                    return None
                documents[key] = document
            return documents[key]

        primary = metadata(package_name)
        if primary is None:
            return None
        version = requested_version or primary.get("info", {}).get("version")
        if not version:
            return None

        fetches = {"source": record["source"]}
        fetches.update(
            {f"artifact:{name}": source for name, source in record["artifacts"].items()}
        )
        resolved: dict[str, tuple[str, str]] = {}
        for label, source in fetches.items():
            parts = [part for part in urlsplit(source["url"]).path.split("/") if part]
            if len(parts) != 2 or parts[0] != "project":
                return None
            document = metadata(parts[1])
            if document is None:
                return None
            artifact = self._resolve_artifact(
                document, source, version, record["version"]
            )
            if artifact is None:
                return None
            resolved[label] = artifact
        return version, resolved


class HashComputer:
    """Compute Nix hashes for various package types."""

    def __init__(self, repo_dir: Path):
        self.repo_dir = repo_dir
        self._tool_paths: dict[tuple[str, str], Path] = {}
        self.last_error: Optional[str] = None

    def _realize_nix_expression(
        self,
        expression: str,
        *,
        timeout: int = 600,
        runner=subprocess.run,
    ) -> Optional[Path]:
        try:
            result = runner(
                [
                    "nix",
                    "build",
                    "--impure",
                    "--no-link",
                    "--print-out-paths",
                    "--expr",
                    expression,
                ],
                capture_output=True,
                text=True,
                timeout=timeout,
                cwd=self.repo_dir,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            print(f"  Error realizing Nix input: {error}", file=sys.stderr)
            return None
        outputs = [line.strip() for line in result.stdout.splitlines() if line.strip()]
        if result.returncode != 0 or len(outputs) != 1:
            return None
        output = Path(outputs[0])
        return output if output.is_absolute() else None

    def resolve_build_tool(
        self,
        package: str,
        executable: str,
        *,
        runner=subprocess.run,
    ) -> Optional[Path]:
        """Resolve one executable from the repository-locked build package set."""
        if (
            re.fullmatch(r"[A-Za-z0-9_+-]+", package) is None
            or Path(executable).name != executable
            or not executable
        ):
            return None
        key = package, executable
        if key in self._tool_paths:
            return self._tool_paths[key]
        expression = f"""
let
  flake = builtins.getFlake (toString {json.dumps(str(self.repo_dir))});
  pkgs = import flake.inputs.nix-config-ai.inputs.nixpkgs {{
    system = builtins.currentSystem;
  }};
in
  pkgs.lib.getBin pkgs.buildPackages.{package}
"""
        package_path = self._realize_nix_expression(expression, runner=runner)
        if package_path is None:
            return None
        tool = package_path / "bin" / executable
        if not tool.is_file() or not os.access(tool, os.X_OK):
            return None
        self._tool_paths[key] = tool
        return tool

    def realize_native_source(
        self, source: dict, replacements: dict
    ) -> Optional[Path]:
        """Realize exact native fetcher bytes after their hash is known."""
        args = copy.deepcopy(source["args"])
        args.update(replacements)
        fetcher = source["fetcher"]
        if fetcher not in {"fetchurl", "fetchzip"}:
            return None
        expression = f"""
let
  flake = builtins.getFlake (toString {json.dumps(str(self.repo_dir))});
  pkgs = import flake.inputs.nix-config-ai.inputs.nixpkgs {{
    system = builtins.currentSystem;
  }};
  args = builtins.fromJSON {json.dumps(json.dumps(args))};
in
  pkgs.{fetcher} args
"""
        return self._realize_nix_expression(expression)

    def compute_native_hash(self, source: dict, replacements: dict) -> Optional[str]:
        """Hash through the repository-locked native fetcher with exact arguments."""
        self.last_error = None
        operation = "native source hash computation"
        try:
            args = copy.deepcopy(source["args"])
            args.update(replacements)
            hash_name = next(iter({"hash", "sha256", "narHash"} & args.keys()))
            fetcher = source["fetcher"]

            if fetcher == "fetchTree":
                args.pop("narHash")
                expression = (
                    f"(builtins.fetchTree (builtins.fromJSON "
                    f"{json.dumps(json.dumps(args))})).narHash"
                )
                result = subprocess.run(
                    ["nix", "eval", "--impure", "--json", "--expr", expression],
                    capture_output=True,
                    text=True,
                    timeout=600,
                    cwd=self.repo_dir,
                )
                if result.returncode == 0:
                    value = json.loads(result.stdout)
                    if isinstance(value, str) and value:
                        return value
                    self.last_error = _bounded_actionable_error(
                        "nix eval returned an invalid fetchTree hash",
                        fallback="nix eval returned an invalid fetchTree hash",
                    )
                    return None
                detail = _bounded_actionable_error(
                    result.stderr,
                    result.stdout,
                    fallback=f"nix eval exited with status {result.returncode}",
                )
                self.last_error = _bounded_actionable_error(
                    f"fetchTree hash evaluation failed: {detail}",
                    fallback="fetchTree hash evaluation failed",
                )
                return None

            args[hash_name] = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
            expression = f"""
let
  flake = builtins.getFlake (toString {json.dumps(str(self.repo_dir))});
  pkgs = import flake.inputs.nix-config-ai.inputs.nixpkgs {{ system = builtins.currentSystem; }};
  args = builtins.fromJSON {json.dumps(json.dumps(args))};
in
  pkgs.{fetcher} args
"""
            result = subprocess.run(
                ["nix", "build", "--impure", "--no-link", "--expr", expression],
                capture_output=True,
                text=True,
                timeout=600,
                cwd=self.repo_dir,
            )
            match = re.search(r"got:\s+(sha256-[A-Za-z0-9+/=]+)", result.stdout + result.stderr)
            if not match:
                detail = _bounded_actionable_error(
                    result.stderr,
                    result.stdout,
                    fallback=f"nix build exited with status {result.returncode}",
                )
                self.last_error = _bounded_actionable_error(
                    f"native fetcher build failed: {detail}",
                    fallback="native fetcher build failed",
                )
                return None
            value = match.group(1)
            return value
        except (
            KeyError,
            OSError,
            StopIteration,
            TypeError,
            ValueError,
            json.JSONDecodeError,
            subprocess.TimeoutExpired,
        ) as error:
            detail = _bounded_actionable_error(
                getattr(error, "stderr", ""),
                getattr(error, "output", ""),
                error,
                fallback=f"{operation} raised an exception",
            )
            self.last_error = _bounded_actionable_error(
                f"{operation} failed: {detail}",
                fallback=f"{operation} failed",
            )
            return None

    def _package_build_command(
        self, package_name: str, build_mode: str = "pkg"
    ) -> list[str]:
        if build_mode not in {"pkg", "python"}:
            raise ValueError(f"unsupported package build mode: {build_mode}")
        package_expression = (
            f"builtins.getAttr {json.dumps(package_name)} pkgs.python3Packages"
            if build_mode == "python"
            else f"builtins.getAttr {json.dumps(package_name)} pkgs"
        )
        expression = f"""
let
  repoPath = builtins.getEnv "UPDATE_OVERLAY_REPO_DIR";
  flake = builtins.getFlake repoPath;
  repo = flake.outPath;
  portableInputs = builtins.removeAttrs flake.inputs.nix-config-ai.inputs [ "self" ];
  inputs = flake.inputs // portableInputs;
  system = builtins.currentSystem;
  overlays = import (repo + "/config/overlays.nix") {{ inherit inputs; }};
  pkgs = import inputs.nixpkgs {{
    inherit system overlays;
    config.allowUnfree = true;
    config.allowUnsupportedSystem = true;
  }};
in
  {package_expression}
"""
        return ["nix", "build", "--impure", "--no-link", "--expr", expression]

    def _run_package_build(self, package_name: str, build_mode: str = "pkg"):
        environment = dict(os.environ)
        environment["UPDATE_OVERLAY_REPO_DIR"] = str(self.repo_dir)
        return subprocess.run(
            self._package_build_command(package_name, build_mode),
            capture_output=True,
            text=True,
            timeout=600,
            cwd=self.repo_dir,
            env=environment,
        )

    @staticmethod
    def _parse_dummy_hash_mismatch(output: str) -> Optional[str]:
        pairs = re.findall(
            r"specified:\s+(sha256-[A-Za-z0-9+/=]+)\s+"
            r"got:\s+(sha256-[A-Za-z0-9+/=]+)",
            output,
        )
        matching = [got for specified, got in pairs if specified == DUMMY_SRI_HASH]
        return matching[0] if len(matching) == 1 else None

    def _compute_fod_hash(
        self, package_name: str, hash_type: str, build_mode: str = "pkg"
    ) -> Optional[str]:
        """Compute a fixed-output derivation hash from our injected mismatch."""
        print(f"  Computing {hash_type} (this may take a while)...")
        try:
            result = self._run_package_build(package_name, build_mode)
            output = result.stdout + result.stderr
            value = self._parse_dummy_hash_mismatch(output)
            if value is None:
                detail = _bounded_actionable_error(
                    result.stderr,
                    result.stdout,
                    fallback=f"{package_name} build produced no hash mismatch",
                )
                print(f"  Error computing {hash_type}: {detail}", file=sys.stderr)
            return value
        except subprocess.TimeoutExpired:
            print(f"  Timeout computing {hash_type}", file=sys.stderr)
        except Exception as e:
            print(f"  Error computing {hash_type}: {e}", file=sys.stderr)
        return None

    def validate_package_build(
        self, package_name: str, build_mode: str = "pkg"
    ) -> bool:
        try:
            result = self._run_package_build(package_name, build_mode)
            if result.returncode != 0:
                detail = _bounded_actionable_error(
                    result.stderr,
                    result.stdout,
                    fallback=f"{package_name} build failed",
                )
                print(f"  Error validating {package_name}: {detail}", file=sys.stderr)
                if result.returncode < 0:
                    raise RuntimeError(
                        f"{package_name} validation interrupted: {detail}"
                    )
                return False
            return True
        except (OSError, subprocess.TimeoutExpired) as error:
            print(f"  Error validating {package_name}: {error}", file=sys.stderr)
            raise RuntimeError(
                f"{package_name} validation could not run: {error}"
            ) from error

    def validate_cargo_lock(
        self,
        source_url: str,
        revision: str,
        remote_path: str,
        content: str,
    ) -> bool:
        """Ask Cargo to validate a lock against an exact isolated checkout."""
        parsed = urlsplit(source_url)
        remote = Path(remote_path)
        if (
            parsed.scheme != "https"
            or not parsed.netloc
            or re.fullmatch(r"[0-9a-f]{40}", revision) is None
            or remote.is_absolute()
            or ".." in remote.parts
        ):
            return False
        try:
            with tempfile.TemporaryDirectory(
                prefix="update-overlay-cargo-lock-"
            ) as temp_dir:
                root = Path(temp_dir)
                checkout = root / "source"
                commands = (
                    ["git", "init", "--quiet", str(checkout)],
                    [
                        "git",
                        "-C",
                        str(checkout),
                        "fetch",
                        "--quiet",
                        "--depth=1",
                        "--no-tags",
                        source_url,
                        revision,
                    ],
                    [
                        "git",
                        "-C",
                        str(checkout),
                        "checkout",
                        "--quiet",
                        "--detach",
                        "FETCH_HEAD",
                    ],
                )
                for command in commands:
                    result = subprocess.run(
                        command,
                        capture_output=True,
                        text=True,
                        timeout=60,
                    )
                    if result.returncode != 0:
                        return False
                resolved = subprocess.run(
                    ["git", "-C", str(checkout), "rev-parse", "HEAD"],
                    capture_output=True,
                    text=True,
                    timeout=30,
                )
                if resolved.returncode != 0 or resolved.stdout.strip() != revision:
                    return False
                lock_path = checkout / remote
                manifest_path = lock_path.parent / "Cargo.toml"
                if (
                    lock_path.is_symlink()
                    or not lock_path.is_file()
                    or lock_path.read_text() != content
                    or manifest_path.is_symlink()
                    or not manifest_path.is_file()
                ):
                    return False
                cargo_home = root / "cargo-home"
                cargo_home.mkdir()
                environment = dict(os.environ)
                environment.update(
                    CARGO_HOME=str(cargo_home),
                    CARGO_NET_OFFLINE="true",
                )
                metadata = subprocess.run(
                    [
                        "cargo",
                        "metadata",
                        "--locked",
                        "--offline",
                        "--no-deps",
                        "--format-version",
                        "1",
                        "--manifest-path",
                        str(manifest_path),
                    ],
                    capture_output=True,
                    text=True,
                    timeout=120,
                    cwd=checkout,
                    env=environment,
                )
                return metadata.returncode == 0
        except (OSError, UnicodeError, subprocess.TimeoutExpired) as error:
            print(f"  Error validating Cargo.lock: {error}", file=sys.stderr)
            return False


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON key: {key}")
        result[key] = value
    return result


def _string_list(value: object, label: str) -> list[str]:
    if (
        not isinstance(value, list)
        or not all(isinstance(item, str) and item for item in value)
        or len(value) != len(set(value))
    ):
        raise RuntimeError(f"{label} must be a unique list of nonempty strings")
    return value


def load_pi_normalization_contract(nix_dir: Path) -> dict:
    path = nix_dir / PI_NORMALIZATION_POLICY
    normalizer = nix_dir / PI_NORMALIZER
    if (
        path.is_symlink()
        or not path.is_file()
        or normalizer.is_symlink()
        or not normalizer.is_file()
    ):
        raise RuntimeError("Pi npm normalization contract files are missing or unsafe")
    try:
        contract = json.loads(path.read_text(), object_pairs_hook=_unique_object)
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as error:
        raise RuntimeError(f"cannot load Pi npm normalization contract: {error}") from error
    # Deep policy semantics are validated by two owners with distinct
    # roles: normalize-manifest.jq enforces them whenever a target is
    # normalized (build release-sources and lock regeneration), and the
    # whole-contract eval-time assert in packages/pi-gallery/default.nix
    # gates every `nix flake check` — including bin/update's pre-sign
    # validation, which never builds. This loader validates only the shape
    # its own consumers index (a nonempty `targets` object) plus the npm
    # argv tripwire below: the flags feed npm directly, so losing
    # --ignore-scripts must fail here even if both other stages were
    # bypassed.
    if not isinstance(contract, dict) or set(contract) != {
        "schemaVersion",
        "npmDependencyFlags",
        "common",
        "targets",
    }:
        raise RuntimeError("invalid Pi npm normalization contract fields")
    if contract["schemaVersion"] != 3:
        raise RuntimeError("unsupported Pi npm normalization contract schema")
    dependency_flags = _string_list(
        contract["npmDependencyFlags"], "Pi npm dependency flags"
    )
    if tuple(dependency_flags) != PI_NPM_REQUIRED_DEPENDENCY_FLAGS:
        raise RuntimeError("Pi npm dependency flags omit required safety policy")
    if not isinstance(contract["targets"], dict) or not contract["targets"]:
        raise RuntimeError("Pi npm normalization targets must be a nonempty object")
    return contract


def pi_npm_lock_flags(contract: dict) -> list[str]:
    return [
        PI_NPM_LOCK_EXTRA_FLAGS[0],
        *contract["npmDependencyFlags"],
        *PI_NPM_LOCK_EXTRA_FLAGS[1:],
    ]


def verify_npm_integrity(path: Path, integrity: str) -> bool:
    candidates: list[tuple[str, str]] = []
    for token in integrity.split():
        algorithm, separator, encoded = token.partition("-")
        if separator and algorithm in {"sha1", "sha256", "sha384", "sha512"}:
            candidates.append((algorithm, encoded))
    if not candidates or not path.is_file() or path.is_symlink():
        return False
    strength = {"sha1": 1, "sha256": 2, "sha384": 3, "sha512": 4}
    strongest = max(candidates, key=lambda item: strength[item[0]])[0]
    strongest_candidates = [
        (algorithm, encoded)
        for algorithm, encoded in candidates
        if algorithm == strongest
    ]
    digest = hashlib.new(strongest)
    try:
        with path.open("rb") as stream:
            while chunk := stream.read(1024 * 1024):
                digest.update(chunk)
    except OSError:
        return False
    actual = base64.b64encode(digest.digest()).decode()
    return any(
        hmac.compare_digest(actual, encoded)
        for _algorithm, encoded in strongest_candidates
    )


def read_npm_tarball_manifest(path: Path) -> tuple[str, dict]:
    """Read package/package.json with bounded raw tar-header processing."""

    def read_exact(stream, length: int) -> bytes:
        chunks = []
        remaining = length
        while remaining:
            chunk = stream.read(min(remaining, 1024 * 1024))
            if not chunk:
                raise RuntimeError("npm tarball ended before the declared member size")
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)

    def parse_octal(field: bytes, label: str) -> int:
        if field and field[0] & 0x80:
            raise RuntimeError(f"npm tarball uses unsupported base-256 {label}")
        value = field.rstrip(b"\0 ").lstrip(b" ") or b"0"
        if re.fullmatch(rb"[0-7]+", value) is None:
            raise RuntimeError(f"npm tarball has invalid {label}")
        return int(value, 8)

    try:
        if path.stat().st_size > MAX_NPM_TARBALL_BYTES:
            raise RuntimeError("npm tarball exceeds the 256 MiB safety limit")
        manifests = []
        declared_size = 0
        with gzip.open(path, mode="rb") as archive:
            for count in range(1, MAX_NPM_TAR_MEMBERS + 2):
                header = read_exact(archive, 512)
                if header == b"\0" * 512:
                    break
                if count > MAX_NPM_TAR_MEMBERS:
                    raise RuntimeError("npm tarball exceeds the member-count safety limit")
                stored_checksum = parse_octal(header[148:156], "header checksum")
                calculated_checksum = sum(header[:148]) + (8 * ord(" ")) + sum(
                    header[156:]
                )
                if stored_checksum != calculated_checksum:
                    raise RuntimeError("npm tarball header checksum is invalid")
                size = parse_octal(header[124:136], "member size")
                if size > MAX_NPM_TAR_MEMBER_BYTES:
                    raise RuntimeError("npm tarball member exceeds the size safety limit")
                declared_size += size
                if declared_size > MAX_NPM_TAR_DECLARED_BYTES:
                    raise RuntimeError("npm tarball exceeds the declared-size safety limit")
                typeflag = header[156:157]
                if typeflag in {b"x", b"g", b"L", b"K"}:
                    raise RuntimeError("npm tarball extended headers are unsupported")
                name = header[0:100].split(b"\0", 1)[0]
                prefix = header[345:500].split(b"\0", 1)[0]
                encoded_path = b"/".join(part for part in (prefix, name) if part)
                member_path = PurePosixPath(encoded_path.decode("utf-8"))
                if member_path.is_absolute() or ".." in member_path.parts:
                    raise RuntimeError("npm tarball contains an unsafe member path")
                payload = read_exact(archive, size)
                padding = (-size) % 512
                if padding:
                    read_exact(archive, padding)
                parts = tuple(part for part in member_path.parts if part != ".")
                if parts == ("package", "package.json"):
                    if typeflag not in {b"", b"0"}:
                        raise RuntimeError(
                            "npm tarball package.json must be a regular file"
                        )
                    if size > 1024 * 1024:
                        raise RuntimeError(
                            "npm tarball package.json exceeds the 1 MiB safety limit"
                        )
                    manifests.append(payload)
            else:
                raise RuntimeError("npm tarball has no end marker")
        if len(manifests) != 1:
            raise RuntimeError("npm tarball must contain one bounded package/package.json")
        raw = manifests[0].decode("utf-8")
    except (OSError, UnicodeError, EOFError, gzip.BadGzipFile) as error:
        raise RuntimeError(f"cannot read npm tarball manifest: {error}") from error
    try:
        manifest = json.loads(raw, object_pairs_hook=_unique_object)
    except (ValueError, json.JSONDecodeError) as error:
        raise RuntimeError(f"npm tarball package.json is invalid: {error}") from error
    if not isinstance(manifest, dict):
        raise RuntimeError("npm tarball package.json must be an object")
    return raw, manifest


def normalize_pi_manifest(
    nix_dir: Path,
    target: str,
    expected_name: str,
    expected_version: str,
    raw_manifest: str,
    jq: Path,
    runner=subprocess.run,
) -> Optional[str]:
    contract = load_pi_normalization_contract(nix_dir)
    if target not in contract["targets"]:
        return None
    command = [
        str(jq),
        "--arg",
        "target",
        target,
        "--arg",
        "expectedName",
        expected_name,
        "--arg",
        "expectedVersion",
        expected_version,
        "--slurpfile",
        "policy",
        str(nix_dir / PI_NORMALIZATION_POLICY),
        "-f",
        str(nix_dir / PI_NORMALIZER),
    ]
    try:
        result = runner(
            command,
            input=raw_manifest,
            capture_output=True,
            text=True,
            timeout=60,
            cwd=nix_dir,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        raise RuntimeError(
            _bounded_actionable_error(
                getattr(result, "stderr", ""),
                result.stdout,
                fallback=f"jq exited with status {result.returncode}",
            )
        )
    if not result.stdout:
        return None
    try:
        normalized = json.loads(result.stdout, object_pairs_hook=_unique_object)
    except (ValueError, json.JSONDecodeError):
        return None
    if (
        not isinstance(normalized, dict)
        or normalized.get("name") != expected_name
        or normalized.get("version") != expected_version
    ):
        return None
    return result.stdout


def validate_npm_manifest_lock(manifest_text: str, lock_text: str) -> bool:
    try:
        manifest = json.loads(manifest_text, object_pairs_hook=_unique_object)
        lock = json.loads(lock_text, object_pairs_hook=_unique_object)
    except (ValueError, json.JSONDecodeError):
        return False
    if not isinstance(manifest, dict) or not isinstance(lock, dict):
        return False
    packages = lock.get("packages")
    root = packages.get("") if isinstance(packages, dict) else None
    if (
        lock.get("lockfileVersion") != 3
        or not isinstance(root, dict)
        or lock.get("name") != manifest.get("name")
        or lock.get("version") != manifest.get("version")
        or root.get("name") != manifest.get("name")
        or root.get("version") != manifest.get("version")
    ):
        return False
    for field in (
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "peerDependencies",
        "peerDependenciesMeta",
    ):
        manifest_value = manifest.get(field, {})
        root_value = root.get(field, {})
        if not isinstance(manifest_value, dict) or not isinstance(root_value, dict):
            return False
        if manifest_value != root_value:
            return False
    for package_path, descriptor in packages.items():
        if package_path == "":
            continue
        if not isinstance(descriptor, dict) or descriptor.get("link") is True:
            return False
        resolved = descriptor.get("resolved")
        integrity = descriptor.get("integrity")
        integrity_match = (
            re.fullmatch(r"(sha(?:1|256|384|512))-([A-Za-z0-9+/=]+)", integrity)
            if isinstance(integrity, str)
            else None
        )
        try:
            integrity_bytes = (
                base64.b64decode(integrity_match.group(2), validate=True)
                if integrity_match is not None
                else b""
            )
        except (ValueError, binascii.Error):
            integrity_bytes = b""
        if (
            not isinstance(resolved, str)
            or not resolved.startswith("https://registry.npmjs.org/")
            or integrity_match is None
            or len(integrity_bytes)
            != hashlib.new(integrity_match.group(1)).digest_size
        ):
            return False
    return True


def npm_lock_documents_equal(left: str, right: str) -> bool:
    try:
        documents = [
            json.loads(value, object_pairs_hook=_unique_object)
            for value in (left, right)
        ]
    except (ValueError, json.JSONDecodeError):
        return False
    for document in documents:
        if (
            isinstance(document, dict)
            and document.get("lockfileVersion") == 3
            and document.get("requires") is True
        ):
            document.pop("requires")
    return documents[0] == documents[1]


def validate_npm_resolution_manifest(manifest_text: str) -> bool:
    try:
        manifest = json.loads(manifest_text, object_pairs_hook=_unique_object)
    except (ValueError, json.JSONDecodeError):
        return False
    if not isinstance(manifest, dict):
        return False
    if any(
        manifest.get(field) not in (None, {}, [])
        for field in (
            "bundleDependencies",
            "bundledDependencies",
            "overrides",
            "resolutions",
            "workspaces",
        )
    ):
        return False
    package_name = re.compile(
        r"(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)", re.IGNORECASE
    )
    registry_spec = re.compile(r"[A-Za-z0-9*<>=~^| .+_-]+")

    def safe_spec(value: object) -> bool:
        if (
            not isinstance(value, str)
            or not value
            or value.strip() != value
            or value in {".", ".."}
            or value.startswith(("./", "../", "/"))
        ):
            return False
        if value.startswith("npm:"):
            alias = value.removeprefix("npm:")
            package, separator, version = alias.rpartition("@")
            return bool(
                separator
                and package_name.fullmatch(package)
                and registry_spec.fullmatch(version)
            )
        return registry_spec.fullmatch(value) is not None

    for field in ("dependencies", "optionalDependencies"):
        dependencies = manifest.get(field, {})
        if not isinstance(dependencies, dict):
            return False
        if not all(
            isinstance(name, str)
            and package_name.fullmatch(name)
            and safe_spec(specification)
            for name, specification in dependencies.items()
        ):
            return False
    return True


def generate_npm_lock(
    normalized_manifest: str,
    previous_lock: str,
    npm: Path,
    flags: list[str],
    runner=subprocess.run,
    proxy_factory=registry_only_proxy,
) -> Optional[str]:
    if not validate_npm_resolution_manifest(normalized_manifest):
        return None
    with tempfile.TemporaryDirectory(prefix="update-overlay-npm-lock-") as temp_dir:
        root = Path(temp_dir)
        manifest_path = root / "package.json"
        lock_path = root / "package-lock.json"
        manifest_path.write_text(normalized_manifest)
        lock_path.write_text(previous_lock)
        user_npmrc = root / "user.npmrc"
        global_npmrc = root / "global.npmrc"
        user_npmrc.write_text("")
        global_npmrc.write_text("")
        home = root / "home"
        cache = root / "cache"
        home.mkdir()
        cache.mkdir()
        environment = {
            key: os.environ[key]
            for key in (
                "LANG",
                "LC_ALL",
                "NIX_SSL_CERT_FILE",
                "SSL_CERT_FILE",
                "TZ",
            )
            if key in os.environ
        }
        environment.update(
            HOME=str(home),
            CI="true",
            PATH=str(npm.parent),
            GIT_CONFIG_GLOBAL="/dev/null",
            GIT_CONFIG_NOSYSTEM="1",
            GIT_SSH_COMMAND="/usr/bin/false",
            NODE_OPTIONS="",
            NODE_PATH="",
            npm_config_cache=str(cache),
            npm_config_git="/usr/bin/false",
            npm_config_userconfig=str(user_npmrc),
            npm_config_globalconfig=str(global_npmrc),
            npm_config_registry="https://registry.npmjs.org",
            npm_config_update_notifier="false",
        )
        try:
            with proxy_factory() as proxy:
                environment.update(
                    ALL_PROXY=proxy,
                    HTTP_PROXY=proxy,
                    HTTPS_PROXY=proxy,
                    NO_PROXY="",
                    npm_config_https_proxy=proxy,
                    npm_config_proxy=proxy,
                )
                result = runner(
                    [str(npm), "install", *flags],
                    capture_output=True,
                    text=True,
                    timeout=300,
                    cwd=root,
                    env=environment,
                )
        except (OSError, subprocess.TimeoutExpired):
            return None
        if result.returncode != 0 or manifest_path.read_text() != normalized_manifest:
            return None
        if lock_path.is_symlink() or not lock_path.is_file() or lock_path.stat().st_size > 20 * 1024 * 1024:
            return None
        generated = lock_path.read_text()
        return generated if validate_npm_manifest_lock(normalized_manifest, generated) else None


def _validate_https(name: str, value: object) -> str:
    if not isinstance(value, str) or not value.startswith("https://"):
        raise RuntimeError(f"source catalog URL must use HTTPS: {name}")
    return value


def _same_git_url(left: str, right: str) -> bool:
    def canonical(value: str) -> tuple[str, str]:
        parsed = urlsplit(value)
        return parsed.netloc.lower(), parsed.path.rstrip("/").removesuffix(".git")

    return canonical(left) == canonical(right)


def _normalized_package_name(value: str) -> str:
    return re.sub(r"[-_.]+", "-", value).lower()


def _github_release_asset_url(
    owner: str, repo: str, tag: str, asset: str
) -> str:
    return (
        f"https://github.com/{owner}/{repo}/releases/download/"
        f"{quote(tag, safe='')}/{quote(asset, safe='-._~')}"
    )


def _render_github_release_asset(
    template: object, version: object
) -> str:
    """Render one closed release-asset basename template."""
    token = "{version}"
    if not isinstance(template, str) or not template:
        raise ValueError("release asset template must be a non-empty string")
    if "/" in template or "\\" in template:
        raise ValueError("release asset template must be a basename")
    token_count = template.count(token)
    remainder = template.replace(token, "")
    if token_count > 1 or "{" in remainder or "}" in remainder:
        raise ValueError("release asset template has invalid placeholders")
    if not isinstance(version, str) or not version:
        raise ValueError("release asset version must be a non-empty string")
    if token_count and (
        "/" in version
        or "\\" in version
        or "{" in version
        or "}" in version
        or version in {".", ".."}
        or any(ord(character) < 32 or ord(character) == 127 for character in version)
    ):
        raise ValueError("release asset version is unsafe for a basename")
    rendered = template.replace(token, version)
    if (
        not rendered
        or "/" in rendered
        or "\\" in rendered
        or "{" in rendered
        or "}" in rendered
        or rendered in {".", ".."}
        or any(ord(character) < 32 or ord(character) == 127 for character in rendered)
    ):
        raise ValueError("rendered release asset is not a safe basename")
    return rendered


def _lock_input_node(lock: dict, input_name: str, catalog_name: str) -> dict:
    nodes = lock.get("nodes")
    root_name = lock.get("root", "root")
    if not isinstance(nodes, dict) or not isinstance(nodes.get(root_name), dict):
        raise RuntimeError("invalid portable flake lock structure")
    reference = nodes[root_name].get("inputs", {}).get(input_name)
    if not isinstance(reference, str) or not isinstance(nodes.get(reference), dict):
        raise RuntimeError(
            f"flake input projection has no selected lock node: {catalog_name} ({input_name})"
        )
    return nodes[reference]


def _flake_input_literal(nix_dir: Path, input_name: str, catalog_name: str) -> dict[str, str]:
    flake_path = nix_dir / "config" / "ai" / "flake.nix"
    if not flake_path.is_file():
        raise RuntimeError(f"flake input projection requires config/ai/flake.nix: {catalog_name}")
    text = flake_path.read_text()
    escaped = re.escape(input_name)
    urls = re.findall(rf'(?m)^\s*{escaped}\.url\s*=\s*"([^"]+)"\s*;', text)
    for match in re.finditer(rf"(?ms)^\s*{escaped}\s*=\s*\{{(.*?)^\s*\}};", text):
        urls.extend(re.findall(r'(?m)^\s*url\s*=\s*"([^"]+)"\s*;', match.group(1)))
    if len(urls) != 1 or not urls[0].startswith("github:"):
        raise RuntimeError(f"flake input projection has no unique github literal: {catalog_name}")
    parts = urls[0].removeprefix("github:").split("/")
    if len(parts) not in {2, 3} or not all(parts):
        raise RuntimeError(f"flake input projection has an invalid github literal: {catalog_name}")
    literal = {"type": "github", "owner": parts[0], "repo": parts[1]}
    if len(parts) == 3:
        literal["rev"] = parts[2]
    return literal


def _validate_flake_projection(
    nix_dir: Path, name: str, record: dict, portable_lock: Optional[dict]
) -> None:
    update = record["update"]
    source = record["source"]
    if source["fetcher"] != "fetchTree" or "input" not in update:
        return
    if portable_lock is None:
        raise RuntimeError(f"flake input projection requires config/ai/flake.lock: {name}")

    node = _lock_input_node(portable_lock, update["input"], name)
    locked = node.get("locked")
    original = node.get("original")
    if not isinstance(locked, dict) or not isinstance(original, dict):
        raise RuntimeError(f"flake input projection has no locked/original source: {name}")

    args = source["args"]
    for field in ("type", "owner", "repo", "rev", "narHash"):
        if args.get(field) != locked.get(field):
            raise RuntimeError(f"flake input projection {name} {field} does not match portable lock")
    for field in ("type", "owner", "repo"):
        if args.get(field) != original.get(field):
            raise RuntimeError(f"flake input projection {name} {field} does not match declared input")
    if "rev" in original and args.get("rev") != original["rev"]:
        raise RuntimeError(f"flake input projection {name} rev does not match declared input")
    literal = _flake_input_literal(nix_dir, update["input"], name)
    for field in ("type", "owner", "repo"):
        if args.get(field) != literal.get(field):
            raise RuntimeError(f"flake input projection {name} {field} does not match flake literal")
    if "rev" in literal and args.get("rev") != literal["rev"]:
        raise RuntimeError(f"flake input projection {name} rev does not match flake literal")


def _validate_fetch_record(name: str, source: dict) -> None:
    if not isinstance(source, dict) or set(source) != {"args", "fetcher", "url"}:
        raise RuntimeError(f"invalid source object for {name}")
    args = source["args"]
    if not isinstance(args, dict):
        raise RuntimeError(f"source catalog record has no fetcher args: {name}")

    fetcher = source["fetcher"]
    required = {
        "fetchFromGitHub": {"owner", "repo"},
        "fetchgit": {"rev"},
        "fetchurl": set(),
        "fetchzip": set(),
        "fetchpatch": set(),
        "fetchPypi": {"pname", "version"},
        "fetchTree": {"owner", "repo", "rev", "type"},
    }
    if fetcher not in required:
        raise RuntimeError(f"unknown source fetcher for {name}: {fetcher}")
    missing = required[fetcher] - args.keys()
    if missing:
        raise RuntimeError(f"invalid source catalog record {name}: missing {sorted(missing)}")

    identity_url = _validate_https(name, source["url"])
    hash_fields = {"hash", "sha256", "narHash"} & args.keys()
    allowed_hashes = {"narHash"} if fetcher == "fetchTree" else {"hash", "sha256"}
    if len(hash_fields) != 1 or not hash_fields <= allowed_hashes:
        raise RuntimeError(f"source catalog record must have exactly one native hash: {name}")
    hash_value = args[next(iter(hash_fields))]
    if not isinstance(hash_value, str) or not hash_value:
        raise RuntimeError(f"invalid source hash for {name}")

    if fetcher == "fetchFromGitHub":
        refs = {"rev", "tag"} & args.keys()
        if len(refs) != 1:
            raise RuntimeError(f"fetchFromGitHub record must have exactly one rev or tag: {name}")
        expected = f"https://github.com/{args['owner']}/{args['repo']}"
        if not _same_git_url(identity_url, expected):
            raise RuntimeError(f"GitHub identity does not match fetcher args: {name}")
    elif fetcher == "fetchTree":
        if args["type"] != "github":
            raise RuntimeError(f"unsupported fetchTree type for {name}: {args['type']}")
        expected = f"https://github.com/{args['owner']}/{args['repo']}"
        if not _same_git_url(identity_url, expected):
            raise RuntimeError(f"GitHub identity does not match fetcher args: {name}")
    elif fetcher == "fetchPypi":
        parsed = urlsplit(identity_url)
        parts = [part for part in parsed.path.split("/") if part]
        if (
            parsed.netloc.lower() != "pypi.org"
            or len(parts) != 2
            or parts[0] != "project"
            or _normalized_package_name(parts[1]) != _normalized_package_name(args["pname"])
        ):
            raise RuntimeError(f"PyPI identity does not match fetcher args: {name}")
    elif fetcher in {"fetchgit", "fetchurl", "fetchzip", "fetchpatch"}:
        locators = {"url", "urls"} & args.keys()
        if len(locators) != 1:
            raise RuntimeError(f"source catalog record must have exactly one url or urls: {name}")
        values = [args["url"]] if "url" in args else args["urls"]
        if not isinstance(values, list) or not values:
            raise RuntimeError(f"invalid source URLs for {name}")
        actual_urls = [_validate_https(name, value) for value in values]
        matches = (
            any(_same_git_url(identity_url, value) for value in actual_urls)
            if fetcher == "fetchgit"
            else identity_url in actual_urls
        )
        if not matches:
            raise RuntimeError(f"source identity does not match fetcher args: {name}")


def _catalog_executor(record: dict) -> Optional[str]:
    update = record["update"]
    if update["kind"] == "npm-release" and update.get("normalizer") == "pi-gallery-v1":
        return "update"
    if update["kind"] == "github-release-asset" or update.get("buildMode") or update.get(
        "artifactSources"
    ):
        return "update"
    if (
        update["kind"] == "pypi-release"
        and record.get("artifacts")
        and not record.get("hashes")
    ):
        return "update"
    if update["kind"] in {
        "fixed-flake-input",
        "flake-input",
        "flake-input+build",
        "flake-input+copy",
        "npm-release+flake-input",
    }:
        return "update"
    expected_fetchers = {
        "explicit-rev": {"fetchgit", "fetchpatch", "fetchTree", "fetchurl"},
        "github-commit": {"fetchFromGitHub"},
        "github-release": {"fetchFromGitHub"},
        "github-tag": {"fetchFromGitHub"},
        "npm-release": {"fetchurl", "fetchzip"},
        "pypi-release": {"fetchPypi", "fetchurl"},
        "url-release": {"fetchurl"},
    }.get(update["kind"], set())
    if (
        record["source"]["fetcher"] in expected_fetchers
        and not update.get("artifacts")
        and not record.get("artifacts")
        and set(record.get("hashes", {})) <= {"cargoHash", "npmDepsHash", "vendorHash"}
    ):
        return "update-overlay"
    return None


def load_source_catalog(
    nix_dir: Path,
    *,
    validate_flake_projections: bool = True,
) -> dict[str, dict]:
    """Load data-only package source records from sources/*.json."""
    catalog_dir = nix_dir / "sources"
    targets = {}
    normalization_path = nix_dir / PI_NORMALIZATION_POLICY
    pi_normalization = (
        load_pi_normalization_contract(nix_dir)
        if normalization_path.is_file()
        else None
    )
    pi_npm_targets: set[str] = set()
    pi_lock_shape_targets: set[str] = set()
    artifact_owners: dict[Path, set[str]] = {}
    allowed = {
        "artifacts", "commit", "date", "hashes", "source", "update", "version",
    }
    common_update_fields = {"artifacts", "kind", "policy", "reason"}
    update_schema = {
        "explicit-rev": (common_update_fields | {"branch"}, set()),
        "fixed-flake-input": (common_update_fields | {"input"}, {"input"}),
        "flake-input": (common_update_fields | {"input"}, {"input"}),
        "flake-input+build": (
            common_update_fields | {"buildPackage", "input"},
            {"buildPackage", "input"},
        ),
        "flake-input+copy": (common_update_fields | {"input"}, {"input"}),
        "github-commit": (
            common_update_fields | {"artifactSources", "branch", "buildMode"},
            {"branch"},
        ),
        "github-release": (
            common_update_fields | {"buildMode", "normalizer", "tagPrefix"},
            set(),
        ),
        "github-tag": (
            common_update_fields | {"buildMode", "tagPrefix"},
            set(),
        ),
        "github-release-asset": (
            common_update_fields | {"assets", "owner", "repo", "tagPrefix"},
            {"assets", "owner", "repo", "tagPrefix"},
        ),
        "npm-release": (
            common_update_fields | {"normalizer", "package"},
            {"package"},
        ),
        "npm-release+flake-input": (
            common_update_fields | {"input", "package"},
            {"input", "package"},
        ),
        "pypi-release": (common_update_fields | {"package"}, {"package"}),
        "url-release": (common_update_fields, set()),
    }
    portable_lock_path = nix_dir / "config" / "ai" / "flake.lock"
    portable_lock = None
    for path in sorted(catalog_dir.glob("*.json")):
        payload = json.loads(path.read_text(), object_pairs_hook=_unique_object)
        if set(payload) != {"schemaVersion", "sources"}:
            raise RuntimeError(f"invalid source catalog document fields: {path}")
        if payload.get("schemaVersion") != 1 or not isinstance(payload.get("sources"), dict):
            raise RuntimeError(f"invalid source catalog schema: {path}")
        for name, record in payload["sources"].items():
            if name in targets:
                raise RuntimeError(f"duplicate source catalog id: {name}")
            unknown = record.keys() - allowed
            if unknown:
                raise RuntimeError(f"unknown source catalog fields for {name}: {sorted(unknown)}")
            for field in ("version", "date", "commit"):
                if field in record and (not isinstance(record[field], str) or not record[field]):
                    raise RuntimeError(f"invalid source catalog {field}: {name}")
            _validate_fetch_record(name, record.get("source"))
            artifacts = record.get("artifacts", {})
            if not isinstance(artifacts, dict):
                raise RuntimeError(f"invalid source artifacts for source catalog record: {name}")
            for artifact, fetch in artifacts.items():
                _validate_fetch_record(f"{name}.{artifact}", fetch)
            hashes = record.get("hashes", {})
            if not isinstance(hashes, dict) or not all(isinstance(value, str) and value for value in hashes.values()):
                raise RuntimeError(f"invalid dependent hashes for source catalog record: {name}")
            update = record.get("update")
            if not isinstance(update, dict) or update.get("kind") not in update_schema:
                raise RuntimeError(f"invalid update strategy for source catalog record: {name}")
            update_allowed, update_required = update_schema[update["kind"]]
            if update.keys() - update_allowed or update_required - update.keys():
                raise RuntimeError(f"invalid update strategy fields for source catalog record: {name}")
            policy = update.get("policy", "automatic")
            if policy not in {"automatic", "manual"}:
                raise RuntimeError(f"invalid update policy for source catalog record: {name}")
            if "reason" in update and (not isinstance(update["reason"], str) or not update["reason"]):
                raise RuntimeError(f"invalid update reason for source catalog record: {name}")
            if policy == "manual" and "reason" not in update:
                raise RuntimeError(f"manual source catalog record requires a reason: {name}")
            kind = update["kind"]
            build_mode = update.get("buildMode")
            if build_mode is not None and (
                build_mode not in {"pkg", "python"} or not hashes
            ):
                raise RuntimeError(
                    f"invalid dependent-hash build mode for source catalog record: {name}"
                )
            if kind == "flake-input+build" and (
                not isinstance(update["buildPackage"], str)
                or not update["buildPackage"]
                or not hashes
            ):
                raise RuntimeError(
                    f"invalid flake input build strategy for source catalog record: {name}"
                )
            source_args = record["source"]["args"]
            source_fetcher = record["source"]["fetcher"]
            tag_prefix = update.get("tagPrefix")
            if kind in {"github-release", "github-tag"} and tag_prefix is not None and not isinstance(
                tag_prefix, str
            ):
                raise RuntimeError(
                    f"invalid GitHub release tag prefix for source catalog record: {name}"
                )
            if build_mode is not None and kind in {
                "github-commit",
                "github-release",
                "github-tag",
            } and source_fetcher != "fetchFromGitHub":
                raise RuntimeError(
                    f"GitHub dependent-hash projection requires fetchFromGitHub: {name}"
                )
            if validate_flake_projections:
                if (
                    source_fetcher == "fetchTree"
                    or kind == "npm-release+flake-input"
                ) and "input" in update and portable_lock is None:
                    if not portable_lock_path.is_file():
                        raise RuntimeError(
                            f"flake input projection requires config/ai/flake.lock: {name}"
                        )
                    portable_lock = json.loads(portable_lock_path.read_text())
                _validate_flake_projection(nix_dir, name, record, portable_lock)
                if kind == "npm-release+flake-input":
                    flake_input = artifacts.get("flakeInput")
                    if not isinstance(flake_input, dict):
                        raise RuntimeError(
                            f"npm flake input record has no flakeInput artifact: {name}"
                        )
                    _validate_flake_projection(
                        nix_dir,
                        name,
                        {
                            "source": flake_input,
                            "update": {
                                "input": update["input"],
                                "kind": "fixed-flake-input",
                            },
                        },
                        portable_lock,
                    )
            if source_fetcher == "fetchPypi" and record.get("version") != source_args["version"]:
                raise RuntimeError(f"PyPI source version does not match catalog version: {name}")
            if kind == "github-commit" and (
                source_fetcher != "fetchFromGitHub"
                or "rev" not in source_args
                or "tag" in source_args
            ):
                raise RuntimeError(f"github-commit requires a native rev field: {name}")
            if kind == "github-release-asset":
                owner = update["owner"]
                repo = update["repo"]
                assets = update["assets"]
                expected_asset_labels = {"source"} | set(artifacts)
                fetches = {"source": record["source"], **artifacts}
                if (
                    not isinstance(owner, str)
                    or re.fullmatch(r"[A-Za-z0-9_.-]+", owner) is None
                    or not isinstance(repo, str)
                    or re.fullmatch(r"[A-Za-z0-9_.-]+", repo) is None
                    or not isinstance(assets, dict)
                    or "source" in artifacts
                    or set(assets) != expected_asset_labels
                    or bool(hashes)
                    or any(fetch["fetcher"] != "fetchurl" for fetch in fetches.values())
                ):
                    raise RuntimeError(
                        f"invalid GitHub release asset projection: {name}"
                    )
                prefix = update.get("tagPrefix", "")
                version = record.get("version")
                if not isinstance(prefix, str) or not isinstance(version, str):
                    raise RuntimeError(
                        f"invalid GitHub release asset version projection: {name}"
                    )
                tag = f"{prefix}{version}"
                for label, fetch in fetches.items():
                    try:
                        asset = _render_github_release_asset(
                            assets[label], version
                        )
                    except ValueError as error:
                        raise RuntimeError(
                            f"invalid GitHub release asset projection: {name}"
                        ) from error
                    expected_url = _github_release_asset_url(
                        owner, repo, tag, asset
                    )
                    if (
                        fetch["url"] != expected_url
                        or fetch["args"].get("url") != expected_url
                    ):
                        raise RuntimeError(
                            f"GitHub release asset URL does not match projection: {name}.{label}"
                        )
            if kind in {"npm-release", "npm-release+flake-input"}:
                package = update["package"]
                if (
                    source_fetcher not in {"fetchurl", "fetchzip"}
                    or f"/{package}/-/" not in source_args["url"]
                ):
                    raise RuntimeError(f"npm source identity does not match update package: {name}")
                version = record.get("version")
                if not isinstance(version, str) or source_args["url"].count(version) != 1:
                    raise RuntimeError(
                        f"npm source URL does not match catalog version: {name}"
                    )
            if kind == "pypi-release" and source_fetcher == "fetchPypi":
                if _normalized_package_name(source_args["pname"]) != _normalized_package_name(
                    update["package"]
                ):
                    raise RuntimeError(f"PyPI source identity does not match update package: {name}")
            if kind == "pypi-release" and artifacts:
                fetches = [record["source"], *artifacts.values()]
                if source_fetcher != "fetchPypi" or any(
                    fetch["fetcher"] != "fetchPypi" for fetch in artifacts.values()
                ):
                    raise RuntimeError(
                        f"compound PyPI record requires native fetchPypi artifacts: {name}"
                    )
                version = record.get("version")
                if not isinstance(version, str) or any(
                    fetch["args"]["version"] != version for fetch in fetches
                ):
                    raise RuntimeError(
                        f"compound PyPI artifact version does not match catalog version: {name}"
                    )
            update_artifacts = update.get("artifacts", [])
            if (
                not isinstance(update_artifacts, list)
                or not all(isinstance(value, str) and value for value in update_artifacts)
            ):
                raise RuntimeError(f"invalid update artifacts for source catalog record: {name}")
            catalog_root = nix_dir.resolve()
            invalid_artifacts = [
                value for value in update_artifacts
                if Path(value).is_absolute()
                or not (nix_dir / value).resolve().is_relative_to(catalog_root)
            ]
            if invalid_artifacts:
                raise RuntimeError(
                    f"source catalog record {name} references unsafe artifacts: {invalid_artifacts}"
                )
            missing_artifacts = [
                value
                for value in update_artifacts
                if not (nix_dir / value).is_file()
                or (nix_dir / value).is_symlink()
            ]
            if missing_artifacts:
                raise RuntimeError(f"source catalog record {name} references missing artifacts: {missing_artifacts}")
            for artifact in update_artifacts:
                artifact_owners.setdefault((nix_dir / artifact).resolve(), set()).add(name)
            pi_lock_shape = (
                path.name == "pi.json"
                and kind == "npm-release"
                and bool(update_artifacts)
                and set(hashes) == {"npmDepsHash"}
            )
            if pi_lock_shape:
                pi_lock_shape_targets.add(name)
            normalizer = update.get("normalizer")
            prime_normalization = normalizer == PRIME_AGENT_NORMALIZER
            if prime_normalization:
                if (
                    name != "prime-agent"
                    or kind != "github-release"
                    or source_fetcher != "fetchFromGitHub"
                    or artifacts
                    or update_artifacts != [str(PRIME_AGENT_LOCK)]
                    or set(hashes) != {"npmDepsHash"}
                    or build_mode != "pkg"
                ):
                    raise RuntimeError(
                        f"invalid Prime Agent lock normalization projection: {name}"
                    )
            elif normalizer is not None:
                canonical_lock = (
                    f"packages/pi-gallery/locks/{name}-package-lock.json"
                )
                if (
                    normalizer != "pi-gallery-v1"
                    or kind != "npm-release"
                    or path.name != "pi.json"
                    or pi_normalization is None
                    or name not in pi_normalization["targets"]
                    or source_fetcher != "fetchurl"
                    or artifacts
                    or update_artifacts != [canonical_lock]
                    or set(hashes) != {"npmDepsHash"}
                ):
                    raise RuntimeError(
                        f"invalid Pi npm normalization projection: {name}"
                    )
                pi_npm_targets.add(name)
            if build_mode is not None and (artifacts or update_artifacts) and not prime_normalization:
                raise RuntimeError(
                    f"dependent-hash projection cannot also declare artifacts: {name}"
                )
            artifact_sources = update.get("artifactSources")
            if artifact_sources is not None or (
                kind == "github-commit" and update_artifacts
            ):
                if (
                    not isinstance(artifact_sources, dict)
                    or set(artifact_sources) != set(update_artifacts)
                    or not all(
                        isinstance(value, str)
                        and value
                        and not Path(value).is_absolute()
                        and ".." not in Path(value).parts
                        for value in artifact_sources.values()
                    )
                ):
                    raise RuntimeError(
                        f"invalid exact-revision artifact projection: {name}"
                    )
                if hashes:
                    raise RuntimeError(
                        f"exact-revision artifact projection cannot also declare "
                        f"dependent hashes: {name}"
                    )
            targets[name] = {
                "kind": update["kind"],
                "version": record.get("version", record["source"]["args"].get("rev", record["source"]["args"].get("tag", "unversioned"))),
                "files": [str(path.relative_to(nix_dir)), *update_artifacts],
                "source": "catalog",
                "executor": _catalog_executor(record),
                "_document": payload,
                "_path": path,
                "_record": record,
            }
    if pi_normalization is not None:
        policy_targets = set(pi_normalization["targets"])
        if pi_lock_shape_targets != policy_targets or pi_npm_targets != policy_targets:
            raise RuntimeError(
                "Pi npm normalization target set differs from catalog projections"
            )
        for name in policy_targets:
            canonical_lock = (
                f"packages/pi-gallery/locks/{name}-package-lock.json"
            )
            canonical_path = (nix_dir / canonical_lock).resolve()
            if artifact_owners.get(canonical_path, set()) != {name}:
                raise RuntimeError(
                    "Pi npm lock artifact must have exactly its normalizer target "
                    f"as owner: {canonical_lock}"
                )
    return targets


def resolve_flake_input_version(
    nix_dir: Path, input_name: str, locked: dict, runner=subprocess.run
) -> str:
    fetch_args = {
        field: locked[field]
        for field in ("type", "owner", "repo", "rev", "narHash")
    }
    expression = f"""
let
  input = builtins.fetchTree (builtins.fromJSON {json.dumps(json.dumps(fetch_args))});
  package = builtins.fromJSON (builtins.readFile (input.outPath + "/package.json"));
in
  package.version
"""
    result = runner(
        ["nix", "eval", "--impure", "--raw", "--expr", expression],
        capture_output=True,
        text=True,
        timeout=600,
        cwd=nix_dir,
    )
    version = result.stdout.strip()
    if result.returncode != 0 or not version:
        raise RuntimeError(f"failed to resolve flake input package version: {input_name}")
    return version


def resolve_flake_input_dependent_hash(
    nix_dir: Path, package_name: str, hash_type: str
) -> str:
    value = HashComputer(nix_dir)._compute_fod_hash(package_name, hash_type)
    if not value:
        raise RuntimeError(
            f"failed to resolve flake input dependent hash: {package_name}.{hash_type}"
        )
    return value


def validate_flake_input_build(nix_dir: Path, package_name: str) -> None:
    validator = HashComputer(nix_dir)
    if not validator.validate_package_build(package_name):
        raise CandidateRejected(
            f"flake input package validation failed: {package_name}"
        )


def sync_flake_projections(
    nix_dir: Path,
    version_resolver=resolve_flake_input_version,
    dependent_hash_resolver=resolve_flake_input_dependent_hash,
    build_validator=validate_flake_input_build,
) -> int:
    """Refresh catalog fetchTree projections from the selected portable lock nodes."""
    lock_path = nix_dir / "config" / "ai" / "flake.lock"
    if not lock_path.is_file():
        raise RuntimeError("flake projection sync requires config/ai/flake.lock")
    portable_lock = json.loads(lock_path.read_text())
    changed_records = 0
    for path in sorted((nix_dir / "sources").glob("*.json")):
        payload = json.loads(path.read_text(), object_pairs_hook=_unique_object)
        changed_document = False
        for name, record in payload.get("sources", {}).items():
            source = record.get("source", {})
            update = record.get("update", {})
            if source.get("fetcher") != "fetchTree" or not isinstance(update.get("input"), str):
                continue
            node = _lock_input_node(portable_lock, update["input"], name)
            locked = node.get("locked")
            if not isinstance(locked, dict):
                raise RuntimeError(f"flake input projection has no locked source: {name}")
            args = source.get("args")
            if not isinstance(args, dict):
                raise RuntimeError(f"flake input projection has no fetchTree args: {name}")
            projected = {
                **args,
                **{field: locked[field] for field in ("type", "owner", "repo", "rev", "narHash")},
            }
            projected_url = f"https://github.com/{locked['owner']}/{locked['repo']}"
            record_changed = False
            if projected != args or source.get("url") != projected_url:
                source["args"] = projected
                source["url"] = projected_url
                record_changed = True
            if update["kind"] in {"flake-input+build", "flake-input+copy"}:
                projected_version = version_resolver(
                    nix_dir, update["input"], locked
                )
                if record.get("version") != projected_version:
                    record["version"] = projected_version
                    record_changed = True
            if update["kind"] == "flake-input+build" and record_changed:
                dependent_hashes = record.get("hashes", {})
                if not dependent_hashes:
                    raise RuntimeError(
                        f"flake input build has no dependent hashes: {name}"
                    )
                for hash_type in dependent_hashes:
                    dependent_hashes[hash_type] = DUMMY_SRI_HASH
                    path.write_text(json.dumps(payload, indent=2) + "\n")
                    dependent_hashes[hash_type] = dependent_hash_resolver(
                        nix_dir, update["buildPackage"], hash_type
                    )
                path.write_text(json.dumps(payload, indent=2) + "\n")
                build_validator(nix_dir, update["buildPackage"])
            if record_changed:
                changed_document = True
                changed_records += 1
        if changed_document:
            path.write_text(json.dumps(payload, indent=2) + "\n")
    load_source_catalog(nix_dir)
    return changed_records


def require_detached_linked_worktree(nix_dir: Path) -> None:
    """Refuse projection writes in the primary or any branch-attached worktree."""
    dotgit = nix_dir / ".git"
    if not dotgit.is_file():
        raise RuntimeError("projection sync requires a detached linked worktree")
    pointer = dotgit.read_text().strip()
    if not pointer.startswith("gitdir:"):
        raise RuntimeError("projection sync requires a detached linked worktree")
    git_dir = Path(pointer.removeprefix("gitdir:").strip())
    if not git_dir.is_absolute():
        git_dir = (nix_dir / git_dir).resolve()
    if not git_dir.is_dir() or not (git_dir / "commondir").is_file():
        raise RuntimeError("projection sync requires a detached linked worktree")
    head_path = git_dir / "HEAD"
    if not head_path.is_file() or head_path.read_text().strip().startswith("ref:"):
        raise RuntimeError("projection sync requires a detached linked worktree")


def build_inventory(catalog_targets: dict[str, dict]) -> dict:
    """Return the catalog-owned update target inventory."""
    packages = []
    for name, target in catalog_targets.items():
        executor = target.get("executor")
        package = {
            "name": name,
            "source": "catalog",
            "kind": target["kind"],
            "version": target.get("version", target.get("rev", "")),
            "files": target["files"],
            "inventoried": True,
            "managed": executor is not None,
            "executor": executor,
        }
        update = target["_record"]["update"]
        package["policy"] = update.get("policy", "automatic")
        if "reason" in update:
            package["reason"] = update["reason"]
        if "input" in update:
            package["input"] = update["input"]
        packages.append(package)
    return {
        "schemaVersion": 1,
        "packages": sorted(packages, key=lambda item: item["name"]),
    }


def print_inventory(inventory: dict, json_output: bool) -> None:
    if json_output:
        print(json.dumps(inventory, indent=2, sort_keys=True))
        return
    for package in inventory["packages"]:
        print(f"{package['name']}\t{package['kind']}\t{package['version']}")
    managed = sum(package["managed"] for package in inventory["packages"])
    pending = len(inventory["packages"]) - managed
    print(
        f"{len(inventory['packages'])} inventoried targets; {managed} executable; "
        f"{pending} pending executors"
    )


def delegate_to_update(nix_dir: Path, names: list[str], args, runner=subprocess.run) -> int:
    command = [str(Path(__file__).with_name("update"))]
    for name in names:
        command.extend(["--target", name])
    if args.version:
        command.extend(["--version", args.version])
    if args.dry_run:
        command.append("--dry-run")
    environment = {**os.environ, "NIX_CONFIG_DIR": str(nix_dir)}
    result = runner(command, cwd=nix_dir, env=environment, check=False)
    return result.returncode


class SourceTransaction:
    """Restore every watched source file unless the invocation commits."""

    def __init__(self) -> None:
        self.original: dict[Path, str] = {}
        self.committed = False

    def watch(self, path: Path) -> None:
        self.original.setdefault(path, path.read_text())

    def rollback(self) -> int:
        restored = 0
        for path, content in self.original.items():
            if path.read_text() != content:
                path.write_text(content)
                restored += 1
        self.committed = True
        return restored

    def commit(self) -> None:
        self.committed = True

    def rollback_unless_committed(self) -> None:
        if not self.committed:
            self.rollback()


def snapshot_catalog_record_isolation(
    names: list[str],
    targets: dict[str, dict],
    transaction: SourceTransaction,
) -> dict[Path, tuple[dict, set[str]]]:
    """Snapshot shared catalog documents for an explicit target selection."""
    selected_by_path: dict[Path, set[str]] = {}
    for name in names:
        selected_by_path.setdefault(targets[name]["_path"], set()).add(name)

    snapshots = {}
    for path, selected in selected_by_path.items():
        transaction.watch(path)
        snapshots[path] = (
            json.loads(path.read_text(), object_pairs_hook=_unique_object),
            selected,
        )
    return snapshots


def validate_catalog_record_isolation(
    snapshots: dict[Path, tuple[dict, set[str]]],
) -> None:
    """Allow changes only below .sources for explicitly selected records."""
    for path, (before, selected) in snapshots.items():
        try:
            after = json.loads(path.read_text(), object_pairs_hook=_unique_object)
        except (ValueError, json.JSONDecodeError) as error:
            raise RuntimeError(
                f"catalog update made shared document invalid: {path}"
            ) from error
        before_sources = before.get("sources")
        after_sources = after.get("sources")
        if (
            not isinstance(before_sources, dict)
            or not isinstance(after_sources, dict)
            or set(before_sources) != set(after_sources)
        ):
            raise RuntimeError(
                f"catalog update changed the record set in shared document: {path}"
            )
        unexpected = sorted(
            name
            for name in before_sources
            if name not in selected and before_sources[name] != after_sources[name]
        )
        masked_after = copy.deepcopy(after)
        for name in selected:
            masked_after["sources"][name] = before_sources[name]
        if unexpected or masked_after != before:
            detail = f": {unexpected}" if unexpected else ""
            raise RuntimeError(
                f"catalog update changed unselected data in {path}{detail}"
            )


def enforce_catalog_record_isolation(
    snapshots: dict[Path, tuple[dict, set[str]]],
    transaction: SourceTransaction,
) -> None:
    """Validate explicit records and roll back the transaction on any escape."""
    try:
        validate_catalog_record_isolation(snapshots)
    except RuntimeError:
        transaction.rollback()
        raise


def _write_catalog_target(target: dict) -> None:
    target["_path"].write_text(json.dumps(target["_document"], indent=2) + "\n")


def _rewrite_fixed_flake_input(target: dict, old_rev: str, new_rev: str) -> Path:
    record = target["_record"]
    source_args = record["source"]["args"]
    flake_path = target["_path"].parent.parent / "config" / "ai" / "flake.nix"
    old_url = f"github:{source_args['owner']}/{source_args['repo']}/{old_rev}"
    new_url = f"github:{source_args['owner']}/{source_args['repo']}/{new_rev}"
    text = flake_path.read_text()
    if text.count(old_url) != 1:
        raise RuntimeError(
            f"fixed flake input {record['update']['input']} has no unique literal revision"
        )
    flake_path.write_text(text.replace(old_url, new_url, 1))
    return flake_path


def _rewrite_npm_flake_input_literal(target: dict, new_rev: str) -> Path:
    record = target["_record"]
    update = record["update"]
    git_args = record["artifacts"]["flakeInput"]["args"]
    flake_path = target["_path"].parent.parent / "config" / "ai" / "flake.nix"
    base_url = f"github:{git_args['owner']}/{git_args['repo']}"
    pattern = re.compile(rf'{re.escape(base_url)}(?:/[0-9a-f]{{40}})?(?=")')
    text = flake_path.read_text()
    matches = pattern.findall(text)
    if len(matches) != 1:
        raise RuntimeError(
            f"npm flake input {update['input']} has no unique literal revision"
        )
    flake_path.write_text(pattern.sub(f"{base_url}/{new_rev}", text, count=1))
    return flake_path


def update_npm_flake_target(
    name: str,
    target: dict,
    args,
    npm_client: NpmRegistryClient,
    hash_computer: HashComputer,
    transaction,
) -> str:
    record = target["_record"]
    source = record["source"]
    source_args = source["args"]
    update = record["update"]
    git_source = record["artifacts"]["flakeInput"]
    git_args = git_source["args"]
    metadata = npm_client.get_version_metadata(update["package"], args.version)
    if metadata is None or re.fullmatch(r"[0-9a-f]{40}", metadata.get("gitHead", "")) is None:
        print(f"{Colors.RED}{name}: npm release has no exact gitHead{Colors.RESET}")
        return "failed"

    old_version = record["version"]
    new_version = metadata["version"]
    old_url = source_args["url"]
    if old_url.count(old_version) != 1:
        print(f"{Colors.RED}{name}: npm URL has no unique version coordinate{Colors.RESET}")
        return "failed"
    new_url = (
        old_url
        if old_version == new_version
        else old_url.replace(old_version, new_version, 1)
    )
    new_rev = metadata["gitHead"]
    new_tar_hash = hash_computer.compute_native_hash(source, {"url": new_url})
    if not new_tar_hash:
        message = _failure_message(
            "source archive hash failed",
            getattr(hash_computer, "last_error", None),
        )
        print(f"{Colors.RED}{name}: {message}{Colors.RESET}")
        return "failed"
    new_git_hash = hash_computer.compute_native_hash(git_source, {"rev": new_rev})
    if not new_git_hash:
        message = _failure_message(
            "flake input hash failed",
            getattr(hash_computer, "last_error", None),
        )
        print(f"{Colors.RED}{name}: {message}{Colors.RESET}")
        return "failed"

    flake_path = target["_path"].parent.parent / "config" / "ai" / "flake.nix"
    exact_literal = f"github:{git_args['owner']}/{git_args['repo']}/{new_rev}"
    changed = (
        new_version != old_version
        or new_url != old_url
        or new_tar_hash != source_args["hash"]
        or new_rev != git_args["rev"]
        or new_git_hash != git_args["narHash"]
        or exact_literal not in flake_path.read_text()
    )
    if not changed:
        print(f"catalog/{name} {Colors.GREEN}✓ up-to-date{Colors.RESET}")
        return "skipped"
    if args.dry_run:
        print(f"catalog/{name} {Colors.CYAN}→ {new_version} (dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    transaction.watch(flake_path)
    record["version"] = new_version
    source_args["url"] = new_url
    source_args["hash"] = new_tar_hash
    source["url"] = new_url
    git_args["rev"] = new_rev
    git_args["narHash"] = new_git_hash
    _rewrite_npm_flake_input_literal(target, new_rev)
    _write_catalog_target(target)
    print(f"catalog/{name} {Colors.GREEN}→ {new_version} ✓{Colors.RESET}")
    return "updated"


def update_npm_lock_target(
    name: str,
    target: dict,
    args,
    npm_client: NpmRegistryClient,
    hash_computer: HashComputer,
    transaction,
    *,
    manifest_reader=read_npm_tarball_manifest,
    manifest_normalizer=normalize_pi_manifest,
    lock_generator=generate_npm_lock,
    integrity_verifier=verify_npm_integrity,
) -> str:
    """Regenerate one Pi npm lock from the shared normalized manifest."""
    record = target["_record"]
    source = record["source"]
    source_args = source["args"]
    update = record["update"]
    old_version = record["version"]
    metadata = npm_client.get_version_metadata(update["package"], args.version)
    if metadata is None:
        print(f"catalog/{name} {Colors.RED}✗ npm lookup failed{Colors.RESET}")
        return "failed"
    new_version = metadata["version"]
    registry_integrity = metadata["integrity"]
    new_url = metadata["tarball"]
    if not new_url.startswith("https://registry.npmjs.org/"):
        print(f"catalog/{name} {Colors.RED}✗ unsupported npm tarball host{Colors.RESET}")
        return "failed"
    current_url = source_args["url"]
    if current_url.count(old_version) != 1:
        print(f"catalog/{name} {Colors.RED}✗ source URL rewrite failed{Colors.RESET}")
        return "failed"
    if current_url.replace(old_version, new_version, 1) != new_url:
        print(f"catalog/{name} {Colors.RED}✗ registry tarball mismatch{Colors.RESET}")
        return "failed"
    hash_name = next(iter({"hash", "sha256"} & source_args.keys()))
    new_source_hash = hash_computer.compute_native_hash(source, {"url": new_url})
    if not new_source_hash:
        message = _failure_message(
            "source hash failed",
            getattr(hash_computer, "last_error", None),
        )
        print(f"catalog/{name} {Colors.RED}✗ {message}{Colors.RESET}")
        return "failed"
    source_path = hash_computer.realize_native_source(
        source,
        {"url": new_url, hash_name: new_source_hash},
    )
    jq = hash_computer.resolve_build_tool("jq", "jq")
    npm = hash_computer.resolve_build_tool("nodejs_22", "npm")
    if source_path is None or jq is None or npm is None:
        print(f"catalog/{name} {Colors.RED}✗ locked toolchain failed{Colors.RESET}")
        return "failed"
    if not integrity_verifier(source_path, registry_integrity):
        print(f"catalog/{name} {Colors.RED}✗ registry integrity mismatch{Colors.RESET}")
        return "failed"
    try:
        raw_manifest, _raw_document = manifest_reader(source_path)
    except RuntimeError as error:
        print(f"catalog/{name} {Colors.RED}✗ {error}{Colors.RESET}")
        return "failed"
    try:
        normalized_manifest = manifest_normalizer(
            target["_path"].parent.parent,
            name,
            update["package"],
            new_version,
            raw_manifest,
            jq,
        )
    except RuntimeError as error:
        detail = _bounded_actionable_error(
            error,
            fallback="manifest normalizer rejected the candidate",
        )
        print(f"catalog/{name} {Colors.RED}✗ normalization failed: {detail}{Colors.RESET}")
        return "failed"
    if normalized_manifest is None:
        print(f"catalog/{name} {Colors.RED}✗ normalization failed{Colors.RESET}")
        return "failed"
    lock_relative = update["artifacts"][0]
    lock_path = target["_path"].parent.parent / lock_relative
    previous_lock = lock_path.read_text()
    contract = load_pi_normalization_contract(target["_path"].parent.parent)
    generated_lock = lock_generator(
        normalized_manifest,
        previous_lock,
        npm,
        pi_npm_lock_flags(contract),
    )
    if generated_lock is None or not validate_npm_manifest_lock(
        normalized_manifest, generated_lock
    ):
        print(f"catalog/{name} {Colors.RED}✗ lock generation failed{Colors.RESET}")
        return "failed"

    final_lock = (
        previous_lock
        if npm_lock_documents_equal(generated_lock, previous_lock)
        else generated_lock
    )
    changed = (
        record["version"] != new_version
        or source_args["url"] != new_url
        or source_args[hash_name] != new_source_hash
        or final_lock != previous_lock
    )
    if not changed:
        if hash_computer.validate_package_build(name):
            print(f"catalog/{name} {Colors.GREEN}✓ up-to-date{Colors.RESET}")
            return "skipped"
        print(f"catalog/{name} {Colors.RED}✗ package build failed{Colors.RESET}")
        return "failed"
    if args.dry_run:
        print(f"catalog/{name} {Colors.CYAN}→ {new_version} (dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    transaction.watch(lock_path)
    record["version"] = new_version
    source["url"] = new_url
    source_args["url"] = new_url
    source_args[hash_name] = new_source_hash
    lock_path.write_text(final_lock)
    record["hashes"]["npmDepsHash"] = DUMMY_SRI_HASH
    _write_catalog_target(target)
    new_npm_hash = hash_computer._compute_fod_hash(name, "npmDepsHash")
    if not new_npm_hash:
        print(f"catalog/{name} {Colors.RED}✗ npmDepsHash failed{Colors.RESET}")
        return "failed"
    record["hashes"]["npmDepsHash"] = new_npm_hash
    _write_catalog_target(target)
    if not hash_computer.validate_package_build(name):
        print(f"catalog/{name} {Colors.RED}✗ final package build failed{Colors.RESET}")
        raise CandidateRejected(f"{name} final package build failed")
    print(f"catalog/{name} {Colors.GREEN}→ {new_version} ✓{Colors.RESET}")
    return "updated"


def update_pypi_artifact_target(
    name: str,
    target: dict,
    args,
    pypi_client: PypiClient,
    transaction,
) -> str:
    """Resolve a compound PyPI record and write it under transaction rollback."""
    record = target["_record"]
    old_version = record["version"]
    resolved = pypi_client.get_release_artifacts(
        record["update"]["package"], record, args.version
    )
    if resolved is None:
        print(f"catalog/{name} {Colors.RED}✗ artifact resolution failed{Colors.RESET}")
        return "failed"

    new_version, artifacts = resolved
    fetches = {"source": record["source"]}
    fetches.update(
        {f"artifact:{key}": source for key, source in record["artifacts"].items()}
    )
    changed = new_version != old_version
    for label, source in fetches.items():
        artifact_url, artifact_hash = artifacts[label]
        source_args = source["args"]
        hash_name = next(iter({"hash", "sha256"} & source_args.keys()))
        changed = changed or source_args["version"] != new_version
        changed = changed or source_args[hash_name] != artifact_hash
        if source["fetcher"] == "fetchurl":
            changed = changed or source_args["url"] != artifact_url

    if not changed:
        print(f"catalog/{name} {Colors.GREEN}✓ up-to-date{Colors.RESET}")
        return "skipped"
    if args.dry_run:
        print(f"catalog/{name} {Colors.CYAN}→ {new_version} (dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    record["version"] = new_version
    for label, source in fetches.items():
        artifact_url, artifact_hash = artifacts[label]
        source_args = source["args"]
        hash_name = next(iter({"hash", "sha256"} & source_args.keys()))
        source_args["version"] = new_version
        source_args[hash_name] = artifact_hash
        if source["fetcher"] == "fetchurl":
            source_args["url"] = artifact_url
    _write_catalog_target(target)
    print(f"catalog/{name} {Colors.GREEN}→ {new_version} ✓{Colors.RESET}")
    return "updated"


def update_github_release_asset_target(
    name: str,
    target: dict,
    args,
    github_client: GitHubClient,
    hash_computer: HashComputer,
    transaction,
) -> str:
    """Resolve every declared GitHub release asset before writing any of them."""
    record = target["_record"]
    update = record["update"]
    prefix = update.get("tagPrefix", "")
    if args.version:
        new_tag = (
            args.version
            if args.version.startswith(prefix)
            else f"{prefix}{args.version}"
        )
    else:
        new_tag = github_client.get_latest_release(update["owner"], update["repo"])
        release_error = (
            getattr(github_client, "last_error", None) if new_tag is None else None
        )
    if args.version:
        release_error = None
    if not new_tag or not new_tag.startswith(prefix):
        message = _failure_message("release lookup failed", release_error)
        print(f"catalog/{name} {Colors.RED}✗ {message}{Colors.RESET}")
        return "failed"
    new_version = new_tag[len(prefix):] if prefix else new_tag

    fetches = {"source": record["source"]}
    fetches.update(
        {
            f"artifact:{key}": source
            for key, source in record.get("artifacts", {}).items()
        }
    )
    resolved: dict[str, tuple[str, str]] = {}
    for label, source in fetches.items():
        asset_label = label.removeprefix("artifact:")
        try:
            asset = _render_github_release_asset(
                update["assets"][asset_label], new_version
            )
        except ValueError:
            print(
                f"catalog/{name} {Colors.RED}✗ invalid release asset{Colors.RESET}"
            )
            return "failed"
        new_url = _github_release_asset_url(
            update["owner"], update["repo"], new_tag, asset
        )
        new_hash = hash_computer.compute_native_hash(source, {"url": new_url})
        if not new_hash:
            message = _failure_message(
                f"{asset_label} hash failed",
                getattr(hash_computer, "last_error", None),
            )
            print(f"catalog/{name} {Colors.RED}✗ {message}{Colors.RESET}")
            return "failed"
        resolved[label] = new_url, new_hash

    changed = record["version"] != new_version
    for label, source in fetches.items():
        new_url, new_hash = resolved[label]
        source_args = source["args"]
        hash_name = next(iter({"hash", "sha256"} & source_args.keys()))
        changed = changed or source_args["url"] != new_url
        changed = changed or source_args[hash_name] != new_hash
    if not changed:
        if not hash_computer.validate_package_build(name):
            print(f"catalog/{name} {Colors.RED}✗ package build failed{Colors.RESET}")
            return "failed"
        print(f"catalog/{name} {Colors.GREEN}✓ up-to-date{Colors.RESET}")
        return "skipped"
    if args.dry_run:
        print(f"catalog/{name} {Colors.CYAN}→ {new_version} (dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    record["version"] = new_version
    for label, source in fetches.items():
        new_url, new_hash = resolved[label]
        source_args = source["args"]
        hash_name = next(iter({"hash", "sha256"} & source_args.keys()))
        source["url"] = new_url
        source_args["url"] = new_url
        source_args[hash_name] = new_hash
    _write_catalog_target(target)
    if not hash_computer.validate_package_build(name):
        print(f"catalog/{name} {Colors.RED}✗ final package build failed{Colors.RESET}")
        raise CandidateRejected(f"{name} final package build failed")
    print(f"catalog/{name} {Colors.GREEN}→ {new_version} ✓{Colors.RESET}")
    return "updated"


def _valid_cargo_lock(content: str) -> bool:
    try:
        document = tomllib.loads(content)
    except (tomllib.TOMLDecodeError, ValueError):
        return False
    packages = document.get("package")
    return (
        document.get("version") in {3, 4}
        and isinstance(packages, list)
        and bool(packages)
        and all(
            isinstance(package, dict)
            and isinstance(package.get("name"), str)
            and isinstance(package.get("version"), str)
            for package in packages
        )
    )


def update_github_commit_artifact_target(
    name: str,
    target: dict,
    args,
    github_client: GitHubClient,
    hash_computer: HashComputer,
    transaction,
) -> str:
    """Update a source commit and repository files under transaction rollback."""
    record = target["_record"]
    source = record["source"]
    source_args = source["args"]
    update = record["update"]
    candidate = (
        (args.version, "")
        if args.version
        else github_client.get_latest_commit(
            source_args["owner"], source_args["repo"], update["branch"]
        )
    )
    lookup_error = (
        getattr(github_client, "last_error", None)
        if not args.version and candidate is None
        else None
    )
    new_ref = candidate[0] if candidate else None
    if not new_ref or re.fullmatch(r"[0-9a-f]{40}", new_ref) is None:
        message = _failure_message("exact commit lookup failed", lookup_error)
        print(f"catalog/{name} {Colors.RED}✗ {message}{Colors.RESET}")
        return "failed"

    new_hash = hash_computer.compute_native_hash(source, {"rev": new_ref})
    if not new_hash:
        message = _failure_message(
            "source hash failed",
            getattr(hash_computer, "last_error", None),
        )
        print(f"catalog/{name} {Colors.RED}✗ {message}{Colors.RESET}")
        return "failed"
    resolved_files: dict[Path, str] = {}
    for local, remote in update["artifactSources"].items():
        content = github_client.get_file(
            source_args["owner"], source_args["repo"], new_ref, remote
        )
        file_error = (
            getattr(github_client, "last_error", None) if content is None else None
        )
        cargo_lock = Path(local).name == "Cargo.lock"
        if content is None or (
            cargo_lock
            and (
                not _valid_cargo_lock(content)
                or not hash_computer.validate_cargo_lock(
                    source["url"], new_ref, remote, content
                )
            )
        ):
            message = _failure_message(f"{remote} validation failed", file_error)
            print(f"catalog/{name} {Colors.RED}✗ {message}{Colors.RESET}")
            return "failed"
        resolved_files[target["_path"].parent.parent / local] = content

    hash_name = next(iter({"hash", "sha256"} & source_args.keys()))
    changed = source_args["rev"] != new_ref or source_args[hash_name] != new_hash
    changed = changed or any(
        path.read_text() != content for path, content in resolved_files.items()
    )
    if not changed:
        print(f"catalog/{name} {Colors.GREEN}✓ up-to-date{Colors.RESET}")
        return "skipped"
    if args.dry_run:
        print(f"catalog/{name} {Colors.CYAN}→ {new_ref[:8]} (dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    for path in resolved_files:
        transaction.watch(path)
    source_args["rev"] = new_ref
    source_args[hash_name] = new_hash
    _write_catalog_target(target)
    for path, content in resolved_files.items():
        path.write_text(content)
    print(f"catalog/{name} {Colors.GREEN}→ {new_ref[:8]} ✓{Colors.RESET}")
    return "updated"


def _prime_agent_registry_tarball(package: str, version: str) -> str:
    encoded = quote(package, safe="@/")
    basename = package.rsplit("/", 1)[-1]
    return f"https://registry.npmjs.org/{encoded}/-/{basename}-{version}.tgz"


def _prime_agent_lock_is_normalized(upstream: dict, candidate: dict) -> bool:
    """Check that candidate is exactly upstream plus closed registry metadata."""
    if not isinstance(candidate, dict) or not isinstance(candidate.get("packages"), dict):
        return False
    stripped = copy.deepcopy(candidate)
    upstream_packages = upstream.get("packages")
    if not isinstance(upstream_packages, dict):
        return False
    for lock_path, package in stripped["packages"].items():
        if not isinstance(package, dict):
            return False
        if "node_modules/" not in lock_path or package.get("link"):
            continue
        upstream_package = upstream_packages.get(lock_path)
        if not isinstance(upstream_package, dict):
            return False
        if "resolved" in upstream_package or "integrity" in upstream_package:
            continue
        resolved = package.pop("resolved", None)
        integrity = package.pop("integrity", None)
        name = lock_path.rsplit("node_modules/", 1)[1]
        version = package.get("version")
        if (
            not isinstance(version, str)
            or not version
            or resolved != _prime_agent_registry_tarball(name, version)
            or not isinstance(integrity, str)
            or re.fullmatch(r"sha(?:1|256|384|512)-[A-Za-z0-9+/=]+", integrity) is None
        ):
            return False
    return stripped == upstream


def normalize_prime_agent_lock(
    source_path: Path,
    previous_lock: str,
    npm_client: NpmRegistryClient,
) -> str:
    """Project upstream's omitted registry metadata into a Nix-fetchable lock."""
    try:
        upstream = json.loads((source_path / "package-lock.json").read_text(), object_pairs_hook=_unique_object)
        previous = json.loads(previous_lock, object_pairs_hook=_unique_object)
    except (OSError, ValueError) as error:
        raise RuntimeError("Prime Agent lock input is not valid JSON") from error
    if _prime_agent_lock_is_normalized(upstream, previous):
        return previous_lock
    packages = upstream.get("packages")
    if not isinstance(packages, dict):
        raise RuntimeError("Prime Agent upstream lock has no packages object")
    normalized = copy.deepcopy(upstream)
    metadata_cache: dict[tuple[str, str], dict[str, str]] = {}
    for lock_path, package in normalized["packages"].items():
        if "node_modules/" not in lock_path or package.get("link"):
            continue
        if "resolved" in package and "integrity" in package:
            continue
        name = lock_path.rsplit("node_modules/", 1)[1]
        version = package.get("version")
        if not isinstance(version, str) or not version:
            raise RuntimeError(f"Prime Agent lock entry has no version: {lock_path}")
        key = (name, version)
        if key not in metadata_cache:
            metadata = npm_client.get_version_metadata(name, version)
            if metadata is None:
                raise RuntimeError(f"npm metadata lookup failed for Prime Agent dependency: {name}@{version}")
            metadata_cache[key] = metadata
        metadata = metadata_cache[key]
        expected_url = _prime_agent_registry_tarball(name, version)
        if metadata["version"] != version or metadata["tarball"] != expected_url:
            raise RuntimeError(f"npm registry coordinate mismatch for Prime Agent dependency: {name}@{version}")
        package["resolved"] = expected_url
        package["integrity"] = metadata["integrity"]
    if not _prime_agent_lock_is_normalized(upstream, normalized):
        raise RuntimeError("Prime Agent lock normalization produced an invalid projection")
    return json.dumps(normalized, indent=2) + "\n"


def update_catalog_target(
    name: str,
    target: dict,
    args,
    github_client: GitHubClient,
    npm_client: NpmRegistryClient,
    pypi_client: PypiClient,
    hash_computer: HashComputer,
    transaction,
 ) -> str:
    record = target["_record"]
    source = record["source"]
    source_args = source["args"]
    update = record["update"]
    kind = update["kind"]
    old_version = record.get(
        "version", source_args.get("rev", source_args.get("tag", "unversioned"))
    )
    hash_name = next(iter({"hash", "sha256", "narHash"} & source_args.keys()))
    old_hash = source_args[hash_name]
    current_ref = source_args.get("tag", source_args.get("rev"))
    current_url = source_args.get("url")
    new_ref = None
    new_version = None
    new_hash = None
    new_url = None
    fetch_error = None
    hash_error = None

    display = f"{Colors.BOLD}catalog/{name}{Colors.RESET} {Colors.DIM}{old_version}{Colors.RESET}"
    print(display, end=" ")

    if kind == "fixed-flake-input":
        if args.version:
            new_ref = args.version
        else:
            branch = github_client.get_default_branch(
                source_args["owner"], source_args["repo"]
            )
            if branch is None:
                fetch_error = getattr(github_client, "last_error", None)
            candidate = (
                github_client.get_latest_commit(
                    source_args["owner"], source_args["repo"], branch
                )
                if branch
                else None
            )
            if candidate:
                new_ref = candidate[0]
            elif branch:
                fetch_error = getattr(github_client, "last_error", None)
        if new_ref:
            new_version = new_ref
    elif kind == "npm-release":
        candidate = npm_client.get_version(update["package"], args.version)
        if candidate:
            new_version, _registry_integrity = candidate
            if old_version and current_url and current_url.count(old_version) == 1:
                new_url = current_url.replace(old_version, new_version, 1)
    elif kind == "pypi-release":
        candidate = pypi_client.get_release(update["package"], record, args.version)
        if candidate:
            new_version, artifact_url, new_hash = candidate
            new_url = artifact_url if source["fetcher"] == "fetchurl" else None
            new_ref = new_version
    elif kind == "github-commit":
        if args.version:
            new_ref = args.version
        else:
            candidate = github_client.get_latest_commit(
                source_args["owner"], source_args["repo"], update["branch"]
            )
            if candidate:
                new_ref = candidate[0]
            else:
                fetch_error = getattr(github_client, "last_error", None)
        if new_ref:
            current_version = record.get("version")
            new_version = (
                new_ref[: len(current_version)]
                if current_version and current_ref.startswith(current_version)
                else current_version or new_ref
            )
    elif kind in {"github-release", "github-tag"}:
        prefix = update.get("tagPrefix")
        if prefix is None:
            prefix = (
                current_ref[: -len(old_version)]
                if old_version and current_ref and current_ref.endswith(old_version)
                else ""
            )
        if args.version:
            new_ref = args.version if args.version.startswith(prefix) else f"{prefix}{args.version}"
        else:
            new_ref = (
                github_client.get_latest_release(
                    source_args["owner"], source_args["repo"]
                )
                if kind == "github-release"
                else github_client.get_latest_tag(
                    source_args["owner"], source_args["repo"], prefix
                )
            )
            if new_ref is None:
                fetch_error = getattr(github_client, "last_error", None)
        if new_ref:
            new_version = extract_version_number(new_ref, prefix)
    elif kind == "explicit-rev":
        if not args.version:
            print(f"{Colors.RED}✗ explicit --version required{Colors.RESET}")
            return "failed"
        if current_ref:
            prefix = (
                current_ref[: -len(old_version)]
                if old_version and current_ref.endswith(old_version)
                else ""
            )
            new_ref = args.version if args.version.startswith(prefix) else f"{prefix}{args.version}"
            new_version = extract_version_number(new_ref, prefix) if prefix else args.version
        elif current_url:
            match = re.search(r"[0-9a-fA-F]{40}", current_url)
            if match is None:
                print(f"{Colors.RED}✗ URL has no replaceable revision{Colors.RESET}")
                return "failed"
            new_ref = args.version
            new_version = record.get("version", new_ref)
            new_url = current_url.replace(match.group(0), new_ref, 1)
    elif kind == "url-release":
        new_version = args.version or old_version
        if args.version:
            if not record.get("version") or current_url.count(old_version) != 1:
                print(f"{Colors.RED}✗ URL has no unique version coordinate{Colors.RESET}")
                return "failed"
            new_url = current_url.replace(old_version, args.version, 1)
        else:
            new_url = current_url

    if new_version is None:
        message = _failure_message("fetch failed", fetch_error)
        print(f"{Colors.RED}✗ {message}{Colors.RESET}")
        return "failed"
    if kind == "npm-release" and new_url is None:
        print(f"{Colors.RED}✗ URL rewrite failed{Colors.RESET}")
        return "failed"

    replacements = {}
    if new_ref and current_ref:
        replacements["tag" if "tag" in source_args else "rev"] = new_ref
    if new_url is not None:
        replacements["url"] = new_url
    if kind != "pypi-release":
        new_hash = hash_computer.compute_native_hash(source, replacements)
        if not new_hash:
            hash_error = getattr(hash_computer, "last_error", None)
    if not new_hash:
        message = _failure_message("hash failed", hash_error)
        print(f"{Colors.RED}✗ {message}{Colors.RESET}")
        return "failed"

    normalized_artifact_path = None
    normalized_artifact = None
    normalizer = update.get("normalizer")
    if normalizer == PRIME_AGENT_NORMALIZER:
        normalized_artifact_path = target["_path"].parent.parent / update["artifacts"][0]
        source_path = hash_computer.realize_native_source(
            source,
            {**replacements, hash_name: new_hash},
        )
        if source_path is None:
            print(f"{Colors.RED}✗ Prime Agent source realization failed{Colors.RESET}")
            return "failed"
        try:
            normalized_artifact = normalize_prime_agent_lock(
                source_path,
                normalized_artifact_path.read_text(),
                npm_client,
            )
        except (OSError, RuntimeError) as error:
            detail = _bounded_actionable_error(
                error,
                fallback="Prime Agent lock normalization failed",
            )
            print(f"{Colors.RED}✗ {detail}{Colors.RESET}")
            return "failed"

    same_location = (new_ref is None or new_ref == current_ref) and (
        new_url is None or new_url == current_url
    )
    normalized_artifact_changed = (
        normalized_artifact_path is not None
        and normalized_artifact != normalized_artifact_path.read_text()
    )
    if (
        new_version == old_version
        and same_location
        and new_hash == old_hash
        and not normalized_artifact_changed
    ):
        print(f"{Colors.GREEN}✓ up-to-date{Colors.RESET}")
        return "skipped"

    print(f"{Colors.YELLOW}→ {new_version}{Colors.RESET}", end="")
    if args.dry_run:
        print(f" {Colors.CYAN}(dry-run){Colors.RESET}")
        return "updated"

    transaction.watch(target["_path"])
    if normalized_artifact_path is not None:
        transaction.watch(normalized_artifact_path)
    if kind == "fixed-flake-input":
        flake_path = target["_path"].parent.parent / "config" / "ai" / "flake.nix"
        transaction.watch(flake_path)
    if "version" in record:
        record["version"] = new_version
    source_args[hash_name] = new_hash
    if new_url is not None:
        source_args["url"] = new_url
        source["url"] = new_url
    if kind == "pypi-release" and source["fetcher"] == "fetchPypi":
        source_args["version"] = new_version
    if new_ref and current_ref:
        source_args["tag" if "tag" in source_args else "rev"] = new_ref
    if kind == "fixed-flake-input":
        _rewrite_fixed_flake_input(target, current_ref, new_ref)
    if kind == "explicit-rev" and "commit" in record:
        resolved = subprocess.run(
            ["git", "ls-remote", source["url"], new_ref, f"{new_ref}^{{}}"],
            capture_output=True,
            text=True,
            timeout=60,
        )
        commits = [line.split()[0] for line in resolved.stdout.splitlines() if line.split()]
        if resolved.returncode != 0 or not commits:
            print(f" {Colors.RED}✗ commit resolution failed{Colors.RESET}")
            return "failed"
        record["commit"] = commits[-1]
    _write_catalog_target(target)
    if normalized_artifact_path is not None:
        normalized_artifact_path.write_text(normalized_artifact)

    computed = []
    build_mode = update.get("buildMode")
    for hash_type, old_dependent_hash in record.get("hashes", {}).items():
        record["hashes"][hash_type] = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
        _write_catalog_target(target)
        new_dependent_hash = (
            hash_computer._compute_fod_hash(name, hash_type, build_mode)
            if build_mode
            else hash_computer._compute_fod_hash(name, hash_type)
        )
        if not new_dependent_hash:
            record["hashes"][hash_type] = old_dependent_hash
            _write_catalog_target(target)
            print(f" {Colors.RED}✗ {hash_type} failed{Colors.RESET}")
            return "failed"
        record["hashes"][hash_type] = new_dependent_hash
        computed.append(hash_type)
    _write_catalog_target(target)
    if build_mode and computed and not hash_computer.validate_package_build(
        name, build_mode
    ):
        print(f" {Colors.RED}✗ final {build_mode} build failed{Colors.RESET}")
        raise CandidateRejected(f"{name} final {build_mode} build failed")
    suffix = f" +{','.join(computed)}" if computed else ""
    print(f" {Colors.GREEN}✓{Colors.RESET}{suffix}")
    return "updated"


def update_github_projection_target(
    name: str,
    target: dict,
    args,
    github_client: GitHubClient,
    npm_client: NpmRegistryClient,
    pypi_client: PypiClient,
    hash_computer: HashComputer,
    transaction,
) -> str:
    """Dispatch one candidate-only GitHub projection by its declared shape."""
    kind = target["kind"]
    update = target["_record"]["update"]
    if kind == "github-release-asset":
        return update_github_release_asset_target(
            name,
            target,
            args,
            github_client,
            hash_computer,
            transaction,
        )
    if kind == "github-commit" and update.get("artifactSources"):
        return update_github_commit_artifact_target(
            name,
            target,
            args,
            github_client,
            hash_computer,
            transaction,
        )
    return update_catalog_target(
        name,
        target,
        args,
        github_client,
        npm_client,
        pypi_client,
        hash_computer,
        transaction,
    )


def prepare_update_target(
    name: str,
    target: dict,
    args,
    github_client: GitHubClient,
    npm_client: NpmRegistryClient,
    pypi_client: PypiClient,
    hash_computer: HashComputer,
    transaction,
) -> str:
    """Prepare one update-owned target before any declared flake lock move."""
    kind = target["kind"]
    if kind in {"flake-input", "flake-input+build", "flake-input+copy"}:
        return "skipped"
    if kind == "npm-release+flake-input":
        return update_npm_flake_target(
            name, target, args, npm_client, hash_computer, transaction
        )
    if kind == "npm-release":
        return update_npm_lock_target(
            name, target, args, npm_client, hash_computer, transaction
        )
    if kind == "pypi-release":
        return update_pypi_artifact_target(
            name, target, args, pypi_client, transaction
        )
    if kind in {
        "github-commit",
        "github-release",
        "github-release-asset",
        "github-tag",
    }:
        return update_github_projection_target(
            name,
            target,
            args,
            github_client,
            npm_client,
            pypi_client,
            hash_computer,
            transaction,
        )
    return update_catalog_target(
        name,
        target,
        args,
        github_client,
        npm_client,
        pypi_client,
        hash_computer,
        transaction,
    )


def validate_catalog_target(nix_dir: Path, name: str, target: dict) -> bool:
    """Build the package contract declared by one restored catalog target."""
    update = target["_record"]["update"]
    return HashComputer(nix_dir).validate_package_build(
        update.get("buildPackage", name), update.get("buildMode", "pkg")
    )


def extract_version_number(tag: str, prefix: str = "") -> str:
    """Strip a matching declared prefix, otherwise a conventional prefix."""
    if prefix and tag.startswith(prefix):
        return tag[len(prefix):]

    for candidate in ("v", "b", "release-", "version-"):
        if tag.startswith(candidate):
            return tag[len(candidate):]
    return tag


def main():
    parser = argparse.ArgumentParser(
        description="Update catalog-managed Nix package sources to their latest versions",
        epilog="""
Examples:
  update-overlay llama-cpp gguf-tools    Update to latest release/commit
  update-overlay --dry-run llama-swap    Preview changes without modifying
  update-overlay -V 1.2.3 browser-control-mcp  Force specific version
  update-overlay --all --dry-run         Preview all automatic catalog updates
""",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "packages", nargs="*",
        help="Package names to update (not required if --all is used)"
    )
    parser.add_argument(
        "--all", "-a", action="store_true",
        help="Update every automatic catalog target handled by this command"
    )
    parser.add_argument(
        "--dry-run", "-n", action="store_true",
        help="Show what would be changed without making changes"
    )
    parser.add_argument(
        "--no-build", action="store_true",
        help="Retired; catalog updates always validate required dependent hashes"
    )
    parser.add_argument(
        "--version", "-V",
        help="Specify version instead of fetching latest"
    )
    parser.add_argument(
        "--verbose", "-v", action="store_true",
        help="Show automatic catalog targets delegated to another executor"
    )
    parser.add_argument(
        "--inventory", action="store_true",
        help="List every catalog-owned update target without network access"
    )
    parser.add_argument(
        "--json", dest="json_output", action="store_true",
        help="Emit inventory as JSON (with --inventory)"
    )
    parser.add_argument(
        "--sync-flake-projections", action="store_true",
        help="Refresh catalog fetchTree projections from config/ai/flake.lock"
    )
    internal = parser.add_mutually_exclusive_group()
    internal.add_argument("--prepare-target", metavar="NAME", help=argparse.SUPPRESS)
    internal.add_argument("--validate-target", metavar="NAME", help=argparse.SUPPRESS)
    args = parser.parse_args()
    internal_target = args.prepare_target or args.validate_target

    # Validate arguments
    if args.no_build:
        parser.error(
            "--no-build is no longer supported; catalog updates always validate "
            "required dependent hashes"
        )

    if (
        not args.inventory
        and not args.all
        and not args.packages
        and not args.sync_flake_projections
        and not internal_target
    ):
        parser.error(
            "Please specify package names, --all, --inventory, or --sync-flake-projections"
        )

    if args.sync_flake_projections and (
        args.inventory
        or args.all
        or args.packages
        or args.version
        or args.dry_run
        or args.verbose
        or args.json_output
        or internal_target
    ):
        parser.error("--sync-flake-projections cannot be combined with another operation")

    if internal_target and (
        args.inventory
        or args.all
        or args.sync_flake_projections
        or args.packages
        or args.dry_run
        or args.verbose
        or args.json_output
    ):
        parser.error("internal target operation cannot be combined with another operation")
    if args.validate_target and args.version:
        parser.error("--validate-target does not accept --version")

    if args.sync_flake_projections and os.environ.get("UPDATE_AGENTS_CANDIDATE") != "1":
        parser.error("--sync-flake-projections is restricted to the update candidate")

    if internal_target and os.environ.get("UPDATE_AGENTS_CANDIDATE") != "1":
        parser.error("internal target operation is restricted to the update candidate")

    if args.inventory and (args.all or args.packages or args.version):
        parser.error("--inventory cannot be combined with package updates")

    if args.json_output and not args.inventory:
        parser.error("--json requires --inventory")

    if args.all and args.version:
        parser.error("Cannot use --version with --all")

    nix_dir = Path(__file__).parent.parent.resolve()
    if args.sync_flake_projections:
        require_detached_linked_worktree(nix_dir)
        try:
            changed = sync_flake_projections(nix_dir)
        except CandidateRejected as error:
            print(f"candidate rejected: {error}", file=sys.stderr)
            return CANDIDATE_REJECTED_EXIT
        print(f"synchronized {changed} flake input projection(s)")
        return 0
    internal_prepare = args.prepare_target is not None
    internal_validate = args.validate_target is not None
    catalog_targets = load_source_catalog(
        nix_dir,
        validate_flake_projections=not internal_prepare,
    )
    requested_names = [internal_target] if internal_target else args.packages
    unknown_names = sorted(set(requested_names) - catalog_targets.keys())
    if unknown_names:
        parser.error(f"unknown catalog target ID(s): {', '.join(unknown_names)}")
    if args.inventory:
        print_inventory(build_inventory(catalog_targets), args.json_output)
        return 0

    if internal_validate:
        require_detached_linked_worktree(nix_dir)
        try:
            valid = validate_catalog_target(
                nix_dir, args.validate_target, catalog_targets[args.validate_target]
            )
        except RuntimeError as error:
            print(f"baseline validation failed: {error}", file=sys.stderr)
            return 1
        if not valid:
            print(
                f"baseline package build failed: {args.validate_target}",
                file=sys.stderr,
            )
            return 1
        return 0

    if internal_prepare:
        require_detached_linked_worktree(nix_dir)
    elif args.packages:
        delegated_names = [
            name
            for name in args.packages
            if catalog_targets[name].get("executor") == "update"
        ]
        if delegated_names:
            if len(delegated_names) != len(args.packages):
                parser.error("update targets cannot be mixed with direct targets")
            if args.verbose:
                parser.error("update targets do not accept --verbose")
            return delegate_to_update(nix_dir, delegated_names, args)

    github_client = GitHubClient()
    npm_client = NpmRegistryClient()
    pypi_client = PypiClient()
    transaction = SourceTransaction()
    atexit.register(transaction.rollback_unless_committed)
    success_count = 0
    fail_count = 0
    rejected_count = 0
    skipped_count = 0

    if internal_prepare:
        selected_catalog_names = requested_names
    elif args.all:
        selected_catalog_names = [
            name for name in sorted(catalog_targets)
            if catalog_targets[name]["_record"]["update"].get("policy", "automatic")
            == "automatic"
            and (not args.packages or name in args.packages)
        ]
    else:
        selected_catalog_names = args.packages
    catalog_record_snapshots = (
        snapshot_catalog_record_isolation(
            selected_catalog_names, catalog_targets, transaction
        )
        if (args.packages or internal_prepare) and selected_catalog_names
        else {}
    )
    catalog_hash_computer = HashComputer(nix_dir)
    for name in selected_catalog_names:
        target = catalog_targets[name]
        expected_executor = "update" if internal_prepare else "update-overlay"
        if target.get("executor") != expected_executor:
            if args.all:
                if args.verbose:
                    print(f"{Colors.DIM}catalog/{name}: skipped (no executor){Colors.RESET}")
                skipped_count += 1
            else:
                print(f"{Colors.RED}{name}: catalog target has no update executor{Colors.RESET}")
                fail_count += 1
            continue
        try:
            if internal_prepare:
                status = prepare_update_target(
                    name,
                    target,
                    args,
                    github_client,
                    npm_client,
                    pypi_client,
                    catalog_hash_computer,
                    transaction,
                )
            else:
                status = update_catalog_target(
                    name,
                    target,
                    args,
                    github_client,
                    npm_client,
                    pypi_client,
                    catalog_hash_computer,
                    transaction,
                )
        except CandidateRejected:
            rejected_count += 1
            continue
        except RuntimeError as error:
            print(f"catalog/{name} {Colors.RED}✗ {error}{Colors.RESET}")
            fail_count += 1
            continue
        success_count += status == "updated"
        skipped_count += status == "skipped"
        fail_count += status == "failed"

    if catalog_record_snapshots:
        try:
            enforce_catalog_record_isolation(
                catalog_record_snapshots, transaction
            )
        except RuntimeError as error:
            print(f"{Colors.RED}{error}{Colors.RESET}", file=sys.stderr)
            fail_count += 1

    if internal_prepare:
        if fail_count or rejected_count:
            transaction.rollback()
        else:
            transaction.commit()
        if fail_count:
            return 1
        return CANDIDATE_REJECTED_EXIT if rejected_count else 0

    if args.dry_run:
        restored = transaction.rollback()
        if restored:
            print(
                f"Dry-run attempted to mutate {restored} source file(s)",
                file=sys.stderr,
            )
            fail_count += 1
    elif fail_count or rejected_count:
        restored = transaction.rollback()
        if restored:
            reason = (
                "rejected update"
                if rejected_count and not fail_count
                else "update failure"
            )
            print(f"Rolled back {restored} source file(s) after {reason}")
    else:
        transaction.commit()

    # Colored summary
    updated_str = f"{Colors.GREEN}{success_count} updated{Colors.RESET}" if success_count else f"{success_count} updated"
    skipped_str = f"{skipped_count} up-to-date"
    failed_str = f"{Colors.RED}{fail_count} failed{Colors.RESET}" if fail_count else f"{fail_count} failed"
    rejected_str = (
        f", {Colors.YELLOW}{rejected_count} rejected{Colors.RESET}"
        if rejected_count
        else ""
    )
    print(
        f"\n{Colors.BOLD}Summary:{Colors.RESET} {updated_str}, {skipped_str}"
        f"{rejected_str}, {failed_str}"
    )

    if fail_count:
        return 1
    if rejected_count:
        if os.environ.get("UPDATE_AGENTS_CANDIDATE") == "1":
            return CANDIDATE_REJECTED_EXIT
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
