#!/usr/bin/env python3
"""
update-overlay - Update catalog-managed Nix package sources to their latest versions.

Usage:
    update-overlay <package1> [package2] ...

Examples:
    update-overlay llama-swap llama-cpp
    update-overlay hfdownloader
    update-overlay --dry-run mlx-lm
"""

import argparse
import atexit
