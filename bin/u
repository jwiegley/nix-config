#!/bin/bash

if [[ "$(uname -s)" == "Darwin" ]]; then
    sudo /bin/launchctl limit maxfiles 524288 524288
    ulimit -n 65536
fi

# Host identity comes from the shared routing library, not a fourth
# hand-maintained pattern table.
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
installed_routing_path=
routing=${installed_routing_path:-$script_dir/lib/host-routing.sh}
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

if host=$(normalize_nix_host "${1:-}"); then
    shift 1
elif ! host=$(normalize_nix_host "$(hostname)"); then
    echo "u: unrecognized host '$(hostname)'" >&2
    exit 1
fi

case $host in
hera)
    HOSTNAME=hera
    REMOTES=clio
    ;;
clio)
    HOSTNAME=clio
    REMOTES=hera
    ;;
vulcan)
    HOSTNAME=vulcan
    REMOTES=clio
    ;;
*)
    echo "u: unsupported host class '$host'" >&2
    exit 1
    ;;
esac

MAKEARGS=(-C "$NIX_CONF" -f Makefile)

if [[ -n $BUILDER && $HOSTNAME != "$BUILDER" ]]; then
    MAKEARGS+=(BUILDER="$BUILDER")
    echo "BUILDER=$BUILDER"
fi
if [[ -n $CACHE && $HOSTNAME != "$CACHE" ]]; then
    MAKEARGS+=(CACHE="$CACHE")
    echo "CACHE=$CACHE"
fi

cd "$NIX_CONF" || exit 1

echo "HOSTNAME=$HOSTNAME"
echo "REMOTES=\"$REMOTES\""
echo "MAKEARGS=\"${MAKEARGS[*]}\""

exec make "${MAKEARGS[@]}" HOSTNAME="$HOSTNAME" REMOTES="$REMOTES" "$@"
