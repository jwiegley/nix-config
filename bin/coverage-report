# Git repository selectors and configuration injection must never leak into a
# discovery subprocess.  Removing every GIT_* variable is stronger and easier to
# audit than attempting to maintain Git's growing list of local-environment keys.
GIT_ENV_PREFIX = "GIT_"

SENSITIVE_KEY_PARTS = (
    "password",
    "passwd",
    "secret",
    "credential",
    "privatekey",
    "private-key",
    "private_key",
    "accesstoken",
    "access-token",
    "access_token",
    "apikey",
    "api-key",
    "api_key",
    "authorization",
    "rawvalue",
    "raw-value",
    "raw_value",
    "token",
)
FORBIDDEN_RAW_KEYS = frozenset(
    {
        "value",
        "values",
        "raw",
        "rawoutput",
        "environment",
        "environmentvariables",
        "env",
        "command",
        "shellcommand",
        "arguments",
    }
)
SENSITIVE_ASSIGNMENT_RE = re.compile(
    r"(?i)(?:^|[\s,{;])(?:[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|"
    r"CREDENTIAL|PRIVATE[_-]?KEY|API[_-]?KEY|AUTHORIZATION)[A-Z0-9_]*)\s*[:=]"
)
PRIVATE_KEY_RE = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----")
KNOWN_CREDENTIAL_RE = re.compile(
    r"(?:gh[pousr]_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|"
    r"xox[baprs]-[A-Za-z0-9-]{10,})"
)


class CoverageError(RuntimeError):
    """A fail-closed collection or validation error."""


class DuplicateKeyError(CoverageError):
    """A JSON object contained the same key more than once."""


RunCommand = Callable[
    [Sequence[str], Path, Mapping[str, str]], subprocess.CompletedProcess[str]
]


def clean_environment(source: Mapping[str, str] | None = None) -> dict[str, str]:
    """Return a deterministic environment with all Git injection removed."""

    source = os.environ if source is None else source
    env = {
        key: value
        for key, value in source.items()
        if not key.startswith(GIT_ENV_PREFIX)
    }
    env["LC_ALL"] = "C"
    env["LANG"] = "C"
    return env


def run_command(
    argv: Sequence[str], cwd: Path, env: Mapping[str, str]
) -> subprocess.CompletedProcess[str]:
    """Run one argv without a shell and retain output only in memory."""

    return subprocess.run(
        list(argv),
        cwd=cwd,
        env=dict(env),
        capture_output=True,
        text=True,
        check=False,
    )


def run_nix_probe_command(
    argv: Sequence[str], cwd: Path, env: Mapping[str, str]
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            list(argv),
            cwd=cwd,
            env=dict(env),
            capture_output=True,
            text=True,
            check=False,
            timeout=NIX_PROBE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise CoverageError(
            f"Nix probe exceeded {NIX_PROBE_TIMEOUT_SECONDS}s; output redacted"
        ) from error


def _object_without_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, member in pairs:
        if key in value:
            raise DuplicateKeyError(f"duplicate JSON key: {key!r}")
        value[key] = member
    return value


def parse_json(text: str, *, source: str) -> Any:
    """Parse strict JSON, rejecting duplicate object keys."""

    try:
        return json.loads(text, object_pairs_hook=_object_without_duplicates)
    except DuplicateKeyError:
        raise
    except (json.JSONDecodeError, UnicodeError) as error:
        raise CoverageError(f"{source}: malformed JSON: {error}") from error


def load_json(path: Path) -> Any:
    descriptor = -1
    try:
        descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise CoverageError(f"JSON input is not a regular file: {path}")
        with os.fdopen(descriptor, "r", encoding="utf-8") as stream:
            descriptor = -1
            text = stream.read()
    except CoverageError:
        raise
    except OSError as error:
        raise CoverageError(f"cannot read {path}: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    return parse_json(text, source=str(path))


def _expect_object(value: Any, where: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise CoverageError(f"{where} must be an object")
    return value


def _expect_list(value: Any, where: str) -> list[Any]:
    if not isinstance(value, list):
        raise CoverageError(f"{where} must be an array")
    return value


def _expect_string(value: Any, where: str, *, nonempty: bool = True) -> str:
    if not isinstance(value, str) or (nonempty and not value):
        qualifier = "non-empty " if nonempty else ""
        raise CoverageError(f"{where} must be a {qualifier}string")
    return value


def _expect_exact_keys(
    value: dict[str, Any], keys: set[str] | frozenset[str], where: str
) -> None:
    actual = set(value)
    if actual != set(keys):
        missing = sorted(set(keys) - actual)
        extra = sorted(actual - set(keys))
        raise CoverageError(f"{where} keys differ; missing={missing}, extra={extra}")


def _unique_strings(value: Any, where: str, *, nonempty: bool = True) -> list[str]:
    members = _expect_list(value, where)
    result = [
        _expect_string(member, f"{where}[{index}]")
        for index, member in enumerate(members)
    ]
    if nonempty and not result:
        raise CoverageError(f"{where} must not be empty")
    if len(result) != len(set(result)):
        raise CoverageError(f"{where} contains duplicate entries")
    return result


def _safe_id(value: Any, where: str) -> str:
    result = _expect_string(value, where)
    if not SAFE_ID_RE.fullmatch(result):
        raise CoverageError(f"{where} is not a safe identifier: {result!r}")
    return result


def _relative_path(value: Any, where: str) -> str:
    result = _expect_string(value, where)
    pure = PurePosixPath(result)
    if (
        pure.is_absolute()
        or result != pure.as_posix()
        or result in {".", ""}
        or ".." in pure.parts
        or any(ord(character) < 32 for character in result)
    ):
        raise CoverageError(f"{where} is not a normalized repository path: {result!r}")
    return result


def _validate_argv(value: Any, where: str) -> list[str]:
    argv = [
        _expect_string(member, f"{where}[{index}]")
        for index, member in enumerate(_expect_list(value, where))
    ]
    if not argv:
        raise CoverageError(f"{where} must not be empty")
    if any("\x00" in member or "\n" in member or "\r" in member for member in argv):
        raise CoverageError(f"{where} contains a control character")
    return argv


def _validate_nix_probe_argv(argv: Sequence[str], where: str) -> None:
    """Validate the complete credential-free argv grammar for a Nix probe."""

    if list(argv[:2]) != ["nix", "eval"]:
        raise CoverageError(f"{where} must begin with ['nix', 'eval']")
    no_value_flags = {
        "--no-eval-cache",
        "--no-write-lock-file",
        "--no-warn-dirty",
        "--raw",
        "--json",
    }
    seen_flags: set[str] = set()
    source_count = 0
    output_modes = 0
    index = 2
    while index < len(argv):
        argument = argv[index]
        if argument in no_value_flags or re.fullmatch(r"-v+", argument):
            canonical = "-v" if argument.startswith("-v") else argument
            if canonical in seen_flags:
                raise CoverageError(f"{where} repeats flag {canonical!r}")
            seen_flags.add(canonical)
            if argument in {"--raw", "--json"}:
                output_modes += 1
            index += 1
            continue
        if argument == "--log-format":
            if argument in seen_flags or index + 1 >= len(argv):
                raise CoverageError(f"{where} has an invalid --log-format")
            if argv[index + 1] != "internal-json":
                raise CoverageError(f"{where} must use internal-json logs")
            seen_flags.add(argument)
            index += 2
            continue
        if argument.startswith("--log-format="):
            if "--log-format" in seen_flags or argument != "--log-format=internal-json":
                raise CoverageError(f"{where} has an invalid --log-format")
            seen_flags.add("--log-format")
            index += 1
            continue
        if argument == "--apply":
            if argument in seen_flags or index + 1 >= len(argv):
                raise CoverageError(f"{where} has an invalid --apply")
            expression = argv[index + 1]
            apply_match = re.fullmatch(
                r"x: builtins[.]mapAttrs \(_: ([A-Za-z][A-Za-z0-9]*): "
                r"builtins[.]attrNames \1\) x",
                expression,
            )
            if apply_match is None:
                raise CoverageError(
                    f"{where} --apply is outside the allowlisted normal form"
                )
            seen_flags.add(argument)
            index += 2
            continue
        if argument == "--file":
            if argument in seen_flags or index + 1 >= len(argv):
                raise CoverageError(f"{where} has an invalid --file")
            source = _relative_path(argv[index + 1], f"{where} --file source")
            if not source.endswith(".nix"):
                raise CoverageError(f"{where} --file source must be a Nix file")
            seen_flags.add(argument)
            source_count += 1
            index += 2
            continue
        if argument.startswith("path:"):
            raise CoverageError(
                f"{where} explicit path: refs can copy untracked or Git metadata"
            )
        source_match = re.fullmatch(
            r"([.](?:/[A-Za-z0-9._/-]+)?)#[A-Za-z0-9.@_\"/-]+", argument
        )
        if source_match is not None:
            source = source_match.group(1)
            if source != ".":
                _relative_path(source[2:], f"{where} path source")
            source_count += 1
            index += 1
            continue
        raise CoverageError(
            f"{where} contains a non-allowlisted argument at index {index}"
        )
    required = {
        "--no-eval-cache",
        "--no-write-lock-file",
        "-v",
        "--log-format",
    }
    if not required.issubset(seen_flags):
        raise CoverageError(f"{where} lacks required cache/logging flags")
    if source_count != 1:
        raise CoverageError(
            f"{where} must contain exactly one bounded evaluation source"
        )
    if output_modes != 1:
        raise CoverageError(f"{where} must select exactly one of --raw or --json")


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(
        value, sort_keys=True, ensure_ascii=False, separators=(",", ":")
    ).encode("utf-8")


def sensitive_scan(value: Any, where: str = "artifact") -> None:
    """Reject credential-shaped keys and assignments recursively.

    Paths containing words such as ``key`` or ``secret`` remain safe; what is
    forbidden is a structural field for a sensitive value or a string that looks
    like an assignment/token/private key.
    """

    if isinstance(value, dict):
        for key, member in value.items():
            normalized = key.casefold().replace(" ", "")
            if normalized in FORBIDDEN_RAW_KEYS or any(
                part in normalized for part in SENSITIVE_KEY_PARTS
            ):
                raise CoverageError(f"{where}: forbidden sensitive key {key!r}")
            sensitive_scan(member, f"{where}.{key}")
    elif isinstance(value, list):
        for index, member in enumerate(value):
            sensitive_scan(member, f"{where}[{index}]")
    elif isinstance(value, str):
        if (
            SENSITIVE_ASSIGNMENT_RE.search(value)
            or PRIVATE_KEY_RE.search(value)
            or KNOWN_CREDENTIAL_RE.search(value)
            or re.search(
                r"(?i)(?:^|\s)--?(?:password|token|access-tokens|secret-key|"
                r"private-key|credentials?)(?:[=\s]|$)",
                value,
            )
        ):
            raise CoverageError(f"{where}: credential-shaped string is forbidden")


def _validate_inventory_entries(
    value: Any, where: str, allowed_kinds: frozenset[str]
) -> list[dict[str, Any]]:
    entries = _expect_list(value, where)
    seen: set[str] = set()
    normalized: list[dict[str, Any]] = []
    keys = {"path", "kind", "tier", "evidence", "gap"}
    for index, raw in enumerate(entries):
        entry_where = f"{where}[{index}]"
        entry = _expect_object(raw, entry_where)
        _expect_exact_keys(entry, keys, entry_where)
        path = _relative_path(entry["path"], f"{entry_where}.path")
        if path in seen:
            raise CoverageError(f"{where}: duplicate ownership assignment for {path!r}")
        seen.add(path)
        kind = _safe_id(entry["kind"], f"{entry_where}.kind")
        if kind not in allowed_kinds:
            raise CoverageError(
                f"{entry_where}.kind must be one of {sorted(allowed_kinds)}"
            )
        tier = _expect_string(entry["tier"], f"{entry_where}.tier")
        if tier not in TIERS:
            raise CoverageError(f"{entry_where}.tier must be one of {sorted(TIERS)}")
        evidence = _unique_strings(
            entry["evidence"], f"{entry_where}.evidence", nonempty=False
        )
        gap = entry["gap"]
        if gap is not None:
            gap = _expect_string(gap, f"{entry_where}.gap")
        if not evidence and gap is None:
            raise CoverageError(f"{entry_where} needs evidence or an explicit gap")
        normalized.append(
            {
                "path": path,
                "kind": kind,
                "tier": tier,
                "evidence": sorted(evidence),
                "gap": gap,
            }
        )
    return sorted(normalized, key=lambda entry: entry["path"])


def _validate_hosts(manifest: dict[str, Any]) -> dict[str, Any]:
    hosts = _expect_object(manifest["hosts"], "manifest.hosts")
    _expect_exact_keys(
        hosts, {"machineIds", "groupRows", "syntheticFixtures"}, "manifest.hosts"
    )

    machines: dict[str, str] = {}
    normalized_machines: list[dict[str, str]] = []
    for index, raw in enumerate(
        _expect_list(hosts["machineIds"], "manifest.hosts.machineIds")
    ):
        where = f"manifest.hosts.machineIds[{index}]"
        entry = _expect_object(raw, where)
        _expect_exact_keys(entry, {"id", "root"}, where)
        identifier = _safe_id(entry["id"], f"{where}.id")
        root = _safe_id(entry["root"], f"{where}.root")
        if identifier in machines:
            raise CoverageError(f"duplicate machine id {identifier!r}")
        machines[identifier] = root
        normalized_machines.append({"id": identifier, "root": root})
    if not machines:
        raise CoverageError("manifest must declare at least one machine ID")

    groups: dict[str, dict[str, Any]] = {}
    normalized_groups: list[dict[str, Any]] = []
    group_member_owner: dict[str, str] = {}
    for index, raw in enumerate(
        _expect_list(hosts["groupRows"], "manifest.hosts.groupRows")
    ):
        where = f"manifest.hosts.groupRows[{index}]"
        entry = _expect_object(raw, where)
        _expect_exact_keys(entry, {"id", "members", "root", "evidenceLimits"}, where)
        identifier = _safe_id(entry["id"], f"{where}.id")
        if identifier in groups or identifier in machines:
            raise CoverageError(f"duplicate or overlapping group id {identifier!r}")
        members = _unique_strings(entry["members"], f"{where}.members")
        root = _safe_id(entry["root"], f"{where}.root")
        raw_limits = entry["evidenceLimits"]
        if isinstance(raw_limits, str):
            limits = [_expect_string(raw_limits, f"{where}.evidenceLimits")]
        else:
            limits = _unique_strings(raw_limits, f"{where}.evidenceLimits")
        for member in members:
            if member not in machines:
                raise CoverageError(f"{where}: unknown member {member!r}")
            if member in group_member_owner:
                raise CoverageError(f"machine {member!r} occurs in multiple group rows")
            group_member_owner[member] = identifier
            if machines[member] != root:
                raise CoverageError(f"{where}: member {member!r} has a different root")
        groups[identifier] = {"members": members, "root": root}
        normalized_groups.append(
            {
                "id": identifier,
                "members": sorted(members),
                "root": root,
                "evidenceLimits": sorted(limits),
            }
        )

    synthetic: dict[str, dict[str, str]] = {}
    normalized_synthetic: list[dict[str, str]] = []
    for index, raw in enumerate(
        _expect_list(hosts["syntheticFixtures"], "manifest.hosts.syntheticFixtures")
    ):
        where = f"manifest.hosts.syntheticFixtures[{index}]"
        entry = _expect_object(raw, where)
        _expect_exact_keys(entry, {"id", "alias", "root"}, where)
        identifier = _safe_id(entry["id"], f"{where}.id")
        alias = _safe_id(entry["alias"], f"{where}.alias")
        root = _safe_id(entry["root"], f"{where}.root")
        if identifier in synthetic or identifier in machines or identifier in groups:
            raise CoverageError(f"duplicate or overlapping synthetic id {identifier!r}")
        synthetic[identifier] = {"alias": alias, "root": root}
        normalized_synthetic.append({"id": identifier, "alias": alias, "root": root})
    if not synthetic:
        raise CoverageError("manifest must declare at least one synthetic fixture")

    roots: dict[str, dict[str, Any]] = {}
    all_aliases: set[str] = set()
    normalized_roots: list[dict[str, Any]] = []
    for index, raw in enumerate(
        _expect_list(manifest["evaluationRoots"], "manifest.evaluationRoots")
    ):
        where = f"manifest.evaluationRoots[{index}]"
        entry = _expect_object(raw, where)
        _expect_exact_keys(
            entry,
            {"id", "kind", "system", "members", "aliases", "qualityEvidence"},
            where,
        )
        identifier = _safe_id(entry["id"], f"{where}.id")
        if identifier in roots:
            raise CoverageError(f"duplicate evaluation root {identifier!r}")
        kind = _safe_id(entry["kind"], f"{where}.kind")
        system = _safe_id(entry["system"], f"{where}.system")
        members = _unique_strings(entry["members"], f"{where}.members")
        aliases = _unique_strings(entry["aliases"], f"{where}.aliases", nonempty=False)
        quality_evidence = _unique_strings(
            entry["qualityEvidence"], f"{where}.qualityEvidence"
        )
        overlap = all_aliases.intersection(aliases)
        if overlap:
            raise CoverageError(f"evaluation aliases are duplicated: {sorted(overlap)}")
        all_aliases.update(aliases)
        roots[identifier] = {
            "kind": kind,
            "system": system,
            "members": set(members),
            "aliases": set(aliases),
        }
        normalized_roots.append(
            {
                "id": identifier,
                "kind": kind,
                "system": system,
                "members": sorted(members),
                "aliases": sorted(aliases),
                "qualityEvidence": sorted(quality_evidence),
            }
        )
    if not roots:
        raise CoverageError("manifest must declare at least one evaluation root")
    declared_systems = set(manifest["declaredSystems"])
    allowed_root_kinds = {
        "darwin-configuration",
        "external-consumer",
        "shared-home-manager",
        "synthetic-home-manager",
    }
    for identifier, root in roots.items():
        if root["system"] not in declared_systems:
            raise CoverageError(
                f"evaluation root {identifier!r} uses undeclared system {root['system']!r}"
            )
        if root["kind"] not in allowed_root_kinds:
            raise CoverageError(
                f"evaluation root {identifier!r} uses unknown kind {root['kind']!r}"
            )

    expected_members: dict[str, set[str]] = {identifier: set() for identifier in roots}
    for identifier, root in machines.items():
        if root not in roots:
            raise CoverageError(
                f"machine {identifier!r} names unknown evaluation root {root!r}"
            )
        expected_members.setdefault(root, set()).add(identifier)
    for identifier, entry in synthetic.items():
        if entry["root"] not in roots:
            raise CoverageError(
                f"synthetic fixture {identifier!r} names unknown root {entry['root']!r}"
            )
        expected_members.setdefault(entry["root"], set()).add(identifier)
    for identifier, entry in groups.items():
        if entry["root"] not in roots:
            raise CoverageError(
                f"group {identifier!r} names unknown root {entry['root']!r}"
            )
        if identifier not in roots[entry["root"]]["aliases"]:
            raise CoverageError(
                f"group alias {identifier!r} is absent from root {entry['root']!r}"
            )
    for identifier, root in roots.items():
        if root["members"] != expected_members.get(identifier, set()):
            raise CoverageError(
                f"evaluation root {identifier!r} members differ; "
                f"expected={sorted(expected_members.get(identifier, set()))}, "
                f"actual={sorted(root['members'])}"
            )

    return {
        "machineIds": sorted(normalized_machines, key=lambda entry: entry["id"]),
        "groupRows": sorted(normalized_groups, key=lambda entry: entry["id"]),
        "syntheticFixtures": sorted(
            normalized_synthetic, key=lambda entry: entry["id"]
        ),
        "evaluationRoots": sorted(normalized_roots, key=lambda entry: entry["id"]),
    }


def _validate_nix_probes(value: Any) -> list[dict[str, Any]]:
    section = _expect_object(value, "manifest.nixFileReach")
    _expect_exact_keys(section, {"probes"}, "manifest.nixFileReach")
    probes: list[dict[str, Any]] = []
    seen: set[str] = set()
    for index, raw in enumerate(
        _expect_list(section["probes"], "manifest.nixFileReach.probes")
    ):
        where = f"manifest.nixFileReach.probes[{index}]"
        probe = _expect_object(raw, where)
        _expect_exact_keys(
            probe, {"id", "tier", "argv", "normalForm", "expectedRootFiles"}, where
        )
        identifier = _safe_id(probe["id"], f"{where}.id")
        if identifier in seen:
            raise CoverageError(f"duplicate Nix probe id {identifier!r}")
        seen.add(identifier)
        tier = _expect_string(probe["tier"], f"{where}.tier")
        if tier not in TIERS:
            raise CoverageError(f"{where}.tier must be one of {sorted(TIERS)}")
        argv = _validate_argv(probe["argv"], f"{where}.argv")
        _validate_nix_probe_argv(argv, f"{where}.argv")
        if not argv or argv[0] != "nix" or "eval" not in argv:
            raise CoverageError(f"{where}.argv must invoke nix eval directly")
        if "--no-eval-cache" not in argv:
            raise CoverageError(f"{where}.argv must disable the evaluation cache")
        has_internal_json = "--log-format=internal-json" in argv or any(
            argv[position : position + 2] == ["--log-format", "internal-json"]
            for position in range(len(argv) - 1)
        )
        if not has_internal_json:
            raise CoverageError(f"{where}.argv must select internal-json logs")
        if not any(
            argument == "--verbose" or re.fullmatch(r"-v+", argument)
            for argument in argv
        ):
            raise CoverageError(
                f"{where}.argv must request talkative evaluation diagnostics"
            )
        normal_form = _expect_string(probe["normalForm"], f"{where}.normalForm")
        roots = [
            _relative_path(path, f"{where}.expectedRootFiles[{root_index}]")
            for root_index, path in enumerate(
                _expect_list(probe["expectedRootFiles"], f"{where}.expectedRootFiles")
            )
        ]
        if not roots or len(roots) != len(set(roots)):
            raise CoverageError(
                f"{where}.expectedRootFiles must be nonempty and unique"
            )
        contract = PROBE_CONTRACTS.get(identifier)
        if contract is None:
            raise CoverageError(f"{where}.id is not a declared Nix probe contract")
        if argv.count(contract["target"]) != 1:
            raise CoverageError(f"{where}.argv is not bound to probe id {identifier!r}")
        if normal_form != contract["normalForm"]:
            raise CoverageError(
                f"{where}.normalForm is not bound to probe id {identifier!r}"
            )
        if sorted(roots) != sorted(contract["roots"]):
            raise CoverageError(
                f"{where}.expectedRootFiles is not bound to probe id {identifier!r}"
            )
        probes.append(
            {
                "id": identifier,
                "tier": tier,
                "argv": argv,
                "normalForm": normal_form,
                "expectedRootFiles": sorted(roots),
            }
        )
    if not probes:
        raise CoverageError("manifest.nixFileReach.probes must not be empty")
    missing_contracts = sorted(REQUIRED_PROBE_IDS - seen)
    extra_contracts = sorted(seen - REQUIRED_PROBE_IDS)
    if missing_contracts or extra_contracts:
        raise CoverageError(
            "manifest Nix probe contract set differs; "
            f"missing={missing_contracts}, extra={extra_contracts}"
        )
    return sorted(probes, key=lambda probe: probe["id"])


def validate_manifest(value: Any) -> dict[str, Any]:
    manifest = _expect_object(value, "manifest")
    _expect_exact_keys(manifest, MANIFEST_KEYS, "manifest")
    if manifest["schema"] != MANIFEST_SCHEMA:
        raise CoverageError(f"unsupported manifest schema: {manifest['schema']!r}")
    systems = _unique_strings(manifest["declaredSystems"], "manifest.declaredSystems")
    if systems != sorted(systems):
        raise CoverageError("manifest.declaredSystems must be sorted")

    python_inventory = _validate_inventory_entries(
        manifest["pythonInventory"], "manifest.pythonInventory", PYTHON_KINDS
    )
    shell_ownership = _validate_inventory_entries(
        manifest["shellOwnership"], "manifest.shellOwnership", SHELL_KINDS
    )
    hosts = _validate_hosts(manifest)
    root_systems = {entry["system"] for entry in hosts["evaluationRoots"]}
    if set(systems) != root_systems:
        raise CoverageError(
            "manifest.declaredSystems differs from evaluation-root systems"
        )

    gates = _expect_object(manifest["gateDenominator"], "manifest.gateDenominator")
    _expect_exact_keys(
        gates,
        {"policy", "qualitySuites", "topLevelChecks"},
        "manifest.gateDenominator",
    )
    policy = _expect_object(gates["policy"], "manifest.gateDenominator.policy")
    _expect_exact_keys(
        policy,
        {
            "authorityIds",
            "invocationSurfaces",
            "invocationSurfaceRule",
            "provenNegativeRule",
        },
        "manifest.gateDenominator.policy",
    )
    normalized_policy = {
        "authorityIds": sorted(
            _unique_strings(
                policy["authorityIds"],
                "manifest.gateDenominator.policy.authorityIds",
            )
        ),
        "invocationSurfaces": sorted(
            _unique_strings(
                policy["invocationSurfaces"],
                "manifest.gateDenominator.policy.invocationSurfaces",
            )
        ),
        "invocationSurfaceRule": _expect_string(
            policy["invocationSurfaceRule"],
            "manifest.gateDenominator.policy.invocationSurfaceRule",
        ),
        "provenNegativeRule": _expect_string(
            policy["provenNegativeRule"],
            "manifest.gateDenominator.policy.provenNegativeRule",
        ),
    }
    quality_suites = _unique_strings(
        gates["qualitySuites"], "manifest.gateDenominator.qualitySuites"
    )
    checks: list[dict[str, str]] = []
    check_keys: set[tuple[str, str]] = set()
    for index, raw in enumerate(
        _expect_list(gates["topLevelChecks"], "manifest.gateDenominator.topLevelChecks")
    ):
        where = f"manifest.gateDenominator.topLevelChecks[{index}]"
        entry = _expect_object(raw, where)
        _expect_exact_keys(entry, {"system", "id"}, where)
        system = _safe_id(entry["system"], f"{where}.system")
        identifier = _safe_id(entry["id"], f"{where}.id")
        if system not in systems:
            raise CoverageError(f"{where}: system {system!r} is not declared")
        key = (system, identifier)
        if key in check_keys:
            raise CoverageError(f"duplicate top-level check {key!r}")
        check_keys.add(key)
        checks.append({"system": system, "id": identifier})
    if not checks:
        raise CoverageError("manifest gate denominator has no flake checks")
    if {entry["system"] for entry in checks} != set(systems):
        raise CoverageError(
            "every declared system must have at least one top-level check"
        )

    probes = _validate_nix_probes(manifest["nixFileReach"])

    output = _expect_object(
        manifest["outputApplicability"], "manifest.outputApplicability"
    )
    _expect_exact_keys(
        output,
        {"expectedTopLevelOutputNames", "outputKinds"},
        "manifest.outputApplicability",
    )
    expected_output_names = _unique_strings(
        output["expectedTopLevelOutputNames"],
        "manifest.outputApplicability.expectedTopLevelOutputNames",
    )
    output_kinds = _expect_list(
        output["outputKinds"], "manifest.outputApplicability.outputKinds"
    )
    if not output_kinds:
        raise CoverageError(
            "manifest.outputApplicability.outputKinds must not be empty"
        )
    # The output-kind records are declarative. Packages additionally split their
    # denominator into common and system-specific attribute sets.
    kind_ids: set[str] = set()
    normalized_output_kinds: list[dict[str, Any]] = []
    for index, raw in enumerate(output_kinds):
        where = f"manifest.outputApplicability.outputKinds[{index}]"
        entry = _expect_object(raw, where)
        required_keys = {"kind", "systems", "expectation", "expectedAttrs"}
        optional_keys = {"commonAttrs", "systemAdditions"}
        if not required_keys.issubset(entry) or not set(entry).issubset(
            required_keys | optional_keys
        ):
            raise CoverageError(f"{where} has invalid keys")
        if ("commonAttrs" in entry) != ("systemAdditions" in entry):
            raise CoverageError(
                f"{where} must provide commonAttrs and systemAdditions together"
            )
        kind = _safe_id(entry["kind"], f"{where}.kind")
        if kind in kind_ids:
            raise CoverageError(f"duplicate output kind {kind!r}")
        kind_ids.add(kind)
        kind_systems = _unique_strings(
            entry["systems"], f"{where}.systems", nonempty=False
        )
        if not set(kind_systems).issubset(systems):
            raise CoverageError(f"{where} contains an undeclared system")
        expected_attrs = _unique_strings(
            entry["expectedAttrs"], f"{where}.expectedAttrs", nonempty=False
        )
        expectation = _expect_string(entry["expectation"], f"{where}.expectation")
        normalized_output: dict[str, Any] = {
            "kind": kind,
            "systems": sorted(kind_systems),
            "expectation": expectation,
            "expectedAttrs": sorted(expected_attrs),
        }
        if "commonAttrs" in entry:
            normalized_output["commonAttrs"] = sorted(
                _unique_strings(entry["commonAttrs"], f"{where}.commonAttrs")
            )
            additions = _expect_object(
                entry["systemAdditions"], f"{where}.systemAdditions"
            )
            if set(additions) != set(systems):
                raise CoverageError(
                    f"{where}.systemAdditions must name every declared system exactly"
                )
            normalized_output["systemAdditions"] = {
                system: sorted(
                    _unique_strings(
                        additions[system],
                        f"{where}.systemAdditions.{system}",
                        nonempty=False,
                    )
                )
                for system in sorted(additions)
            }
        normalized_output_kinds.append(normalized_output)
    if set(expected_output_names) != kind_ids:
        raise CoverageError(
            "expected top-level output names must exactly match output-kind records"
        )

    budgets = _expect_object(manifest["budgetsSeconds"], "manifest.budgetsSeconds")
    _expect_exact_keys(budgets, TIERS, "manifest.budgetsSeconds")
    normalized_budgets: dict[str, int] = {}
    for key, value_for_key in budgets.items():
        if (
            isinstance(value_for_key, bool)
            or not isinstance(value_for_key, int)
            or value_for_key <= 0
        ):
            raise CoverageError(
                f"manifest.budgetsSeconds.{key} must be a positive integer"
            )
        normalized_budgets[key] = value_for_key
    blind_spots = _unique_strings(manifest["blindSpots"], "manifest.blindSpots")

    normalized = {
        "schema": MANIFEST_SCHEMA,
        "declaredSystems": systems,
        "hosts": {
            "machineIds": hosts["machineIds"],
            "groupRows": hosts["groupRows"],
            "syntheticFixtures": hosts["syntheticFixtures"],
        },
        "evaluationRoots": hosts["evaluationRoots"],
        "pythonInventory": python_inventory,
        "shellOwnership": shell_ownership,
        "gateDenominator": {
            "policy": normalized_policy,
            "qualitySuites": quality_suites,
            "topLevelChecks": sorted(
                checks, key=lambda entry: (entry["system"], entry["id"])
            ),
        },
        "nixFileReach": {"probes": probes},
        "outputApplicability": {
            "expectedTopLevelOutputNames": sorted(expected_output_names),
            "outputKinds": sorted(
                normalized_output_kinds, key=lambda entry: entry["kind"]
            ),
        },
        "budgetsSeconds": normalized_budgets,
        "blindSpots": sorted(blind_spots),
    }
    sensitive_scan(normalized, "manifest")
    return normalized


def _checked_command(
    runner: RunCommand,
    argv: Sequence[str],
    repo: Path,
    *,
    description: str,
) -> subprocess.CompletedProcess[str]:
    proc = runner(argv, repo, clean_environment())
    if proc.returncode != 0:
        raise CoverageError(f"{description} failed with exit {proc.returncode}")
    return proc


def _git_index_entries(
    repo: Path, runner: RunCommand, pathspec: str | None = None
) -> list[dict[str, str]]:
    argv = ["git", "ls-files", "--stage", "-z"]
    if pathspec is not None:
        argv.extend(["--", pathspec])
    proc = _checked_command(
        runner, argv, repo, description="git tracked-file discovery"
    )
    records = proc.stdout.split("\0")
    if records and records[-1] == "":
        records.pop()
    normalized: list[dict[str, str]] = []
    for index, record in enumerate(records):
        metadata, separator, raw_path = record.partition("\t")
        fields = metadata.split()
        if not separator or len(fields) != 3:
            raise CoverageError(f"git index record {index} is malformed")
        mode, object_id, stage = fields
        if stage != "0":
            raise CoverageError(f"git index has an unresolved entry for {raw_path!r}")
        if mode not in {"100644", "100755"}:
            raise CoverageError(
                f"tracked path {raw_path!r} is not a regular file (mode {mode})"
            )
        if re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", object_id) is None:
            raise CoverageError(f"git index object for {raw_path!r} is malformed")
        normalized.append(
            {
                "path": _relative_path(raw_path, "git tracked path"),
                "mode": mode,
                "object": object_id,
            }
        )
    paths = [entry["path"] for entry in normalized]
    if len(paths) != len(set(paths)):
        raise CoverageError("git tracked-file discovery returned duplicate paths")
    return sorted(normalized, key=lambda entry: entry["path"])


def _git_paths(
    repo: Path, runner: RunCommand, pathspec: str | None = None
) -> list[str]:
    return [entry["path"] for entry in _git_index_entries(repo, runner, pathspec)]


def _path_bytes(repo: Path, path: str, runner: RunCommand) -> bytes:
    proc = runner(["git", "show", f":{path}"], repo, clean_environment())
    if proc.returncode != 0:
        raise CoverageError(f"tracked path {path!r} is absent from the index")
    # ``RunCommand`` is text-oriented for injectable tests.  Shebangs and Python
    # sources must be UTF-8; surrogate-unsafe/binary content fails classification.
    return proc.stdout.encode("utf-8")


def load_index_json(
    repo: Path, path: PurePosixPath | str, runner: RunCommand = run_command
) -> Any:
    relative = _relative_path(str(path), "indexed JSON path")
    try:
        text = _path_bytes(repo, relative, runner).decode("utf-8")
    except UnicodeError as error:
        raise CoverageError(f"indexed JSON {relative} is not UTF-8: {error}") from error
    return parse_json(text, source=f"index:{relative}")


def ensure_projected_worktree_matches_index(
    repo: Path, runner: RunCommand = run_command
) -> None:
    proc = _checked_command(
        runner,
        ["git", "diff", "--name-only", "-z", "--"],
        repo,
        description="index/worktree comparison",
    )
    changed: list[str] = []
    for path in proc.stdout.split("\0"):
        if not path:
            continue
        pure = PurePosixPath(_relative_path(path, "changed tracked path"))
        if pure.parent == ARTIFACT_DIRECTORY and ARTIFACT_RE.fullmatch(pure.name):
            continue
        changed.append(pure.as_posix())
    if changed:
        raise CoverageError(
            f"tracked source differs between index and worktree: {sorted(changed)}"
        )


def discover_files(
    repo: Path, runner: RunCommand = run_command
) -> dict[str, list[str]]:
    tracked = _git_index_entries(repo, runner)
    nix_files: list[str] = []
    python_files: list[str] = []
    python_tests: list[str] = []
    shell_files: list[str] = []
    for entry in tracked:
        path = entry["path"]
        executable = entry["mode"] == "100755"
        if path.endswith(".nix"):
            nix_files.append(path)
        if path.endswith(".py"):
            python_files.append(path)
        elif executable:
            first_line = _path_bytes(repo, path, runner).splitlines()[:1]
            if (
                first_line
                and first_line[0].startswith(b"#!")
                and b"python" in first_line[0]
            ):
                python_files.append(path)
        if (
            path.startswith("bin/")
            and "/" not in path[len("bin/") :]
            and path.endswith("-test.py")
        ):
            python_tests.append(path)
        if executable or path.endswith((".sh", ".bash")):
            first_line = _path_bytes(repo, path, runner).splitlines()[:1]
            if (
                first_line
                and first_line[0].startswith(b"#!")
                and b"bash" in first_line[0]
            ):
                shell_files.append(path)
    return {
        "nix": sorted(nix_files),
        "python": sorted(python_files),
        "pythonTests": sorted(python_tests),
        "shell": sorted(shell_files),
    }


def source_projection_digest(
    repo: Path,
    runner: RunCommand = run_command,
) -> str:
    """Hash every tracked regular source except the coverage artifact itself."""

    projection: list[dict[str, str]] = []
    for entry in _git_index_entries(repo, runner):
        path = entry["path"]
        pure = PurePosixPath(path)
        if pure.parent == ARTIFACT_DIRECTORY and ARTIFACT_RE.fullmatch(pure.name):
            continue
        projection.append(
            {
                "path": path,
                "mode": entry["mode"],
                "object": entry["object"],
            }
        )
    if not projection:
        raise CoverageError("coverage source projection is empty")
    return hashlib.sha256(canonical_bytes(projection)).hexdigest()


def _attribute_root_and_name(node: ast.AST) -> tuple[str | None, str | None]:
    if not isinstance(node, ast.Attribute):
        return None, None
    name = node.attr
    root: ast.AST = node.value
    while isinstance(root, ast.Attribute):
        root = root.value
    return (root.id if isinstance(root, ast.Name) else None), name


def _base_name(node: ast.expr) -> str | None:
    if isinstance(node, ast.Name):
        return node.id
    if isinstance(node, ast.Attribute):
        parts: list[str] = [node.attr]
        current: ast.expr = node.value
        while isinstance(current, ast.Attribute):
            parts.append(current.attr)
            current = current.value
        if isinstance(current, ast.Name):
            parts.append(current.id)
            return ".".join(reversed(parts))
    return None


def discover_python_static(
    repo: Path,
    python_paths: Sequence[str],
    runner: RunCommand = run_command,
) -> dict[str, list[str]]:
    cases: list[str] = []
    assertions: list[str] = []
    for path in python_paths:
        try:
            source = _path_bytes(repo, path, runner).decode("utf-8")
        except UnicodeError as error:
            raise CoverageError(
                f"Python source {path} is not UTF-8: {error}"
            ) from error
        try:
            tree = ast.parse(source, filename=path)
        except SyntaxError as error:
            raise CoverageError(
                f"cannot parse Python source {path}: {error}"
            ) from error

        # unittest discovers module-level TestCase classes. Nested same-named
        # classes are different AST objects and are not module attributes; using
        # ast.walk plus node.name conflates them and can manufacture test IDs.
        class_nodes = [node for node in tree.body if isinstance(node, ast.ClassDef)]
        unittest_aliases = {"TestCase", "IsolatedAsyncioTestCase"}
        for node in tree.body:
            if not isinstance(node, ast.ImportFrom) or node.module != "unittest":
                continue
            for imported in node.names:
                if imported.name in {"TestCase", "IsolatedAsyncioTestCase"}:
                    unittest_aliases.add(imported.asname or imported.name)
        direct_test_cases: set[str] = set()
        bases_by_class: dict[str, set[str]] = {}
        for node in class_nodes:
            bases = {
                name for base in node.bases if (name := _base_name(base)) is not None
            }
            bases_by_class[node.name] = bases
            if any(
                base in unittest_aliases
                or base.endswith(".TestCase")
                or base.endswith(".IsolatedAsyncioTestCase")
                for base in bases
            ):
                direct_test_cases.add(node.name)
        changed = True
        while changed:
            changed = False
            for class_name, bases in bases_by_class.items():
                if class_name not in direct_test_cases and bases.intersection(
                    direct_test_cases
                ):
                    direct_test_cases.add(class_name)
                    changed = True
        for node in class_nodes:
            if node.name not in direct_test_cases:
                continue
            for child in node.body:
                if isinstance(
                    child, (ast.FunctionDef, ast.AsyncFunctionDef)
                ) and child.name.startswith("test_"):
                    cases.append(f"{path}::{node.name}.{child.name}")
        for node in ast.walk(tree):
            if not isinstance(node, ast.Call):
                continue
            root, name = _attribute_root_and_name(node.func)
            direct_self = (
                isinstance(node.func, ast.Attribute)
                and isinstance(node.func.value, ast.Name)
                and node.func.value.id == "self"
            )
            if (
                direct_self
                and root == "self"
                and name is not None
                and name.startswith("assert")
            ):
                assertions.append(f"{path}:{node.lineno}:{node.col_offset + 1}:{name}")
    if len(cases) != len(set(cases)):
        raise CoverageError("static Python test-case IDs are not unique")
    if len(assertions) != len(set(assertions)):
        raise CoverageError("static Python assertion-call IDs are not unique")
    return {"testCases": sorted(cases), "assertionCalls": sorted(assertions)}


def discover_quality_suites(repo: Path, runner: RunCommand = run_command) -> list[str]:
    proc = _checked_command(
        runner, ["bin/quality", "--list"], repo, description="quality suite discovery"
    )
    suites = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
    if not suites or len(suites) != len(set(suites)):
        raise CoverageError(
            "bin/quality --list returned an empty or duplicate suite set"
        )
    for index, suite in enumerate(suites):
        _safe_id(suite, f"quality suite[{index}]")
    return sorted(suites)


def _normalize_local_event_path(repo: Path, raw_path: str) -> str | None:
    if "\x00" in raw_path or "\n" in raw_path or "\r" in raw_path:
        raise CoverageError(
            "Nix evaluation diagnostic path contains a control character"
        )
    if re.match(r"^«[^»]+»/", raw_path) or raw_path.startswith("<nix/"):
        return None
    raw = Path(raw_path)
    candidate = raw if raw.is_absolute() else repo / raw
    candidate = Path(os.path.abspath(os.path.normpath(candidate)))
    absolute_repo = Path(os.path.abspath(repo))
    try:
        relative = candidate.relative_to(absolute_repo)
    except ValueError:
        return None
    if relative == Path("."):
        return None
    return _relative_path(relative.as_posix(), "Nix evaluation event path")


def parse_nix_evaluation_events(
    stderr: str, repo: Path, tracked_nix: set[str]
) -> list[str]:
    """Parse internal-json logs and return credited local evaluation starts."""

    reached: set[str] = set()
    for line_number, raw_line in enumerate(stderr.splitlines(), start=1):
        line = raw_line.strip()
        if not line:
            continue
        if not line.startswith("@nix "):
            raise CoverageError(
                f"Nix internal-json line {line_number} lost its @nix framing"
            )
        line = line[len("@nix ") :]
        event = parse_json(line, source=f"Nix internal-json line {line_number}")
        event = _expect_object(event, f"Nix internal-json line {line_number}")
        message = event.get("msg")
        if message is None:
            continue
        if not isinstance(message, str):
            raise CoverageError(
                f"Nix internal-json line {line_number}.msg must be a string"
            )
        match = EVALUATING_FILE_RE.fullmatch(message)
        if match is None:
            if message.casefold().startswith("evaluating file"):
                raise CoverageError(
                    "Nix evaluating-file diagnostic changed shape; refusing stale evidence"
                )
            continue
        if event.get("action") != "msg":
            raise CoverageError(
                "Nix evaluating-file event no longer uses the internal-json msg action"
            )
        if event.get("level") != 4:
            raise CoverageError(
                "Nix evaluating-file event no longer uses talkative diagnostic level 4"
            )
        local = _normalize_local_event_path(repo, match.group(1))
        if local is None:
            continue
        if local in tracked_nix:
            reached.add(local)
        elif local.endswith(".nix"):
            raise CoverageError(f"Nix evaluated untracked local file {local!r}")
        # scopedImport may report a directory.  It is deliberately not credited
        # as default.nix because the diagnostic does not prove that resolution.
    return sorted(reached)


def _system_attr_map(
    stdout: str, systems: Sequence[str], where: str
) -> dict[str, list[str]]:
    value = _expect_object(parse_json(stdout, source=where), where)
    if sorted(value) != sorted(systems):
        raise CoverageError(f"{where} system set differs from the manifest")
    normalized: dict[str, list[str]] = {}
    for system in systems:
        attrs = _unique_strings(value[system], f"{where}.{system}", nonempty=False)
        if attrs != sorted(attrs):
            raise CoverageError(f"{where}.{system} attributes must be sorted")
        normalized[system] = attrs
    return normalized


def validate_nix_probe_stdout(
    probe: Mapping[str, Any], stdout: str, manifest: Mapping[str, Any]
) -> None:
    contract = PROBE_CONTRACTS[probe["id"]]
    kind = contract["outputKind"]
    if kind == "raw-drv-path":
        value = stdout[:-1] if stdout.endswith("\n") else stdout
        if (
            "\n" in value
            or re.fullmatch(
                r"/nix/store/[0-9abcdfghijklmnpqrsvwxyz]{32}-[^/\n]+[.]drv", value
            )
            is None
        ):
            raise CoverageError(
                f"Nix probe {probe['id']!r} did not return one raw drvPath"
            )
        return
    systems = manifest["declaredSystems"]
    actual = (
        _system_attr_map(stdout, systems, f"Nix probe {probe['id']}")
        if kind != "host-registry"
        else {}
    )
    if kind == "root-checks":
        expected = {system: [] for system in systems}
        for entry in manifest["gateDenominator"]["topLevelChecks"]:
            expected[entry["system"]].append(entry["id"])
        expected = {system: sorted(attrs) for system, attrs in expected.items()}
    elif kind == "root-packages":
        packages = next(
            entry
            for entry in manifest["outputApplicability"]["outputKinds"]
            if entry["kind"] == "packages"
        )
        expected = {
            system: sorted(
                packages["commonAttrs"] + packages["systemAdditions"].get(system, [])
            )
            for system in systems
        }
    elif kind == "host-registry":
        value = _expect_object(
            parse_json(stdout, source="Nix probe host-registry"),
            "Nix probe host-registry",
        )
        _expect_exact_keys(value, {"rows"}, "Nix probe host-registry")
        actual_rows = _expect_list(value["rows"], "Nix probe host-registry.rows")
        normalized_rows = []
        for index, raw in enumerate(actual_rows):
            where = f"Nix probe host-registry.rows[{index}]"
            row = _expect_object(raw, where)
            _expect_exact_keys(
                row, {"id", "system", "activation", "grouped", "members"}, where
            )
            grouped = row["grouped"]
            if not isinstance(grouped, bool):
                raise CoverageError(f"{where}.grouped must be boolean")
            normalized_rows.append(
                {
                    "id": _safe_id(row["id"], f"{where}.id"),
                    "system": _safe_id(row["system"], f"{where}.system"),
                    "activation": _safe_id(row["activation"], f"{where}.activation"),
                    "grouped": grouped,
                    "members": sorted(
                        _unique_strings(row["members"], f"{where}.members")
                    ),
                }
            )
        machines = manifest["hosts"]["machineIds"]
        groups = manifest["hosts"]["groupRows"]
        roots = {entry["id"]: entry for entry in manifest["evaluationRoots"]}
        grouped_members = {member for group in groups for member in group["members"]}
        activation_for_kind = {
            "darwin-configuration": "darwin",
            "external-consumer": "nixos-module",
            "shared-home-manager": "home-standalone",
        }
        expected_rows = [
            {
                "id": machine["id"],
                "system": roots[machine["root"]]["system"],
                "activation": activation_for_kind[roots[machine["root"]]["kind"]],
                "grouped": False,
                "members": [machine["id"]],
            }
            for machine in machines
            if machine["id"] not in grouped_members
        ] + [
            {
                "id": group["id"],
                "system": roots[group["root"]]["system"],
                "activation": activation_for_kind[roots[group["root"]]["kind"]],
                "grouped": True,
                "members": sorted(group["members"]),
            }
            for group in groups
        ]
        if sorted(normalized_rows, key=lambda row: row["id"]) != sorted(
            expected_rows, key=lambda row: row["id"]
        ):
            raise CoverageError("Nix host-registry output differs from the manifest")
        return
    else:
        raise CoverageError(f"unsupported Nix probe output contract: {kind}")
    if actual != expected:
        raise CoverageError(
            f"Nix probe {probe['id']!r} output differs from its denominator"
        )


def collect_nix_file_reach(
    repo: Path,
    probes: Sequence[dict[str, Any]],
    nix_files: Sequence[str],
    manifest: Mapping[str, Any],
    runner: RunCommand = run_nix_probe_command,
) -> dict[str, Any]:
    tracked = set(nix_files)
    union: set[str] = set()
    records: list[dict[str, Any]] = []
    for probe in probes:
        proc = runner(probe["argv"], repo, clean_environment())
        if proc.returncode != 0:
            raise CoverageError(
                f"Nix file-reach probe {probe['id']!r} failed with exit {proc.returncode}"
            )
        validate_nix_probe_stdout(probe, proc.stdout, manifest)
        reached = parse_nix_evaluation_events(proc.stderr, repo, tracked)
        if not reached:
            raise CoverageError(
                f"Nix file-reach probe {probe['id']!r} succeeded without a local evaluation-start event"
            )
        missing_roots = sorted(set(probe["expectedRootFiles"]) - set(reached))
        if missing_roots:
            raise CoverageError(
                f"Nix file-reach probe {probe['id']!r} omitted expected roots: {missing_roots}"
            )
        union.update(reached)
        records.append(
            {
                "id": probe["id"],
                "state": "observed",
                "evidenceKind": "file-evaluation-start",
                "argv": list(probe["argv"]),
                "expectedRootFiles": list(probe["expectedRootFiles"]),
                "paths": reached,
            }
        )
    return {
        "state": "observed",
        "evidenceKind": "file-evaluation-start",
        "denominator": sorted(nix_files),
        "reached": sorted(union),
        "unreached": sorted(tracked - union),
        "probes": sorted(records, key=lambda record: record["id"]),
        "blindSpots": [
            "An evaluation-start event precedes parse and evaluation success.",
            "Lazy expressions and non-evaluation file reads are not observed.",
            "Directory events from scopedImport are not credited as default.nix.",
        ],
    }


def unknown_nix_file_reach(
    probes: Sequence[dict[str, Any]], nix_files: Sequence[str]
) -> dict[str, Any]:
    return {
        "state": "unknown",
        "evidenceKind": "file-evaluation-start",
        "denominator": sorted(nix_files),
        "reached": [],
        "unreached": [],
        "probes": [
            {
                "id": probe["id"],
                "state": "unknown",
                "evidenceKind": "file-evaluation-start",
                "argv": list(probe["argv"]),
                "expectedRootFiles": list(probe["expectedRootFiles"]),
                "paths": [],
            }
            for probe in probes
        ],
        "blindSpots": [
            "Structural collection does not execute Nix file-reach probes.",
            "Unknown is not a passing measurement.",
        ],
    }


def _tool_version(
    repo: Path,
    runner: RunCommand,
    argv: Sequence[str],
    version_pattern: re.Pattern[str],
) -> dict[str, str]:
    if shutil.which(argv[0]) is None:
        return {"state": "unknown", "reason": f"{argv[0]} is not available"}
    proc = runner(argv, repo, clean_environment())
    output = (proc.stdout or proc.stderr).strip()
    if (
        proc.returncode != 0
        or not output
        or "\n" in output
        or not version_pattern.fullmatch(output)
    ):
        return {
            "state": "unknown",
            "reason": f"{argv[0]} version was not safely identifiable",
        }
    return {"state": "observed", "version": output}


def tool_identities(repo: Path, runner: RunCommand = run_command) -> dict[str, Any]:
    coverage_identity = {
        "state": "unknown",
        "reason": "pythonDynamic is not collected by fleet-coverage/1; no coverage.py executable was invoked",
    }
    return {
        "collector": {"state": "observed", "version": REPORT_SCHEMA},
        "python": {
            "state": "observed",
            "implementation": sys.implementation.name,
            "version": ".".join(str(part) for part in sys.version_info[:3]),
        },
        "git": _tool_version(
            repo,
            runner,
            ["git", "--version"],
            re.compile(r"git version [0-9A-Za-z.+_-]+"),
        ),
        "nix": _tool_version(
            repo, runner, ["nix", "--version"], re.compile(r"[A-Za-z0-9 ()/._+-]+")
        ),
        "coveragePy": coverage_identity,
        "flakeSchemas": {
            "state": "unknown",
            "reason": "schema implementation is supplied by the Nix distribution, not a pinned flake input",
        },
    }


def source_revision(repo: Path, runner: RunCommand = run_command) -> str:
    proc = _checked_command(
        runner,
        ["git", "rev-parse", "HEAD"],
        repo,
        description="source revision discovery",
    )
    revision = proc.stdout.strip()
    if not HEX_REVISION_RE.fullmatch(revision):
        raise CoverageError(
            f"git rev-parse HEAD returned an invalid revision: {revision!r}"
        )
    return revision


def source_tree(repo: Path, runner: RunCommand = run_command) -> str:
    proc = _checked_command(
        runner,
        ["git", "write-tree"],
        repo,
        description="source index tree discovery",
    )
    tree = proc.stdout.strip()
    if re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", tree) is None:
        raise CoverageError("git write-tree returned an invalid object ID")
    return tree


def run_timed_command(
    argv: Sequence[str], repo: Path, env: Mapping[str, str], timeout_seconds: int
) -> tuple[subprocess.CompletedProcess[str], float]:
    started = time.monotonic()
    proc = subprocess.run(
        list(argv),
        cwd=repo,
        env=dict(env),
        capture_output=True,
        text=True,
        check=False,
        timeout=timeout_seconds,
    )
    return proc, time.monotonic() - started


def collect_pre_commit_timing(
    repo: Path,
    budget_seconds: int,
    timed_runner: Callable[
        [Sequence[str], Path, Mapping[str, str], int],
        tuple[subprocess.CompletedProcess[str], float],
    ] = run_timed_command,
) -> dict[str, Any]:
    ensure_projected_worktree_matches_index(repo)
    try:
        proc, elapsed = timed_runner(
            PRE_COMMIT_CORE_ARGV, repo, clean_environment(), budget_seconds
        )
    except subprocess.TimeoutExpired as error:
        raise CoverageError(
            f"pre-commit core exceeded its {budget_seconds}s deadline"
        ) from error
    if proc.returncode != 0:
        raise CoverageError(
            f"pre-commit core failed with exit {proc.returncode}; output redacted"
        )
    if not math.isfinite(elapsed) or elapsed <= 0:
        raise CoverageError("pre-commit timing clock returned an invalid duration")
    if elapsed > budget_seconds:
        raise CoverageError(
            f"pre-commit core took {elapsed:.3f}s, exceeding {budget_seconds}s"
        )
    host = socket.gethostname().split(".", 1)[0].lower()
    if SAFE_ID_RE.fullmatch(host) is None:
        raise CoverageError("timing host name is not safe to persist")
    platform_id = f"{platform.system().lower()}-{platform.machine().lower()}"
    if SAFE_ID_RE.fullmatch(platform_id) is None:
        raise CoverageError("timing platform identity is not safe to persist")
    return {
        "state": "observed",
        "evidenceKind": "measured-wall-clock",
        "records": [
            {
                "tier": "pre-commit-core",
                "seconds": round(elapsed, 3),
                "budgetSeconds": budget_seconds,
                "host": host,
                "platform": platform_id,
                "argv": list(PRE_COMMIT_CORE_ARGV),
            }
        ],
    }


def derive_report(
    repo: Path,
    *,
    collect_nix_reach: bool = False,
    pre_commit_timing: dict[str, Any] | None = None,
    runner: RunCommand = run_command,
    probe_runner: RunCommand = run_nix_probe_command,
) -> dict[str, Any]:
    repo = repo.resolve()
    ensure_projected_worktree_matches_index(repo, runner)
    initial_tree = source_tree(repo, runner)
    manifest = validate_manifest(load_index_json(repo, MANIFEST_RELATIVE, runner))
    files = discover_files(repo, runner)

    manifest_python = {entry["path"] for entry in manifest["pythonInventory"]}
    manifest_shell = {entry["path"] for entry in manifest["shellOwnership"]}
    if manifest_python != set(files["python"]):
        raise CoverageError(
            "manifest Python ownership is incomplete; "
            f"missing={sorted(set(files['python']) - manifest_python)}, "
            f"extra={sorted(manifest_python - set(files['python']))}"
        )
    if manifest_shell != set(files["shell"]):
        raise CoverageError(
            "manifest shell ownership is incomplete; "
            f"missing={sorted(set(files['shell']) - manifest_shell)}, "
            f"extra={sorted(manifest_shell - set(files['shell']))}"
        )
    nix_set = set(files["nix"])
    for probe in manifest["nixFileReach"]["probes"]:
        missing = sorted(set(probe["expectedRootFiles"]) - nix_set)
        if missing:
            raise CoverageError(
                f"probe {probe['id']!r} names non-inventory Nix roots: {missing}"
            )

    quality_suites = discover_quality_suites(repo, runner)
    manifest_suites = sorted(manifest["gateDenominator"]["qualitySuites"])
    if quality_suites != manifest_suites:
        raise CoverageError(
            "manifest quality suites differ from bin/quality --list; "
            f"live={quality_suites}, manifest={manifest_suites}"
        )
    static_tests = discover_python_static(repo, files["python"], runner)
    checks = [
        {
            "system": entry["system"],
            "id": entry["id"],
            "qualifiedId": f"checks.{entry['system']}.{entry['id']}",
        }
        for entry in manifest["gateDenominator"]["topLevelChecks"]
    ]
    structural = {
        "files": files,
        "pythonStatic": static_tests,
        "ownership": {
            "python": manifest["pythonInventory"],
            "shell": manifest["shellOwnership"],
        },
        "hosts": {
            "machineIds": manifest["hosts"]["machineIds"],
            "groupRows": manifest["hosts"]["groupRows"],
            "syntheticFixtures": manifest["hosts"]["syntheticFixtures"],
            "evaluationRoots": manifest["evaluationRoots"],
        },
        "gates": {
            "policy": manifest["gateDenominator"]["policy"],
            "quality": [f"quality:{suite}" for suite in quality_suites],
            "flake": checks,
        },
        "outputApplicability": manifest["outputApplicability"],
        "budgetsSeconds": manifest["budgetsSeconds"],
    }
    nix_measurement = (
        collect_nix_file_reach(
            repo,
            manifest["nixFileReach"]["probes"],
            files["nix"],
            manifest,
            probe_runner,
        )
        if collect_nix_reach
        else unknown_nix_file_reach(manifest["nixFileReach"]["probes"], files["nix"])
    )
    if pre_commit_timing is None:
        timing_measurement = {
            "state": "unknown",
            "reason": "not measured by structural collection",
        }
    else:
        timing_measurement = pre_commit_timing
    unknown = {"state": "unknown", "reason": "not measured by structural collection"}
    provenance_commands = [
        ["git", "ls-files", "--stage", "-z"],
        ["bin/quality", "--list"],
        ["git", "rev-parse", "HEAD"],
        ["git", "--version"],
        ["nix", "--version"],
    ]
    if collect_nix_reach:
        provenance_commands.extend(
            probe["argv"] for probe in manifest["nixFileReach"]["probes"]
        )
    if pre_commit_timing is not None:
        provenance_commands.append(list(PRE_COMMIT_CORE_ARGV))
    report: dict[str, Any] = {
        "schema": REPORT_SCHEMA,
        "sourceBaseRev": source_revision(repo, runner),
        "sourceTree": initial_tree,
        "sourceProjectionDigest": source_projection_digest(repo, runner),
        "manifestDigest": hashlib.sha256(canonical_bytes(manifest)).hexdigest(),
        "tools": tool_identities(repo, runner),
        "structural": structural,
        "measurements": {
            "nixFileReach": nix_measurement,
            "outputReach": dict(unknown),
            "hostReach": dict(unknown),
            "optionValueReach": dict(unknown),
            "pythonDynamic": dict(unknown),
            "shellBehavior": dict(unknown),
            "negativeGate": dict(unknown),
            "testCaseReach": dict(unknown),
            "assertionCallReach": dict(unknown),
            "darwinValueSurface": dict(unknown),
            "timing": timing_measurement,
        },
        "blindSpots": manifest["blindSpots"],
        "provenance": {
            "kind": "declared-command-recipe",
            "commands": provenance_commands,
        },
    }
    ensure_projected_worktree_matches_index(repo, runner)
    if source_tree(repo, runner) != initial_tree:
        raise CoverageError("source index changed during coverage collection")
    validate_report(
        report,
        manifest=manifest,
        expected_structural=structural,
        expected_projection_digest=report["sourceProjectionDigest"],
    )
    return report


def _validate_state_object(value: Any, where: str) -> dict[str, Any]:
    state_object = _expect_object(value, where)
    state = _expect_string(state_object.get("state"), f"{where}.state")
    if state not in STATES:
        raise CoverageError(f"{where}.state must be one of {sorted(STATES)}")
    if state == "unknown" and "result" in state_object:
        raise CoverageError(f"{where}: unknown measurements cannot contain a result")
    return state_object


def _validate_tool_identity(value: Any, where: str) -> dict[str, Any]:
    identity = _expect_object(value, where)
    state = _expect_string(identity.get("state"), f"{where}.state")
    if state == "observed":
        _expect_exact_keys(identity, {"state", "version"}, where)
        version = _expect_string(identity["version"], f"{where}.version")
        if len(version) > 200 or any(ord(character) < 32 for character in version):
            raise CoverageError(f"{where}.version is not a safe tool identity")
    elif state == "unknown":
        _expect_exact_keys(identity, {"state", "reason"}, where)
        _expect_string(identity["reason"], f"{where}.reason")
    else:
        raise CoverageError(f"{where}.state must be observed or unknown")
    return identity


def validate_report(
    value: Any,
    *,
    manifest: dict[str, Any],
    expected_structural: dict[str, Any] | None = None,
    expected_projection_digest: str | None = None,
) -> dict[str, Any]:
    report = _expect_object(value, "artifact")
    _expect_exact_keys(report, REPORT_KEYS, "artifact")
    if report["schema"] != REPORT_SCHEMA:
        raise CoverageError(f"unsupported artifact schema: {report['schema']!r}")
    revision = _expect_string(report["sourceBaseRev"], "artifact.sourceBaseRev")
    if not HEX_REVISION_RE.fullmatch(revision):
        raise CoverageError("artifact.sourceBaseRev must be a lowercase 40-hex commit")
    tree = _expect_string(report["sourceTree"], "artifact.sourceTree")
    if re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", tree) is None:
        raise CoverageError("artifact.sourceTree must be a Git tree object ID")
    projection_digest = _expect_string(
        report["sourceProjectionDigest"], "artifact.sourceProjectionDigest"
    )
    if re.fullmatch(r"[0-9a-f]{64}", projection_digest) is None:
        raise CoverageError("artifact.sourceProjectionDigest must be lowercase SHA-256")
    if (
        expected_projection_digest is not None
        and projection_digest != expected_projection_digest
    ):
        raise CoverageError("artifact source projection differs from live source bytes")
    digest = _expect_string(report["manifestDigest"], "artifact.manifestDigest")
    expected_digest = hashlib.sha256(canonical_bytes(manifest)).hexdigest()
    if digest != expected_digest:
        raise CoverageError(
            "artifact manifest digest does not match the committed manifest"
        )
    tools = _expect_object(report["tools"], "artifact.tools")
    _expect_exact_keys(
        tools,
        {"collector", "python", "git", "nix", "coveragePy", "flakeSchemas"},
        "artifact.tools",
    )
    collector = _validate_tool_identity(tools["collector"], "artifact.tools.collector")
    if (
        collector.get("state") != "observed"
        or collector.get("version") != REPORT_SCHEMA
    ):
        raise CoverageError("artifact collector identity differs from its schema")
    python_identity = _expect_object(tools["python"], "artifact.tools.python")
    _expect_exact_keys(
        python_identity,
        {"state", "implementation", "version"},
        "artifact.tools.python",
    )
    if python_identity["state"] != "observed":
        raise CoverageError("artifact Python identity must be observed")
    _safe_id(python_identity["implementation"], "artifact.tools.python.implementation")
    python_version = _expect_string(
        python_identity["version"], "artifact.tools.python.version"
    )
    if re.fullmatch(r"[0-9]+[.][0-9]+[.][0-9]+", python_version) is None:
        raise CoverageError(
            "artifact Python version must be a semantic version triplet"
        )
    _validate_tool_identity(tools["git"], "artifact.tools.git")
    _validate_tool_identity(tools["nix"], "artifact.tools.nix")
    _validate_tool_identity(tools["coveragePy"], "artifact.tools.coveragePy")
    flake_schemas = _validate_tool_identity(
        tools["flakeSchemas"], "artifact.tools.flakeSchemas"
    )
    if flake_schemas["state"] != "unknown":
        raise CoverageError(
            "schema 1 has no independently pinned flake-schema identity"
        )
    structural = _expect_object(report["structural"], "artifact.structural")
    if expected_structural is not None and structural != expected_structural:
        raise CoverageError(
            "artifact structural inventories regress from live derivation"
        )

    measurements = _expect_object(report["measurements"], "artifact.measurements")
    expected_measurement_keys = {
        "nixFileReach",
        "outputReach",
        "hostReach",
        "optionValueReach",
        "pythonDynamic",
        "shellBehavior",
        "negativeGate",
        "testCaseReach",
        "assertionCallReach",
        "darwinValueSurface",
        "timing",
    }
    _expect_exact_keys(measurements, expected_measurement_keys, "artifact.measurements")
    for key in expected_measurement_keys:
        _validate_state_object(measurements[key], f"artifact.measurements.{key}")
    for key in expected_measurement_keys - {"nixFileReach", "timing"}:
        measurement = measurements[key]
        if set(measurement) != {"state", "reason"} or measurement["state"] != "unknown":
            raise CoverageError(
                f"artifact.measurements.{key} is unsupported in schema 1 and must remain explicit unknown"
            )

    timing = measurements["timing"]
    if timing["state"] == "unknown":
        if set(timing) != {"state", "reason"}:
            raise CoverageError("unknown timing must contain only state and reason")
    elif timing["state"] == "observed":
        _expect_exact_keys(
            timing,
            {"state", "evidenceKind", "records"},
            "artifact.measurements.timing",
        )
        if timing["evidenceKind"] != "measured-wall-clock":
            raise CoverageError("timing evidence must be labeled measured-wall-clock")
        records = _expect_list(
            timing["records"], "artifact.measurements.timing.records"
        )
        if len(records) != 1:
            raise CoverageError(
                "schema 1 requires exactly one pre-commit timing record"
            )
        record = _expect_object(records[0], "artifact.measurements.timing.records[0]")
        _expect_exact_keys(
            record,
            {"tier", "seconds", "budgetSeconds", "host", "platform", "argv"},
            "artifact.measurements.timing.records[0]",
        )
        if record["tier"] != "pre-commit-core":
            raise CoverageError("schema 1 timing record must measure pre-commit-core")
        seconds = record["seconds"]
        if (
            isinstance(seconds, bool)
            or not isinstance(seconds, (int, float))
            or not math.isfinite(seconds)
            or seconds <= 0
        ):
            raise CoverageError("timing seconds must be a positive finite number")
        budget = manifest["budgetsSeconds"]["pre-commit"]
        if record["budgetSeconds"] != budget or seconds > budget:
            raise CoverageError(
                "pre-commit timing does not satisfy the manifest budget"
            )
        _safe_id(record["host"], "artifact.measurements.timing.records[0].host")
        _safe_id(record["platform"], "artifact.measurements.timing.records[0].platform")
        command = _validate_argv(
            record["argv"], "artifact.measurements.timing.records[0].argv"
        )
        if command != PRE_COMMIT_CORE_ARGV:
            raise CoverageError(
                "pre-commit core timing command differs from the contract"
            )
    else:
        raise CoverageError("timing must be observed or explicit unknown in schema 1")

    nix_reach = measurements["nixFileReach"]
    if nix_reach["state"] not in {"unknown", "observed"}:
        raise CoverageError("Nix file reach must be observed or explicit unknown")
    _expect_exact_keys(
        nix_reach,
        {
            "state",
            "evidenceKind",
            "denominator",
            "reached",
            "unreached",
            "probes",
            "blindSpots",
        },
        "artifact.measurements.nixFileReach",
    )
    if nix_reach.get("evidenceKind") != "file-evaluation-start":
        raise CoverageError("Nix file reach must be labeled file-evaluation-start")
    nix_files = structural.get("files", {}).get("nix")
    if not isinstance(nix_files, list) or nix_reach.get("denominator") != nix_files:
        raise CoverageError(
            "Nix file-reach denominator differs from structural Nix files"
        )
    reached = _unique_strings(
        nix_reach.get("reached"),
        "artifact.measurements.nixFileReach.reached",
        nonempty=False,
    )
    unreached = _unique_strings(
        nix_reach.get("unreached"),
        "artifact.measurements.nixFileReach.unreached",
        nonempty=False,
    )
    if not set(reached).issubset(nix_files) or not set(unreached).issubset(nix_files):
        raise CoverageError("Nix file-reach paths must be members of the denominator")
    if nix_reach["state"] == "observed":
        if set(reached).intersection(unreached) or set(reached).union(unreached) != set(
            nix_files
        ):
            raise CoverageError(
                "observed Nix file reach must partition the denominator"
            )
    elif reached or unreached:
        raise CoverageError(
            "unmeasured Nix file reach cannot claim reached/unreached paths"
        )
    probe_records = _expect_list(
        nix_reach.get("probes"), "artifact.measurements.nixFileReach.probes"
    )
    manifest_probes = {
        probe["id"]: probe for probe in manifest["nixFileReach"]["probes"]
    }
    union_probe_paths: set[str] = set()
    if len(probe_records) != len(manifest_probes):
        raise CoverageError("artifact Nix probe records differ from the manifest")
    for index, raw in enumerate(probe_records):
        where = f"artifact.measurements.nixFileReach.probes[{index}]"
        record = _expect_object(raw, where)
        _expect_exact_keys(
            record,
            {
                "id",
                "state",
                "evidenceKind",
                "argv",
                "expectedRootFiles",
                "paths",
            },
            where,
        )
        identifier = _expect_string(record.get("id"), f"{where}.id")
        if identifier not in manifest_probes:
            raise CoverageError(f"{where}: unknown probe {identifier!r}")
        probe = manifest_probes.pop(identifier)
        if (
            record.get("argv") != probe["argv"]
            or record.get("expectedRootFiles") != probe["expectedRootFiles"]
        ):
            raise CoverageError(
                f"{where}: probe argv/root contract differs from the manifest"
            )
        if record.get("evidenceKind") != "file-evaluation-start":
            raise CoverageError(f"{where}: incorrect evidence label")
        _validate_state_object(record, where)
        if record["state"] not in {"unknown", "observed"}:
            raise CoverageError(f"{where}: state must be observed or explicit unknown")
        paths = _unique_strings(record.get("paths"), f"{where}.paths", nonempty=False)
        if not set(paths).issubset(nix_files):
            raise CoverageError(f"{where}: path outside Nix denominator")
        if record["state"] == "observed" and not paths:
            raise CoverageError(f"{where}: observed probe has no local event")
        if record["state"] != "observed" and paths:
            raise CoverageError(f"{where}: unobserved probe claims paths")
        if record["state"] != nix_reach["state"]:
            raise CoverageError(f"{where}: probe state differs from aggregate state")
        if record["state"] == "observed" and not set(
            probe["expectedRootFiles"]
        ).issubset(paths):
            raise CoverageError(f"{where}: observed probe omitted an expected root")
        union_probe_paths.update(paths)
    if manifest_probes:
        raise CoverageError(f"artifact omitted Nix probes: {sorted(manifest_probes)}")
    if set(reached) != union_probe_paths:
        raise CoverageError("Nix reached paths differ from the union of probe evidence")
    _unique_strings(
        nix_reach["blindSpots"],
        "artifact.measurements.nixFileReach.blindSpots",
    )

    blind_spots = _unique_strings(report["blindSpots"], "artifact.blindSpots")
    if sorted(blind_spots) != manifest["blindSpots"]:
        raise CoverageError("artifact blind spots differ from the committed manifest")
    provenance = _expect_object(report["provenance"], "artifact.provenance")
    _expect_exact_keys(provenance, {"kind", "commands"}, "artifact.provenance")
    if provenance["kind"] != "declared-command-recipe":
        raise CoverageError(
            "artifact provenance must be labeled declared-command-recipe"
        )
    commands = _expect_list(provenance["commands"], "artifact.provenance.commands")
    if not commands:
        raise CoverageError("artifact provenance commands must not be empty")
    for index, argv in enumerate(commands):
        _validate_argv(argv, f"artifact.provenance.commands[{index}]")
    expected_commands = [
        ["git", "ls-files", "--stage", "-z"],
        ["bin/quality", "--list"],
        ["git", "rev-parse", "HEAD"],
        ["git", "--version"],
        ["nix", "--version"],
    ]
    if nix_reach["state"] == "observed":
        expected_commands.extend(
            probe["argv"] for probe in manifest["nixFileReach"]["probes"]
        )
    if timing["state"] == "observed":
        expected_commands.append(timing["records"][0]["argv"])
    if commands != expected_commands:
        raise CoverageError("artifact provenance commands differ from the allowlist")
    sensitive_scan(report)
    return report


def artifact_candidates(repo: Path, runner: RunCommand = run_command) -> list[Path]:
    paths = _git_paths(repo, runner, "test/baseline/coverage-*.json")
    candidates: list[Path] = []
    for path in paths:
        pure = PurePosixPath(path)
        if pure.parent != ARTIFACT_DIRECTORY or not ARTIFACT_RE.fullmatch(pure.name):
            raise CoverageError(f"invalid tracked coverage artifact path: {path!r}")
        candidates.append(repo / path)
    return candidates


def _validate_artifact_path_ancestry(repo: Path, path: Path) -> None:
    expected_parent = repo / ARTIFACT_DIRECTORY
    if path.parent != expected_parent:
        raise CoverageError("coverage artifact escaped its fixed baseline directory")
    current = repo
    for part in ARTIFACT_DIRECTORY.parts:
        current /= part
        if current.is_symlink():
            raise CoverageError(f"coverage artifact directory is a symlink: {current}")
        if current.exists() and not current.is_dir():
            raise CoverageError(
                f"coverage artifact ancestor is not a directory: {current}"
            )


def _resolve_artifact(
    repo: Path,
    runner: RunCommand,
    explicit: str | None,
    *,
    for_write: bool,
    revision: str | None = None,
) -> Path:
    candidates = artifact_candidates(repo, runner)
    if len(candidates) > 1:
        raise CoverageError(
            f"expected at most one committed coverage artifact, found {len(candidates)}"
        )
    if explicit is not None:
        pure = PurePosixPath(explicit)
        if pure.parent != ARTIFACT_DIRECTORY or not ARTIFACT_RE.fullmatch(pure.name):
            raise CoverageError("--artifact must name test/baseline/coverage-*.json")
        selected = repo / pure
        if candidates and selected != candidates[0]:
            raise CoverageError(
                "--artifact does not name the sole committed coverage artifact"
            )
        if not candidates and not for_write:
            raise CoverageError("--artifact is not committed")
        if not candidates and for_write and selected.exists():
            raise CoverageError("refusing to overwrite an untracked coverage artifact")
        _validate_artifact_path_ancestry(repo, selected)
        return selected
    if candidates:
        _validate_artifact_path_ancestry(repo, candidates[0])
        return candidates[0]
    if not for_write:
        raise CoverageError(
            "no committed test/baseline/coverage-*.json artifact exists"
        )
    if revision is None:
        raise CoverageError(
            "internal error: source revision required for initial artifact name"
        )
    selected = repo / ARTIFACT_DIRECTORY / f"coverage-{revision[:12]}.json"
    if selected.exists():
        raise CoverageError("refusing to overwrite an untracked coverage artifact")
    _validate_artifact_path_ancestry(repo, selected)
    return selected


def check_artifact(
    repo: Path,
    *,
    explicit: str | None = None,
    runner: RunCommand = run_command,
) -> Path:
    ensure_projected_worktree_matches_index(repo, runner)
    manifest = validate_manifest(load_index_json(repo, MANIFEST_RELATIVE, runner))
    live = derive_report(repo, runner=runner)
    path = _resolve_artifact(repo, runner, explicit, for_write=False)
    artifact = _expect_object(
        load_index_json(repo, path.relative_to(repo).as_posix(), runner), "artifact"
    )
    revision = _expect_string(artifact.get("sourceBaseRev"), "artifact.sourceBaseRev")
    if not HEX_REVISION_RE.fullmatch(revision):
        raise CoverageError("artifact.sourceBaseRev must be a lowercase 40-hex commit")
    ancestor = runner(
        ["git", "merge-base", "--is-ancestor", revision, "HEAD"],
        repo,
        clean_environment(),
    )
    if ancestor.returncode != 0:
        raise CoverageError(
            "artifact sourceBaseRev is not a reachable ancestor of HEAD"
        )
    validate_report(
        artifact,
        manifest=manifest,
        expected_structural=live["structural"],
    )
    for tool in ("collector", "python", "nix"):
        if artifact["tools"].get(tool) != live["tools"].get(tool):
            raise CoverageError(f"coverage artifact tool identity drifted: {tool}")
    required = ("nixFileReach", "timing")
    missing = [
        name
        for name in required
        if artifact["measurements"][name]["state"] != "observed"
    ]
    if missing:
        raise CoverageError(
            f"coverage artifact is schema-valid but not gate-ready; unobserved={missing}"
        )
    previous = load_head_artifact(repo, revision, runner)
    if previous is not None:
        validate_non_regression(artifact, previous)
    return path


def load_head_artifact(
    repo: Path, revision: str, runner: RunCommand = run_command
) -> dict[str, Any] | None:
    proc = _checked_command(
        runner,
        ["git", "ls-tree", "-r", "--name-only", revision, "--", "test/baseline"],
        repo,
        description="parent coverage artifact discovery",
    )
    candidates = []
    for path in proc.stdout.splitlines():
        pure = PurePosixPath(path)
        if pure.parent == ARTIFACT_DIRECTORY and ARTIFACT_RE.fullmatch(pure.name):
            candidates.append(pure.as_posix())
    if len(candidates) > 1:
        raise CoverageError("HEAD contains multiple coverage artifacts")
    if not candidates:
        return None
    shown = _checked_command(
        runner,
        ["git", "show", f"{revision}:{candidates[0]}"],
        repo,
        description="parent coverage artifact read",
    )
    return _expect_object(
        parse_json(shown.stdout, source=f"{revision}:{candidates[0]}"),
        "parent artifact",
    )


def validate_non_regression(
    current: Mapping[str, Any], previous: Mapping[str, Any]
) -> None:
    if previous.get("schema") != REPORT_SCHEMA:
        raise CoverageError("parent coverage artifact uses a different schema")
    current_reach = _expect_object(
        _expect_object(current.get("measurements"), "artifact.measurements").get(
            "nixFileReach"
        ),
        "artifact.measurements.nixFileReach",
    )
    previous_reach = _expect_object(
        _expect_object(previous.get("measurements"), "parent.measurements").get(
            "nixFileReach"
        ),
        "parent.measurements.nixFileReach",
    )
    if previous_reach.get("state") != "observed":
        raise CoverageError("parent Nix file reach is not an observed baseline")
    current_denominator = set(
        _unique_strings(current_reach.get("denominator"), "current denominator")
    )
    previous_denominator = set(
        _unique_strings(previous_reach.get("denominator"), "parent denominator")
    )
    current_reached = set(
        _unique_strings(current_reach.get("reached"), "current reached", nonempty=False)
    )
    previous_reached = set(
        _unique_strings(previous_reach.get("reached"), "parent reached", nonempty=False)
    )
    lost = sorted((previous_reached & current_denominator) - current_reached)
    if lost:
        raise CoverageError(f"Nix file reach regressed for paths: {lost}")
    if len(current_reached) * len(previous_denominator) < len(previous_reached) * len(
        current_denominator
    ):
        raise CoverageError(
            "Nix file-reach ratio regressed: "
            f"{len(current_reached)}/{len(current_denominator)} < "
            f"{len(previous_reached)}/{len(previous_denominator)}"
        )
    current_structural = _expect_object(
        current.get("structural"), "artifact.structural"
    )
    previous_structural = _expect_object(
        previous.get("structural"), "parent.structural"
    )
    current_gates = _expect_object(current_structural.get("gates"), "artifact.gates")
    previous_gates = _expect_object(previous_structural.get("gates"), "parent.gates")
    current_flake = {
        _expect_string(entry.get("qualifiedId"), "artifact flake gate")
        for entry in _expect_list(current_gates.get("flake"), "artifact.gates.flake")
        if isinstance(entry, dict)
    }
    previous_flake = {
        _expect_string(entry.get("qualifiedId"), "parent flake gate")
        for entry in _expect_list(previous_gates.get("flake"), "parent.gates.flake")
        if isinstance(entry, dict)
    }
    lost_gates = sorted(previous_flake - current_flake)
    if lost_gates:
        raise CoverageError(f"flake gate denominator regressed: {lost_gates}")
    current_quality = set(
        _unique_strings(current_gates.get("quality"), "artifact.gates.quality")
    )
    previous_quality = set(
        _unique_strings(previous_gates.get("quality"), "parent.gates.quality")
    )
    lost_quality = sorted(previous_quality - current_quality)
    if lost_quality:
        raise CoverageError(f"quality authority denominator regressed: {lost_quality}")
    current_hosts = _expect_object(current_structural.get("hosts"), "artifact.hosts")
    previous_hosts = _expect_object(previous_structural.get("hosts"), "parent.hosts")
    for key in ("machineIds", "groupRows", "syntheticFixtures", "evaluationRoots"):
        current_ids = {
            _expect_string(entry.get("id"), f"artifact.hosts.{key} id")
            for entry in _expect_list(current_hosts.get(key), f"artifact.hosts.{key}")
            if isinstance(entry, dict)
        }
        previous_ids = {
            _expect_string(entry.get("id"), f"parent.hosts.{key} id")
            for entry in _expect_list(previous_hosts.get(key), f"parent.hosts.{key}")
            if isinstance(entry, dict)
        }
        lost_ids = sorted(previous_ids - current_ids)
        if lost_ids:
            raise CoverageError(f"host denominator {key} regressed: {lost_ids}")


def artifact_summary(repo: Path, path: Path, runner: RunCommand = run_command) -> str:
    report = _expect_object(
        load_index_json(repo, path.relative_to(repo).as_posix(), runner), "artifact"
    )
    return format_report_summary(report)


def format_report_summary(report: Mapping[str, Any]) -> str:
    structural = _expect_object(report.get("structural"), "artifact.structural")
    files = _expect_object(structural.get("files"), "artifact.structural.files")
    gates = _expect_object(structural.get("gates"), "artifact.structural.gates")
    measurements = _expect_object(report.get("measurements"), "artifact.measurements")
    reach = _expect_object(measurements.get("nixFileReach"), "nixFileReach")
    timing = _expect_object(measurements.get("timing"), "timing")
    reached = _expect_list(reach.get("reached"), "nixFileReach.reached")
    denominator = _expect_list(reach.get("denominator"), "nixFileReach.denominator")
    if timing.get("state") == "observed":
        records = _expect_list(timing.get("records"), "timing.records")
        timing_record = _expect_object(records[0], "timing.records[0]")
        timing_text = f"{timing_record['seconds']}/{timing_record['budgetSeconds']}s"
    else:
        timing_text = "unknown"
    unknown = sorted(
        name
        for name, value in measurements.items()
        if isinstance(value, dict) and value.get("state") == "unknown"
    )
    return (
        "coverage-report: "
        f"nix-file-evaluation-start={len(reached)}/{len(denominator)} "
        f"python-inventory={len(_expect_list(files.get('python'), 'files.python'))} "
        f"shell-inventory={len(_expect_list(files.get('shell'), 'files.shell'))} "
        f"gates={len(_expect_list(gates.get('quality'), 'gates.quality')) + len(_expect_list(gates.get('flake'), 'gates.flake'))} "
        f"pre-commit-core={timing_text} "
        f"unknown={','.join(unknown) if unknown else 'none'}"
    )


def compare_live_coverage(
    repo: Path,
    *,
    explicit: str | None = None,
    runner: RunCommand = run_command,
    probe_runner: RunCommand = run_nix_probe_command,
) -> dict[str, Any]:
    path = check_artifact(repo, explicit=explicit, runner=runner)
    baseline = _expect_object(
        load_index_json(repo, path.relative_to(repo).as_posix(), runner), "artifact"
    )
    current = derive_report(
        repo,
        collect_nix_reach=True,
        runner=runner,
        probe_runner=probe_runner,
    )
    validate_non_regression(current, baseline)
    return current


def atomic_write_json(
    path: Path,
    value: Any,
    *,
    replace: Callable[[str, str], None] = os.replace,
    fsync: Callable[[int], None] = os.fsync,
    open_directory: Callable[[Path, int], int] = os.open,
) -> None:
    """Atomically install one validated JSON artifact in its target directory."""

    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        raise CoverageError(f"refusing to replace symlink artifact {path}")
    payload = json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    temporary: str | None = None
    installed = False
    try:
        descriptor, temporary = tempfile.mkstemp(
            prefix=f".{path.name}.", dir=path.parent
        )
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            stream.write(payload)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            fsync(stream.fileno())
        # Reparse the exact on-disk bytes before exposing them.
        parse_json(Path(temporary).read_text(encoding="utf-8"), source=temporary)
        replace(temporary, str(path))
        installed = True
        temporary = None
        directory_fd = open_directory(
            path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
        )
        try:
            fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError as error:
        if installed:
            raise CoverageError(
                f"artifact installed but directory durability sync failed: {error}"
            ) from error
        raise CoverageError(f"atomic artifact write failed: {error}") from error
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except FileNotFoundError:
                pass


def write_artifact(
    repo: Path,
    *,
    explicit: str | None = None,
    collect_nix_reach: bool = False,
    measure_pre_commit: bool = False,
    runner: RunCommand = run_command,
    probe_runner: RunCommand = run_nix_probe_command,
    timed_runner: Callable[
        [Sequence[str], Path, Mapping[str, str], int],
        tuple[subprocess.CompletedProcess[str], float],
    ] = run_timed_command,
) -> Path:
    ensure_projected_worktree_matches_index(repo, runner)
    initial_tree = source_tree(repo, runner)
    manifest = validate_manifest(load_index_json(repo, MANIFEST_RELATIVE, runner))
    timing = (
        collect_pre_commit_timing(
            repo, manifest["budgetsSeconds"]["pre-commit"], timed_runner
        )
        if measure_pre_commit
        else None
    )
    report = derive_report(
        repo,
        collect_nix_reach=collect_nix_reach,
        pre_commit_timing=timing,
        runner=runner,
        probe_runner=probe_runner,
    )
    if report["sourceTree"] != initial_tree:
        raise CoverageError("source index changed during timing or coverage collection")
    path = _resolve_artifact(
        repo, runner, explicit, for_write=True, revision=report["sourceBaseRev"]
    )
    if path.exists():
        if not path.is_file() or path.is_symlink():
            raise CoverageError(f"coverage artifact is not a regular file: {path}")
        # Narrow precondition: do not clobber arbitrary JSON or another schema.
        old = _expect_object(load_json(path), "existing artifact")
        _expect_exact_keys(old, REPORT_KEYS, "existing artifact")
        if old.get("schema") != REPORT_SCHEMA:
            raise CoverageError("existing artifact does not use fleet-coverage/1")
        if not HEX_REVISION_RE.fullmatch(
            _expect_string(old.get("sourceBaseRev"), "existing artifact.sourceBaseRev")
        ):
            raise CoverageError("existing artifact has an invalid source revision")
        if (
            re.fullmatch(
                r"[0-9a-f]{64}",
                _expect_string(
                    old.get("manifestDigest"), "existing artifact.manifestDigest"
                ),
            )
            is None
        ):
            raise CoverageError("existing artifact has an invalid manifest digest")
        for key in ("tools", "structural", "measurements", "provenance"):
            _expect_object(old[key], f"existing artifact.{key}")
        _expect_list(old["blindSpots"], "existing artifact.blindSpots")
        sensitive_scan(old, "existing artifact")
    validate_report(
        report,
        manifest=manifest,
        expected_structural=report["structural"],
        expected_projection_digest=report["sourceProjectionDigest"],
    )
    atomic_write_json(path, report)
    return path


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--print",
        dest="print_report",
        action="store_true",
        help="derive and print safe JSON (default)",
    )
    mode.add_argument(
        "--check", action="store_true", help="validate the sole committed artifact"
    )
    mode.add_argument(
        "--write", action="store_true", help="atomically replace the sole artifact"
    )
    mode.add_argument(
        "--compare-live",
        action="store_true",
        help="collect current Nix reach and compare it with the committed artifact",
    )
    parser.add_argument(
        "--artifact", metavar="PATH", help="explicit test/baseline/coverage-*.json path"
    )
    parser.add_argument(
        "--collect-nix-reach",
        action="store_true",
        help="execute manifest Nix probes and collect evaluation-start paths",
    )
    parser.add_argument(
        "--measure-pre-commit",
        action="store_true",
        help="execute and record the bounded pre-commit core tier",
    )
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    repo = Path(__file__).resolve().parent.parent
    try:
        if args.check:
            if args.collect_nix_reach:
                raise CoverageError("--check never executes expensive Nix probes")
            if args.measure_pre_commit:
                raise CoverageError("--check never records timing evidence")
            path = check_artifact(repo, explicit=args.artifact)
            print(
                f"coverage-report: {path.relative_to(repo)} matches live structural inventories"
            )
            print(artifact_summary(repo, path))
            return 0
        if args.compare_live:
            if args.collect_nix_reach or args.measure_pre_commit:
                raise CoverageError(
                    "--compare-live owns collection and cannot combine collection flags"
                )
            current = compare_live_coverage(repo, explicit=args.artifact)
            print(format_report_summary(current))
            return 0
        if args.write:
            if not args.collect_nix_reach or not args.measure_pre_commit:
                raise CoverageError(
                    "--write requires --collect-nix-reach and --measure-pre-commit"
                )
            path = write_artifact(
                repo,
                explicit=args.artifact,
                collect_nix_reach=args.collect_nix_reach,
                measure_pre_commit=args.measure_pre_commit,
            )
            print(f"coverage-report: wrote {path.relative_to(repo)}")
            return 0
        if args.artifact:
            raise CoverageError(
                "--artifact is valid only with --check, --compare-live, or --write"
            )
        manifest = validate_manifest(load_index_json(repo, MANIFEST_RELATIVE))
        timing = (
            collect_pre_commit_timing(repo, manifest["budgetsSeconds"]["pre-commit"])
            if args.measure_pre_commit
            else None
        )
        report = derive_report(
            repo,
            collect_nix_reach=args.collect_nix_reach,
            pre_commit_timing=timing,
        )
        print(json.dumps(report, indent=2, sort_keys=True, ensure_ascii=False))
        return 0
    except CoverageError as error:
        print(f"coverage-report: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
