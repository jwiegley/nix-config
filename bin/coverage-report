#!/usr/bin/env python3
"""Build and validate the fleet's credential-safe structural coverage artifact.

The default operation is intentionally cheap: it derives denominators from Git,
Python syntax, ``bin/quality --list``, and the committed applicability manifest.
Nix evaluation-start evidence is collected only with ``--collect-nix-reach``.

The persisted format is ``fleet-coverage/1``.  Runtime output is never copied into
the artifact: Nix probes retain their allowlisted argv and normalized repository
paths only.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import math
import os
import platform
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable, Mapping, Sequence
from pathlib import Path, PurePosixPath
from typing import Any


REPORT_SCHEMA = "fleet-coverage/1"
MANIFEST_SCHEMA = "fleet-coverage-manifest/1"
MANIFEST_RELATIVE = PurePosixPath("test/coverage/manifest.json")
ARTIFACT_DIRECTORY = PurePosixPath("test/baseline")
ARTIFACT_RE = re.compile(r"coverage-[A-Za-z0-9._-]+[.]json\Z")
HEX_REVISION_RE = re.compile(r"[0-9a-f]{40}\Z")
SAFE_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._@+/-]*\Z")
EVALUATING_FILE_RE = re.compile(r"evaluating file '([^'\n]+)'\Z")
TIERS = frozenset({"pre-commit", "pre-push", "ci-on-demand"})
STATES = frozenset({"unknown", "observed", "failed", "skipped", "not-run"})
PRE_COMMIT_CORE_ARGV = ["bin/quality", "--tier", "pre-commit-core"]
NIX_PROBE_TIMEOUT_SECONDS = 240

PYTHON_KINDS = frozenset({"product", "test"})
SHELL_KINDS = frozenset({"library", "production", "test-driver"})
PROBE_CONTRACTS = {
