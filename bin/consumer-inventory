#!/usr/bin/env bash
# Derive the merged consumer inventory: one classified record per reference from
# every consumer of nix-config into nix-config, across the internal tree and the
# external consumer checkouts.
#
# Why this exists: the planned config/ai -> config/fleet rename (jwiegley/nix-config#47)
# is only complete if EVERY reference to the config/ai contract is known first,
# yet no artifact owned the inventory (issue #17, critique H4). Four separate
# inventory passes (narrow ?dir URLs, rename-verification, all compat surfaces,
# flake-ai.nix compat) are the same read-only sweep under different lenses. This
# script IS that sweep. #47 (the rename) and #63 (post-rename stragglers) consume
# its JSON mechanically, so the schema is stable and every record carries
# consumer, kind, classification, file, line, and the exact source text.
#
# The output is stored evidence, not a Nix-generated leaf, so it is committed as
# a tracked data file (bin/consumer-inventory --write).
#
# CLASSIFICATION SCHEME (issue #17). Every reference is exactly one of:
#
#   rename-now       A stale operational reference to the literal "config/ai"
#                    path inside nix-config's own tree. #47 rewrites these.
#
#   stub-covered     An external consumer edge that still resolves through the
#                    retired ?dir=config/ai URL. #47's throwing stub makes this
#                    fail loudly; the consumer URL must move in the coordinated
#                    publication transaction. Owner + trigger are recorded.
#
#   retire           A consumer reach-in into nix-config INTERNAL overlay files
#                    (${inputs.nix-config}/overlays/*.nix) and the attributes
#                    cherry-picked from them. Not a supported API; this class is
#                    what broke vulcan when a3cc3843 changed overlay signatures.
#                    Delete once the consumer moves to typed config/fleet outputs.
#
#   retain-with-owner  Keep as-is; owner + retirement trigger recorded. Covers the
#                    four flake-ai.nix internal imports (GAP-FLAKEAI-INTERNAL, out
#                    of scope for #47), the supported config/*.nix portable surface,
#                    the root flake=false nix-config inputs, and the
#                    ai-nix/node-red/global-Anvil compat surfaces routed to EPIC 7.
#
# Determinism contract: for a fixed tracked working tree and fixed consumer locks,
# every record below is a pure function of on-disk tracked files. The internal
# reference set is DERIVED by git-ls-files-scoped grep (never asserted); the count
# falls out of the derived list. Remote checks (gh) are
# recorded as commands plus a documented finding rather than run inside derive(),
# so the artifact reproduces offline.
#
# Usage:
#   bin/consumer-inventory                 # derive, print JSON to stdout
#   bin/consumer-inventory --print         # same
#   bin/consumer-inventory --write [FILE]  # derive, write FILE
#                                          #   (default test/inventory/consumer-inventory.json)
#
# Environment overrides (all optional; defaults mirror bin/parity-baseline's
# BASH_SOURCE-relative root detection and the ~/src sibling-checkout layout):
#   CONSUMER_INVENTORY_REPO_ROOT      nix-config repo root
#   CONSUMER_INVENTORY_CONSUMER_BASE  directory holding the sibling consumer checkouts
#   CONSUMER_INVENTORY_REPO_HEAD      repo HEAD sha to record (default: resolve from
#                                     REPO_ROOT/.git via pure file reads, no git binary;
#                                     empty string records null)
#
# Refs: jwiegley/nix-config#17 (this inventory); #47 (E3-RENAME) and #63 consume it.

set -euo pipefail

repo_root=${CONSUMER_INVENTORY_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
consumer_base=${CONSUMER_INVENTORY_CONSUMER_BASE:-$(cd "$repo_root/.." && pwd)}
repo_head=${CONSUMER_INVENTORY_REPO_HEAD-__auto__}

die() {
    printf 'consumer-inventory: %s\n' "$*" >&2
    exit 1
}

verify_write_source() {
    local actual_head
    actual_head=$(git -C "$repo_root" rev-parse --verify HEAD 2>/dev/null) ||
        die "refusing to write: repoHead cannot be verified from a Git checkout"
    if [[ $repo_head != __auto__ && -n $repo_head && $repo_head != "$actual_head" ]]; then
        die "refusing to write: repoHead override does not match HEAD $actual_head"
    fi
    git -C "$repo_root" diff --quiet "$actual_head" -- ||
        die "refusing to write: tracked files differ from HEAD, so repoHead would not describe the scanned content"
    printf '%s\n' "$actual_head"
}

cleanup_write_temps() {
    [[ -z ${tmp:-} ]] || rm -f -- "$tmp"
    [[ -z ${snapshot_root:-} ]] || rm -rf -- "$snapshot_root"
}

# All derivation lives in one Python program: it scopes repository scans through
# git ls-files, shells out to grep over those tracked paths, and reads tracked
# consumer flake.nix / flake.lock / *.nix files directly (with a labeled
# filesystem fallback only when a consumer is not a Git checkout).
derive() {
    local derive_root=${1:-$repo_root}
    local derive_head=${2-$repo_head}
    python3 - "$derive_root" "$consumer_base" "$derive_head" <<'PY'
import collections
import json
import fnmatch
import os
import re
import subprocess
import sys

repo_root, consumer_base, repo_head_arg = sys.argv[1], sys.argv[2], sys.argv[3]
home = os.path.expanduser("~")

SCHEMA_VERSION = 1

# Scan every tracked path. grep -I rejects binary payloads; limiting this to a
# hand-maintained extension list missed the extensionless production scripts and
# Python contracts that execute the rename.
INCLUDE_GLOBS = ["*"]
EXCLUDED_INTERNAL_PATHS = {"test/inventory/consumer-inventory.json"}
EXCLUDED_INTERNAL_PREFIXES = ("test/baseline/",)
CONFIG_AI = "config/ai"
CONFIG_FLEET = "config/fleet"
INTENTIONAL_CONFIG_AI_FILES = {
    "CLAUDE.md",
    "README.md",
    "bin/consumer-inventory",
    "bin/coverage-report",
    "bin/coverage-report-test.py",
    "bin/cross-consumer-eval",
    "bin/gates-test.py",
    "bin/immutable-subflake-check",
    "bin/oracle-currency-test.py",
    "bin/parity-baseline",
    "doc/AI-NIX-REINTEGRATION-WIGGUM-HANDOFF.md",
    "doc/AI-NIX-REINTEGRATION-WIGGUM-PLAN.md",
    "doc/AI-UPDATE-FOLLOWUPS-2026-07-24.md",
    "doc/FLEET-DECISIONS.md",
    "doc/FLEET-DESIGN-PLAN.md",
    "doc/FLEET-IMPL-WIGGUM-HANDOFF.md",
    "doc/FLEET-IMPL-WIGGUM-PLAN.md",
    "doc/FLEET-PROGRAMME-CROSS-STREAM.md",
    "doc/HM-CONTRACT-SPLIT-PLAN.md",
    "doc/PARITY-ORACLE-REFRESH.md",
    "doc/RENAME-ROLLBACK.md",
    "doc/UNIFIED-CONFIG-RESEARCH.md",
    "doc/UNIFIED-CONFIG-WIGGUM-HANDOFF.md",
    "doc/UNIFIED-CONFIG-WIGGUM-PLAN.md",
    "doc/designs/HOST-REGISTRY-PLAN.md",
    "doc/migrations/nix-managed-agent-oracle.md",
    "test/coverage/manifest.json",
}
INTENTIONAL_CONFIG_AI_PREFIXES = ("doc/superpowers/plans/",)
FLAKE_AI_RE = re.compile(r"flake-ai\.nix")
# A load-bearing flake-ai.nix import is a relative/interpolated path in a .nix
# file that is not a comment; doc/lint mentions are counted but not classified.
FLAKE_AI_IMPORT_RE = re.compile(r"(\.\.?/)+[\w./-]*flake-ai\.nix|\$\{inputs\.nix-config\}/flake-ai\.nix")
COMPAT_SURFACES = [
    ("ai-nix", r"ai-nix"),
    ("node-red", r"node-red"),
    ("global-anvil", r"global.*[Aa]nvil"),
]

# References into nix-config from a consumer file.
NC_PATH_RE = re.compile(r"\$\{inputs\.nix-config\}/([^\"'\s)]+)")
URL_RE = re.compile(r'url\s*=\s*"([^"]*nix-config[^"]*)"')
FOLLOWS_RE = re.compile(r'([\w][\w-]*)\.follows\s*=\s*"(nix-config[^"]*)"')
OVERLAY_USE_RE = re.compile(r"inputs\.nix-config-ai\.overlays[.\w]*")


# A derived syntactic facet on each internal reference. #47 needs two different
# numbers from this artifact and the flat rename-now count gives only one: the
# COMPLETE set (verified by re-grepping to zero) and the LOAD-BEARING subset (verified
# by the build). 223 records collapsed into one bucket mixes ~43 references that break
# evaluation with ~180 comments and doc lines that a mechanical rename must still
# rewrite but which cannot break anything.
#
# Records are never dropped and never reclassified out of rename-now. This is metadata
# only, so a misjudgement here yields a mislabelled-but-present record rather than a
# silent miss -- which is the whole reason the artifact exists (issue #17 critique H4).
#
# The rule is deliberately CONSERVATIVE and mirrors the one this script already applies
# to flake-ai a few lines below (`.nix and not startswith("#")`): anything in code is
# load-bearing. That keeps two real traps on the safe side --
#   test/ai/home-manager-contract-common.nix:929 reads like prose but is the expected
#     value of an assertion, and
#   the sources/*.json entries look like message strings but are the update
#     tooling's artifact lists,
# both of which a prose-detecting filter would wrongly demote.
def ref_kind(path, text):
    stripped = text.strip()
    if path.endswith(".md"):
        return "doc-prose"
    if path.endswith(".json"):
        return "data"
    if stripped.startswith("#"):
        return "comment"
    # A whole-line quoted path is a list element: tooling DATA, load-bearing.
    if re.fullmatch(r'"[^"]*"\s*,?', stripped):
        return "data"
    if re.search(r"(import\s|inputs\.|\$\{|\./|\.\./)", stripped):
        return "import"
    return "path"


def load_bearing(kind):
    return kind not in ("doc-prose", "comment")


def classify_internal_old_path(path, text):
    if path == "config/ai/flake.nix":
        return (
            "retain-with-owner",
            "jwiegley/nix-config#47",
            "retire only after #63 proves every stale consumer URL is gone",
            "throwing compatibility stub; stale consumers must fail loudly",
        )
    if path in INTENTIONAL_CONFIG_AI_FILES or path.startswith(
        INTENTIONAL_CONFIG_AI_PREFIXES
    ):
        return (
            "retain-with-owner",
            "jwiegley/nix-config#47 historical or detector evidence",
            "none; preserve recorded history or stale-path detection",
            "intentional old-path reference, not a live config/fleet consumer",
        )
    if "config/ai.nix" in text and "config/ai/" not in text and "?dir=config/ai" not in text:
        return (
            "retain-with-owner",
            "config/ai.nix Home Manager module",
            "none; the sibling module filename is not the renamed directory",
            "module filename, not a config/ai directory reference",
        )
    return (
        "rename-now",
        "jwiegley/nix-config#47 (E3-RENAME)",
        "rewrite before #47 reaches its local verification boundary",
        "stale operational reference to the renamed config/ai directory",
    )


def rel(path):
    try:
        return os.path.relpath(path, repo_root)
    except ValueError:
        return path


def resolve_head():
    """Best-effort repo HEAD via pure file reads (no git binary). Returns None on
    any failure or if the gitdir resolves outside repo_root (a worktree pointing
    at another repo) so the sweep never reads into a tree it does not own."""
    if repo_head_arg != "__auto__":
        return repo_head_arg or None
    try:
        dotgit = os.path.join(repo_root, ".git")
        if os.path.isfile(dotgit):
            line = open(dotgit).read().strip()
            if not line.startswith("gitdir:"):
                return None
            gitdir = os.path.normpath(os.path.join(repo_root, line.split("gitdir:", 1)[1].strip()))
        elif os.path.isdir(dotgit):
            gitdir = dotgit
        else:
            return None
        # A LINKED WORKTREE's gitdir legitimately lives outside repo_root — it
        # points at <main>/.git/worktrees/<name>. Declining that case made this
        # emit `repoHead: null` for every run in a worktree, which is how this
        # programme normally works, and a committed inventory that cannot say
        # which tree it describes is uninterpretable. The `gitdir:` pointer came
        # from repo_root's own .git file, so it is by construction this repo's
        # gitdir; there is nothing to protect against here.
        commondir = gitdir
        cdf = os.path.join(gitdir, "commondir")
        if os.path.exists(cdf):
            commondir = os.path.normpath(os.path.join(gitdir, open(cdf).read().strip()))
        head = open(os.path.join(gitdir, "HEAD")).read().strip()
        if not head.startswith("ref:"):
            return head
        ref = head.split("ref:", 1)[1].strip()
        for base in (gitdir, commondir):
            p = os.path.join(base, ref)
            if os.path.exists(p):
                return open(p).read().strip()
        pr = os.path.join(commondir, "packed-refs")
        if os.path.exists(pr):
            for l in open(pr):
                l = l.strip()
                if l and not l.startswith(("#", "^")) and l.endswith(ref):
                    return l.split()[0]
    except Exception:
        return None
    return None


def tracked_files(root):
    """Paths git tracks under `root`, or None when `root` is not a git checkout.

    Scope must come from git, not from walking the filesystem. Measured: this
    inventory was derived by `grep -r` over the working tree, so once
    `.pi-subagents/artifacts/` appeared -- untracked scratch output from Pi
    subagent runs -- regenerating the artifact grew it from 166 references to 325,
    with 83 of the new ones being prose in transient files that merely MENTION a
    path. A tracked data file whose contents depend on whatever scratch
    directories happen to exist is not a baseline; it cannot be reproduced, and a
    real reference appearing or vanishing is invisible in the noise.

    This is the rule bin/quality states in its own header -- "Scope lives in one
    place now: `git ls-files`" -- applied to the other inventory that had not
    adopted it.
    """
    out = subprocess.run(
        ["git", "-C", root, "ls-files", "-z"], capture_output=True, text=True
    )
    if out.returncode != 0:
        return None
    return [os.path.join(root, p) for p in out.stdout.split("\0") if p]


def _excluded_internal(path):
    relative = rel(path)
    return relative in EXCLUDED_INTERNAL_PATHS or any(
        relative.startswith(prefix) for prefix in EXCLUDED_INTERNAL_PREFIXES
    )


def _matches_globs(path):
    return (
        not _excluded_internal(path)
        and any(fnmatch.fnmatch(os.path.basename(path), g) for g in INCLUDE_GLOBS)
    )


def grep(pattern, root, fixed=False):
    """grep -In over the issue's include globs. Returns [(relpath, lineno, text)].
    Missing matches (grep rc 1) are not an error; anything else is."""
    cmd = ["grep", "-HIn"]
    tracked = tracked_files(root)
    if tracked is None:
        # Not a git checkout: fall back to walking, and say so rather than
        # silently producing a differently-scoped result.
        sys.stderr.write(
            "consumer-inventory: %s is not a git checkout; scanning the "
            "filesystem instead of tracked files\n" % root
        )
        cmd.append("-r")
        cmd.append("--exclude-dir=.git")
        for g in INCLUDE_GLOBS:
            cmd.append("--include=" + g)
        targets = [root]
    else:
        # The index is not always what is on disk -- a staged rename or deletion
        # leaves the old path tracked and gone, and lefthook's pre-commit stash
        # creates exactly that state during a partial commit. grep exits 2 when a
        # named file cannot be opened, and the returncode check below turns that
        # into a RuntimeError for the ENTIRE run: one path mid-rename in any of the
        # four roots this walks would abort the whole inventory.
        #
        # This is the guard bin/quality got in d6b3cf3d. Adopting that file's scope
        # rule without its companion guard was taking half the pattern.
        targets = [p for p in tracked if _matches_globs(p) and os.path.exists(p)]
        if not targets:
            return []
    cmd.append("-F" if fixed else "-E")
    cmd += ["-e", pattern, *targets]
    out = subprocess.run(cmd, capture_output=True, text=True)
    if out.returncode not in (0, 1):
        raise RuntimeError("grep failed (%d): %s" % (out.returncode, out.stderr.strip()))
    rows = []
    for line in out.stdout.splitlines():
        # format: PATH:LINENO:TEXT
        m = re.match(r"^(.*?):(\d+):(.*)$", line)
        if not m:
            continue
        relative = rel(m.group(1))
        if _excluded_internal(relative):
            continue
        rows.append((relative, int(m.group(2)), m.group(3)))
    return rows


def nix_files(root):
    """Every .nix file git tracks under `root`; see tracked_files for why."""
    tracked = tracked_files(root)
    if tracked is not None:
        # os.path.exists for the same reason as in grep(): callers READ these paths,
        # so a tracked-but-absent one raises FileNotFoundError rather than grep's rc 2.
        return sorted(
            p for p in tracked if p.endswith(".nix") and os.path.exists(p)
        )
    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in (".git",)]
        for fn in filenames:
            if fn.endswith(".nix"):
                files.append(os.path.join(dirpath, fn))
    return sorted(files)


def line_of(text, idx):
    return text.count("\n", 0, idx) + 1


def scan_reachins(path, consumer_root):
    """Yield reference dicts for every ${inputs.nix-config}/PATH interpolation and
    every attribute cherry-picked via `inherit (import "${inputs.nix-config}/..." )`."""
    text = open(path).read()
    lines = text.splitlines()
    relf = os.path.relpath(path, consumer_root)
    refs = []

    # 1) path interpolations into nix-config internals / supported surface.
    for m in NC_PATH_RE.finditer(text):
        sub = m.group(1)
        ln = line_of(text, m.start())
        refs.append({
            "_kind": "config-import" if sub.startswith("config/") else (
                "reach-in-path" if sub.startswith("overlays/") else "nix-config-path"),
            "file": relf,
            "line": ln,
            "text": lines[ln - 1].strip(),
            "targetPath": sub,
        })

    # 2) inherit (import "${inputs.nix-config}/...") ATTR ... ; -> cherry-picked attrs.
    for im in re.finditer(r"\binherit\b", text):
        k = im.end()
        while k < len(text) and text[k].isspace():
            k += 1
        if k >= len(text) or text[k] != "(":
            continue  # `inherit foo;` (no from-set) is not a reach-in
        depth, p = 0, k
        while p < len(text):
            if text[p] == "(":
                depth += 1
            elif text[p] == ")":
                depth -= 1
                if depth == 0:
                    break
            p += 1
        group = text[k:p + 1]
        if "inputs.nix-config}" not in group:
            continue
        src_paths = NC_PATH_RE.findall(group)
        semi = text.find(";", p + 1)
        attrs = [a for a in re.split(r"\s+", text[p + 1:semi].strip()) if a]
        for a in attrs:
            aidx = text.find(a, p + 1)
            aln = line_of(text, aidx)
            refs.append({
                "_kind": "reach-in-attr",
                "file": relf,
                "line": aln,
                "text": lines[aln - 1].strip(),
                "attr": a,
                "srcOverlays": src_paths,
            })
    return refs


def load_lock_nc_nodes(root):
    """Map dir-key -> node info for every flake.lock node referencing nix-config.
    Key is '' for the repo-root input and the declared config/ai or config/fleet
    directory for the subflake input."""
    lock_path = os.path.join(root, "flake.lock")
    if not os.path.isfile(lock_path):
        return {}
    lock = json.load(open(lock_path))
    out = {}
    for name, node in lock.get("nodes", {}).items():
        locked = node.get("locked", {}) or {}
        orig = node.get("original", {}) or {}
        blob = json.dumps(orig) + json.dumps(locked)
        if (locked.get("repo") == "nix-config" or orig.get("repo") == "nix-config"
                or "nix-config" in (locked.get("url") or "") or "nix-config" in (orig.get("url") or "")):
            if "nix-config" not in blob:
                continue
            key = locked.get("dir") or orig.get("dir") or ""
            out[key] = {
                "node": name,
                "rev": locked.get("rev"),
                "flake": node.get("flake", True),
                "dir": locked.get("dir") or orig.get("dir"),
                "ref": locked.get("ref") or orig.get("ref"),
                "original": orig,
            }
    return out


# --- consumer table -------------------------------------------------------
# Each consumer lists candidate roots in priority order. vulcan/vps read from
# the local ~/src checkout the sweep was pointed at; their authoritative BUILD
# tree is /etc/nixos on the host (locks there may differ). shared-work has NO
# authoritative copy on this machine: its live config is ~/.config/home-manager
# on the four work machines' shared NFS home. ~/src/andoria is a developer
# PROXY of that config (issue #17 cites it by line number); when only the proxy
# is present the consumer is reported unresolved (resolved=false, provisional)
# and its rows are tagged as proxy-derived, to force reconfirmation via the
# verifyCommand rather than being mistaken for the live tree.
CONSUMERS = [
    {
        "name": "vulcan",
        "type": "nixos",
        "candidates": [(os.path.join(consumer_base, "nixos"), "local-checkout")],
        "authoritativeHostPath": "/etc/nixos on vulcan",
        "ownerId": "jwiegley/nixos-config (read from ~/src/nixos; live build tree /etc/nixos on vulcan)",
        "reachinRetireOwner": "jwiegley/nixos-config#4",
        "verifyCommand": (
            "on vulcan (read-only): grep -nE "
