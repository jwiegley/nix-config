    },
    {
        "name": "vps",
        "type": "nixos",
        "candidates": [(os.path.join(consumer_base, "vps"), "local-checkout")],
        "authoritativeHostPath": "/etc/nixos on ovh-vps",
        "ownerId": "vps consumer (read from ~/src/vps; live build tree /etc/nixos on ovh-vps)",
        "reachinRetireOwner": "jwiegley/nix-config#69",
        "verifyCommand": (
            "on ovh-vps (read-only): grep -nE "
