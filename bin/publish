#!/usr/bin/env bash
# Publish one revision to the authoritative Gitea remote with a fail-loud preflight.
#
# Every managed consumer fetches this repository from the same Gitea authority:
#
#   origin  gitea@gitea:johnw/nix-config.git
#
# GitHub is not a publication destination or consumer source. The command checks
# the raw fetch and push URLs before contacting the remote so a stale clone cannot
# silently publish elsewhere. The push is fast-forward-only; never weaken this by
# adding force.
#
# Never permits a non-fast-forward publication. Never embeds a credential:
# authentication is whatever ssh already provides, so this works only where the
# operator's keys already work.
#
# Usage:
#   bin/publish                     # no push; refresh refs and pre-flight. The default.
#   bin/publish --publish           # actually push HEAD's branch to Gitea
#   bin/publish --rev REV           # assert the revision (must equal the checked-out
#                                   # branch tip; refuses otherwise)
#   bin/publish --branch NAME       # assert the branch (must be currently checked out)
#
# Publication is deliberately restricted to the clean tip of the checked-out branch:
# Lefthook gates the current checkout while Git pushes the named object, and those
# must be the same tree. Check out a different revision or branch before publishing it.
#
# Pushing is a human-gated action per CLAUDE.md, so the gate is encoded here: a
# bare invocation reports what WOULD happen and exits. Only --publish pushes.
# Building this tool was never authorization to run it, and an earlier revision of
# this header wrongly described the bare form as "default-safe" while the bare form
# actually published. That claim is now true rather than deleted.
#
# --dry-run is accepted as a synonym for the default, so existing muscle memory
# and any caller written against the old interface stay correct. It cannot be
# combined with --publish.
#
# The tracked pre-push group is run explicitly ONCE before any real push. The
# revision is required to be the clean checked-out branch tip both before
# pre-flight and after the gates. Git's --no-verify then suppresses duplicate hook
# invocations for that exact verified revision across dry-run and real pushes;
# it does not skip the gate.
# Raw `git push` still runs the installed hook, whose tracked-tree file scope keeps
# empty remote ranges from turning every command into a silent no-op.
#
# Ref: doc/ARCHITECTURE.md "Publication and activation".

set -euo pipefail

# Signature and ancestry checks must inspect the objects whose exact IDs will be
# pushed. A local refs/replace view can otherwise make an unsigned object appear
# to be a different, signed commit while preserving the original displayed ID.
export GIT_NO_REPLACE_OBJECTS=1

readonly REMOTE=origin
readonly EXPECTED_REMOTE_URL=gitea@gitea:johnw/nix-config.git

# Default to NOT pushing. --publish opts in.
do_publish=0
saw_dry_run=0
rev=""
branch=""
publication_state=before-push

die() {
    printf 'publish: %s\n' "$*" >&2
    exit 1
}
say() { printf 'publish: %s\n' "$*"; }
warn() { printf 'publish: %s\n' "$*" >&2; }

print_transaction_recovery() {
    local retry_command
    warn "The remote is not verified at the target revision. Retry only through"
    warn "the publication transaction; it revalidates authority, signatures,"
    warn "fast-forward state, and the final Gitea readback:"
    printf -v retry_command 'bin/publish --publish --rev %q --branch %q' "$rev" "$branch"
    warn "  $retry_command"
}

# shellcheck disable=SC2329 # Invoked by the INT and TERM traps below.
handle_publication_signal() {
    local signal_name=$1 exit_status=$2

    # Prevent a second signal from cutting off the recovery command or EXIT trap.
    trap '' INT TERM
    if [[ $publication_state == in-flight ]]; then
        warn "publication interrupted by $signal_name after the real push began;"
        warn "Gitea may have changed and final readback did not complete."
        print_transaction_recovery
    elif [[ $publication_state == verified ]]; then
        warn "interrupted by $signal_name after publication; final Gitea readback"
        warn "had already verified the target revision"
    else
        warn "interrupted by $signal_name before publication; no real push began"
    fi
    exit "$exit_status"
}

trap 'handle_publication_signal INT 130' INT
trap 'handle_publication_signal TERM 143' TERM

while [[ $# -gt 0 ]]; do
    case $1 in
    --dry-run)
        [[ $do_publish -eq 0 ]] ||
            die "--dry-run cannot be combined with --publish"
        saw_dry_run=1
        ;;
    --publish)
        [[ $saw_dry_run -eq 0 ]] ||
            die "--publish cannot be combined with --dry-run"
        do_publish=1
        ;;
    --rev)
        [[ -n ${2-} ]] || die "--rev needs a revision"
        rev=$2
        shift
        ;;
    --branch)
        [[ -n ${2-} ]] || die "--branch needs a name"
        branch=$2
        shift
        ;;
    --force | -f | --force-with-lease)
        die "refusing to force-push. This tool never rewrites published history.
    If you genuinely need to, do it deliberately by hand, with explicit
    authorization for that specific action (CLAUDE.md)."
        ;;
    -h | --help)
        sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'
        exit 0
        ;;
    *) die "unknown argument: $1" ;;
    esac
    shift
done

repo_root=$(git rev-parse --show-toplevel) || die "not in a git repository"
cd "$repo_root"

[[ -n $branch ]] || branch=$(git symbolic-ref --quiet --short HEAD) ||
    die "detached HEAD and no --branch given; say which branch to publish"

if [[ -n $rev ]]; then
    rev=$(git rev-parse --verify "$rev^{commit}") || die "cannot resolve rev: $rev"
else
    rev=$(git rev-parse --verify "refs/heads/$branch^{commit}") ||
        die "no such branch: $branch"
fi
short=${rev:0:12}

say "branch $branch at $short"

# Lefthook evaluates the current checkout, whereas Git pushes an object named by
# $rev. Keep those two trees identical: publication is deliberately restricted to
# the clean tip of the checked-out branch. Re-checking this after the gates catches
# a gate that changes tracked state or advances the ref before hooks are bypassed.
# Untracked files are irrelevant to the committed tree and remain allowed.
assert_publish_tree() {
    local phase=$1 current branch_tip tracked_state

    current=$(git symbolic-ref --quiet --short HEAD) ||
        die "$phase: detached HEAD cannot be matched to the tree being gated"
    [[ $current == "$branch" ]] ||
        die "$phase: branch '$branch' is not checked out (current branch: '$current')"

    branch_tip=$(git rev-parse --verify "refs/heads/$branch^{commit}") ||
        die "$phase: no such branch: $branch"
    [[ $branch_tip == "$rev" ]] ||
        die "$phase: revision $short must equal the current $branch branch tip
    (${branch_tip:0:12}); refusing to gate one tree and publish another"

    tracked_state=$(git status --porcelain=v1 --untracked-files=no) ||
        die "$phase: could not inspect tracked working-tree state"
    [[ -z $tracked_state ]] ||
        die "$phase: tracked working tree or index is dirty; commit or restore it
    before publishing so the gated tree is exactly $short"
}

assert_publish_tree "pre-flight"

# ---- Pre-flight ---------------------------------------------------------
# Everything checkable before remote publication. This phase reads Gitea into
# temporary local refs but does not push.

assert_exact_remote_urls() {
    local action=$1 source=$2 urls=$3 count=0 candidate
    while IFS= read -r candidate; do
        [[ -n $candidate ]] || continue
        count=$((count + 1))
        [[ $candidate == "$EXPECTED_REMOTE_URL" ]] ||
            die "remote '$REMOTE' must $action $EXPECTED_REMOTE_URL only
    ($source URL set contains a non-authoritative destination)"
    done <<<"$urls"
    [[ $count -eq 1 ]] ||
        die "remote '$REMOTE' must $action $EXPECTED_REMOTE_URL only
    ($source URL set must contain exactly one destination; found $count)"
}

assert_remote_authority() {
    local phase=$1 configured_fetches configured_pushes effective_fetches effective_pushes remotes

    remotes=$(git remote 2>/dev/null || true)
    [[ $remotes == "$REMOTE" ]] ||
        die "$phase: configured remote set must be exactly '$REMOTE'"

    configured_fetches=$(git config --get-all "remote.$REMOTE.url" 2>/dev/null || true)
    assert_exact_remote_urls "fetch from" "$phase configured" "$configured_fetches"

    configured_pushes=$(git config --get-all "remote.$REMOTE.pushurl" 2>/dev/null || true)
    if [[ -n $configured_pushes ]]; then
        assert_exact_remote_urls "push to" "$phase configured" "$configured_pushes"
    fi

    # `url.*.insteadOf` and `pushInsteadOf` are applied after the raw remote
    # configuration is read. Validate Git's expanded destinations too.
    effective_fetches=$(git remote get-url --all "$REMOTE" 2>/dev/null || true)
    assert_exact_remote_urls "fetch from" "$phase effective" "$effective_fetches"
    effective_pushes=$(git remote get-url --push --all "$REMOTE" 2>/dev/null || true)
    assert_exact_remote_urls "push to" "$phase effective" "$effective_pushes"
}

assert_remote_authority "pre-flight"

# The revision must actually be on the branch being published, or the push would
# publish something other than what was verified.
git merge-base --is-ancestor "$rev" "refs/heads/$branch" ||
    die "$short is not an ancestor of $branch; refusing to publish a revision
    that is not on the branch you named"

# The selected branch tip is always part of the signed-publication contract,
# including when Gitea already has it or it is reachable from another branch.
declare -A checked_commits=()
unsigned=0
checked=0
check_signature_record() {
    local record=$1 sig sha subject
    read -r sig sha subject <<<"$record"
    [[ -n $sha ]] || return 0
    [[ -z ${checked_commits[$sha]+present} ]] || return 0
    checked_commits["$sha"]=1
    checked=$((checked + 1))

    # G/U are cryptographically good; Y remains valid under a now-expired key.
    case $sig in
    G | U | Y) : ;;
    *)
        warn "UNSIGNED or bad signature ($sig) ${sha:0:12} ${subject:-}"
        unsigned=1
        ;;
    esac
}

check_signature_oid() {
    local oid=$1 record inspected_sha
    record=$(transport_git --no-replace-objects log --no-walk=unsorted -1 \
        --pretty='%G? %H %s' "$oid") ||
        die "could not inspect signature for commit $oid"
    inspected_sha=${record#* }
    inspected_sha=${inspected_sha%% *}
    [[ $inspected_sha == "$oid" ]] ||
        die "signature inspection returned $inspected_sha instead of $oid"
    check_signature_record "$record"
}

# Network Git runs in a throwaway bare repository with no system, global, or
# caller-injected command configuration. Its only object alternate is this
# checkout, so explicit SHA refspecs can push the already-verified local tip.
# This makes the literal URL the transport authority even if .git/config is
# changed during a fetch, push, or readback.
source_object_dir=$(git rev-parse --path-format=absolute --git-path objects) ||
    die "could not locate the publication object database"
object_format=$(git rev-parse --show-object-format) ||
    die "could not determine the repository object format"
transport_root=""
transport_git_dir=""

# shellcheck disable=SC2329 # Invoked by the EXIT trap below.
cleanup_transport() {
    if [[ -n ${transport_root:-} && -d $transport_root ]]; then
        rm -rf -- "$transport_root"
    fi
}
trap cleanup_transport EXIT

transport_root=$(mktemp -d "${TMPDIR:-/tmp}/publish-transport.XXXXXX") ||
    die "could not create an isolated Git transport directory"
transport_git_dir="$transport_root/repo.git"
transport_template_dir="$transport_root/empty-template"
mkdir -m 0700 "$transport_template_dir" ||
    die "could not create the isolated Git template directory"
snapshot_namespace=refs/publish-snapshot

transport_git() {
    env \
        -u GIT_COMMON_DIR \
        -u GIT_CONFIG \
        -u GIT_CONFIG_COUNT \
        -u GIT_CONFIG_PARAMETERS \
        -u GIT_GRAFT_FILE \
        -u GIT_IMPLICIT_WORK_TREE \
        -u GIT_INDEX_FILE \
        -u GIT_INTERNAL_SUPER_PREFIX \
        -u GIT_NAMESPACE \
        -u GIT_OBJECT_DIRECTORY \
        -u GIT_PREFIX \
        -u GIT_REPLACE_REF_BASE \
        -u GIT_SHALLOW_FILE \
        -u GIT_SSH \
        -u GIT_SSH_COMMAND \
        -u GIT_SSH_VARIANT \
        -u GIT_TEMPLATE_DIR \
        -u GIT_WORK_TREE \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_SYSTEM=/dev/null \
        GIT_CONFIG_GLOBAL=/dev/null \
        GIT_CONFIG_COUNT=2 \
        GIT_CONFIG_KEY_0=core.commitGraph \
        GIT_CONFIG_VALUE_0=false \
        GIT_CONFIG_KEY_1=pack.useBitmaps \
        GIT_CONFIG_VALUE_1=false \
        GIT_DIR="$transport_git_dir" \
        GIT_ALTERNATE_OBJECT_DIRECTORIES="$source_object_dir" \
        git "$@"
}

delete_snapshot_refs() {
    local ref
    while IFS= read -r ref; do
        [[ -n $ref ]] || continue
        transport_git update-ref -d "$ref" >/dev/null 2>&1 || return 1
    done < <(transport_git for-each-ref --format='%(refname)' "$snapshot_namespace/")
}

transport_git init --bare --quiet --template="$transport_template_dir" \
    --object-format="$object_format" ||
    die "could not initialize the isolated Git transport"
unexpected_transport_config=$(transport_git config --local --name-only --list |
    LC_ALL=C grep -Ev \
        '^(core\.(bare|filemode|ignorecase|logallrefupdates|precomposeunicode|repositoryformatversion|symlinks)|extensions\.objectformat)$' || true)
[[ -z $unexpected_transport_config ]] ||
    die "isolated Git transport acquired unexpected local configuration"
delete_snapshot_refs || die "could not clear the temporary Gitea ref namespace"
snapshot_residue=$(transport_git for-each-ref --format='%(refname)' "$snapshot_namespace/")
[[ -z $snapshot_residue ]] ||
    die "temporary Gitea ref namespace was not empty before fetch"

assert_remote_authority "before Gitea fetch"
snapshot_refspec="+refs/heads/*:$snapshot_namespace/*"
fetch_stderr="$transport_root/fetch.stderr"
if ! fetch_output=$(transport_git fetch --porcelain --atomic --prune --no-tags \
    --no-write-fetch-head "$EXPECTED_REMOTE_URL" "$snapshot_refspec" \
    2>"$fetch_stderr"); then
    while IFS= read -r fetch_error; do
        printf '%s\n' "$fetch_error" >&2
    done <"$fetch_stderr"
    die "authoritative Gitea is unreachable or its fresh-ref fetch failed"
fi
assert_remote_authority "after Gitea fetch"
transport_is_shallow=$(transport_git rev-parse --is-shallow-repository) ||
    die "could not verify the isolated Gitea snapshot depth"
[[ $transport_is_shallow == false ]] ||
    die "authoritative Gitea produced a shallow snapshot; refusing incomplete history"

# Accept only refs named by the successful fetch report, then freeze their exact
# object IDs. An injected namespace ref is either pruned or rejected here and can
# never become an implicit negative revision.
reported_refs=""
while read -r flag _old_sha new_sha fetched_ref extra; do
    [[ -n ${flag:-} ]] || continue
    [[ -z ${extra:-} && $fetched_ref == "$snapshot_namespace/"* ]] ||
        die "unexpected ref in Gitea fetch report: ${fetched_ref:-<missing>}"
    case $flag in
    -) continue ;;
    \*)
        reported_refs+="${reported_refs:+$'\n'}$fetched_ref"$'\t'"$new_sha"
        ;;
    *) die "unexpected Gitea fetch status '$flag' for $fetched_ref" ;;
    esac
done <<<"$fetch_output"
if [[ -n $reported_refs ]]; then
    reported_refs=$(printf '%s\n' "$reported_refs" | LC_ALL=C sort) ||
        die "could not order the authoritative Gitea fetch report"
fi
observed_refs=$(transport_git for-each-ref --sort=refname \
    --format='%(refname)%09%(objectname)' "$snapshot_namespace/") ||
    die "could not enumerate the fetched Gitea refs"
[[ $observed_refs == "$reported_refs" ]] ||
    die "temporary Gitea refs did not exactly match the authoritative fetch report"

remote_sha=""
while IFS=$'\t' read -r fetched_ref observed_sha; do
    [[ -n ${fetched_ref:-} ]] || continue
    if [[ $fetched_ref == "$snapshot_namespace/$branch" ]]; then
        remote_sha=$observed_sha
    fi
done <<<"$observed_refs"
delete_snapshot_refs || die "could not clear the fetched Gitea ref namespace"
snapshot_residue=$(transport_git for-each-ref --format='%(refname)' "$snapshot_namespace/")
[[ -z $snapshot_residue ]] || die "temporary Gitea refs survived snapshot capture"

declare -a need_push=()
declare -a already=()
r=$REMOTE
if [[ $remote_sha == "$rev" ]]; then
    say "  $r already at $short"
    already+=("$r")
else
    if [[ -n $remote_sha ]]; then
        # Fast-forward only. A non-ff push here would be a rewrite of published
        # history, which this tool must never do.
        if ! transport_git merge-base --is-ancestor "$remote_sha" "$rev" 2>/dev/null; then
            die "$r/$branch is at ${remote_sha:0:12}, which is NOT an ancestor of
    $short. Publishing would rewrite published history. Rebase onto the remote
    first, then publish. This tool will not force."
        fi
        say "  $r at ${remote_sha:0:12}, fast-forward to $short"
    else
        say "  $r has no $branch yet, would create it"
    fi
    need_push+=("$r")
fi

# This check deliberately follows remote reachability and fast-forward checks,
# but precedes every successful exit and every dry-run or real push.
say "checking the selected branch-tip signature"
check_signature_oid "$rev"
[[ $unsigned -eq 0 ]] ||
    die "refusing to publish unsigned commits: unsigned branch tip"

# Signed commits only (CLAUDE.md). Check every commit that would become newly
# published, not just the tip — an unsigned commit in the middle still lands.
if [[ ${#need_push[@]} -gt 0 ]]; then
    say "checking signatures on commits newly reachable from Gitea $branch"
    declare -a signature_range=("$rev")
    if [[ -n $remote_sha ]]; then
        signature_range+=(--not "$remote_sha")
    fi
    unpublished_oids=$(transport_git rev-list "${signature_range[@]}" 2>/dev/null) ||
        die "could not compute the unpublished commit range from fresh Gitea refs"
    while IFS= read -r unpublished_oid; do
        [[ -n $unpublished_oid ]] || continue
        check_signature_oid "$unpublished_oid"
    done <<<"$unpublished_oids"
fi
[[ $unsigned -eq 0 ]] || die "refusing to publish unsigned commits (see above)"
say "  all selected commits signed (unique commits checked: $checked)"

if [[ ${#need_push[@]} -eq 0 ]]; then
    say "Gitea already at $short; nothing to do"
    exit 0
fi

# Require dry-run ref negotiation before mutating Gitea.
# Real hooks, concurrent changes, or network faults can still reject a real push.
say "pre-flight: dry-run push to Gitea"
target_ref="refs/heads/$branch"
# This exact compare-and-swap lease closes the fetch/push race. The ancestry
# check above still prohibits non-fast-forward publication; the lease cannot be
# used by a caller to request a rewrite.
target_lease="--force-with-lease=$target_ref:$remote_sha"
for r in "${need_push[@]}"; do
    assert_remote_authority "before Gitea dry-run"
    if dry_run_output=$(transport_git push --dry-run --no-verify "$target_lease" \
        "$EXPECTED_REMOTE_URL" "$rev:$target_ref" 2>&1); then
        assert_remote_authority "after Gitea dry-run"
        say "  $r would accept"
    else
        assert_remote_authority "after rejected Gitea dry-run"
        printf '\n%s\n' "$dry_run_output" >&2
        die "$r rejected the dry-run (output above). Nothing was pushed."
    fi
done

if [[ $do_publish -eq 0 ]]; then
    say "Gitea would accept $short on $branch. Nothing pushed."
    say "re-run with --publish to actually publish."
    exit 0
fi

# All remote pre-flight is complete. Run the tracked hook group once, forced so an
# empty range cannot turn tree-validating commands into skips. Only this successful
# proof permits the duplicate-suppressed pushes below.
say "pre-push: running tracked gates once for $short"
if ! lefthook run pre-push --force; then
    die "pre-push gates failed. Nothing was pushed anywhere."
fi
assert_publish_tree "post-gate"
assert_remote_authority "post-gate"
say "pre-push: all tracked gates passed once"

# ---- Publish ------------------------------------------------------------
# Push, then independently verify Gitea actually holds the revision.
# `git push` exiting 0 is not proof; re-reading the remote ref is.

declare -a pushed=()
declare -a failed=()
declare -A failed_state=()
for r in "${need_push[@]}"; do
    say "pushing to $r"
    assert_remote_authority "immediately before Gitea push"
    publication_state=in-flight
    if transport_git push --no-verify "$target_lease" "$EXPECTED_REMOTE_URL" \
        "$rev:$target_ref"; then
        push_succeeded=1
    else
        push_succeeded=0
    fi
    authority_changed=0
    if authority_error=$(assert_remote_authority \
        "after Gitea push and before readback" 2>&1); then
        if confirm=$(transport_git ls-remote "$EXPECTED_REMOTE_URL" \
            "refs/heads/$branch" 2>/dev/null | awk '{print $1}'); then
            observed=${confirm:-<missing>}
        else
            warn "  $r push readback failed; remote state is unverified"
            confirm=""
            observed="<unreadable>"
        fi
        if ! authority_error=$(assert_remote_authority "after Gitea readback" 2>&1); then
            authority_changed=1
        fi
    else
        authority_changed=1
    fi
    if [[ $authority_changed -eq 1 ]]; then
        warn "  $r authority changed after push; remote state is unverified"
        printf '%s\n' "$authority_error" >&2
        confirm=""
        observed="<authority-changed>"
    fi
    if [[ $confirm == "$rev" ]]; then
        publication_state=verified
        if [[ $push_succeeded -eq 1 ]]; then
            say "  $r confirmed at $short"
            pushed+=("$r")
        else
            say "  $r already at $short after rejected push (concurrent publisher)"
            already+=("$r")
        fi
    elif [[ $push_succeeded -eq 1 ]]; then
        warn "  $r reported success but reads back ${confirm:-<nothing>}"
        failed+=("$r")
        failed_state["$r"]=$observed
    else
        failed+=("$r")
        failed_state["$r"]=$observed
    fi
done

if [[ ${#failed[@]} -eq 0 ]]; then
    say "published $short on $branch to: ${pushed[*]} ${already[*]-}"
    exit 0
fi

# Failed publication. The remote is not verified at the requested revision.
printf '\n' >&2
warn "=============================================================="
warn "PUBLICATION FAILED — Gitea is not verified at the target"
warn "=============================================================="
warn "revision : $short on $branch"
[[ ${#pushed[@]} -gt 0 ]] && warn "published: ${pushed[*]}"
[[ ${#already[@]} -gt 0 ]] && warn "already  : ${already[*]}"
warn "FAILED   : ${failed[*]}"
warn ""
print_transaction_recovery
for r in "${failed[@]}"; do
    observed=${failed_state[$r]-<unreadable>}
    warn "  $r observed: $observed (target $short)"
done
exit 1
