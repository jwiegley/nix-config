#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
routing=$script_dir/lib/host-routing.sh
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

raw_host=$(hostname -s)
[[ ! -d /etc/srp-next ]] || raw_host=vps
host=$(normalize_nix_host "$raw_host") || {
    echo "switch: unknown host: $raw_host" >&2
    exit 2
}

if [[ $(uname -s) == Darwin ]]; then
    exec u switch
elif [[ -d /etc/nixos ]]; then
    output=$(nix_flake_output_for_host "$host")
    cd /etc/nixos
    exec sudo nixos-rebuild switch --flake ".#$output"
elif [[ -d $HOME/.config/home-manager ]]; then
    # Use the flake's OWN pinned home-manager, not home-manager/master.
    #
    # `nix run home-manager/master -- switch` fetched a floating upstream every
    # time, so the tool performing the activation was not the one the flake was
    # locked against. On the four shared-work machines that is worse than
    # untidy: they share one $HOME over NFS, so the home-manager release doing
    # the writing must match the one the configuration was evaluated with, or
    # the four can disagree about profile and state layout.
    #
    # Build the activation package from the local flake, then run its activate
    # script — which is exactly what `home-manager switch` does internally,
    # minus the floating fetch.
    output=$(nix_flake_output_for_host "$host") || {
        echo "switch: no flake output for host: $host" >&2
        exit 2
    }
    cd "$HOME/.config/home-manager"
    generation=$(nix build --no-link --print-out-paths \
        ".#homeConfigurations.\"$output\".activationPackage")
    exec "$generation/activate"
else
    exec u "$host" switch
fi
