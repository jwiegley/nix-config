#!/usr/bin/env bash
# The single quality authority. lefthook, GitHub Actions and the Makefile all
# delegate here rather than each keeping their own copy of "which files, which
# tool, which flags".
#
# Why this exists. Before it, the same checks were defined in four places and had
# already drifted apart in ways that made CI strictly weaker than the local hook:
#
#   * CI shell-checks named 9 files by hand; lefthook globbed the non-recursive
#     bin/* plus build and found 18. CI was blind to 9 real scripts, including
#     bin/switch, bin/update-remote and bin/upgrade-all. (An audit corrected this
#     from "19 / blind to 10": the extra file was bin/quality itself, already in
#     the working tree when the measurement was taken.)
#   * Both hardcoded the same 4 Python files while the tree tracks 35. The other
#     31 — the whole packages/anvil-mcp suite among them — were never linted.
#   * Worse, both looped over files WITHOUT propagating failure: no `set -e`, no
#     accumulation, so the loop exited with the status of its last iteration. A
#     misformatted file in the middle passed silently. bin/update-agents had a
#     45-line shfmt diff and every gate reported success.
#
# So the two rules this script exists to enforce:
#
#   1. Scope comes from `git ls-files`, never from a hand-maintained list. A new
#      file is in scope the moment it is tracked; nothing has to be remembered.
#   2. Every file is checked and EVERY failure is reported, then the suite exits
#      non-zero. Never stop at the first failure, never lose one to $?.
#
# Usage:
#   bin/quality                      # run every suite (same as `all`)
#   bin/quality nix-format           # one suite
#   bin/quality --python-tier pre-commit python-test
#   bin/quality --tier expensive      # low-frequency exhaustive assurance
#   bin/quality shell-format --fix   # rewrite instead of check, where meaningful
#   bin/quality --list               # print every suite
#   bin/quality --files shell        # print the discovered file set and exit
#
# Suites: nix-format nix-lint nix-deadcode shell-lint shell-format
#         python-lint python-test portable-eval immutable-subflake
#         darwin-surface consumer-eval signatures coverage coverage-live
#
# Refs: jwiegley/nix-config#46.

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel) || {
    printf 'quality: not in a git repository\n' >&2
    exit 1
}
quality_program=$repo_root/bin/quality
cd "$repo_root" || exit 1

SUITES=(
    nix-format
    nix-lint
    nix-deadcode
    shell-lint
    shell-format
    python-lint
    python-test
    portable-eval
    immutable-subflake
    darwin-surface
    consumer-eval
    signatures
    coverage
    coverage-live
)

fix=0
python_tier=all
python_tier_seen=0
quality_tier=""
quality_tier_seen=0
want=()

PRE_COMMIT_CORE_SUITES=(
    nix-format
    nix-lint
    nix-deadcode
    shell-lint
    shell-format
    python-lint
    python-test
)

EXPENSIVE_SUITES=(
    python-test
    portable-eval
    immutable-subflake
    consumer-eval
    signatures
    coverage
    coverage-live
    darwin-surface
)

# ---- file discovery -----------------------------------------------------
# Tracked files only. This is deliberate: it excludes result/ symlinks, build
# artifacts and anything gitignored without needing a prune list, and it means
# "in scope" and "in the repository" are the same statement.

files_nix() { git ls-files -- '*.nix'; }

# Interpreter detection by shebang rather than by extension, because the repo's
# operational scripts carry no extension (bin/u, bin/de, build) and one Python
# program is likewise extensionless (bin/update-overlay).
_shebang_is() {
    local pat=$1 f=$2
    [[ -f $f ]] || return 1
    IFS= read -r first <"$f" 2>/dev/null || return 1
    [[ $first == '#!'* && $first == *"$pat"* ]]
}

files_shell() {
    local f
    while IFS= read -r f; do
        _shebang_is bash "$f" && printf '%s\n' "$f"
    done < <(git ls-files)
}

files_python() {
    local f
    while IFS= read -r f; do
        if [[ $f == *.py || $f == *.py.in ]]; then
            printf '%s\n' "$f"
        elif _shebang_is python "$f"; then
            printf '%s\n' "$f"
        fi
    done < <(git ls-files)
}

# unittest suites, by the repo's bin/<name>-test.py convention.
#
# Scope boundary, stated rather than left to be discovered: this is deliberately
# narrower than files_python. The tree also tracks 12 packages/anvil-mcp/*-test.py
# suites and test/ai/statusline-command-test.py. Those are LINTED by python-lint
# but not EXECUTED here, because several drive a live Emacs or a long soak and are
# not safe to run unattended in a pre-commit hook. They have their own flake
# checks. Widening this glob without first tiering those suites would make every
# commit wait on them.
files_python_tests() { git ls-files -- 'bin/*-test.py'; }

# Tier assignment is data, not another filename glob. The manifest owns the
# assignment and this selector intersects it with the live tracked test set. A
# missing, duplicate, non-test, or empty assignment is a refusal: otherwise a new
# test could silently disappear from every invocation surface while the hook stays
# green. `all` preserves the historical `bin/quality python-test` behavior.
files_python_tests_for_tier() {
    local tier=$1
    python3 - "$repo_root" "$tier" <<'PY'
import json
import subprocess
import sys
from collections import Counter
from pathlib import Path

repo = Path(sys.argv[1])
tier = sys.argv[2]
allowed = {"pre-commit", "pre-push", "ci-on-demand", "all"}
if tier not in allowed:
    raise SystemExit(f"quality: invalid Python test tier: {tier}")

manifest_path = repo / "test" / "coverage" / "manifest.json"
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as error:
    raise SystemExit(f"quality: cannot read Python tier manifest: {error}")

tracked_run = subprocess.run(
    ["git", "ls-files", "--", "bin/*-test.py"],
    cwd=repo,
    capture_output=True,
    text=True,
    check=False,
)
if tracked_run.returncode != 0:
    raise SystemExit("quality: could not discover tracked Python test suites")
tracked = sorted(path for path in tracked_run.stdout.splitlines() if path)
tracked_set = set(tracked)

entries = [
    entry
    for entry in manifest.get("pythonInventory", [])
    if isinstance(entry, dict) and entry.get("path") in tracked_set
]
counts = Counter(entry.get("path") for entry in entries)
missing = sorted(tracked_set - set(counts))
duplicates = sorted(path for path, count in counts.items() if count != 1)
invalid = sorted(
    entry.get("path", "<missing-path>")
    for entry in entries
    if entry.get("kind") != "test"
    or entry.get("tier") not in {"pre-commit", "pre-push", "ci-on-demand"}
)
if missing or duplicates or invalid:
    raise SystemExit(
        "quality: Python tier ownership is invalid; "
        f"missing={missing}, duplicates={duplicates}, invalid={invalid}"
    )

by_path = {entry["path"]: entry for entry in entries}
selected = tracked if tier == "all" else [
    path for path in tracked if by_path[path]["tier"] == tier
]
if not selected:
    raise SystemExit(f"quality: Python test tier {tier!r} selected zero suites")
print("\n".join(selected))
PY
}

python_test_budget() {
    local tier=$1
    [[ $tier == all ]] && tier=ci-on-demand
    python3 - "$repo_root/test/coverage/manifest.json" "$tier" <<'PY'
import json
import sys
from pathlib import Path

try:
    value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))[
        "budgetsSeconds"
    ][sys.argv[2]]
except (OSError, KeyError, TypeError, json.JSONDecodeError) as error:
    raise SystemExit(f"quality: cannot read Python tier budget: {error}")
if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
    raise SystemExit("quality: Python tier budget must be a positive integer")
print(value)
PY
}

# ---- reporting ----------------------------------------------------------

failures=()

note() { printf 'quality: %s\n' "$*"; }
fail() {
    printf 'quality: FAIL %s\n' "$*" >&2
    failures+=("$*")
}

need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    fail "$2: required tool '$1' not found in PATH"
    return 1
}

# Run a per-file check over every file, accumulating failures. This function is
# the whole point of the script: it is the thing the old shell loops got wrong.
#
# MUST be fed by redirect — `each_file ... < <(files_x)` — never by a pipeline.
# `files_x | each_file ...` puts this function in a subshell, so its appends to
# `failures` are discarded and the final summary silently undercounts. That is
# the same class of bug as the loops this script replaces, one level up.
each_file() {
    local suite=$1 desc=$2
    shift 2
    local -a cmd=("$@")
    local f bad=0 count=0 out
    # mktemp, not /tmp/quality.$$: a predictable path in a world-writable
    # directory can be pre-created as a symlink by another user, which would
    # redirect this write.
    out=$(mktemp "${TMPDIR:-/tmp}/quality.XXXXXX") || {
        fail "$suite: could not create a temporary file"
        return
    }
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        # `git ls-files` lists what the INDEX tracks, which is not always what is
        # on disk. A staged rename or deletion leaves the old path tracked and
        # absent, and lefthook's pre-commit stash creates exactly that state
        # during a partial commit (`git commit -- <path>` while a rename is
        # staged). Running a formatter on it produced
        #     nixfmt: <path>: openFile: does not exist
        # reported as "1 of 96 file(s) failed" -- a formatting failure that does
        # not exist, which also hides whether anything real failed. A path that is
        # gone cannot be checked, so skip it rather than manufacture a failure.
        #
        # `-L` is deliberate, not redundant: `-e` follows symlinks, so a tracked
        # DANGLING symlink would also be skipped by `-e` alone. Those two cases
        # deserve opposite treatment. A staged rename is benign bookkeeping; a
        # tracked symlink whose target is missing is a real repository defect that
        # nothing else in this tool would catch, so it must reach the checker and
        # fail loudly rather than vanish into a silent skip. (This repository
        # currently tracks zero symlinks, so the choice is free today -- which is
        # exactly why it is worth fixing the semantics now rather than inheriting
        # whichever behaviour `-e` happened to give.)
        [[ -e $f || -L $f ]] || continue
        count=$((count + 1))
        if ! "${cmd[@]}" "$f" >"$out" 2>&1; then
            bad=$((bad + 1))
            printf '  --- %s\n' "$f" >&2
            sed 's/^/      /' "$out" >&2
        fi
    done
    rm -f "$out"
    if [[ $bad -gt 0 ]]; then
        fail "$suite: $bad of $count file(s) failed ($desc)"
    else
        note "$suite: $count file(s) OK"
    fi
}

# ---- suites -------------------------------------------------------------

run_nix_format() {
    need nixfmt nix-format || return
    if [[ $fix -eq 1 ]]; then
        files_nix | xargs -r nixfmt
        note "nix-format: rewrote $(files_nix | wc -l | tr -d ' ') file(s)"
    else
        each_file nix-format "nixfmt --check" nixfmt --check < <(files_nix)
    fi
}

run_nix_lint() {
    need statix nix-lint || return
    if statix check .; then
        note "nix-lint: statix OK"
    else
        fail "nix-lint: statix reported findings"
    fi
}

run_nix_deadcode() {
    need deadnix nix-deadcode || return
    if deadnix --no-lambda-arg --no-lambda-pattern-names --no-underscore --fail .; then
        note "nix-deadcode: deadnix OK"
    else
        fail "nix-deadcode: deadnix reported findings"
    fi
}

run_shell_lint() {
    need shellcheck shell-lint || return
    each_file shell-lint "shellcheck --severity=warning" \
        shellcheck --severity=warning < <(files_shell)
}

run_shell_format() {
    need shfmt shell-format || return
    if [[ $fix -eq 1 ]]; then
        local n=0 f
        while IFS= read -r f; do
            shfmt -i 4 -w "$f" && n=$((n + 1))
        done < <(files_shell)
        note "shell-format: rewrote $n file(s)"
    else
        each_file shell-format "shfmt -i 4 -d" shfmt -i 4 -d < <(files_shell)
    fi
}

run_python_lint() {
    need ruff python-lint || return
    need python3 python-lint || return
    local f bad=0
    local -a py=() templates=()
    while IFS= read -r f; do
        if [[ $f == *.py.in ]]; then
            templates+=("$f")
        else
            py+=("$f")
        fi
    done < <(files_python)
    if [[ ${#py[@]} -eq 0 && ${#templates[@]} -eq 0 ]]; then
        note "python-lint: no files"
        return
    fi
    if [[ ${#py[@]} -gt 0 ]] && ! ruff check "${py[@]}"; then
        bad=1
    fi
    for f in "${templates[@]}"; do
        if ! python3 - "$f" <<'PY' | ruff check --stdin-filename "${f%.in}" -; then
import re
import sys
from pathlib import Path

source = Path(sys.argv[1]).read_text(encoding="utf-8")
rendered, count = re.subn(r"@[A-Z][A-Z0-9_]*@", "1", source)
if count == 0:
    raise SystemExit(f"quality: Python template has no placeholders: {sys.argv[1]}")
sys.stdout.write(rendered)
PY
            bad=1
        fi
    done
    if [[ $bad -eq 0 ]]; then
        note "python-lint: $((${#py[@]} + ${#templates[@]})) file(s) OK (${#templates[@]} rendered template(s))"
    else
        fail "python-lint: ruff reported findings across $((${#py[@]} + ${#templates[@]})) file(s)"
    fi
}

run_python_test() {
    need python3 python-test || return
    need timeout python-test || return
    [[ -x $repo_root/bin/unittest-strict.py ]] || {
        fail "python-test: bin/unittest-strict.py is missing or not executable"
        return
    }
    local selection budget start elapsed remaining status
    local f bad=0 ran=0 timed_out=0 killed=0 budget_exceeded=0 not_reached=0
    local -a tests=() timeout_args=()
    selection=$(mktemp "${TMPDIR:-/tmp}/quality-python-tests.XXXXXX") || {
        fail "python-test: could not create a tier-selection file"
        return
    }
    if ! files_python_tests_for_tier "$python_tier" >"$selection"; then
        rm -f "$selection"
        fail "python-test: tier selection failed"
        return
    fi
    while IFS= read -r f; do
        [[ -n $f ]] && tests+=("$f")
    done <"$selection"
    rm -f "$selection"
    if ! budget=$(python_test_budget "$python_tier"); then
        fail "python-test: tier budget discovery failed"
        return
    fi

    start=$SECONDS
    note "python-test: tier=$python_tier planned=${#tests[@]} budget=${budget}s"
    for f in "${tests[@]}"; do
        elapsed=$((SECONDS - start))
        remaining=$((budget - elapsed))
        if [[ $remaining -le 0 ]]; then
            not_reached=$((${#tests[@]} - ran))
            break
        fi
        note "python-test: $f"
        timeout_args=(--signal=TERM --kill-after=5)
        if [[ ${QUALITY_TIER_SUPERVISED:-0} == 1 ]]; then
            timeout_args+=(--foreground)
        fi
        timeout "${timeout_args[@]}" "$remaining" \
            "$repo_root/bin/unittest-strict.py" "$f"
        status=$?
        ran=$((ran + 1))
        if [[ $status -eq 124 ]]; then
            timed_out=$((timed_out + 1))
            not_reached=$((${#tests[@]} - ran))
            break
        elif [[ $status -eq 137 ]]; then
            killed=$((killed + 1))
            not_reached=$((${#tests[@]} - ran))
            break
        elif [[ $status -ne 0 ]]; then
            bad=$((bad + 1))
        fi
    done
    elapsed=$((SECONDS - start))
    if [[ $elapsed -gt $budget && $timed_out -eq 0 && $killed -eq 0 ]]; then
        budget_exceeded=1
    fi
    if [[ $bad -gt 0 || $timed_out -gt 0 || $killed -gt 0 || $budget_exceeded -gt 0 || $not_reached -gt 0 ]]; then
        fail "python-test: tier=$python_tier planned=${#tests[@]} ran=$ran failed=$bad timed-out=$timed_out killed=$killed budget-exceeded=$budget_exceeded not-reached=$not_reached elapsed=${elapsed}s budget=${budget}s"
    else
        note "python-test: tier=$python_tier planned=${#tests[@]} ran=$ran failed=0 timed-out=0 killed=0 budget-exceeded=0 not-reached=0 elapsed=${elapsed}s budget=${budget}s"
    fi
}

# Unlike every other suite, this one does not read the local tree with a per-file
# tool. It evaluates the fleet's CONSUMERS (vulcan, vps, shared-work) against THIS
# working tree, eval-only, so an overlay or shared-config change here that would
# break a consumer fails at pre-push instead of at the consumer's next lock bump —
# which is how vulcan's evaluation stayed broken for weeks.
#
# bin/cross-consumer-eval is the authority for what that means; it reports every
# consumer before exiting non-zero, so this suite only records the verdict.
# Targeted but expensive: wired into pre-push, deliberately NOT pre-commit.
run_consumer_eval() {
    need nix consumer-eval || return
    if bin/cross-consumer-eval; then
        note "consumer-eval: OK"
    else
        fail "consumer-eval: bin/cross-consumer-eval reported a failing consumer"
    fi
}

run_signatures() {
    need git signatures || return
    need gpg signatures || return
    # verify-signatures owns the range logic and the %G? policy. It resolves the
    # CI push/PR range from SIGVERIFY_BASE/SIGVERIFY_HEAD, or when run bare the
    # local "not yet on any remote" set, and requires %G? in {G,U} for every
    # commit. It imports only PUBLIC keys from .github/signing-keys into a
    # throwaway keyring; no secret material is read or written.
    #
    # Unlike every other suite this one operates on a COMMIT RANGE rather than a
    # `git ls-files` file set, so it has no --files arm.
    if bin/verify-signatures; then
        note "signatures: every commit in range carries a good signature"
    else
        fail "signatures: unsigned or bad-signature commit(s) in range"
    fi
}

run_portable_eval() {
    need nix portable-eval || return
    if nix flake check ./config/ai --all-systems --no-build --no-warn-dirty; then
        note "portable-eval: OK"
    else
        fail "portable-eval: nix flake check ./config/ai failed"
    fi
}

# Unlike portable-eval, this reads no source from the working tree during Nix
# evaluation.  The script archives an exact commit, content-pins that tarball,
# proves Nix reports a tarball lock with the committed subflake lock graph, then
# checks the ?dir=config/ai flake without allowing a lock write.  It is expensive
# closeout evidence and therefore deliberately absent from pre-commit.
run_immutable_subflake() {
    if [[ ! -x bin/immutable-subflake-check ]]; then
        fail "immutable-subflake: bin/immutable-subflake-check is missing or not executable"
        return
    fi
    if bin/immutable-subflake-check; then
        note "immutable-subflake: immutable config/ai archive is lock-stable"
    else
        fail "immutable-subflake: immutable archive verification failed"
    fi
}

# The nix-darwin system layer has no useful drvPath parity signal: source-path
# propagation changes several store hashes on every commit. This targeted check
# compares seven evaluated value surfaces while masking only store hash prefixes.
# It is intentionally expensive and belongs in pre-push/CI, not pre-commit.
run_darwin_surface() {
    need nix darwin-surface || return
    local system
    if ! system=$(nix eval --impure --raw --expr builtins.currentSystem); then
        fail "darwin-surface: could not determine the current Nix system"
        return
    fi
    if nix build --no-link ".#checks.${system}.darwin-value-surface"; then
        note "darwin-surface: hera and clio match the committed value baseline"
    else
        fail "darwin-surface: evaluated Darwin values drifted from the baseline"
    fi
}

# Cheap regression authority. Expensive measurements are refreshed explicitly;
# this verifies that the committed artifact still matches live structural
# denominators and refuses missing, stale, malformed, or duplicate artifacts.
run_coverage() {
    if [[ ! -x bin/coverage-report ]]; then
        fail "coverage: bin/coverage-report is missing or not executable"
        return
    fi
    if bin/coverage-report --check; then
        note "coverage: committed artifact matches live structural inventories"
    else
        fail "coverage: bin/coverage-report rejected the committed artifact"
    fi
}

run_coverage_live() {
    if [[ ! -x bin/coverage-report ]]; then
        fail "coverage-live: bin/coverage-report is missing or not executable"
        return
    fi
    if bin/coverage-report --compare-live; then
        note "coverage-live: current Nix reach does not regress from the artifact"
    else
        fail "coverage-live: current Nix reach regressed or collection failed"
    fi
}

# ---- argument parsing ---------------------------------------------------

while [[ $# -gt 0 ]]; do
    case $1 in
    --fix) fix=1 ;;
    --python-tier)
        if [[ $python_tier_seen -eq 1 ]]; then
            printf 'quality: --python-tier may be specified only once\n' >&2
            exit 1
        fi
        python_tier_seen=1
        shift
        python_tier=${1-}
        case $python_tier in
        pre-commit | pre-push | ci-on-demand | all) ;;
        *)
            printf 'quality: --python-tier needs one of: pre-commit pre-push ci-on-demand all\n' >&2
            exit 1
            ;;
        esac
        ;;
    --tier)
        if [[ $quality_tier_seen -eq 1 ]]; then
            printf 'quality: --tier may be specified only once\n' >&2
            exit 1
        fi
        quality_tier_seen=1
        shift
        quality_tier=${1-}
        case $quality_tier in
        pre-commit | pre-commit-core | expensive) ;;
        *)
            printf 'quality: --tier needs one of: pre-commit pre-commit-core expensive\n' >&2
            exit 1
            ;;
        esac
        ;;
    --list)
        printf '%s\n' "${SUITES[@]}"
        exit 0
        ;;
    --files)
        case ${2-} in
        nix) files_nix ;;
        shell) files_shell ;;
        python) files_python ;;
        python-tests) files_python_tests ;;
        *)
            printf 'quality: --files needs one of: nix shell python python-tests\n' >&2
            exit 1
            ;;
        esac
        exit 0
        ;;
    -h | --help)
        sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'
        exit 0
        ;;
    all) want=("${SUITES[@]}") ;;
    -*)
        printf 'quality: unknown option: %s\n' "$1" >&2
        exit 1
        ;;
    *)
        # shellcheck disable=SC2076  # literal match is intended here
        if [[ " ${SUITES[*]} " =~ " $1 " ]]; then
            want+=("$1")
        else
            printf 'quality: unknown suite: %s (try --list)\n' "$1" >&2
            exit 1
        fi
        ;;
    esac
    shift
done

if [[ -n $quality_tier ]]; then
    if [[ $python_tier_seen -eq 1 ]]; then
        printf 'quality: --tier cannot be combined with --python-tier\n' >&2
        exit 1
    fi
    if [[ ${#want[@]} -gt 0 || $fix -eq 1 ]]; then
        printf 'quality: --tier cannot be combined with suites or --fix\n' >&2
        exit 1
    fi
    deadline_supervisor=$repo_root/bin/deadline-supervisor.py
    [[ -x $deadline_supervisor ]] || {
        printf 'quality: bin/deadline-supervisor.py is missing or not executable\n' >&2
        exit 1
    }
    case $quality_tier in
    pre-commit | pre-commit-core)
        budget=$(python_test_budget pre-commit) || exit 1
        python_tier=pre-commit
        tier_suites=("${PRE_COMMIT_CORE_SUITES[@]}")
        ;;
    expensive)
        budget=$(python_test_budget ci-on-demand) || exit 1
        python_tier=all
        tier_suites=("${EXPENSIVE_SUITES[@]}")
        ;;
    esac
    # A source-changing work commit is allowed to carry stale consolidated
    # evidence. Coverage freshness remains mandatory in pre-push, expensive,
    # make test, and issue closeout; forcing it here would require an expensive
    # artifact regeneration after every intermediate commit.
    term_after=$((budget - 15))
    if [[ $term_after -le 0 ]]; then
        printf 'quality: tier budget must exceed supervision headroom\n' >&2
        exit 1
    fi
    note "tier: $quality_tier planned=${#tier_suites[@]} budget=${budget}s term-after=${term_after}s kill-grace=5s report-headroom=10s"
    QUALITY_TIER_SUPERVISED=1 "$deadline_supervisor" \
        --term-after "$term_after" --kill-after 5 -- \
        "$quality_program" --python-tier "$python_tier" "${tier_suites[@]}"
    tier_status=$?
    case $tier_status in
    0)
        note "tier: $quality_tier passed inside ${budget}s"
        exit 0
        ;;
    124)
        printf 'quality: FAIL tier: %s exceeded its %ss work deadline inside the %ss envelope\n' "$quality_tier" "$term_after" "$budget" >&2
        exit 1
        ;;
    137)
        printf 'quality: FAIL tier: %s exited 137 (SIGKILL; deadline escalation, OOM, or external kill)\n' "$quality_tier" >&2
        exit 1
        ;;
    *)
        printf 'quality: FAIL tier: %s failed with exit %s\n' "$quality_tier" "$tier_status" >&2
        exit 1
        ;;
    esac
fi

[[ ${#want[@]} -gt 0 ]] || want=("${SUITES[@]}")

for suite in "${want[@]}"; do
    case $suite in
    nix-format) run_nix_format ;;
    nix-lint) run_nix_lint ;;
    nix-deadcode) run_nix_deadcode ;;
    shell-lint) run_shell_lint ;;
    shell-format) run_shell_format ;;
    python-lint) run_python_lint ;;
    python-test) run_python_test ;;
    portable-eval) run_portable_eval ;;
    immutable-subflake) run_immutable_subflake ;;
    darwin-surface) run_darwin_surface ;;
    consumer-eval) run_consumer_eval ;;
    signatures) run_signatures ;;
    coverage) run_coverage ;;
    coverage-live) run_coverage_live ;;
    esac
done

if [[ ${#failures[@]} -gt 0 ]]; then
    printf '\n' >&2
    printf 'quality: %d suite(s) failed:\n' "${#failures[@]}" >&2
    printf '  - %s\n' "${failures[@]}" >&2
    exit 1
fi

note "all requested suites passed (${want[*]})"
