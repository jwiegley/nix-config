#!/usr/bin/env bash

set -euo pipefail

# Host updates run in parallel panes for an operator watching the fleet.
tmux split-window "ssh clio 'upgrade clio --host-only'; echo 'clio done — press Enter'; read"
tmux split-window "ssh vulcan 'cd /etc/nixos && nix flake update --commit-lock-file && switch'; echo 'vulcan done — press Enter'; read"
tmux split-window "ssh vps 'cd /etc/nixos && nix flake update --commit-lock-file && switch'; echo 'vps done — press Enter'; read"
tmux select-layout even-vertical

# Shared NFS Home Manager source is updated once, then each active host uses
# the maintained switch wrapper from that authoritative checkout.
shared_home=/home/jwiegley/.config/home-manager
shared_hosts=(andoria-08)
ssh andoria-08 "cd $shared_home && nix flake update --commit-lock-file"
for host in "${shared_hosts[@]}"; do
    ssh "$host" "cd $shared_home && switch"
done

remote_home=/home/ubuntu/.config/home-manager
ssh git-ai "cd $remote_home && nix flake update --commit-lock-file && switch"
