#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=bin/lib/host-routing.sh
source "$script_dir/lib/host-routing.sh"

run_remote_job() {
    local job=$1 host=$2 command=$3 status
    printf 'update-remote: start %s\n' "$job"
    if ssh "$host" "$command"; then
        printf 'update-remote: complete %s\n' "$job"
    else
        status=$?
        printf 'update-remote: failed %s (status %d)\n' "$job" "$status" >&2
        return "$status"
    fi
}

# These jobs are deliberately sequential. Completion of one is the barrier
# before the next checkout can be updated or activated.
run_remote_job clio clio \
    'cd ~/src/nix && ./bin/upgrade clio --host-only'
run_remote_job vulcan vulcan \
    'cd /etc/nixos && nix flake update --commit-lock-file && ./build switch'

# VPS is parked: retain its explicit host-owned update path, but do not include
# it in the active remote rollout.

# Update the shared source once, then switch the explicit active rollout.
# Dormant git-ai remains a known member but is not an activation target.
shared_home=/home/jwiegley/.config/home-manager
shared_hosts_text=$(nix_active_shared_work_rollout_hosts) || {
    producer_status=$?
    printf 'update-remote: failed to load active shared-work rollout (status %d)\n' \
        "$producer_status" >&2
    exit "$producer_status"
}
shared_hosts=()
while IFS= read -r host; do
    [[ -n $host ]] && shared_hosts+=("$host")
done <<<"$shared_hosts_text"
((${#shared_hosts[@]} > 0)) || {
    printf '%s\n' 'update-remote: active shared-work rollout is empty' >&2
    exit 1
}

run_remote_job shared-work-update "${shared_hosts[0]}" \
    "cd $shared_home && nix flake update --commit-lock-file && nix flake check --no-update-lock-file"
for host in "${shared_hosts[@]}"; do
    run_remote_job "shared-work-$host" "$host" "cd $shared_home && switch"
done
