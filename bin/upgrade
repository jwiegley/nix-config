#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
routing=$script_dir/lib/host-routing.sh
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

run_host=true
run_projects=true
raw_host=$(hostname -s)

usage() {
    echo 'usage: upgrade [HOST] [--host-only|--projects-only]' >&2
}

while (($#)); do
    case $1 in
    --host-only) run_projects=false ;;
    --projects-only) run_host=false ;;
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        usage
        exit 2
        ;;
    *) raw_host=$1 ;;
    esac
    shift
done

host=$(normalize_nix_host "$raw_host") || {
    echo "upgrade: unknown host: $raw_host" >&2
    exit 2
}

if [[ $run_host == true ]]; then
    if [[ $(uname -s) == Darwin ]]; then
        sudo /bin/launchctl limit maxfiles 524288 524288
        ulimit -n 65536
    fi

    case $host in
    hera)
        cd "$HOME/src/nix"
        update-and-pull
        ./bin/update-agents --commit
        u hera update
        ./build system
        u hera upgrade-tasks sign
        ;;
    clio)
        cd "$HOME/src/nix"
        ./build system
        u clio upgrade-tasks
        ;;
    vulcan | vps | shared-work)
        switch
        ;;
    esac
fi

if [[ $run_projects == true ]]; then
    exec "$script_dir/upgrade-projects"
fi
