#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
installed_routing_path=
installed_upgrade_projects=
routing=${installed_routing_path:-$script_dir/lib/host-routing.sh}
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

run_host=true
run_projects=true
raw_host=$(hostname -s)

usage() {
    echo 'usage: upgrade [HOST] [--host-only|--projects-only]' >&2
}

while (($#)); do
    case $1 in
    --host-only) run_projects=false ;;
    --projects-only) run_host=false ;;
    -h | --help)
        usage
        exit 0
        ;;
    -*)
        usage
        exit 2
        ;;
    *) raw_host=$1 ;;
    esac
    shift
done

if [[ $run_host != true && $run_projects != true ]]; then
    echo "upgrade: --host-only and --projects-only are mutually exclusive" >&2
    usage
    exit 2
fi

if [[ $run_host == true ]]; then
    host=$(normalize_nix_host "$raw_host") || {
        echo "upgrade: unknown host: $raw_host" >&2
        exit 2
    }
    if [[ $(uname -s) == Darwin ]]; then
        sudo /bin/launchctl limit maxfiles 524288 524288
        ulimit -n 65536
    fi

    case $host in
    hera)
        cd "$HOME/src/nix"
        ./bin/update --all-inputs --pull --commit --switch --push
        u hera upgrade-tasks sign
        ;;
    clio)
        cd "$HOME/src/nix"
        ./build system
        u clio switch upgrade-tasks
        ;;
    vulcan | vps | shared-work)
        switch
        ;;
    esac
fi

if [[ $run_projects == true ]]; then
    exec "${installed_upgrade_projects:-$script_dir/upgrade-projects}"
fi
