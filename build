#!/usr/bin/env bash

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
routing=$script_dir/bin/lib/host-routing.sh
[[ -r $routing ]] || routing=$script_dir/../libexec/nix-scripts/host-routing.sh
# shellcheck source=bin/lib/host-routing.sh
source "$routing"

usage() {
    cat <<'EOF'
Usage: ./build MODE [PACKAGE] [NIX_BUILD_ARGS...]

Modes:
  system             Build the current Darwin system
  pkg PACKAGE        Build a package from the current Darwin package set
  emacs PACKAGE      Build an Emacs package
  python PACKAGE     Build a Python package
  haskell PACKAGE    Build a Haskell package
EOF
}

resolve_host_output() {
    local host_name
    host_name=$(command -v myhost >/dev/null 2>&1 && myhost || hostname -s)
    nix_flake_output_for_host "$host_name" || {
        echo "build: no flake output for host: $host_name" >&2
        return 2
    }
}

mode=${1:-}
case $mode in
system)
    host_output=$(resolve_host_output)
    shift
    case $host_output in hera | clio) ;; *)
        echo "build: system mode supports Darwin outputs only" >&2
        exit 2
        ;;
    esac
    nix build --max-jobs 8 --cores 8 \
        ".#darwinConfigurations.$host_output.system" \
        "$@" --keep-going --show-trace
    ;;
pkg | emacs | python | haskell)
    if (($# < 2)); then
        echo "build: $mode requires PACKAGE" >&2
        usage >&2
        exit 2
    fi
    host_output=$(resolve_host_output)
    package=$2
    shift 2
    case $mode in
    pkg) attribute="pkgs.$package" ;;
    emacs) attribute="pkgs.emacs30MacPortPackages.$package" ;;
    python) attribute="pkgs.python3Packages.$package" ;;
    haskell) attribute="pkgs.haskellPackages.$package" ;;
    esac
    nix build --cores 24 ".#darwinConfigurations.$host_output.$attribute" "$@"
    ;;
-h | --help)
    usage
    ;;
*)
    [[ -n $mode ]] && echo "build: unknown mode: $mode" >&2
    usage >&2
    exit 2
    ;;
esac
