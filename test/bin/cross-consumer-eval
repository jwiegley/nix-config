#!/usr/bin/env bash
# Evaluate selected nix-config consumers against this working tree.
#
# The targets have different depths:
#
#   shared-work  This repo's own homeConfigurations."jwiegley@x86_64-linux"
#                activationPackage. This synthetic fixture imports
#                config/johnw.nix, config/packages.nix, and config/overlays.nix
#                at hostname "linux"; it does not cover named-host branches.
#
#   vps          VPS_CHECKOUT's ovh-vps system.build.toplevel with its nix-config
#                input overridden to this working tree.
#
# Each target is forced to drvPath. Evaluation can still realize
# import-from-derivation dependencies from the consumer configuration.
#
# Every eval uses --no-write-lock-file; the VPS input override is in-memory.
#
# Usage:
#   test/bin/cross-consumer-eval                     # every discoverable consumer
#   test/bin/cross-consumer-eval vps                 # a subset
#   test/bin/cross-consumer-eval --list              # print the consumer set, exit
#
# Environment:
#   NIX_CONFIG_TREE          nix-config revision under test
#                            (default: this checkout, from the script's location)
#   VPS_CHECKOUT             vps checkout (default: ~/src/vps)
#   CONSUMER_EVAL_OFFLINE=1  add --offline to every eval; use where the
#                            consumers' inputs are already realized in the store
#   CONSUMER_EVAL_STRICT=1   a missing consumer checkout is a FAILURE, not a
#                            skip (use where the checkouts are guaranteed, e.g.
#                            a local closeout on hera/clio)
#
# Refs: jwiegley/nix-config#22.

set -uo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)

tree=${NIX_CONFIG_TREE:-$repo_root}
vps_checkout=${VPS_CHECKOUT:-$HOME/src/vps}

CONSUMERS=(shared-work vps)

# ---- reporting ----------------------------------------------------------

failures=()
ran=0
evaluated=0
skipped=0

note() { printf 'cross-consumer-eval: %s\n' "$*"; }
fail() {
    printf 'cross-consumer-eval: FAIL %s\n' "$*" >&2
    failures+=("$*")
}

# Common flags for every eval. --no-write-lock-file guarantees a consumer's lock
# is never modified by this gate; --no-warn-dirty silences the working-tree
# notice (a dirty tree is the normal, intended input here).
nix_common=(--no-write-lock-file --no-warn-dirty)
if [[ ${CONSUMER_EVAL_OFFLINE:-0} == 1 ]]; then
    nix_common+=(--offline)
fi

# Evaluate one target to a store path, accumulating (never aborting) on failure
# so every consumer is reported before the gate exits — the same rule test/bin/quality
# enforces for its per-file suites.
eval_target() {
    local name=$1
    shift
    local -a cmd=(nix eval "${nix_common[@]}" "$@")
    note "$name: ${cmd[*]}"
    ran=$((ran + 1))
    evaluated=$((evaluated + 1))
    local out rc
    out=$("${cmd[@]}" 2>&1)
    rc=$?
    if [[ $rc -eq 0 ]]; then
        local drv
        drv=$(printf '%s\n' "$out" | grep -oE '/nix/store/[a-z0-9]{32}-[^ ]*\.drv' | tr '\n' ' ')
        note "$name: OK  ${drv:-(evaluated)}"
    else
        fail "$name: evaluation failed against $tree"
        printf '%s\n' "$out" | sed 's/^/      /' >&2
    fi
}

# Skip a consumer whose checkout is absent — loudly, and as a failure under
# CONSUMER_EVAL_STRICT. A skip is NEVER counted as a pass.
skip_or_fail() {
    local name=$1 reason=$2
    if [[ ${CONSUMER_EVAL_STRICT:-0} == 1 ]]; then
        fail "$name: $reason (CONSUMER_EVAL_STRICT is set)"
    else
        note "$name: SKIPPED — $reason"
        skipped=$((skipped + 1))
    fi
}

# ---- lock coherence ------------------------------------------------------
#
# VPS takes two inputs from this repository: `nix-config` for path-imported
# modules and `nix-config-ai` for portable typed outputs. Require coherent
# revisions so those two surfaces cannot drift apart.
#
# Two inputs drifting apart is the same class of failure as a consumer crossing
# an incompatible revision, with a harder-to-read symptom.
#
# Checked from the consumer's own committed lock, read-only. Nothing here
# depends on the rename (jwiegley/nix-config#47) having landed.
check_lock_coherence() {
    local name=$1 checkout=$2
    local lock=$checkout/flake.lock
    if [[ ! -f $lock ]]; then
        skip_or_fail "$name [lock coherence]" "no flake.lock at $checkout"
        return
    fi
    local out
    if ! out=$(
        python3 - "$lock" <<'PYEOF'
import json, sys

nodes = json.load(open(sys.argv[1]))["nodes"]
revs = {}
for key in ("nix-config", "nix-config-ai"):
    node = nodes.get(key)
    if node is None:
        print("MISSING %s" % key)
        raise SystemExit(1)
    revs[key] = node.get("locked", {}).get("rev")
if None in revs.values():
    print("NOREV %s" % revs)
    raise SystemExit(1)
if len(set(revs.values())) != 1:
    print(
        "SKEW nix-config=%s nix-config-ai=%s"
        % (revs["nix-config"][:12], revs["nix-config-ai"][:12])
    )
    raise SystemExit(1)
print(next(iter(revs.values()))[:12])
PYEOF
    ); then
        fail "$name [lock coherence]: $out"
        return
    fi
    ran=$((ran + 1))
    note "$name [lock coherence]: OK  both inputs at $out"
}

# ---- consumers ----------------------------------------------------------

run_shared_work() {
    # This repo's own fixture; evaluated directly against the tree under test,
    # no override needed because it IS that tree.
    eval_target "shared-work [jwiegley@x86_64-linux]" \
        --raw \
        "$tree#homeConfigurations.\"jwiegley@x86_64-linux\".activationPackage.drvPath"
}

run_vps() {
    check_lock_coherence "vps" "$vps_checkout"
    if [[ ! -f $vps_checkout/flake.nix ]]; then
        skip_or_fail "vps [ovh-vps toplevel]" "no flake.nix at $vps_checkout (set VPS_CHECKOUT)"
        return
    fi
    eval_target "vps [ovh-vps toplevel]" \
        --raw --override-input nix-config "$tree" \
        --override-input nix-config-ai "$tree?dir=config/ai" \
        "$vps_checkout#nixosConfigurations.ovh-vps.config.system.build.toplevel.drvPath"
}

# ---- argument parsing ---------------------------------------------------

want=()
while [[ $# -gt 0 ]]; do
    case $1 in
    --list)
        printf '%s\n' "${CONSUMERS[@]}"
        exit 0
        ;;
    -h | --help)
        sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'
        exit 0
        ;;
    all) want=("${CONSUMERS[@]}") ;;
    -*)
        printf 'cross-consumer-eval: unknown option: %s\n' "$1" >&2
        exit 1
        ;;
    *)
        # shellcheck disable=SC2076  # literal membership test is intended
        if [[ " ${CONSUMERS[*]} " =~ " $1 " ]]; then
            want+=("$1")
        else
            printf 'cross-consumer-eval: unknown consumer: %s (try --list)\n' "$1" >&2
            exit 1
        fi
        ;;
    esac
    shift
done

[[ ${#want[@]} -gt 0 ]] || want=("${CONSUMERS[@]}")

need_nix() {
    command -v nix >/dev/null 2>&1 && return 0
    printf 'cross-consumer-eval: required tool '\''nix'\'' not found in PATH\n' >&2
    exit 1
}
need_nix

note "nix-config tree under test: $tree"

for consumer in "${want[@]}"; do
    case $consumer in
    shared-work) run_shared_work ;;
    vps) run_vps ;;
    esac
done

# ---- summary ------------------------------------------------------------

if [[ ${#failures[@]} -gt 0 ]]; then
    printf '\n' >&2
    printf 'cross-consumer-eval: %d consumer(s) failed:\n' "${#failures[@]}" >&2
    printf '  - %s\n' "${failures[@]}" >&2
    exit 1
fi

# A gate that evaluated nothing must not report success — the same failure mode
# as a formatter that exits 0 having formatted nothing (jwiegley/nix-config#48).
# Reading a consumer lock is an auxiliary check, not a consumer evaluation.
if [[ $evaluated -eq 0 ]]; then
    printf 'cross-consumer-eval: evaluated nothing (%d skipped); refusing to report success\n' \
        "$skipped" >&2
    exit 1
fi

# A full run must reach VPS rather than succeeding on the shared-work proxy
# alone. A named shared-work-only subset remains an explicit caller choice.
if [[ ${#want[@]} -eq ${#CONSUMERS[@]} && $evaluated -eq 1 && $skipped -gt 0 ]]; then
    printf 'cross-consumer-eval: a full run evaluated ONLY shared-work (%d skipped).\n' \
        "$skipped" >&2
    printf '    shared-work is this repo own fixture and a moderate proxy; it says\n' >&2
    printf '    nothing about vps. Point VPS_CHECKOUT at a real checkout, or name a\n' >&2
    printf '    subset to acknowledge the narrower scope.\n' >&2
    exit 1
fi

note "all evaluated consumers passed ($ran ran, $skipped skipped: ${want[*]})"
