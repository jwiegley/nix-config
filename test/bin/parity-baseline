#!/usr/bin/env bash
# Derive the fleet parity oracle: per-host toplevel drvPath plus the sorted
# selected-package multiset.
#
# Why this exists: nearly every parity gate in the Fleet Configuration Programme
# says "byte-identical to baseline", but until this script there was no committed
# baseline artifact and no single recorded way to derive one. Two gates comparing
# against differently-derived numbers are not comparing anything.
#
# The output is stored evidence, not a Nix-generated leaf, so it is committed as
# a tracked data file under test/baseline/.
#
# Determinism contract: for a fixed revision and a fixed nixpkgs lock, every
# value below is a pure function of the flake. Re-running at the same revision
# must reproduce the artifact byte-for-byte; that is the whole point, and
# `--check` asserts it.
#
# The two recorded quantities answer DIFFERENT questions, and a gate that
# conflates them will either cry wolf or miss a regression:
#
#   packageCount + packages  — the parity invariant. A refactor must never add
#       or drop a package. If this multiset moves, something real changed.
#
#   drvPath  — sensitive to derivation inputs, which includes source files. A
#       pure refactor that leaves every derivation input identical leaves
#       drvPath identical, which is what makes it a sharp refactor oracle. But
#       in practice EVERY commit moves it: vulcan-crt is path:./config/certs,
#       which resolves to <whole-flake-source>/config/certs and therefore carries
#       the hash of the entire tree. Measured: adding one unrelated file moves it.
#       Adding a file under bin/ additionally moves the nix-scripts source. So a
#       moved host drvPath is uninformative here; the multiset is the signal.
#       Measured: adding test/bin/quality and test/bin/parity-baseline moved all four host
#       drvPaths and moved no multiset (386/414/367/368 unchanged). The portable
#       drvPaths did not move, since config/fleet does not depend on bin/.
#
# So: "drvPath moved" is a question to answer, not automatically a failure.
# "multiset moved" during a refactor is a failure. Use --compare to see which.
#
# Usage:
#   test/bin/parity-baseline                     # derive, print JSON to stdout
#   test/bin/parity-baseline --write             # derive, write test/baseline/parity-<rev>.json
#   test/bin/parity-baseline --check FILE        # strict: re-derive at the SAME rev,
#                                           #   require byte-identical (determinism)
#   test/bin/parity-baseline --compare FILE      # cross-rev: report multiset drift
#                                           #   separately from drvPath drift
#   REFRESH_REASON=... [REFRESH_DELTAS=...] \
#     test/bin/parity-baseline --refresh FILE    # advance the oracle to HEAD, appending
#                                           #   a provenance entry; refuses a moved
#                                           #   multiset unless REFRESH_DELTAS names it
#
# Refs: jwiegley/nix-config#19 (capture), #31 (refresh as main advances).

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo_root"

# The oracle is only satisfiable if it postdates the overlay-factory refactor.
# a36d3f51 predates a3cc3843, so demanding byte-identity against it can never be
# met by post-a3cc3843 work. Assert the capture revision is a descendant.
ARMED_REFACTOR=a3cc3843

# Darwin hosts: (attr, home-manager username)
DARWIN_HOSTS=(
    "hera:johnw"
    "clio:johnw"
)

# Standalone Home Manager configurations, by flake attribute name.
HM_CONFIGS=(
    "johnw@aarch64-linux"
    "jwiegley@x86_64-linux"
)

# Portable fleet-core systems.
PORTABLE_DIR=./config/fleet
PORTABLE_SYSTEMS=(aarch64-darwin aarch64-linux x86_64-linux)

# Sort package names rather than trusting attribute or list order: a reordering
# that leaves the multiset identical is not a parity change, and treating it as
# one would make the gate cry wolf.
SORT_NAMES='ps: builtins.sort builtins.lessThan (map (p: p.pname or p.name) ps)'
SORT_ATTRS='ps: builtins.sort builtins.lessThan (builtins.attrNames ps)'

die() {
    printf 'parity-baseline: %s\n' "$*" >&2
    exit 1
}

# Record every command verbatim in the artifact so a later "vs baseline" gate
# re-derives identically instead of inventing its own query.
commands_json() {
    python3 - "$SORT_NAMES" "$SORT_ATTRS" "$PORTABLE_DIR" <<'PY'
import json, sys
names, attrs, portable = sys.argv[1], sys.argv[2], sys.argv[3]
print(json.dumps({
    "darwinDrvPath":
        'nix eval --no-write-lock-file --raw '
        '".#darwinConfigurations.<host>.config.system.build.toplevel.drvPath"',
    "darwinPackages":
        'nix eval --no-write-lock-file --json '
        '".#darwinConfigurations.<host>.config.home-manager.users.<user>'
        '.home.packages" --apply %r' % names,
    "hmDrvPath":
        'nix eval --no-write-lock-file --raw '
        '".#homeConfigurations.\\"<attr>\\".activationPackage.drvPath"',
    "hmPackages":
        'nix eval --no-write-lock-file --json '
        '".#homeConfigurations.\\"<attr>\\".config.home.packages" --apply %r' % names,
    "portablePackages":
        'nix eval --no-write-lock-file --json "%s#packages.<system>" --apply %r'
        % (portable, attrs),
}, indent=1))
PY
}

# Two guards that make a "vs baseline" comparison meaningful, both required by
# #31. Neither existed when #31 was first closed: the refresh POLICY was written
# but nothing enforced it, so the policy could be read as satisfied while the
# comparison it governs was still free to be nonsense.
#
#   1. The stored oracle rev must be an ancestor of HEAD. If it is not, the
#      oracle was captured on a branch that current work does not descend from,
#      and "drift" between them conflates divergence with regression.
#
#   2. The recorded derivation commands must equal the ones this script would
#      issue now. The artifact has always RECORDED them (so a reader can
#      re-derive by hand) but nothing COMPARED them, so changing PORTABLE_DIR or
#      a --apply expression would silently redefine what the numbers mean while
#      the file still claimed to be the same oracle.
guard_oracle_compatible() {
    local file=$1 want_rev
    want_rev=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["baselineRev"])' "$file")

    git merge-base --is-ancestor "$want_rev" HEAD || die "\
oracle rev ${want_rev:0:12} is NOT an ancestor of HEAD $(git rev-parse --short HEAD).
    The oracle describes a revision this checkout does not descend from, so any
    difference measures divergence, not regression. Re-point at an oracle on
    this history, or re-capture (#19)."

    local recorded current
    recorded=$(python3 -c 'import json,sys; print(json.dumps(json.load(open(sys.argv[1]))["commands"], sort_keys=True))' "$file")
    current=$(commands_json | python3 -c 'import json,sys; print(json.dumps(json.load(sys.stdin), sort_keys=True))')
    if [[ $recorded != "$current" ]]; then
        printf 'parity-baseline: DERIVATION COMMAND DIVERGENCE against %s\n' "$file" >&2
        diff -u <(printf '%s\n' "$recorded" | python3 -m json.tool) \
            <(printf '%s\n' "$current" | python3 -m json.tool) >&2 || true
        die "\
the oracle was derived by different commands than this script now issues, so the
    two sets of numbers do not answer the same question. Either restore the
    recorded commands or re-capture the oracle (#19) -- do not compare across a
    changed derivation."
    fi
}

derive() {
    local rev
    rev=$(git rev-parse HEAD)

    git merge-base --is-ancestor "$ARMED_REFACTOR" "$rev" ||
        die "capture rev $rev does not descend from $ARMED_REFACTOR; the oracle would be unsatisfiable"

    # A dirty tree means the artifact would describe something that is not the
    # recorded revision. Refuse rather than silently mislabel it.
    if [[ -n $(git status --porcelain -- . ':!test/baseline') ]]; then
        printf 'parity-baseline: WARNING tree is dirty; values may not match rev %s\n' \
            "${rev:0:12}" >&2
    fi

    local tmp
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' RETURN

    : >"$tmp/targets.jsonl"

    local spec host user attr system drv pkgs
    for spec in "${DARWIN_HOSTS[@]}"; do
        host=${spec%%:*}
        user=${spec##*:}
        printf 'parity-baseline: deriving darwin %s\n' "$host" >&2
        drv=$(nix eval --no-write-lock-file --raw \
            ".#darwinConfigurations.$host.config.system.build.toplevel.drvPath")
        pkgs=$(nix eval --no-write-lock-file --json \
            ".#darwinConfigurations.$host.config.home-manager.users.$user.home.packages" \
            --apply "$SORT_NAMES")
        python3 -c '
import json, sys
print(json.dumps({"kind": "darwin", "target": sys.argv[1], "user": sys.argv[2],
                  "drvPath": sys.argv[3], "packages": json.loads(sys.argv[4])}))
' "$host" "$user" "$drv" "$pkgs" >>"$tmp/targets.jsonl"
    done

    for attr in "${HM_CONFIGS[@]}"; do
        printf 'parity-baseline: deriving home-manager %s\n' "$attr" >&2
        drv=$(nix eval --no-write-lock-file --raw \
            ".#homeConfigurations.\"$attr\".activationPackage.drvPath")
        pkgs=$(nix eval --no-write-lock-file --json \
            ".#homeConfigurations.\"$attr\".config.home.packages" \
            --apply "$SORT_NAMES")
        python3 -c '
import json, sys
print(json.dumps({"kind": "home-manager", "target": sys.argv[1],
                  "drvPath": sys.argv[2], "packages": json.loads(sys.argv[3])}))
' "$attr" "$drv" "$pkgs" >>"$tmp/targets.jsonl"
    done

    for system in "${PORTABLE_SYSTEMS[@]}"; do
        printf 'parity-baseline: deriving portable %s\n' "$system" >&2
        pkgs=$(nix eval --no-write-lock-file --json \
            "$PORTABLE_DIR#packages.$system" --apply "$SORT_ATTRS")
        python3 -c '
import json, sys
print(json.dumps({"kind": "portable", "target": sys.argv[1],
                  "packages": json.loads(sys.argv[2])}))
' "$system" "$pkgs" >>"$tmp/targets.jsonl"
    done

    commands_json >"$tmp/commands.json"

    python3 - "$rev" "$tmp/targets.jsonl" "$tmp/commands.json" <<'PY'
import json, sys
rev, targets_path, commands_path = sys.argv[1], sys.argv[2], sys.argv[3]
targets = [json.loads(l) for l in open(targets_path) if l.strip()]
for t in targets:
    # Length is derived here rather than asserted anywhere, so a gate can never
    # compare against a hand-maintained count that has drifted from the list.
    t["packageCount"] = len(t["packages"])
out = {
    "schema": "fleet-parity-oracle/1",
    "baselineRev": rev,
    "armedRefactorAncestor": "a3cc3843",
    "note": (
        "Stored evidence for the Fleet Configuration Programme parity gates. "
        "Package counts are derived from the lists in this file, never asserted "
        "separately. Re-derive with test/bin/parity-baseline --check <this file>."
    ),
    "commands": json.load(open(commands_path)),
    "targets": sorted(targets, key=lambda t: (t["kind"], t["target"])),
}
print(json.dumps(out, indent=1, sort_keys=False))
PY
}

case ${1-} in
--write)
    out=$(derive)
    # Take the revision FROM the derived artifact, never by asking git a second
    # time. HEAD can move between derive() and here (it did, during this tool's
    # own development), which produced a file named for one revision while
    # recording another inside. A baseline whose filename disagrees with its
    # contents is worse than no baseline.
    rev=$(printf '%s' "$out" |
        python3 -c 'import json,sys; print(json.load(sys.stdin)["baselineRev"])')
    dest="test/baseline/parity-${rev:0:12}.json"
    mkdir -p test/baseline
    printf '%s\n' "$out" >"$dest"
    printf 'parity-baseline: wrote %s\n' "$dest" >&2
    printf '%s\n' "$dest"
    ;;
--check)
    [[ -n ${2-} ]] || die "--check needs a baseline file"
    [[ -f $2 ]] || die "no such baseline file: $2"
    guard_oracle_compatible "$2"
    want_rev=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["baselineRev"])' "$2")
    have_rev=$(git rev-parse HEAD)
    if [[ $want_rev != "$have_rev" ]]; then
        die "baseline was captured at ${want_rev:0:12} but HEAD is ${have_rev:0:12};
    a mismatch here means the comparison is meaningless, not that parity broke.
    Re-point at the recorded rev, or refresh the oracle (see #31)."
    fi
    # Compare the DERIVED CORE only. Provenance is inline in the artifact, so
    # `schema` and `history` are present in a refreshed oracle and absent from
    # derive()'s output; a literal whole-file diff would call that "drift" and
    # every --check would fail permanently the moment the oracle first advanced.
    # Those two fields are not derived quantities and are validated separately by
    # test/bin/oracle-currency-slow-test.py, which is where they belong.
    core() {
        python3 -c '
import json, sys
d = json.load(sys.stdin)
for k in ("schema", "history"):
    d.pop(k, None)
print(json.dumps(d, indent=1, sort_keys=False))
'
    }
    tmp_want=$(mktemp)
    tmp_have=$(mktemp)
    trap 'rm -f "$tmp_want" "$tmp_have"' EXIT
    core <"$2" >"$tmp_want"
    derive | core >"$tmp_have"
    if diff -u "$tmp_want" "$tmp_have" >/dev/null; then
        printf 'parity-baseline: MATCH %s (derived core)\n' "$2"
    else
        printf 'parity-baseline: DRIFT against %s\n' "$2" >&2
        diff -u "$tmp_want" "$tmp_have" >&2 || true
        exit 1
    fi
    ;;
--compare)
    # Cross-revision comparison. Unlike --check this does NOT require the same
    # rev, because its job is to say WHICH kind of drift happened rather than
    # to assert there was none. Multiset drift fails; drvPath-only drift is
    # reported and exits 0, since an additive source change moves drvPath
    # legitimately (see the header).
    [[ -n ${2-} ]] || die "--compare needs a baseline file"
    [[ -f $2 ]] || die "no such baseline file: $2"
    guard_oracle_compatible "$2"
    tmp_now=$(mktemp)
    trap 'rm -f "$tmp_now"' EXIT
    derive >"$tmp_now"
    python3 - "$2" "$tmp_now" <<'PY'
import json, sys
old = json.load(open(sys.argv[1]))
new = json.load(open(sys.argv[2]))
o = {(t["kind"], t["target"]): t for t in old["targets"]}
n = {(t["kind"], t["target"]): t for t in new["targets"]}

print("baseline %s -> current %s" % (old["baselineRev"][:12], new["baselineRev"][:12]))
missing = sorted(set(o) - set(n))
added = sorted(set(n) - set(o))
if missing:
    print("  TARGETS GONE:  %s" % (missing,))
if added:
    print("  TARGETS ADDED: %s" % (added,))

multiset_drift, drv_drift = [], []
for k in sorted(set(o) & set(n)):
    a, b = o[k], n[k]
    if a["packages"] != b["packages"]:
        lost = sorted(set(a["packages"]) - set(b["packages"]))
        gained = sorted(set(b["packages"]) - set(a["packages"]))
        multiset_drift.append((k, len(a["packages"]), len(b["packages"]), lost, gained))
    elif a.get("drvPath") != b.get("drvPath"):
        drv_drift.append(k)

print()
if multiset_drift:
    print("PACKAGE MULTISET DRIFT — this is a parity failure:")
    for k, na, nb, lost, gained in multiset_drift:
        print("  %s/%s  %d -> %d" % (k[0], k[1], na, nb))
        if lost:
            print("      lost:   %s" % ", ".join(lost[:12]))
        if gained:
            print("      gained: %s" % ", ".join(gained[:12]))
else:
    print("package multisets: IDENTICAL on every target")

if drv_drift:
    print()
    print("drvPath moved with an identical multiset on: %s"
          % ", ".join("%s/%s" % k for k in drv_drift))
    print("  Host drvPaths move on ANY commit, not only additive ones: vulcan-crt is")
    print("  path:./config/certs, which resolves to <whole-flake-source>/config/certs")
    print("  and so carries the hash of the ENTIRE tree. Adding one unrelated file")
    print("  was measured to move it identically. A new file under bin/ also moves")
    print("  nix-scripts, but that is a second cause, not the only one.")
    print("  So drvPath movement here is uninformative. The multiset above is the")
    print("  signal: investigate only if a MULTISET moved.")

sys.exit(1 if (multiset_drift or missing) else 0)
PY
    ;;
--refresh)
    # Advance the oracle to HEAD, per doc/PARITY-ORACLE-REFRESH.md. This is the
    # mechanism that policy describes; it did not exist when #31 was closed.
    #
    # REFRESH_REASON is always mandatory: an oracle that advanced for no recorded
    # reason is indistinguishable from one that was quietly overwritten to make a
    # failing gate pass, which is precisely what the policy exists to prevent.
    #
    # REFRESH_DELTAS is mandatory only when the multiset actually moved. Refusing
    # without it is the anti-laundering rule: a multiset move must be named by a
    # human before it is recorded as accepted.
    [[ -n ${2-} ]] || die "--refresh needs the current baseline file"
    [[ -f $2 ]] || die "no such baseline file: $2"
    [[ -n ${REFRESH_REASON-} ]] ||
        die "REFRESH_REASON is mandatory (see doc/PARITY-ORACLE-REFRESH.md)"
    guard_oracle_compatible "$2"

    tmp_new=$(mktemp)
    trap 'rm -f "$tmp_new"' EXIT
    derive >"$tmp_new"

    python3 - "$2" "$tmp_new" "${REFRESH_DELTAS-}" "$REFRESH_REASON" <<'PY'
import json, os, subprocess, sys

old_path, new_path, deltas, reason = sys.argv[1:5]
old = json.load(open(old_path))
new = json.load(open(new_path))

o = {(t["kind"], t["target"]): t for t in old["targets"]}
n = {(t["kind"], t["target"]): t for t in new["targets"]}

moved = []
for k in sorted(set(o) & set(n)):
    if o[k]["packages"] != n[k]["packages"]:
        lost = sorted(set(o[k]["packages"]) - set(n[k]["packages"]))
        gained = sorted(set(n[k]["packages"]) - set(o[k]["packages"]))
        moved.append((k, lost, gained))
for k in sorted(set(o) - set(n)):
    moved.append((k, ["<target removed>"], []))
for k in sorted(set(n) - set(o)):
    moved.append((k, [], ["<target added>"]))

if moved and not deltas.strip():
    sys.stderr.write(
        "parity-baseline: the multiset MOVED, so REFRESH_DELTAS is mandatory.\n"
        "    A refresh records an ACCEPTED result; it never launders an\n"
        "    unexplained delta (doc/PARITY-ORACLE-REFRESH.md).  Observed:\n")
    for (kind, target), lost, gained in moved:
        for p in lost:
            sys.stderr.write("      lost   %s/%s: %s\n" % (kind, target, p))
        for p in gained:
            sys.stderr.write("      gained %s/%s: %s\n" % (kind, target, p))
    sys.exit(1)

# Record what actually moved alongside the human's explanation, so a later
# reader can check the explanation against the measurement instead of taking
# the prose on trust.
observed = ["%s %s/%s: %s" % (w, k[0], k[1], p)
            for k, lost, gained in moved
            for w, ps in (("lost", lost), ("gained", gained))
            for p in ps]

entry = {
    "old_rev": old["baselineRev"],
    "new_rev": new["baselineRev"],
    "reason": reason,
    "intentional_deltas": [d for d in deltas.splitlines() if d.strip()],
    "observed_deltas": observed,
}

# On the FIRST advance, synthesize the genesis link so the chain is auditable
# from birth rather than from first advance -- the oracle's own capture is a link
# in its lineage, not a precondition of it. Without this the history would begin
# mid-story, and a reader could not tell the genesis rev from a lost entry.
prior = old.get("history")
if not prior:
    prior = [{
        "old_rev": None,
        "new_rev": old["baselineRev"],
        "reason": "genesis capture (jwiegley/nix-config#19)",
        "intentional_deltas": [],
        "observed_deltas": [],
    }]

new["schema"] = "fleet-parity-oracle/2"
new["history"] = prior + [entry]
# Reassemble so schema/baselineRev/history read first rather than wherever
# dict update happened to put them.
order = ["schema", "baselineRev", "armedRefactorAncestor", "note", "history",
         "commands", "targets"]
out = {k: new[k] for k in order if k in new}
out.update({k: v for k, v in new.items() if k not in out})

dest = "test/baseline/parity-%s.json" % new["baselineRev"][:12]
with open(dest, "w") as fh:
    fh.write(json.dumps(out, indent=1, sort_keys=False) + "\n")

# Exactly one oracle is ever tracked; Git is the archive.
if os.path.abspath(dest) != os.path.abspath(old_path):
    os.unlink(old_path)
    sys.stderr.write("parity-baseline: superseded %s (removed; Git is the archive)\n" % old_path)
sys.stderr.write("parity-baseline: advanced oracle to %s\n" % dest)
if observed:
    sys.stderr.write("parity-baseline: recorded %d accepted multiset delta(s)\n" % len(observed))
print(dest)
PY
    ;;
--commands)
    # Cheap: print the derivation commands without evaluating anything, so the
    # currency guard can compare the artifact's command surface to this tool.
    commands_json
    ;;
"" | --print)
    derive
    ;;
*)
    die "unknown argument: $1 (want --write, --check FILE, --compare FILE, --refresh FILE, --commands, or no argument)"
    ;;
esac
