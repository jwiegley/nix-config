#!/usr/bin/env bash
# Evaluate config/fleet from a content-pinned Git archive and its committed lock.

set -euo pipefail

die() {
    printf 'immutable-subflake-check: %s\n' "$*" >&2
    exit 1
}

if [[ ${1-} == -h || ${1-} == --help ]]; then
    printf 'usage: %s [REVISION]\n' "${0##*/}"
    exit 0
fi
[[ $# -le 1 ]] || die "expected at most one revision"

for tool in git nix python3 cmp cp mktemp unlink rmdir; do
    command -v "$tool" >/dev/null 2>&1 || die "required command is missing: $tool"
done

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(git -C "$script_dir/../.." rev-parse --show-toplevel 2>/dev/null) ||
    die "test/bin/immutable-subflake-check is not inside a Git repository"

revision=${1-HEAD}
commit=$(
    git -C "$repo_root" rev-parse --verify --end-of-options "${revision}^{commit}" \
        2>/dev/null
) || die "revision is not a commit: $revision"

worktree_lock=$repo_root/config/fleet/flake.lock
[[ -f $worktree_lock && ! -L $worktree_lock ]] ||
    die "working-tree config/fleet/flake.lock is missing or not a regular file"

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/immutable-subflake.XXXXXX") ||
    die "could not create a temporary directory"
archive=$tmp_dir/source.tar
prefetch_json=$tmp_dir/prefetch.json
metadata_json=$tmp_dir/metadata.json
committed_lock=$tmp_dir/committed-flake.lock
lock_snapshot=$tmp_dir/worktree-flake.lock
lock_change_reported=0

lock_is_unchanged() {
    [[ -f $worktree_lock && ! -L $worktree_lock ]] &&
        cmp -s "$lock_snapshot" "$worktree_lock"
}

cleanup() {
    local status=$? path
    trap - EXIT
    set +e

    if [[ -f $lock_snapshot ]] && ! lock_is_unchanged; then
        if [[ $lock_change_reported -eq 0 ]]; then
            printf '%s\n' \
                'immutable-subflake-check: working-tree config/fleet/flake.lock changed' >&2
        fi
        status=1
    fi

    for path in \
        "$metadata_json" \
        "$prefetch_json" \
        "$committed_lock" \
        "$lock_snapshot" \
        "$archive"; do
        if [[ -e $path || -L $path ]]; then
            if ! unlink "$path"; then
                printf 'immutable-subflake-check: could not unlink %s\n' "$path" >&2
                status=1
            fi
        fi
    done
    if [[ -d $tmp_dir ]] && ! rmdir "$tmp_dir"; then
        printf 'immutable-subflake-check: temporary directory is not empty: %s\n' \
            "$tmp_dir" >&2
        status=1
    fi
    exit "$status"
}
trap cleanup EXIT

cp "$worktree_lock" "$lock_snapshot" || die "could not snapshot the working-tree lock"
git -C "$repo_root" show "$commit:config/fleet/flake.lock" >"$committed_lock" ||
    die "revision $commit has no config/fleet/flake.lock"
git -C "$repo_root" archive --format=tar --output="$archive" "$commit" ||
    die "could not archive revision $commit"

archive_uri=$(
    python3 - "$archive" <<'PY'
import sys
from pathlib import Path

print(Path(sys.argv[1]).resolve().as_uri())
PY
)
prefetch_ref=tarball+$archive_uri
if ! nix flake prefetch --json "$prefetch_ref" >"$prefetch_json"; then
    die "nix flake prefetch failed for revision $commit"
fi

encoded_nar_hash=$(
    python3 - "$prefetch_json" <<'PY'
import json
import sys
from pathlib import Path
from urllib.parse import quote

try:
    value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))["hash"]
except (OSError, KeyError, TypeError, json.JSONDecodeError) as error:
    raise SystemExit(f"immutable-subflake-check: invalid prefetch JSON: {error}")
if not isinstance(value, str) or not value.startswith("sha256-") or len(value) <= 7:
    raise SystemExit("immutable-subflake-check: prefetch returned no SHA-256 NAR hash")
print(quote(value, safe=""))
PY
)

immutable_ref="tarball+${archive_uri}?dir=config/fleet&narHash=${encoded_nar_hash}"
if ! nix flake metadata --json --no-write-lock-file "$immutable_ref" \
    >"$metadata_json"; then
    die "nix flake metadata failed for the immutable subflake reference"
fi

if ! python3 - "$metadata_json" "$committed_lock" "$prefetch_json" <<'PY'; then
import json
import sys
from pathlib import Path


def load(path, label):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"immutable-subflake-check: invalid {label} JSON: {error}")


metadata = load(sys.argv[1], "metadata")
committed = load(sys.argv[2], "committed lock")
prefetch = load(sys.argv[3], "prefetch")
locked = metadata.get("locked")
if not isinstance(locked, dict):
    raise SystemExit("immutable-subflake-check: metadata has no locked object")
if locked.get("type") != "tarball":
    raise SystemExit(
        "immutable-subflake-check: metadata locked.type is not tarball: "
        + repr(locked.get("type"))
    )
if locked.get("dir") != "config/fleet":
    raise SystemExit(
        "immutable-subflake-check: metadata locked.dir is not config/fleet: "
        + repr(locked.get("dir"))
    )
if locked.get("narHash") != prefetch.get("hash"):
    raise SystemExit(
        "immutable-subflake-check: metadata locked.narHash differs from prefetch hash"
    )
if metadata.get("locks") != committed:
    raise SystemExit(
        "immutable-subflake-check: metadata locks differ from the committed revision lock"
    )
PY
    die "immutable metadata validation failed"
fi

if ! lock_is_unchanged; then
    lock_change_reported=1
    die "working-tree config/fleet/flake.lock changed during metadata resolution"
fi

if ! nix flake check "$immutable_ref" \
    --all-systems --no-build --no-write-lock-file; then
    die "nix flake check failed for the immutable subflake reference"
fi

if ! lock_is_unchanged; then
    lock_change_reported=1
    die "working-tree config/fleet/flake.lock changed during flake check"
fi

printf 'immutable-subflake-check: revision %s passed\n' "${commit:0:12}"
