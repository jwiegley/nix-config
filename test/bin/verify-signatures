#!/usr/bin/env bash
# Verify that every commit in a resolved range reports Git signature state G, U,
# or Y. Identity is bounded by the active keyring's contents.
#
# Public-key files from `.github/signing-keys` (or `--keys-dir`) are imported into
# a temporary GNUPGHOME. If no such files exist, the ambient keyring is used.
#
# Range precedence: explicit `--range`; explicit `--base/--head`; CI environment;
# otherwise `HEAD --not --remotes` against the current local tracking-ref snapshot.
# Bare mode does not fetch, and refuses when no tracking refs exist.
#
# EXIT CODES
#   0  every commit in range is G, U or Y (or the range is empty outside strict mode)
#   1  a signature is not-good, or strict mode finds an empty range
#   2  usage or range-resolution error (loud -- never silently green)
#   3  a required tool (git, gpg) is missing
#
# Usage:
#   test/bin/verify-signatures                       # local: check unpushed commits
#   test/bin/verify-signatures --range A..B
#   test/bin/verify-signatures --base <sha> --head <sha>
#   test/bin/verify-signatures --keys-dir DIR        # public keyring source
#   SIGVERIFY_BASE=.. SIGVERIFY_HEAD=.. test/bin/verify-signatures   # the CI contract
#
# Refs: jwiegley/nix-config#23 (GOV-10); sibling of bin/publish.

set -euo pipefail

prog=verify-signatures

say() { printf '%s: %s\n' "$prog" "$*"; }
warn() { printf '%s: %s\n' "$prog" "$*" >&2; }
die() {
    printf '%s: %s\n' "$prog" "$*" >&2
    exit 2
}
need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    printf '%s: required tool not found in PATH: %s\n' "$prog" "$1" >&2
    exit 3
}

# A throwaway GNUPGHOME used when configured public-key files are available.
# Cleanup is best-effort on normal and trapped exits.
ephemeral_gnupg=""
cleanup() {
    [[ -n $ephemeral_gnupg && -d $ephemeral_gnupg ]] || return 0
    gpgconf --homedir "$ephemeral_gnupg" --kill all >/dev/null 2>&1 || true
    rm -rf -- "$ephemeral_gnupg"
}
trap cleanup EXIT INT TERM

# ---- arguments ----------------------------------------------------------

range=${SIGVERIFY_RANGE:-}
base=${SIGVERIFY_BASE:-}
head_rev=${SIGVERIFY_HEAD:-}
keys_dir=${SIGVERIFY_KEYS_DIR:-.github/signing-keys}
default_branch=${SIGVERIFY_DEFAULT_BRANCH:-}

while [[ $# -gt 0 ]]; do
    case $1 in
    --range)
        [[ -n ${2-} ]] || die "--range needs an A..B argument"
        range=$2
        shift
        ;;
    --base)
        [[ -n ${2-} ]] || die "--base needs a revision"
        base=$2
        shift
        ;;
    --head)
        [[ -n ${2-} ]] || die "--head needs a revision"
        head_rev=$2
        shift
        ;;
    --keys-dir)
        [[ -n ${2-} ]] || die "--keys-dir needs a directory"
        keys_dir=$2
        shift
        ;;
    -h | --help)
        sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'
        exit 0
        ;;
    *) die "unknown argument: $1 (try --help)" ;;
    esac
    shift
done

need git
repo_root=$(git rev-parse --show-toplevel) || die "not in a git repository"
cd "$repo_root" || die "cannot cd to repository root: $repo_root"

# ---- keyring ------------------------------------------------------------
# Build a hermetic verification keyring from configured public-key files, if present.
# Otherwise leave the ambient keyring in place.
setup_keyring() {
    if [[ ! -d $keys_dir ]]; then
        say "no committed keyring at '$keys_dir'; using the ambient GPG keyring"
        return 0
    fi
    local -a keyfiles=()
    local f
    while IFS= read -r -d '' f; do
        keyfiles+=("$f")
    done < <(find "$keys_dir" -type f \
        \( -name '*.asc' -o -name '*.gpg' -o -name '*.pgp' -o -name '*.key' \) \
        -print0 2>/dev/null)
    if [[ ${#keyfiles[@]} -eq 0 ]]; then
        warn "keyring dir '$keys_dir' holds no public-key files; using the ambient keyring"
        return 0
    fi
    need gpg
    ephemeral_gnupg=$(mktemp -d "${TMPDIR:-/tmp}/sigverify-gnupg.XXXXXX") ||
        die "could not create a temporary GNUPGHOME"
    chmod 700 "$ephemeral_gnupg"
    export GNUPGHOME=$ephemeral_gnupg
    local imported=0
    for f in "${keyfiles[@]}"; do
        if gpg --batch --quiet --import "$f" >/dev/null 2>&1; then
            imported=$((imported + 1))
        else
            warn "could not import public-key file: $f"
        fi
    done
    [[ $imported -gt 0 ]] || die "no public keys could be imported from '$keys_dir'"
    say "built a hermetic keyring from $imported public-key file(s) in '$keys_dir'"
}

# ---- range --------------------------------------------------------------
# Populate the global array rev_args with the arguments to `git log`.
resolve_range() {
    if [[ -n $range ]]; then
        rev_args=("$range")
        say "range: explicit '$range'"
        return 0
    fi

    if [[ -n $head_rev || -n $base ]]; then
        [[ -n $head_rev ]] || die "a head revision is required when a base is given"
        local head_sha
        head_sha=$(git rev-parse --verify --quiet "$head_rev^{commit}") ||
            die "cannot resolve head revision: $head_rev"

        if [[ -z $base || $base =~ ^0+$ ]]; then
            # Brand-new branch: prefer a locally resolvable default branch, then
            # fall back to the current local remote-tracking refs.
            say "range: no base ref (new branch); using local branch/tracking refs"
            local -a excludes=()
            local ref
            for ref in "$default_branch" origin/master origin/main master main; do
                [[ -n $ref ]] || continue
                if git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
                    excludes=("^$ref")
                    break
                fi
            done
            if [[ ${#excludes[@]} -gt 0 ]]; then
                rev_args=("$head_sha" "${excludes[@]}")
            else
                warn "no default branch to exclude; checking full history of $head_rev (bootstrap)"
                rev_args=("$head_sha" --not --remotes)
            fi
            return 0
        fi

        local base_sha
        base_sha=$(git rev-parse --verify --quiet "$base^{commit}") ||
            die "cannot resolve base revision: $base"
        rev_args=("$base_sha..$head_sha")
        say "range: ${base_sha:0:12}..${head_sha:0:12}"
        return 0
    fi

    if [[ -n ${GITHUB_BASE_REF:-} ]]; then
        local base_ref="origin/$GITHUB_BASE_REF"
        git rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null ||
            die "PR base '$base_ref' not found; the workflow must fetch it (fetch-depth: 0)"
        rev_args=("$base_ref..HEAD")
        say "range: $base_ref..HEAD (pull_request)"
        return 0
    fi

    rev_args=(HEAD --not --remotes)
    # Without any local tracking refs this would degrade to full history, so
    # require an explicit range instead.
    if [[ -z $(git for-each-ref --count=1 refs/remotes 2>/dev/null) ]]; then
        printf 'verify-signatures: no remote-tracking refs, so "unpushed" cannot be\n' >&2
        printf '    determined and the default range would degrade to ALL history.\n' >&2
        printf '    Pass --range A..B, or --base/--head, to say what to verify.\n' >&2
        exit 2
    fi
    say "range: HEAD --not --remotes (local unpushed commits)"
}

# ---- verify -------------------------------------------------------------

declare -a rev_args=()
setup_keyring
resolve_range

# Capture git's output and its exit status FIRST. A `git log` failure must abort
# loudly (exit 2), never degrade to an empty range that passes silently -- that is
# the exact vacuous-green failure this gate exists to prevent.
if ! log_output=$(git log --no-color --pretty='%G? %H %s' "${rev_args[@]}" 2>&1); then
    die "git log failed for range (${rev_args[*]}):
$log_output"
fi

unsigned=0
checked=0
while read -r sig sha subject; do
    [[ -n $sig ]] || continue
    checked=$((checked + 1))
    case $sig in
    # Y means the signature is good under a key in the active keyring, but that
    # key has since expired. X (expired signature) remains rejected.
    G | U | Y) : ;;
    *)
        warn "REJECTED [$sig] $sha $subject"
        unsigned=1
        ;;
    esac
done <<<"$log_output"

if [[ $unsigned -ne 0 ]]; then
    warn "one or more commits in range lack a good signature (see above)"
    exit 1
fi

if [[ $checked -eq 0 ]]; then
    # Exiting 0 here is defensible -- there genuinely is nothing to check -- but
    # it is the same "passed having checked nothing" shape this programme is
    # strict about elsewhere. SIGVERIFY_STRICT=1 turns it into a failure, for CI
    # or any caller that needs "verified something" rather than "found nothing".
    if [[ ${SIGVERIFY_STRICT:-0} == 1 ]]; then
        printf 'verify-signatures: no commits in range and SIGVERIFY_STRICT is set; refusing to report success\n' >&2
        exit 1
    fi
    say "no commits in range; nothing to verify"
else
    say "all $checked commit(s) in range carry a good signature (G, U or Y)"
fi
exit 0
