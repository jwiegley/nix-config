#!/usr/bin/env bash
# Report direct last-known-good package pins whose build failure may have
# expired. On the pin's target system, this low-frequency check builds each
# package from current nixpkgs; it reports results and never edits the overlay.
#
# Usage:
#   test/bin/pin-currency                 # every pinned package
#   test/bin/pin-currency ntp             # a subset, by package name
#   test/bin/pin-currency --list          # print the pin map, exit
#
# Environment:
#   PIN_CURRENCY_TIMEOUT   per-package build timeout in seconds (default 1800)

set -uo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo_root" || exit 1

timeout_seconds=${PIN_CURRENCY_TIMEOUT:-1800}

# Pin name -> directly inherited packages in overlays/00-last-known-good.nix.
# The parser below rejects drift between these direct inherit blocks and the map.
# Each entry is pin:kind:system:packages.
#
#   build   The pin exists because the package itself failed to compile against
#           current nixpkgs. Building it unpinned tests the condition directly.
#   manual  A green package build does not prove the pin condition.
declare -a PIN_MAP=(
    "nixpkgs-last-good:build:aarch64-darwin:ntp"
)

note() { printf 'pin-currency: %s\n' "$*"; }
fail() { printf 'pin-currency: %s\n' "$*" >&2; }

if [[ ${1:-} == --list ]]; then
    for entry in "${PIN_MAP[@]}"; do
        rest=${entry#*:}
        kind=${rest%%:*}
        rest=${rest#*:}
        printf '  %-32s [%-6s] [%-14s] %s\n' "${entry%%:*}" "$kind" "${rest%%:*}" "${rest#*:}"
    done
    exit 0
fi

# Refuse if this map and the overlay disagree, on pin names OR on the packages
# each pin supplies. Names alone are not enough: releasing packages from a pin
# while leaving them listed here would make the report build packages that are
# no longer pinned and call them expired. That happened once, in 941c69e3.
overlay=overlays/00-last-known-good.nix
declared=$(
    python3 - "$overlay" <<'PARSE'
import re, sys
text = open(sys.argv[1]).read()
# Map each `name = nixpkgs "catalog-name"` binding to its catalog record.
catalog = dict(re.findall(r'(\w+)\s*=\s*nixpkgs\s+"([a-z0-9-]+)"', text))
for var, packages in re.findall(r'inherit\s+\((\w+)\)\s*(.*?);', text, re.S):
    name = catalog.get(var)
    if name:
        print(name + ":" + " ".join(sorted(packages.split())))
PARSE
)
known=$(for entry in "${PIN_MAP[@]}"; do
    rest=${entry#*:}
    rest=${rest#*:}
    printf '%s:%s\n' "${entry%%:*}" "$(printf '%s\n' ${rest#*:} | sort | tr '\n' ' ' | sed 's/ $//')"
done)
if [[ $(printf '%s\n' "$declared" | sort) != $(printf '%s\n' "$known" | sort) ]]; then
    fail "pin map disagrees with $overlay"
    fail "  overlay:"
    printf '%s\n' "$declared" | sed 's/^/    /' >&2
    fail "  map:"
    printf '%s\n' "$known" | sed 's/^/    /' >&2
    exit 2
fi

want=("$@")
for requested in "${want[@]}"; do
    found=0
    for entry in "${PIN_MAP[@]}"; do
        rest=${entry#*:}
        rest=${rest#*:}
        for package in ${rest#*:}; do
            if [[ $requested == "$package" ]]; then
                found=1
                break 2
            fi
        done
    done
    if [[ $found -eq 0 ]]; then
        fail "unknown pinned package: $requested"
        exit 2
    fi
done
system=$(nix eval --raw --impure --expr 'builtins.currentSystem' 2>/dev/null)
[[ -n $system ]] || {
    fail "cannot determine the current system"
    exit 2
}

expired=()
still_needed=()
unchecked=()

for entry in "${PIN_MAP[@]}"; do
    pin=${entry%%:*}
    rest=${entry#*:}
    kind=${rest%%:*}
    rest=${rest#*:}
    target_system=${rest%%:*}
    for package in ${rest#*:}; do
        if [[ ${#want[@]} -gt 0 ]] && ! printf '%s\n' "${want[@]}" | grep -qx "$package"; then
            continue
        fi
        if [[ $kind == manual ]]; then
            unchecked+=("$package (pinned by $pin)")
            note "$package: not mechanically checkable — verify $pin by hand"
            continue
        fi
        if [[ $system != "$target_system" ]]; then
            unchecked+=("$package (run on $target_system)")
            note "$package: skipped on $system — check on $target_system"
            continue
        fi
        note "building $package from unpinned nixpkgs ($system)"
        timeout "$timeout_seconds" nix build --no-write-lock-file --no-link --impure --expr "
            let flake = builtins.getFlake (toString $repo_root);
            in flake.inputs.nix-config-ai.inputs.nixpkgs.legacyPackages.${system}.${package}
        " >/dev/null 2>&1
        status=$?
        if [[ $status -eq 0 ]]; then
            expired+=("$package (pinned by $pin)")
            note "$package: BUILDS unpinned — $pin's condition is met"
        elif [[ $status -ge 124 && $status -le 127 || $status -eq 137 ]]; then
            unchecked+=("$package (check incomplete on $target_system, status $status)")
            note "$package: unpinned build check did not complete (status $status) — expiry is unknown"
        else
            still_needed+=("$package")
            note "$package: unpinned build failed (status $status) — pin is not shown expired"
        fi
    done
done

printf '\n'
note "not shown expired: ${#still_needed[@]}   awaiting manual check: ${#unchecked[@]}"
for item in "${unchecked[@]}"; do note "  ? $item"; done
if [[ ${#expired[@]} -eq 0 ]]; then
    if [[ ${#unchecked[@]} -gt 0 ]]; then
        fail "pin expiry is inconclusive until every selected pin is checked on its target system"
        exit 2
    fi
    note "no checked pin has outlived its reason"
    exit 0
fi

fail "${#expired[@]} pin(s) appear to have expired:"
for item in "${expired[@]}"; do
    fail "  - $item"
done
fail "Drop the pin, or record why it is still needed despite building."
exit 1
