#!/usr/bin/env bash
# test/bin/pin-currency — report last-known-good pins whose reason has expired.
#
# overlays/00-last-known-good.nix holds packages at older nixpkgs revisions
# because the current revision broke them. Each pin states its own release
# condition in prose — "Drop this once nixpkgs restores the Darwin code path",
# "Drop these once Hydra is green on aarch64-darwin" — and nothing checks
# whether that condition has been met. A pin outlives its reason silently, and
# the only symptom is packages sitting on old versions for a cause that no
# longer exists.
#
# Two of the expiry conditions audited on 2026-08-01 had already come due. The
# rclone fuse3 pin held 1.74.1 while unpinned nixpkgs built 1.74.4 cleanly on
# aarch64-darwin.
#
# What this proves, and what it does not. Most pins exist because the unpinned
# package FAILED TO BUILD — missing headers, K&R declarations rejected by a
# newer clang, tests that OOM. Those are compile-time failures, so evaluating a
# derivation path proves nothing; only building does. That is why this is a
# deliberate low-frequency target and not a tier suite: it builds each such
# package from unpinned nixpkgs, which is exactly the work the pins avoid.
#
# Not every pin has that shape, and conflating them would make this report
# confidently wrong. mesa's condition is Hydra coverage and rebuild cost, not
# whether a local build can eventually succeed. The retired
# nixos-render-docs pin was the same trap from the other direction: it built
# fine unpinned, because its break was in nix-darwin, which passed a flag the
# new version had removed. Such pins are marked `manual` — reported for a
# human, never auto-flagged, because a green build says nothing about whether
# the reason still holds.
#
# A `build` package that succeeds here has met its pin's condition. Removing the
# pin is still a judgement call — it changes a shipped version — so this reports
# and exits non-zero rather than editing anything.
#
# Usage:
#   test/bin/pin-currency                 # every pinned package
#   test/bin/pin-currency rclone mesa     # a subset, by package name
#   test/bin/pin-currency --list          # print the pin map, exit
#
# Environment:
#   PIN_CURRENCY_TIMEOUT   per-package build timeout in seconds (default 1800)

set -uo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo_root" || exit 1

timeout_seconds=${PIN_CURRENCY_TIMEOUT:-1800}

# Pin name -> packages it supplies, mirroring the inherit blocks in
# overlays/00-last-known-good.nix. Kept beside them deliberately: a new pin
# that is not listed here is invisible to this report, so the check below
# refuses when the two disagree.
# Each entry is pin:kind:packages.
#
#   build   The pin exists because the package itself failed to compile against
#           current nixpkgs. Building it unpinned tests the condition directly.
#   manual  The condition is not a property of the package building. Reported
#           for human verification, never auto-flagged: a green build here would
#           say nothing about whether the reason still holds.
declare -a PIN_MAP=(
    "nixpkgs-last-good:build:ntp"
    # mesa's condition is "Hydra is green on aarch64-darwin" — cache availability
    # and rebuild cost, not whether a local build can eventually succeed.
    "nixpkgs-pre-mesa-26-1:manual:mesa xorg-server xquartz"
)

note() { printf 'pin-currency: %s\n' "$*"; }
fail() { printf 'pin-currency: %s\n' "$*" >&2; }

if [[ ${1:-} == --list ]]; then
    for entry in "${PIN_MAP[@]}"; do
        rest=${entry#*:}
        printf '  %-32s [%-6s] %s\n' "${entry%%:*}" "${rest%%:*}" "${rest#*:}"
    done
    exit 0
fi

# Refuse if this map and the overlay disagree, on pin names OR on the packages
# each pin supplies. Names alone are not enough: releasing packages from a pin
# while leaving them listed here would make the report build packages that are
# no longer pinned and call them expired. That happened once, in 941c69e3.
overlay=overlays/00-last-known-good.nix
declared=$(
    python3 - "$overlay" <<'PARSE'
import re, sys
text = open(sys.argv[1]).read()
# `preMesa26_1 = nixpkgs "nixpkgs-pre-mesa-26-1";` -> variable to catalog name
catalog = dict(re.findall(r'(\w+)\s*=\s*nixpkgs\s+"([a-z0-9-]+)"', text))
for var, packages in re.findall(r'inherit\s+\((\w+)\)\s*(.*?);', text, re.S):
    name = catalog.get(var)
    if name:
        print(name + ":" + " ".join(sorted(packages.split())))
PARSE
)
known=$(for entry in "${PIN_MAP[@]}"; do
    rest=${entry#*:}
    printf '%s:%s\n' "${entry%%:*}" "$(printf '%s\n' ${rest#*:} | sort | tr '\n' ' ' | sed 's/ $//')"
done)
if [[ $(printf '%s\n' "$declared" | sort) != $(printf '%s\n' "$known" | sort) ]]; then
    fail "pin map disagrees with $overlay"
    fail "  overlay:"
    printf '%s\n' "$declared" | sed 's/^/    /' >&2
    fail "  map:"
    printf '%s\n' "$known" | sed 's/^/    /' >&2
    exit 2
fi

want=("$@")
system=$(nix eval --raw --impure --expr 'builtins.currentSystem' 2>/dev/null)
[[ -n $system ]] || {
    fail "cannot determine the current system"
    exit 2
}

expired=()
still_needed=()
unchecked=()

for entry in "${PIN_MAP[@]}"; do
    pin=${entry%%:*}
    rest=${entry#*:}
    kind=${rest%%:*}
    for package in ${rest#*:}; do
        if [[ ${#want[@]} -gt 0 ]] && ! printf '%s\n' "${want[@]}" | grep -qx "$package"; then
            continue
        fi
        if [[ $kind == manual ]]; then
            unchecked+=("$package (pinned by $pin)")
            note "$package: not mechanically checkable — verify $pin by hand"
            continue
        fi
        note "building $package from unpinned nixpkgs ($system)"
        if timeout "$timeout_seconds" nix build --no-write-lock-file --no-link --impure --expr "
            let flake = builtins.getFlake (toString $repo_root);
            in flake.inputs.nix-config-ai.inputs.nixpkgs.legacyPackages.${system}.${package}
        " >/dev/null 2>&1; then
            expired+=("$package (pinned by $pin)")
            note "$package: BUILDS unpinned — $pin's condition is met"
        else
            still_needed+=("$package")
            note "$package: still fails unpinned — $pin remains justified"
        fi
    done
done

printf '\n'
note "still justified: ${#still_needed[@]}   awaiting manual check: ${#unchecked[@]}"
for item in "${unchecked[@]}"; do note "  ? $item"; done
if [[ ${#expired[@]} -eq 0 ]]; then
    note "no pin has outlived its reason"
    exit 0
fi

fail "${#expired[@]} pin(s) appear to have expired:"
for item in "${expired[@]}"; do
    fail "  - $item"
done
fail "Drop the pin, or record why it is still needed despite building."
exit 1
