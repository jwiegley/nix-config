#!/usr/bin/env bash
# The single quality authority. lefthook, GitHub Actions and the Makefile all
# delegate here rather than each keeping their own copy of "which files, which
# tool, which flags".
#
# Why this exists. Before it, the same checks were defined in four places and had
# already drifted apart in ways that made CI strictly weaker than the local hook:
#
#   * CI shell-checks named 9 files by hand; lefthook globbed the non-recursive
#     bin/* plus build and found 18. CI was blind to 9 real scripts, including
#     bin/switch, bin/update-remote and bin/upgrade-all. (An audit corrected this
#     from "19 / blind to 10": the extra file was test/bin/quality itself, already in
#     the working tree when the measurement was taken.)
#   * Both hardcoded the same 4 Python files while the tree tracks 35. The other
#     31 additional tracked Python files were never linted.
#   * Worse, both looped over files WITHOUT propagating failure: no `set -e`, no
#     accumulation, so the loop exited with the status of its last iteration. A
#     misformatted file in the middle passed silently. bin/update had a
#     45-line shfmt diff and every gate reported success.
#
# So the two rules this script exists to enforce:
#
#   1. Scope comes from `git ls-files`, never from a hand-maintained list. A new
#      file is in scope the moment it is tracked; nothing has to be remembered.
#   2. Every file is checked and EVERY failure is reported, then the suite exits
#      non-zero. Never stop at the first failure, never lose one to $?.
#
# Usage:
#   test/bin/quality                      # run every suite (same as `all`)
#   test/bin/quality nix-format           # one suite
#   test/bin/quality --python-tier fast python-test
#   test/bin/quality --tier expensive      # low-frequency exhaustive assurance
#   test/bin/quality shell-format --fix   # rewrite instead of check, where meaningful
#   test/bin/quality --list               # print every suite
#   test/bin/quality --files shell        # print the discovered file set and exit
#
# Suites: nix-format nix-lint nix-deadcode shell-lint shell-format
#         python-lint python-test portable-eval immutable-subflake
#         darwin-surface consumer-eval signatures
#
# Refs: jwiegley/nix-config#46.

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel) || {
    printf 'quality: not in a git repository\n' >&2
    exit 1
}
quality_program=$repo_root/test/bin/quality
cd "$repo_root" || exit 1

SUITES=(
    nix-format
    nix-lint
    nix-deadcode
    shell-lint
    shell-format
    python-lint
    python-test
    portable-eval
    immutable-subflake
    darwin-surface
    consumer-eval
    signatures
)

fix=0
python_tier=full
python_tier_seen=0
quality_tier=""
quality_tier_seen=0
want=()

PRE_COMMIT_CORE_SUITES=(
    nix-format
    nix-lint
    nix-deadcode
    shell-lint
    shell-format
    python-lint
    python-test
)

EXPENSIVE_SUITES=(
    python-test
    portable-eval
    immutable-subflake
    consumer-eval
    signatures
    darwin-surface
)

# ---- file discovery -----------------------------------------------------
# Tracked files only. This excludes untracked result symlinks and build artifacts
# without a prune list, so "in scope" matches the repository's tracked surface.

files_nix() { git ls-files -- '*.nix'; }

# Shell files and extensionless Python are detected by shebang. Python files
# with .py or .py.in suffixes are also selected by extension.
_shebang_is() {
    local pat=$1 f=$2
    [[ -f $f ]] || return 1
    IFS= read -r first <"$f" 2>/dev/null || return 1
    [[ $first == '#!'* && $first == *"$pat"* ]]
}

files_shell() {
    local f inventory
    inventory=$(git ls-files) || return 1
    while IFS= read -r f; do
        if _shebang_is bash "$f" || _shebang_is /sh "$f" || _shebang_is 'env sh' "$f"; then
            printf '%s\n' "$f"
        fi
    done <<<"$inventory"
    return 0
}

files_python() {
    local f inventory
    inventory=$(git ls-files) || return 1
    while IFS= read -r f; do
        if [[ $f == *.py || $f == *.py.in ]]; then
            printf '%s\n' "$f"
        elif _shebang_is python "$f"; then
            printf '%s\n' "$f"
        fi
    done <<<"$inventory"
    return 0
}

# Discover tracked test/bin suites, then classify them by filename.
# Slow suites end in -slow-test.py; every other test/bin/*-test.py suite is fast.
# A test outside test/bin is a hard error so no new suite can silently disappear
# from both tiers.
files_python_tests_for_tier() {
    local tier=$1 path inventory selected=0
    case $tier in
    fast | full) ;;
    *)
        printf 'quality: invalid Python test tier: %s\n' "$tier" >&2
        return 1
        ;;
    esac
    if ! inventory=$(git ls-files -- '*-test.py'); then
        printf 'quality: could not discover tracked Python test suites\n' >&2
        return 1
    fi
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        case $path in
        test/bin/*-test.py) ;;
        *)
            printf 'quality: Python test suite must live under test/bin: %s\n' "$path" >&2
            return 1
            ;;
        esac
        if [[ $tier == fast && $path == *-slow-test.py ]]; then
            continue
        fi
        printf '%s\n' "$path"
        selected=$((selected + 1))
    done <<<"$inventory"
    if [[ $selected -eq 0 ]]; then
        printf 'quality: Python test tier %s selected zero suites\n' "$tier" >&2
        return 1
    fi
}

files_python_tests() { files_python_tests_for_tier full; }

python_test_budget() {
    case $1 in
    fast) printf '%s\n' 120 ;;
    full) printf '%s\n' 900 ;;
    *)
        printf 'quality: invalid Python test tier: %s\n' "$1" >&2
        return 1
        ;;
    esac
}

# ---- reporting ----------------------------------------------------------

failures=()

note() { printf 'quality: %s\n' "$*"; }
fail() {
    printf 'quality: FAIL %s\n' "$*" >&2
    failures+=("$*")
}

need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    fail "$2: required tool '$1' not found in PATH"
    return 1
}

# Run a per-file check over every file, accumulating failures. This function is
# the whole point of the script: it is the thing the old shell loops got wrong.
#
# The producer is named explicitly so its exit status is checked before any tool
# runs. Pipelines and process substitution can obscure producer failure; a
# pipeline can also run the consuming loop in a subshell and lose `failures`.
each_file() {
    local suite=$1 desc=$2 producer=$3
    shift 3
    local -a cmd=("$@")
    local f tool_path output inventory bad=0 count=0
    if ! inventory=$("$producer"); then
        fail "$suite: tracked-file discovery failed"
        return
    fi
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        # `git ls-files` lists what the INDEX tracks, which is not always what is
        # on disk. A staged rename or deletion leaves the old path tracked and
        # absent, and lefthook's pre-commit stash creates exactly that state
        # during a partial commit (`git commit -- <path>` while a rename is
        # staged). Running a formatter on it produced
        #     nixfmt: <path>: openFile: does not exist
        # reported as "1 of 96 file(s) failed" -- a formatting failure that does
        # not exist, which also hides whether anything real failed. A path that is
        # gone cannot be checked, so skip it rather than manufacture a failure.
        #
        # `-L` is deliberate, not redundant: `-e` follows symlinks, so a tracked
        # DANGLING symlink would also be skipped by `-e` alone. Those two cases
        # deserve opposite treatment. A staged rename is benign bookkeeping; a
        # tracked symlink whose target is missing is a real repository defect that
        # nothing else in this tool would catch, so it must reach the checker and
        # fail loudly rather than vanish into a silent skip. (This repository
        # currently tracks zero symlinks, so the choice is free today -- which is
        # exactly why it is worth fixing the semantics now rather than inheriting
        # whichever behaviour `-e` happened to give.)
        [[ -e $f || -L $f ]] || continue
        count=$((count + 1))
        tool_path=./$f
        if ! output=$("${cmd[@]}" "$tool_path" 2>&1); then
            bad=$((bad + 1))
            printf '  --- %s\n' "$f" >&2
            printf '%s\n' "$output" | sed 's/^/      /' >&2
        fi
    done <<<"$inventory"
    if [[ $bad -gt 0 ]]; then
        fail "$suite: $bad of $count file(s) failed ($desc)"
    else
        note "$suite: $count file(s) OK"
    fi
}

rewrite_files() {
    local suite=$1 producer=$2
    shift 2
    local f inventory bad=0 count=0
    if ! inventory=$("$producer"); then
        fail "$suite: tracked-file discovery failed"
        return
    fi
    while IFS= read -r f; do
        [[ -n $f ]] || continue
        [[ -e $f || -L $f ]] || continue
        if "$@" "./$f"; then
            count=$((count + 1))
        else
            bad=$((bad + 1))
        fi
    done <<<"$inventory"
    if [[ $bad -gt 0 ]]; then
        fail "$suite: $bad file(s) could not be rewritten"
    else
        note "$suite: rewrote $count file(s)"
    fi
}

# ---- suites -------------------------------------------------------------

run_nix_format() {
    need nixfmt nix-format || return
    if [[ $fix -eq 1 ]]; then
        rewrite_files nix-format files_nix nixfmt
    else
        each_file nix-format "nixfmt --check" files_nix nixfmt --check
    fi
}

run_nix_lint() {
    need statix nix-lint || return
    each_file nix-lint "statix check" files_nix statix check
}

run_nix_deadcode() {
    need deadnix nix-deadcode || return
    each_file nix-deadcode "deadnix" files_nix \
        deadnix --no-lambda-arg --no-lambda-pattern-names --no-underscore --fail
}

run_shell_lint() {
    need shellcheck shell-lint || return
    each_file shell-lint "shellcheck --severity=warning" \
        files_shell shellcheck --severity=warning
}

run_shell_format() {
    need shfmt shell-format || return
    if [[ $fix -eq 1 ]]; then
        rewrite_files shell-format files_shell shfmt -i 4 -w
    else
        each_file shell-format "shfmt -i 4 -d" files_shell shfmt -i 4 -d
    fi
}

run_python_lint() {
    need ruff python-lint || return
    need python3 python-lint || return
    local f inventory bad=0
    local -a py=() templates=()
    if ! inventory=$(files_python); then
        fail "python-lint: tracked-file discovery failed"
        return
    fi
    while IFS= read -r f; do
        if [[ $f == *.py.in ]]; then
            templates+=("$f")
        else
            py+=("./$f")
        fi
    done <<<"$inventory"
    if [[ ${#py[@]} -eq 0 && ${#templates[@]} -eq 0 ]]; then
        note "python-lint: no files"
        return
    fi
    if [[ ${#py[@]} -gt 0 ]] && ! ruff check "${py[@]}"; then
        bad=1
    fi
    for f in "${templates[@]}"; do
        if ! python3 - "$f" <<'PY' | ruff check --stdin-filename "${f%.in}" -; then
import re
import sys
from pathlib import Path

source = Path(sys.argv[1]).read_text(encoding="utf-8")
rendered, count = re.subn(r"@[A-Z][A-Z0-9_]*@", "1", source)
if count == 0:
    raise SystemExit(f"quality: Python template has no placeholders: {sys.argv[1]}")
sys.stdout.write(rendered)
PY
            bad=1
        fi
    done
    if [[ $bad -eq 0 ]]; then
        note "python-lint: $((${#py[@]} + ${#templates[@]})) file(s) OK (${#templates[@]} rendered template(s))"
    else
        fail "python-lint: ruff reported findings across $((${#py[@]} + ${#templates[@]})) file(s)"
    fi
}

run_python_test() {
    need python3 python-test || return
    need timeout python-test || return
    [[ -x $repo_root/test/bin/unittest-strict.py ]] || {
        fail "python-test: test/bin/unittest-strict.py is missing or not executable"
        return
    }
    local selection budget start elapsed remaining status
    local f bad=0 ran=0 timed_out=0 killed=0 budget_exceeded=0 not_reached=0
    local -a tests=() timeout_args=()
    selection=$(mktemp "${TMPDIR:-/tmp}/quality-python-tests.XXXXXX") || {
        fail "python-test: could not create a tier-selection file"
        return
    }
    if ! files_python_tests_for_tier "$python_tier" >"$selection"; then
        rm -f "$selection"
        fail "python-test: tier selection failed"
        return
    fi
    while IFS= read -r f; do
        [[ -n $f ]] && tests+=("$f")
    done <"$selection"
    rm -f "$selection"
    if ! budget=$(python_test_budget "$python_tier"); then
        fail "python-test: tier budget discovery failed"
        return
    fi

    start=$SECONDS
    note "python-test: tier=$python_tier planned=${#tests[@]} budget=${budget}s"
    for f in "${tests[@]}"; do
        elapsed=$((SECONDS - start))
        remaining=$((budget - elapsed))
        if [[ $remaining -le 0 ]]; then
            not_reached=$((${#tests[@]} - ran))
            break
        fi
        note "python-test: $f"
        timeout_args=(--signal=TERM --kill-after=5)
        if [[ ${QUALITY_TIER_SUPERVISED:-0} == 1 ]]; then
            timeout_args+=(--foreground)
        fi
        timeout "${timeout_args[@]}" "$remaining" \
            "$repo_root/test/bin/unittest-strict.py" "$f"
        status=$?
        ran=$((ran + 1))
        if [[ $status -eq 124 ]]; then
            timed_out=$((timed_out + 1))
            not_reached=$((${#tests[@]} - ran))
            break
        elif [[ $status -eq 137 ]]; then
            killed=$((killed + 1))
            not_reached=$((${#tests[@]} - ran))
            break
        elif [[ $status -ne 0 ]]; then
            bad=$((bad + 1))
        fi
    done
    elapsed=$((SECONDS - start))
    if [[ $elapsed -gt $budget && $timed_out -eq 0 && $killed -eq 0 ]]; then
        budget_exceeded=1
    fi
    if [[ $bad -gt 0 || $timed_out -gt 0 || $killed -gt 0 || $budget_exceeded -gt 0 || $not_reached -gt 0 ]]; then
        fail "python-test: tier=$python_tier planned=${#tests[@]} ran=$ran failed=$bad timed-out=$timed_out killed=$killed budget-exceeded=$budget_exceeded not-reached=$not_reached elapsed=${elapsed}s budget=${budget}s"
    else
        note "python-test: tier=$python_tier planned=${#tests[@]} ran=$ran failed=0 timed-out=0 killed=0 budget-exceeded=0 not-reached=0 elapsed=${elapsed}s budget=${budget}s"
    fi
}

# Evaluate the vps and shared-work targets against this working tree. The helper
# reports every selected consumer before failing; this expensive tier records its
# aggregate verdict. portable-eval owns the separate portable-flake contract.
run_consumer_eval() {
    need nix consumer-eval || return
    if test/bin/cross-consumer-eval; then
        note "consumer-eval: OK"
    else
        fail "consumer-eval: test/bin/cross-consumer-eval reported a failing consumer"
    fi
}

run_signatures() {
    need git signatures || return
    need gpg signatures || return
    # verify-signatures owns range resolution and the G/U/Y policy. Bare mode
    # uses the current local remote-tracking snapshot; CI passes an explicit
    # base/head range. Public key files are imported into a throwaway keyring.
    #
    # This suite operates on a commit range, so it has no --files arm.
    if test/bin/verify-signatures; then
        note "signatures: every commit in range carries a good signature"
    else
        fail "signatures: unsigned or bad-signature commit(s) in range"
    fi
}

run_portable_eval() {
    need nix portable-eval || return
    if nix flake check ./config/ai --all-systems --no-build --no-warn-dirty; then
        note "portable-eval: OK"
    else
        fail "portable-eval: nix flake check ./config/ai failed"
    fi
}

# Unlike portable-eval, this reads no source from the working tree during Nix
# evaluation.  The script archives an exact commit, content-pins that tarball,
# proves Nix reports a tarball lock with the committed subflake lock graph, then
# checks the ?dir=config/ai flake without allowing a lock write.  It is expensive
# closeout evidence and therefore deliberately absent from pre-commit.
run_immutable_subflake() {
    if [[ ! -x test/bin/immutable-subflake-check ]]; then
        fail "immutable-subflake: test/bin/immutable-subflake-check is missing or not executable"
        return
    fi
    if test/bin/immutable-subflake-check; then
        note "immutable-subflake: immutable config/ai archive is lock-stable"
    else
        fail "immutable-subflake: immutable archive verification failed"
    fi
}

# The nix-darwin system layer has no useful drvPath parity signal: source-path
# propagation changes several store hashes on every commit. This targeted check
# compares seven evaluated value surfaces while masking only store hash prefixes.
# It is intentionally expensive and belongs in low-frequency closeout, not hooks.
run_darwin_surface() {
    need nix darwin-surface || return
    local system
    if ! system=$(nix eval --impure --raw --expr builtins.currentSystem); then
        fail "darwin-surface: could not determine the current Nix system"
        return
    fi
    if nix build --no-link ".#checks.${system}.darwin-value-surface"; then
        note "darwin-surface: hera and clio match the committed value baseline"
    else
        fail "darwin-surface: evaluated Darwin values drifted from the baseline"
    fi
}

# ---- argument parsing ---------------------------------------------------

while [[ $# -gt 0 ]]; do
    case $1 in
    --fix) fix=1 ;;
    --python-tier)
        if [[ $python_tier_seen -eq 1 ]]; then
            printf 'quality: --python-tier may be specified only once\n' >&2
            exit 1
        fi
        python_tier_seen=1
        shift
        python_tier=${1-}
        case $python_tier in
        fast | full) ;;
        *)
            printf 'quality: --python-tier needs one of: fast full\n' >&2
            exit 1
            ;;
        esac
        ;;
    --tier)
        if [[ $quality_tier_seen -eq 1 ]]; then
            printf 'quality: --tier may be specified only once\n' >&2
            exit 1
        fi
        quality_tier_seen=1
        shift
        quality_tier=${1-}
        case $quality_tier in
        pre-commit | expensive) ;;
        *)
            printf 'quality: --tier needs one of: pre-commit expensive\n' >&2
            exit 1
            ;;
        esac
        ;;
    --list)
        printf '%s\n' "${SUITES[@]}"
        exit 0
        ;;
    --files)
        case ${2-} in
        nix) files_nix || exit 1 ;;
        shell) files_shell || exit 1 ;;
        python) files_python || exit 1 ;;
        python-tests) files_python_tests || exit 1 ;;
        *)
            printf 'quality: --files needs one of: nix shell python python-tests\n' >&2
            exit 1
            ;;
        esac
        exit 0
        ;;
    -h | --help)
        sed -n '2,/^set -uo/p' "$0" | sed 's/^# \{0,1\}//; $d'
        exit 0
        ;;
    all) want=("${SUITES[@]}") ;;
    -*)
        printf 'quality: unknown option: %s\n' "$1" >&2
        exit 1
        ;;
    *)
        # shellcheck disable=SC2076  # literal match is intended here
        if [[ " ${SUITES[*]} " =~ " $1 " ]]; then
            want+=("$1")
        else
            printf 'quality: unknown suite: %s (try --list)\n' "$1" >&2
            exit 1
        fi
        ;;
    esac
    shift
done

if [[ -n $quality_tier ]]; then
    if [[ $python_tier_seen -eq 1 ]]; then
        printf 'quality: --tier cannot be combined with --python-tier\n' >&2
        exit 1
    fi
    if [[ ${#want[@]} -gt 0 || $fix -eq 1 ]]; then
        printf 'quality: --tier cannot be combined with suites or --fix\n' >&2
        exit 1
    fi
    deadline_supervisor=$repo_root/test/bin/deadline-supervisor.py
    [[ -x $deadline_supervisor ]] || {
        printf 'quality: test/bin/deadline-supervisor.py is missing or not executable\n' >&2
        exit 1
    }
    case $quality_tier in
    pre-commit)
        budget=$(python_test_budget fast) || exit 1
        python_tier=fast
        tier_suites=("${PRE_COMMIT_CORE_SUITES[@]}")
        ;;
    expensive)
        budget=1800
        python_tier=full
        tier_suites=("${EXPENSIVE_SUITES[@]}")
        ;;
    esac
    term_after=$((budget - 15))
    if [[ $term_after -le 0 ]]; then
        printf 'quality: tier budget must exceed supervision headroom\n' >&2
        exit 1
    fi
    note "tier: $quality_tier planned=${#tier_suites[@]} budget=${budget}s term-after=${term_after}s kill-grace=5s report-headroom=10s"
    QUALITY_TIER_SUPERVISED=1 "$deadline_supervisor" \
        --term-after "$term_after" --kill-after 5 -- \
        "$quality_program" --python-tier "$python_tier" "${tier_suites[@]}"
    tier_status=$?
    case $tier_status in
    0)
        note "tier: $quality_tier passed inside ${budget}s"
        exit 0
        ;;
    124)
        printf 'quality: FAIL tier: %s exceeded its %ss work deadline inside the %ss envelope\n' "$quality_tier" "$term_after" "$budget" >&2
        exit 1
        ;;
    137)
        printf 'quality: FAIL tier: %s exited 137 (SIGKILL; deadline escalation, OOM, or external kill)\n' "$quality_tier" >&2
        exit 1
        ;;
    *)
        printf 'quality: FAIL tier: %s failed with exit %s\n' "$quality_tier" "$tier_status" >&2
        exit 1
        ;;
    esac
fi

[[ ${#want[@]} -gt 0 ]] || want=("${SUITES[@]}")

for suite in "${want[@]}"; do
    case $suite in
    nix-format) run_nix_format ;;
    nix-lint) run_nix_lint ;;
    nix-deadcode) run_nix_deadcode ;;
    shell-lint) run_shell_lint ;;
    shell-format) run_shell_format ;;
    python-lint) run_python_lint ;;
    python-test) run_python_test ;;
    portable-eval) run_portable_eval ;;
    immutable-subflake) run_immutable_subflake ;;
    darwin-surface) run_darwin_surface ;;
    consumer-eval) run_consumer_eval ;;
    signatures) run_signatures ;;
    esac
done

if [[ ${#failures[@]} -gt 0 ]]; then
    printf '\n' >&2
    printf 'quality: %d suite(s) failed:\n' "${#failures[@]}" >&2
    printf '  - %s\n' "${failures[@]}" >&2
    exit 1
fi

note "all requested suites passed (${want[*]})"
