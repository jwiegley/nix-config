#!/usr/bin/env python3
"""Compare Darwin value-surface JSON while preserving semantic store names."""

import argparse
import json
import re
import sys
from pathlib import Path


STORE_PATH = re.compile(r"/nix/store/[0-9a-df-np-sv-z]{32}-")


def normalize_store(value):
    """Mask only Nix store hashes, recursively; retain derivation names."""
    if isinstance(value, str):
        return STORE_PATH.sub("/nix/store/<hash>-", value)
    if isinstance(value, list):
        return [normalize_store(item) for item in value]
    if isinstance(value, dict):
        return {key: normalize_store(item) for key, item in value.items()}
    return value


def _child(path, key):
    return f"{path}.{key}" if path else str(key)


def differences(before, after, path=""):
    """Return structural differences, using parent paths for aggregate changes."""
    found = []
    label = path or "<root>"
    if type(before) is not type(after):
        return [
            f"{label}: type {type(before).__name__} -> {type(after).__name__}"
        ]
    if isinstance(before, dict):
        for key in sorted(set(before) | set(after)):
            child = _child(path, key)
            if key not in before:
                found.append(f"{child}: ADDED = {after[key]!r}")
            elif key not in after:
                found.append(f"{child}: REMOVED (was {before[key]!r})")
            else:
                found.extend(differences(before[key], after[key], child))
    elif isinstance(before, list):
        for index in range(max(len(before), len(after))):
            child = f"{path}[{index}]" if path else f"[{index}]"
            if index >= len(before):
                found.append(f"{child}: ADDED = {after[index]!r}")
            elif index >= len(after):
                found.append(f"{child}: REMOVED (was {before[index]!r})")
            else:
                found.extend(differences(before[index], after[index], child))
    elif before != after:
        found.append(f"{label}: {before!r} -> {after!r}")
    return found


def load_json(path):
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument(
        "--normalize-store",
        action="store_true",
        help="mask 32-character Nix store hashes but retain derivation names",
    )
    result.add_argument("before", type=Path)
    result.add_argument("after", type=Path)
    return result


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        before = load_json(args.before)
        after = load_json(args.after)
    except (OSError, json.JSONDecodeError) as error:
        print(f"darwin-surface-diff: {error}", file=sys.stderr)
        return 2

    if args.normalize_store:
        before = normalize_store(before)
        after = normalize_store(after)

    found = differences(before, after)
    if not found:
        print("darwin value surface: IDENTICAL")
        return 0
    for difference in found:
        print(f"darwin value surface: {difference}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
