{
  "schema": "darwin-value-surface/3",
  "baselineRev": "21ce50ee490dc748ab0b04ced536f1ce91bd8bc3",
  "note": "Seven nix-darwin value surfaces at the recorded revision. Only 32-character /nix/store hash prefixes are masked; derivation names remain. Launchd scripts are hashed after that normalization, so their text is not persisted. Authorized-key lists, authorized-key file paths, and build-machine private-key paths are persisted only as content-aware opaque aggregate hashes plus non-sensitive counts; sensitive keys and assignments are refused.",
  "commands": {
    "hostSurface": "nix eval --option eval-cache false --no-write-lock-file --impure --json '.#darwinConfigurations.<host>' --apply 'darwin: import ./test/darwin/darwin-surface.nix darwin'",
    "compare": "test/bin/darwin-surface-diff --normalize-store <before.json> <after.json>",
    "refresh": "test/bin/darwin-surface-baseline --rev <rev> --write"
  },
